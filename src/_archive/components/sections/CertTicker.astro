---
const certs = [
  'ISO 9001:2015 · Quality Management',
  'ISO 14001:2015 · Environmental Management',
  'ISO 45001:2018 · Occupational Safety',
  'IATF 16949:2016 · Automotive Quality',
  'CE Certification · European Conformity',
  'IRS Works Approval · Shipbuilding',
  'BIS IS 733 · IS 1285 · IS 5082',
  'CBAM Certified · 0.763 kg CO₂e / kg',
];
// Duplicate for seamless loop
const doubled = [...certs, ...certs];
---

<div class="cert-ticker-wrap" aria-label="Certifications">
  <div class="cert-ticker" role="marquee" aria-live="off">
    {doubled.map((cert, i) => (
      <span class="cert-item">
        <span class="cert-dot" aria-hidden="true"></span>
        {cert}
      </span>
    ))}
  </div>
</div>
