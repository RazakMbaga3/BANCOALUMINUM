---
// Direction B — "Foundry / Steel Gunmetal"
// Full-viewport video background · All content floats over footage as frosted steel panes
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Banco Aluminium: Integrated aluminium extrusion. Industrial profiles, architectural systems, cast billets. 35,000 MT/yr · Est. 1967 · Vadodara, India." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>Banco Aluminium: Select Segment [Direction B]</title>

  <style>
    /* ============================================================
       DIRECTION B — FULL-VIEWPORT VIDEO · FROSTED STEEL OVERLAY
       Video runs fixed behind entire page.
       Every panel is a translucent steel pane over the footage.
       ============================================================ */
    :root {
      --b-deep:   #1A2228;
      --b-base:   #222B32;
      --b-band:   #303B44;
      --b-hover:  #374249;
      --b-line:   #3E4D57;
      --b-soft:   #4E606E;
      --b-muted:  #8A9BA6;
      --b-silver: #B8C3C9;
      --b-light:  #CDD4D8;
      --b-white:  #E2E7EA;
      --b-green:  #009746;
      --sans: 'Inter', system-ui, sans-serif;
      --mono: 'JetBrains Mono', monospace;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { height: 100%; }

    body {
      font-family: var(--sans);
      background: var(--b-deep);   /* fallback if video not loaded */
      color: var(--b-light);
      -webkit-font-smoothing: antialiased;
      height: 100%;
      overflow: hidden;            /* desktop: no scroll — page fits in viewport */
    }

    a { color: inherit; text-decoration: none; }

    /* ── Fixed video background — covers entire viewport always ── */
    .bg-video {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 35%;
      z-index: 0;
      pointer-events: none;
    }

    /* Dark steel vignette — tones footage into Direction B palette */
    .bg-overlay {
      position: fixed;
      inset: 0;
      background:
        linear-gradient(
          160deg,
          rgba(26, 34, 40, 0.78) 0%,
          rgba(34, 43, 50, 0.58) 50%,
          rgba(22, 29, 34, 0.80) 100%
        );
      z-index: 1;
      pointer-events: none;
    }

    /* Engineering crosshatch — page-wide grid texture over footage */
    .bg-grid {
      position: fixed;
      inset: 0;
      background:
        repeating-linear-gradient(
          0deg,
          transparent 0, transparent 39px,
          rgba(255,255,255,0.022) 39px, rgba(255,255,255,0.022) 40px
        ),
        repeating-linear-gradient(
          90deg,
          transparent 0, transparent 39px,
          rgba(255,255,255,0.022) 39px, rgba(255,255,255,0.022) 40px
        );
      z-index: 2;
      pointer-events: none;
    }

    /* ── Page wrapper — all content floats above video ─────── */
    .page {
      position: relative;
      z-index: 3;
      height: 100dvh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    /* ── Preview switcher ────────────────────────────────────── */
    .preview-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 7px 40px;
      background: rgba(22, 29, 34, 0.82);
      border-bottom: 1px solid rgba(62, 77, 87, 0.5);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      flex-shrink: 0;
    }
    .preview-label {
      font-family: var(--mono);
      font-size: 9.5px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--b-green);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .preview-label::before {
      content: '';
      width: 6px; height: 6px;
      background: var(--b-green);
      border-radius: 50%;
    }
    .preview-switch { display: flex; align-items: center; gap: 6px; }
    .preview-btn {
      font-family: var(--mono);
      font-size: 9.5px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      padding: 4px 12px;
      border: 1px solid rgba(62, 77, 87, 0.7);
      color: var(--b-muted);
      background: transparent;
      cursor: pointer;
      transition: border-color 0.2s, color 0.2s;
      text-decoration: none;
    }
    .preview-btn:hover { border-color: var(--b-silver); color: var(--b-white); }
    .preview-btn.active {
      border-color: var(--b-green);
      color: var(--b-green);
      background: rgba(0,151,70,0.09);
    }
    .preview-sep { font-family: var(--mono); font-size: 9.5px; color: rgba(62,77,87,0.7); }

    /* ── Top bar ─────────────────────────────────────────────── */
    .bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 40px;
      background: rgba(26, 34, 40, 0.68);
      border-bottom: 1px solid rgba(62, 77, 87, 0.45);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      flex-shrink: 0;
    }
    .bar-logo { height: 24px; }
    .bar-data { display: flex; gap: 28px; }
    .bar-data span {
      font-family: var(--mono);
      font-size: 10.5px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(138, 155, 166, 0.8);
    }
    .bar-data span b { color: var(--b-white); font-weight: 600; }

    /* ── Hero intro — transparent strip, video shows directly ── */
    .hero {
      flex-shrink: 0;
      padding: 32px 40px 26px;
      border-bottom: 1px solid rgba(62, 77, 87, 0.35);
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 40px;
      flex-wrap: wrap;
    }

    .hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(138,155,166,0.9);
      margin-bottom: 14px;
    }
    .hero-spark {
      width: 18px; height: 2px;
      background: var(--b-green);
      flex-shrink: 0;
    }
    .hero h1 {
      font-size: clamp(26px, 3.4vw, 48px);
      font-weight: 800;
      letter-spacing: -0.04em;
      line-height: 0.95;
      color: var(--b-white);
      text-transform: uppercase;
      text-shadow: 0 2px 24px rgba(0,0,0,0.5);
    }
    .hero h1 em {
      font-style: normal;
      color: rgba(205, 212, 216, 0.55);
    }
    .hero-sub {
      font-size: 14px;
      line-height: 1.6;
      color: rgba(184, 195, 201, 0.85);
      max-width: 44ch;
      text-shadow: 0 1px 12px rgba(0,0,0,0.4);
    }

    /* Live indicator */
    .hero-live {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: 18px;
      padding: 5px 12px;
      border: 1px solid rgba(255,255,255,0.1);
      background: rgba(0,0,0,0.28);
      font-family: var(--mono);
      font-size: 9px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(184,195,201,0.7);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }
    .live-dot {
      width: 5px; height: 5px;
      background: var(--b-green);
      border-radius: 50%;
      animation: pulse 2.2s ease-in-out infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50%       { opacity: 0.35; transform: scale(0.7); }
    }

    /* ── Segment bands — frosted steel panes over footage ────── */
    .bands { flex: 1; display: flex; flex-direction: column; min-height: 0; }

    .band {
      flex: 1;
      display: grid;
      grid-template-columns: 90px 1.1fr 1.5fr 1fr 72px;
      align-items: center;
      gap: 32px;
      padding: 0 40px;
      border-bottom: 1px solid rgba(62, 77, 87, 0.4);

      /* Frosted steel — video bleeds through */
      background: rgba(48, 59, 68, 0.48);
      backdrop-filter: blur(3px) brightness(0.88);
      -webkit-backdrop-filter: blur(3px) brightness(0.88);

      position: relative;
      overflow: hidden;
      cursor: pointer;
      text-decoration: none;
      color: inherit;
      transition: background 0.28s ease, backdrop-filter 0.28s ease;
    }
    .band:last-child { border-bottom: none; }

    /* Grid lines on each band */
    .band::before {
      content: '';
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(
        90deg,
        transparent 0, transparent 39px,
        rgba(255,255,255,0.008) 39px, rgba(255,255,255,0.008) 40px
      );
      pointer-events: none;
    }

    /* Green left-edge rule */
    .band::after {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 2px;
      background: var(--b-green);
      transform: scaleY(0);
      transform-origin: bottom center;
      transition: transform 0.38s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .band:hover {
      background: rgba(55, 66, 73, 0.68);
      backdrop-filter: blur(6px) brightness(0.78);
      -webkit-backdrop-filter: blur(6px) brightness(0.78);
    }
    .band:hover::after { transform: scaleY(1); }
    .band:hover .band-arrow { color: var(--b-green); transform: translateX(6px); }
    .band:focus-visible { outline: 2px solid var(--b-green); outline-offset: -2px; }

    .band > * { position: relative; z-index: 1; }

    .band-num {
      font-family: var(--mono);
      font-size: 13px;
      letter-spacing: 0.16em;
      color: var(--b-green);
    }

    .band-name h2 {
      font-size: clamp(18px, 1.8vw, 28px);
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1.0;
      color: var(--b-white);
      text-transform: uppercase;
      text-shadow: 0 1px 16px rgba(0,0,0,0.45);
    }
    .band-name .tag {
      font-family: var(--mono);
      font-size: 9px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--b-muted);
      margin-top: 7px;
    }

    .band-desc {
      font-size: 13px;
      line-height: 1.62;
      color: rgba(184, 195, 201, 0.85);
      max-width: 40ch;
    }

    .band-specs { display: flex; flex-direction: column; gap: 6px; }
    .spec-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-family: var(--mono);
      font-size: 10px;
      border-bottom: 1px solid rgba(62, 77, 87, 0.45);
      padding-bottom: 4px;
      gap: 12px;
    }
    .spec-row:last-child { border-bottom: none; padding-bottom: 0; }
    .spec-l {
      color: var(--b-muted);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      font-size: 9px;
      flex-shrink: 0;
    }
    .spec-v {
      color: var(--b-light);
      font-weight: 500;
      text-align: right;
    }

    .band-arrow {
      font-family: var(--mono);
      font-size: 20px;
      color: rgba(138,155,166,0.7);
      text-align: right;
      transition: transform 0.28s ease, color 0.28s ease;
      line-height: 1;
    }

    /* ── Footer cert strip ───────────────────────────────────── */
    .foot {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 14px;
      padding: 13px 40px;
      background: rgba(22, 29, 34, 0.80);
      border-top: 1px solid rgba(62, 77, 87, 0.45);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      flex-shrink: 0;
    }
    .foot-certs { display: flex; gap: 18px; flex-wrap: wrap; }
    .foot-cert {
      font-family: var(--mono);
      font-size: 9.5px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(138,155,166,0.75);
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .foot-cert::before {
      content: '';
      width: 4px; height: 4px;
      background: var(--b-green);
      border-radius: 50%;
    }
    .foot-loc {
      font-family: var(--mono);
      font-size: 9.5px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(138,155,166,0.65);
    }

    /* ── Responsive ─────────────────────────────────────────── */
    @media (max-width: 1100px) {
      .band { grid-template-columns: 72px 1.1fr 1fr 64px; }
      .band-desc { display: none; }
    }
    @media (max-width: 800px) {
      body { overflow-y: auto; height: auto; }   /* allow scroll on mobile */
      .page { height: auto; min-height: 100dvh; overflow: visible; }
      .bg-video { position: fixed; }              /* video stays fixed while scrolling */
      .band {
        grid-template-columns: 56px 1fr 48px;
        gap: 20px;
        min-height: 130px;
        backdrop-filter: blur(8px) brightness(0.75);
        -webkit-backdrop-filter: blur(8px) brightness(0.75);
      }
      .band-desc, .band-specs { display: none; }
      .preview-bar, .bar { padding-left: 22px; padding-right: 22px; }
      .bar-data { display: none; }
      .hero { padding: 28px 22px 22px; }
      .foot { padding: 12px 22px; }
      .band { padding: 0 22px; }
    }
    @media (max-width: 600px) {
      .foot-cert:nth-child(n+5) { display: none; }
    }

    /* Short screens: allow content to breathe, don't clip */
    @media (max-height: 650px) and (min-width: 801px) {
      body { overflow-y: auto; height: auto; }
      .page { height: auto; min-height: 100dvh; overflow: visible; }
      .band { min-height: 110px; }
      .hero { padding: 20px 40px 16px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .band, .band::after, .band-arrow, .live-dot {
        transition: none; animation: none;
      }
    }
  </style>
</head>
<body>

  <!-- ── Fixed full-viewport video — sits behind everything ── -->
  <video
    class="bg-video"
    src="/herovideo.mp4"
    autoplay muted loop playsinline preload="auto"
    aria-hidden="true"
  ></video>
  <div class="bg-overlay" aria-hidden="true"></div>
  <div class="bg-grid"    aria-hidden="true"></div>

  <!-- ── Page content — all floats over the live footage ───── -->
  <div class="page">

    <!-- Preview switcher -->
    <div class="preview-bar">
      <span class="preview-label">Design Review · Direction B</span>
      <div class="preview-switch">
        <a href="/" class="preview-btn">Direction A</a>
        <span class="preview-sep">/</span>
        <span class="preview-btn active">Direction B</span>
      </div>
    </div>

    <!-- Logo + stat bar -->
    <div class="bar">
      <img class="bar-logo" src="/banco-logo-light.png" alt="Banco Aluminium" />
      <div class="bar-data">
        <span>EST <b>1967</b></span>
        <span><b>35,000</b> MT/YR</span>
        <span><b>5</b> PRESSES</span>
        <span><b>1,100+</b> CLIENTS</span>
      </div>
    </div>

    <!-- Hero headline — transparent, video shows through directly -->
    <section class="hero" aria-label="Banco Aluminium: Integrated Extrusion">
      <div>
        <div class="hero-eyebrow">
          <span class="hero-spark" aria-hidden="true"></span>
          Integrated Aluminium Extrusion
        </div>
        <h1>Aluminium at the<br><em>scale of industry.</em></h1>
        <div class="hero-live" aria-hidden="true">
          <span class="live-dot"></span>
          Production · Vadodara, Gujarat
        </div>
      </div>
      <p class="hero-sub">An integrated platform, from billet to finished profile, under one roof. Select your segment below.</p>
    </section>

    <!-- Three segment bands -->
    <main class="bands" aria-label="Product segments">

      <a class="band" href="/products/industrial" aria-label="Enter the Industrial & OEMs segment">
        <div class="band-num">/ 01</div>
        <div class="band-name">
          <h2>Industrial &amp; OEMs</h2>
          <div class="tag">Drawing-led · Repeat production</div>
        </div>
        <p class="band-desc">Application-led extrusions for OEMs with in-house machining, cold drawing and surface finishing.</p>
        <div class="band-specs">
          <div class="spec-row"><span class="spec-l">Sectors</span>   <span class="spec-v">Electrical · Auto · Defence</span></div>
          <div class="spec-row"><span class="spec-l">Profile wt</span><span class="spec-v">0.29 – 35 kg/m</span></div>
          <div class="spec-row"><span class="spec-l">Processing</span><span class="spec-v">3/4/5-axis VMC</span></div>
        </div>
        <div class="band-arrow">→</div>
      </a>

      <a class="band" href="/products/architectural" aria-label="Enter the Architectural segment">
        <div class="band-num">/ 02</div>
        <div class="band-name">
          <h2>Architectural</h2>
          <div class="tag">Systems · Finished</div>
        </div>
        <p class="band-desc">Precision aluminium systems for modern architecture: windows, doors, façades and partitions.</p>
        <div class="band-specs">
          <div class="spec-row"><span class="spec-l">Systems</span> <span class="spec-v">Casement · Sliding · Façade</span></div>
          <div class="spec-row"><span class="spec-l">Finishes</span><span class="spec-v">Anodised · Powder · Brushed</span></div>
          <div class="spec-row"><span class="spec-l">Series</span>  <span class="spec-v">40mm · 25mm Euro</span></div>
        </div>
        <div class="band-arrow">→</div>
      </a>

      <a class="band" href="/products/cast-products" aria-label="Enter the Casting & Billets segment">
        <div class="band-num">/ 03</div>
        <div class="band-name">
          <h2>Casting / Billets</h2>
          <div class="tag">Foundry · Alloy</div>
        </div>
        <p class="band-desc">Foundry-grade billets with controlled chemistry, hot-top casting and SCADA-traceable production.</p>
        <div class="band-specs">
          <div class="spec-row"><span class="spec-l">Capacity</span> <span class="spec-v">55,000 MT/yr</span></div>
          <div class="spec-row"><span class="spec-l">Diameters</span><span class="spec-v">127 – 254 mm</span></div>
          <div class="spec-row"><span class="spec-l">Alloys</span>   <span class="spec-v">1xxx – 7xxx</span></div>
        </div>
        <div class="band-arrow">→</div>
      </a>

    </main>

    <!-- Footer cert strip -->
    <footer class="foot">
      <div class="foot-certs">
        <span class="foot-cert">ISO 9001</span>
        <span class="foot-cert">ISO 14001</span>
        <span class="foot-cert">ISO 45001</span>
        <span class="foot-cert">IATF 16949</span>
        <span class="foot-cert">CE</span>
        <span class="foot-cert">IRS</span>
      </div>
      <div class="foot-loc">Vadodara · Gujarat · India</div>
    </footer>

  </div><!-- /.page -->

</body>
</html>
