---
const products = [
  { label: 'Industrial & OEM profiles', href: '/products/industrial' },
  { label: 'Architectural systems',     href: '/products/architectural' },
  { label: 'Extrusion billets',         href: '/products/cast-products' },
  { label: 'Standard sections',         href: '/products/standard-sections' },
  { label: 'All industries',            href: '/industries' },
];
const capabilities = [
  { label: 'Alloys & foundry',    href: '/capabilities/foundry' },
  { label: 'Die shop',            href: '/capabilities/die-shop' },
  { label: 'Extrusion',          href: '/capabilities/extrusion' },
  { label: 'Heat treatment',     href: '/capabilities/heat-treatment' },
  { label: 'Fabrication',        href: '/capabilities/machining' },
  { label: 'Cold drawing',       href: '/capabilities/cold-drawing' },
  { label: 'Surface finishing',  href: '/capabilities/surface-finishing' },
  { label: 'Packing options',    href: '/capabilities/packing' },
];
const company = [
  { label: 'About Banco',            href: '/about' },
  { label: 'Why Banco',              href: '/about/why-banco' },
  { label: 'Quality & certifications', href: '/about/quality' },
  { label: 'Global reach',           href: '/about/global-reach' },
  { label: 'Sustainability',         href: '/sustainability' },
  { label: 'Careers',               href: '/about/careers' },
  { label: 'News & Insights',   href: '/about/news' },
  { label: 'Downloads',             href: '/downloads' },
];
const contact = [
  { label: 'Send Enquiry', href: '/contact#quote' },
  { label: 'Contact us', href: '/contact' },
  { label: 'Schedule a plant visit', href: '/contact#visit' },
  { label: 'Find us on map', href: '/contact#map' },
];
const certs = ['ISO 9001', 'ISO 14001', 'ISO 45001', 'IATF 16949', 'CE', 'IRS', 'BIS'];

const capabilitiesCol1 = capabilities.slice(0, Math.ceil(capabilities.length / 2));
const capabilitiesCol2 = capabilities.slice(Math.ceil(capabilities.length / 2));
const companyCol1 = company.slice(0, Math.ceil(company.length / 2));
const companyCol2 = company.slice(Math.ceil(company.length / 2));
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand column -->
      <div class="footer-brand">
        <a href="/" aria-label="Banco Aluminium, home">
          <img
            src="/banco-logo-light-480.webp"
            alt="Banco Aluminium"
            width="140"
            height="32"
            loading="lazy"
          />
        </a>
        <p>
          Integrated aluminium extrusion solutions since 1967. From billet to finished
          profile, all under one roof in Vadodara, Gujarat, India.
        </p>
        <ul class="footer-certs" aria-label="Certifications">
          {certs.map((c) => <li>{c}</li>)}
        </ul>
      </div>

      <!-- Products -->
      <details class="footer-col" open>
        <summary><h2>Products</h2></summary>
        <ul>
          {products.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </details>

      <!-- Capabilities -->
      <details class="footer-col footer-col-wide" open>
        <summary><h2>Capabilities</h2></summary>
        <div class="footer-col-split">
          <ul>
            {capabilitiesCol1.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
          <ul>
            {capabilitiesCol2.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </div>
      </details>

      <!-- Company -->
      <details class="footer-col footer-col-wide" open>
        <summary><h2>Company</h2></summary>
        <div class="footer-col-split">
          <ul>
            {companyCol1.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
          <ul>
            {companyCol2.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </div>
      </details>

      <!-- Contact -->
      <details class="footer-col" open>
        <summary><h2>Contact</h2></summary>
        <ul>
          {contact.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </details>
    </div>

    <!-- Contact strip: horizontal, so it doesn't stretch the grid row -->
    <div class="footer-info">
      <div class="footer-info-item">
        <span class="footer-contact-label">Registered office</span>
        <address class="footer-address">
          Banco Aluminium Private Limited, Padra Road, Near Railway Station,
          Bil, Vadodara, Gujarat 391410, India
        </address>
      </div>
      <div class="footer-info-item">
        <span class="footer-contact-label">Sales enquiry</span>
        <a class="footer-contact-link" href="mailto:sales@bancoaluminium.com">sales@bancoaluminium.com</a>
        <a class="footer-contact-link" href="tel:+912652477200">+91 265 2477200</a>
      </div>
      <div class="footer-info-item">
        <span class="footer-contact-label">Suppliers enquiry</span>
        <a class="footer-contact-link" href="mailto:purchase@bancoaluminium.com">purchase@bancoaluminium.com</a>
        <a class="footer-contact-link" href="tel:+912652477452">+91 265 2477452</a>
      </div>
    </div>

    <!-- Bottom strip -->
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} Banco Aluminium Private Limited. All rights reserved.</span>
      <div class="footer-bottom-links">
        <a href="/privacy">Privacy policy</a>
        <a href="/sitemap">Sitemap</a>
        <a href="/contact">Contact us</a>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  // Columns ship `open` so desktop and no-JS keep the full sitemap. Below 640px
  // they collapse to accordions, which is what keeps the mobile footer short.
  (() => {
    const mq = window.matchMedia('(max-width: 640px)');
    const cols = document.querySelectorAll('.site-footer .footer-col');
    const sync = () => cols.forEach((c) => { c.open = !mq.matches; });
    sync();
    mq.addEventListener('change', sync);
  })();
</script>
