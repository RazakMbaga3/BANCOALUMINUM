---
interface Props {
  transparent?: boolean;
}
const { transparent = false } = Astro.props;

const nav = [
  {
    label: 'Solutions',
    children: [
      { label: 'Home',                          href: '/',                           group: 'Products' },
      { label: 'Standard sections',            href: '/products/standard-sections', group: 'Products' },
      { label: 'Automotive & commercial',      href: '/industries/automotive',      group: 'Industries' },
      { label: 'Electrical power & T&D',       href: '/industries/electrical',      group: 'Industries' },
      { label: 'Heat sinks & exchangers',      href: '/industries/heat-management', group: 'Industries' },
      { label: 'Hydraulics & pneumatics',      href: '/industries/hydraulics',      group: 'Industries' },
      { label: 'Machining & forging',          href: '/industries/forging',         group: 'Industries' },
      { label: 'Building & construction',      href: '/industries/building',        group: 'Industries' },
    ],
  },
  {
    label: 'Capabilities',
    children: [
      { label: 'Alloys',              href: '/capabilities/foundry',          group: '' },
      { label: 'Die shop',            href: '/capabilities/die-shop',         group: '' },
      { label: 'Extrusion',           href: '/capabilities/extrusion',        group: '' },
      { label: 'Heat treatment',      href: '/capabilities/heat-treatment',   group: '' },
      { label: 'Fabrication',         href: '/capabilities/machining',        group: '' },
      { label: 'Cold drawing',        href: '/capabilities/cold-drawing',     group: '' },
      { label: 'Surface finishes',    href: '/capabilities/surface-finishing',group: '' },
      { label: 'Packing options',     href: '/capabilities/packing',          group: '' },
    ],
  },
  { label: 'Sustainability', href: '/sustainability' },
  {
    label: 'About us',
    children: [
      { label: 'Company',                   href: '/about',              group: '' },
      { label: 'Quality & certifications',  href: '/about/quality',      group: '' },
      { label: 'Global reach',              href: '/about/global-reach', group: '' },
      { label: 'Careers',                   href: '/about/careers',      group: '' },
    ],
  },
];
---

<header class:list={['site-nav', transparent && 'nav-hero']} id="site-nav">
  <!-- Main nav -->
  <nav class="main-nav" role="navigation" aria-label="Main navigation">
    <div class="container">
      <div class="main-nav-inner">
        <!-- Logo -->
        <a href="/" class="nav-logo" aria-label="Banco Aluminium — home">
          <img
            src="/banco-logo-light.png"
            alt="Banco Aluminium"
            width="160"
            height="36"
            loading="eager"
          />
        </a>

        <!-- Links -->
        <ul class="nav-links" role="list">
          {nav.map((item) => (
            <li>
              {item.children ? (
                <>
                  <button type="button" aria-haspopup="true" aria-expanded="false">
                    {item.label}
                    <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                      <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  </button>
                  <div class="nav-dropdown" role="menu">
                    {item.children.reduce((acc: any[], child, i) => {
                      const prev = item.children[i - 1];
                      if (child.group && child.group !== prev?.group) {
                        acc.push(<div class="nav-dd-group" aria-hidden="true">{child.group}</div>);
                      }
                      acc.push(<a href={child.href} role="menuitem">{child.label}</a>);
                      return acc;
                    }, [])}
                  </div>
                </>
              ) : (
                <a href={item.href}>{item.label}</a>
              )}
            </li>
          ))}
        </ul>

        <!-- CTA -->
        <a href="/contact#quote" class="btn btn-primary-dark nav-cta">
          Request a quote
        </a>

        <!-- Mobile toggle -->
        <button
          class="nav-hamburger"
          id="nav-toggle"
          aria-label="Toggle navigation"
          aria-expanded="false"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>
  </nav>
</header>

<!-- Mobile menu (offcanvas) -->
<div id="mobile-menu" style="
  position:fixed;top:0;left:0;right:0;bottom:0;
  background:var(--color-navy);
  z-index:200;
  display:none;
  flex-direction:column;
  overflow-y:auto;
  padding:24px;
">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:40px">
    <img src="/banco-logo-light.png" alt="Banco Aluminium" height="32" />
    <button id="mobile-close" style="background:none;border:none;color:var(--color-stone-50);cursor:pointer;padding:4px;display:flex;align-items:center;" aria-label="Close menu">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M3 3l14 14M17 3L3 17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
  <nav style="flex:1">
    {nav.map((item) => (
      <div style="border-bottom:1px solid var(--color-navy-line);padding:4px 0">
        {item.children ? (
          <>
            <div style="font-family:var(--font-mono);font-size:10px;letter-spacing:0.18em;text-transform:uppercase;color:var(--color-green);padding:12px 0 8px">{item.label}</div>
            {item.children.map((child) => (
              <a href={child.href} style="display:block;padding:10px 0;font-size:15px;color:var(--color-stone-400)">{child.label}</a>
            ))}
          </>
        ) : (
          <a href={item.href} style="display:block;padding:16px 0;font-size:16px;color:var(--color-stone-50);font-weight:500">{item.label}</a>
        )}
      </div>
    ))}
  </nav>
  <a href="/contact#quote" class="btn btn-primary-dark" style="margin-top:32px;justify-content:center">Request a quote</a>
</div>

<script>
  // ── Mobile menu ──────────────────────────────────────────────
  const toggle = document.getElementById('nav-toggle');
  const close  = document.getElementById('mobile-close');
  const menu   = document.getElementById('mobile-menu');

  function openMenu() {
    if (!menu) return;
    menu.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    toggle?.setAttribute('aria-expanded', 'true');
  }
  function closeMenu() {
    if (!menu) return;
    menu.style.display = 'none';
    document.body.style.overflow = '';
    toggle?.setAttribute('aria-expanded', 'false');
  }

  toggle?.addEventListener('click', openMenu);
  close?.addEventListener('click', closeMenu);
  menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));

  // ── Scroll shadow + transparent-nav scroll class ─────────────
  const nav = document.getElementById('site-nav');
  const isHero = nav?.classList.contains('nav-hero');

  window.addEventListener('scroll', () => {
    if (!nav) return;
    nav.style.boxShadow = window.scrollY > 20 ? '0 2px 24px rgba(0,0,0,0.35)' : '';
    if (isHero) nav.classList.toggle('is-scrolled', window.scrollY > 72);
  }, { passive: true });

  // ── Desktop dropdown: toggle aria-expanded on click/keyboard ─
  document.querySelectorAll<HTMLButtonElement>('.nav-links > li > button[aria-haspopup]').forEach(btn => {
    const li = btn.closest('li');
    const dropdown = li?.querySelector('.nav-dropdown');
    if (!dropdown) return;

    // Update aria-expanded when hover state changes (CSS-driven)
    li?.addEventListener('mouseenter', () => btn.setAttribute('aria-expanded', 'true'));
    li?.addEventListener('mouseleave', () => btn.setAttribute('aria-expanded', 'false'));

    // Allow keyboard Enter/Space to open
    btn.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        const isOpen = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!isOpen));
        if (!isOpen) {
          // Move focus to first menu item
          (dropdown.querySelector('a') as HTMLElement | null)?.focus();
        }
      }
      if (e.key === 'Escape') {
        btn.setAttribute('aria-expanded', 'false');
        btn.focus();
      }
    });

    // Close with Escape from inside the dropdown
    dropdown.querySelectorAll('a').forEach(a => {
      a.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Escape') {
          btn.setAttribute('aria-expanded', 'false');
          btn.focus();
        }
      });
    });
  });

  // ── Active nav state: mark link matching current pathname ────
  const path = window.location.pathname;
  document.querySelectorAll<HTMLAnchorElement>('.nav-links a, .nav-dropdown a').forEach(a => {
    const href = a.getAttribute('href') ?? '';
    // Exact match, or prefix match for sub-pages (not root)
    const isActive = href !== '/' ? path.startsWith(href) : path === '/';
    if (isActive) {
      a.closest('li')?.classList.add('active');
      a.setAttribute('aria-current', 'page');
    }
  });
</script>
