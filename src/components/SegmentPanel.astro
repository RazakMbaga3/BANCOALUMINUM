---
/**
 * SegmentPanel
 * Full-height router panel. Flex item — expands on hover via flex-grow.
 * Drop into any flex-row container (.router-panels or equivalent).
 *
 * The SVG line-drawing is passed as a named slot (not a string prop) so
 * it stays as real markup, gets tree-shaken, and avoids set:html trust issues:
 *
 *   <SegmentPanel {…props}>
 *     <svg slot="svg" viewBox="…" preserveAspectRatio="xMidYMid slice">
 *       …
 *     </svg>
 *   </SegmentPanel>
 */

interface Props {
  /** Mono segment index shown top-left. Convention: "/ 01" */
  number: string;
  /** Short mono label beneath the number. Convention: "OEM · Drawing-led" */
  tag: string;
  /** Inter 700 heading — sentence case. */
  title: string;
  /** 1–2 sentence body copy. Hidden at rest, fades in on hover. */
  description: string;
  /** Short capability/spec strings rendered as mono chips. Revealed on hover. */
  chips: string[];
  /** Destination href. Panel is an <a> — full surface is clickable. */
  href: string;
}

const { number, tag, title, description, chips, href } = Astro.props;
---

<a href={href} class="panel" aria-label={`Enter the ${title} segment`}>

  <!-- SVG line-drawing — caller supplies via <svg slot="svg"> -->
  <div class="panel-bg" aria-hidden="true">
    <slot name="svg" />
  </div>

  <!-- Gradient overlay fades svg into navy-deep at the bottom -->
  <div class="panel-overlay" aria-hidden="true"></div>

  <!-- Segment number: decorative index, aria-hidden — content covered by aria-label -->
  <span class="panel-num font-mono text-green" aria-hidden="true">{number}</span>

  <!-- Content block anchored to the bottom edge -->
  <div class="panel-content">
    <span class="panel-tag font-mono text-nickel">{tag}</span>
    <h2 class="panel-title font-sans text-platinum">{title}</h2>

    <!-- Revealed on hover -->
    <p class="panel-desc text-silver">{description}</p>

    <!-- Revealed on hover, offset 80ms after desc -->
    <ul class="panel-chips" aria-hidden="true">
      {chips.map((chip) => (
        <li class="panel-chip font-mono text-nickel border border-navy-line">{chip}</li>
      ))}
    </ul>

    <!-- Always visible — mono uppercase per Heritage rule 5 -->
    <div class="panel-enter font-mono text-platinum">
      <span>Enter</span>
      <svg
        width="16" height="16" viewBox="0 0 16 16"
        fill="none" aria-hidden="true"
        class="panel-arrow text-green"
      >
        <path
          d="M2 8h12M9 3l5 5-5 5"
          stroke="currentColor" stroke-width="1.5"
          stroke-linecap="round" stroke-linejoin="round"
        />
      </svg>
    </div>
  </div>

  <!-- 2 px green bottom rule — Heritage spark, scales in on hover -->
  <div class="panel-line bg-green" aria-hidden="true"></div>

</a>

<style>
  /* ── Flex item — expands on hover ───────────────────── */
  .panel {
    position: relative;
    flex: 1;
    overflow: hidden;
    text-decoration: none;
    background-color: var(--color-navy-deep);
    display: block;
    outline: none;
    transition: flex 0.55s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .panel:hover,
  .panel:focus-visible {
    flex: 3.5;
  }
  /* Rule 3 fix: outline replaces box-shadow for focus indicator */
  .panel:focus-visible {
    outline: 2px solid var(--color-green);
    outline-offset: -2px;
  }

  /* SVG fills the full panel */
  .panel-bg {
    position: absolute;
    inset: 0;
  }
  /* :global needed — the SVG lives in the slot, outside this component's scope */
  .panel-bg :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Gradient: svg visible at top, dissolves to navy-deep at bottom */
  .panel-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent                                              0%,
      color-mix(in srgb, var(--color-navy-deep) 30%, transparent) 38%,
      color-mix(in srgb, var(--color-navy-deep) 80%, transparent) 68%,
      color-mix(in srgb, var(--color-navy-deep) 97%, transparent) 100%
    );
    transition: background 0.55s ease;
  }
  /* Lighten overlay on hover so the SVG reads better in the expanded panel */
  .panel:hover .panel-overlay,
  .panel:focus-visible .panel-overlay {
    background: linear-gradient(
      180deg,
      transparent                                              0%,
      color-mix(in srgb, var(--color-navy-deep) 18%, transparent) 30%,
      color-mix(in srgb, var(--color-navy-deep) 72%, transparent) 62%,
      color-mix(in srgb, var(--color-navy-deep) 97%, transparent) 100%
    );
  }

  /* Segment number */
  .panel-num {
    position: absolute;
    top: 28px;
    left: 28px;
    z-index: 2;
    font-size: 11px;
    letter-spacing: 0.16em;
  }

  /* Content block */
  .panel-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 2;
    padding: 0 28px 28px;
    border-top: 1px solid var(--color-navy-line);
  }

  .panel-tag {
    display: block;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding-top: 18px;
    padding-bottom: 12px;
  }

  .panel-title {
    font-size: clamp(20px, 2.2vw, 32px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  /* Hidden at rest — fades in on hover */
  .panel-desc {
    font-size: 13px;
    line-height: 1.65;
    margin-top: 12px;
    max-width: 54ch;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s ease 0.12s, transform 0.3s ease 0.12s;
  }
  .panel:hover .panel-desc,
  .panel:focus-visible .panel-desc {
    opacity: 1;
    transform: translateY(0);
  }

  /* Chips — hidden at rest, offset 80 ms behind desc */
  .panel-chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s ease 0.20s, transform 0.3s ease 0.20s;
  }
  .panel:hover .panel-chips,
  .panel:focus-visible .panel-chips {
    opacity: 1;
    transform: translateY(0);
  }
  .panel-chip {
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 5px 10px;
  }

  /* Enter link — Rule 5 fix: mono font for uppercase label */
  .panel-enter {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: gap 0.25s ease;
  }
  .panel:hover .panel-enter,
  .panel:focus-visible .panel-enter {
    gap: 14px;
  }
  .panel-arrow {
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }
  .panel:hover .panel-arrow,
  .panel:focus-visible .panel-arrow {
    transform: translateX(3px);
  }

  /* Green bottom rule — scales in from the left on hover */
  .panel-line {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .panel:hover .panel-line,
  .panel:focus-visible .panel-line {
    transform: scaleX(1);
  }

  /* ── Below 900 px — panels stack vertically ──────────── */
  @media (max-width: 900px) {
    .panel { flex: none; min-height: 320px; transition: none; }
    .panel:hover,
    .panel:focus-visible { flex: none; }
    /* Description visible on mobile — must not depend on hover */
    .panel-desc  { opacity: 1; transform: none; }
    .panel-chips { display: none; }
    .panel-title { font-size: 22px; }
    .panel-line  { transform: scaleX(1); }
  }

  @media (max-width: 480px) {
    .panel         { min-height: 300px; }
    .panel-content { padding: 0 20px 22px; }
    .panel-num     { top: 20px; left: 20px; }
  }

  /* ── Touch devices — desc always visible, no hover dependency */
  @media (hover: none) {
    .panel-desc { opacity: 1; transform: none; }
    .panel-line { transform: scaleX(1); }
  }

  /* ── Reduced motion — kill transitions, show all content ── */
  @media (prefers-reduced-motion: reduce) {
    .panel         { transition: none; }
    .panel-overlay { transition: none; }
    .panel-desc,
    .panel-chips {
      transition: none;
      opacity: 1;
      transform: none;
    }
    .panel-enter { transition: none; }
    .panel-arrow { transition: none; }
    .panel-line  { transition: none; transform: scaleX(1); }
  }
</style>
