---
const industries = [
  { index: '01', name: 'Electrical & power transmission', href: '/industries/electrical' },
  { index: '02', name: 'Automotive & commercial vehicles', href: '/industries/automotive' },
  { index: '03', name: 'Machinery & automation', href: '/industries/machinery' },
  { index: '04', name: 'Heat sinks & heat exchangers', href: '/industries/heat-management' },
  { index: '05', name: 'Aerospace & defence', href: '/industries/aerospace' },
  { index: '06', name: 'Hydraulics & pneumatics', href: '/industries/hydraulics' },
  { index: '07', name: 'Railways & shipbuilding', href: '/industries/railways' },
  { index: '08', name: 'Solar & alternative energy', href: '/industries/solar' },
  { index: '09', name: 'Architecture & construction', href: '/industries/architecture' },
  { index: '10', name: 'Material handling & structural', href: '/industries/material-handling' },
  { index: '11', name: 'Pumps, motors & general engineering', href: '/industries/pumps-motors' },
  { index: '12', name: 'Forging & precision machining', href: '/industries/forging' },
];
---

<section class="section-dark section-pad" aria-label="Industries served">
  <div class="container">
    <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:60px;flex-wrap:wrap;gap:24px">
      <div>
        <div class="eyebrow on-dark">Market coverage</div>
        <h2 class="t-h2" style="color:var(--color-stone-50);margin-top:16px">
          12 industry<br/><em class="accent">segments</em> served.
        </h2>
      </div>
      <a href="/industries" class="btn btn-secondary-dark">
        All industries
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </a>
    </div>

    <div class="industries-grid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--color-navy-line)">
      {industries.map((ind) => (
        <a href={ind.href} class="industry-cell">
          <div>
            <div class="ic-index">{ind.index}</div>
            <div class="ic-name">{ind.name}</div>
          </div>
          <svg class="ic-arrow" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M4 9h10M10 5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </a>
      ))}
    </div>
  </div>
</section>
