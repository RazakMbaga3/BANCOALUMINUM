---
const pillars = [
  {
    index: '01',
    href: '/products/industrial',
    titleParts: ['Industrial', 'profiles'],
    accentWord: 'profiles',
    description:
      'Application-led extrusions for OEM repeat production — drawing-driven, tightly controlled, and supported by in-house die design, Q-Form simulation, and full downstream processing.',
    capabilities: [
      'Electrical & power transmission',
      'Automotive & commercial vehicles',
      'Aerospace & defence',
      'Heat sinks & heat exchangers',
      'Railways · hydraulics · solar',
    ],
    svgContent: `
      <!-- Industrial profile: T-slot structural section -->
      <defs><pattern id="g1" width="16" height="16" patternUnits="userSpaceOnUse"><path d="M16 0L0 0 0 16" fill="none" stroke="#243F60" stroke-width="0.4"/></pattern></defs>
      <rect width="360" height="220" fill="url(#g1)" opacity="0.5"/>
      <!-- Profile outline -->
      <rect x="80" y="30" width="200" height="160" stroke="#9CA3AE" stroke-width="1" fill="none"/>
      <rect x="80" y="30" width="200" height="36" fill="#1A3454" stroke="#9CA3AE" stroke-width="1"/>
      <rect x="80" y="154" width="200" height="36" fill="#1A3454" stroke="#9CA3AE" stroke-width="1"/>
      <rect x="160" y="30" width="40" height="160" fill="#0C2340" fill-opacity="0.8" stroke="#243F60" stroke-width="0.75"/>
      <!-- T-slots -->
      <rect x="110" y="30" width="22" height="16" stroke="#009746" stroke-width="0.75" fill="#061525"/>
      <rect x="228" y="30" width="22" height="16" stroke="#009746" stroke-width="0.75" fill="#061525"/>
      <rect x="110" y="174" width="22" height="16" stroke="#009746" stroke-width="0.75" fill="#061525"/>
      <rect x="228" y="174" width="22" height="16" stroke="#009746" stroke-width="0.75" fill="#061525"/>
      <rect x="80" y="100" width="16" height="20" stroke="#009746" stroke-width="0.75" fill="#061525"/>
      <rect x="264" y="100" width="16" height="20" stroke="#009746" stroke-width="0.75" fill="#061525"/>
      <circle cx="180" cy="110" r="20" stroke="#9CA3AE" stroke-width="1" fill="#061525"/>
      <!-- Dim line -->
      <line x1="80" y1="205" x2="280" y2="205" stroke="#009746" stroke-width="0.6"/>
      <line x1="80" y1="200" x2="80" y2="210" stroke="#009746" stroke-width="0.6"/>
      <line x1="280" y1="200" x2="280" y2="210" stroke="#009746" stroke-width="0.6"/>
      <text x="180" y="218" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="9" fill="#009746" letter-spacing="0.1em">200.00 MM</text>
      <text x="180" y="15" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="8" fill="#4A5260" letter-spacing="0.14em">SECTION A-A · 6063-T6</text>
    `,
  },
  {
    index: '02',
    href: '/products/architectural',
    titleParts: ['Architectural', 'systems'],
    accentWord: 'systems',
    description:
      'Precision-engineered aluminium systems for modern architectural applications — combining advanced profile manufacturing, refined aesthetics, and long-term durability for residential, commercial, and high-rise developments.',
    capabilities: [
      'Casement & sliding window systems',
      'Architectural door profiles',
      'Slim partition systems',
      'Curtain wall & façade profiles',
      'Anodised, powder-coated & mill finishes',
    ],
    image: '/assets/architectural/0fa274d34eaac9f8ed5881ccbca5660c.jpg',
    imageAlt: 'Modern architectural building systems with Banco aluminium profiles',
  },
  {
    index: '03',
    href: '/products/cast-products',
    titleParts: ['Cast products', '& billets'],
    accentWord: '& billets',
    description:
      'Foundry-grade aluminium billets for internal and external extruders. In-house casting with SCADA traceability, Spectro-OES alloy verification, and up to 50% recycled scrap — CBAM-compliant and export-ready.',
    capabilities: [
      '55,000 MT annual foundry capacity',
      '127 – 254 mm billet diameters',
      'Alloy series 1xxx through 7xxx',
      'Lead-free & custom chemistry',
      'SCADA-traceable · Spectro-OES verified',
    ],
    svgContent: `
      <!-- Cast product: billet cross-section -->
      <defs><pattern id="g3" width="16" height="16" patternUnits="userSpaceOnUse"><path d="M16 0L0 0 0 16" fill="none" stroke="#243F60" stroke-width="0.4"/></pattern></defs>
      <rect width="360" height="220" fill="url(#g3)" opacity="0.5"/>
      <!-- Billet round cross-section -->
      <circle cx="180" cy="105" r="75" stroke="#9CA3AE" stroke-width="1.25" fill="#0C2340"/>
      <circle cx="180" cy="105" r="68" stroke="#243F60" stroke-width="0.5" fill="none"/>
      <!-- Grain texture lines -->
      <line x1="115" y1="105" x2="245" y2="105" stroke="#1A3454" stroke-width="0.6"/>
      <line x1="118" y1="85" x2="242" y2="85" stroke="#1A3454" stroke-width="0.5"/>
      <line x1="118" y1="125" x2="242" y2="125" stroke="#1A3454" stroke-width="0.5"/>
      <line x1="130" y1="65" x2="230" y2="65" stroke="#1A3454" stroke-width="0.4"/>
      <line x1="130" y1="145" x2="230" y2="145" stroke="#1A3454" stroke-width="0.4"/>
      <line x1="148" y1="50" x2="212" y2="50" stroke="#1A3454" stroke-width="0.35"/>
      <line x1="148" y1="160" x2="212" y2="160" stroke="#1A3454" stroke-width="0.35"/>
      <!-- Diameter dimension -->
      <line x1="105" y1="105" x2="255" y2="105" stroke="#009746" stroke-width="0.6"/>
      <line x1="105" y1="99" x2="105" y2="111" stroke="#009746" stroke-width="0.6"/>
      <line x1="255" y1="99" x2="255" y2="111" stroke="#009746" stroke-width="0.6"/>
      <text x="180" y="98" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="9" fill="#009746" letter-spacing="0.1em">Ø 152.4 MM (6")</text>
      <!-- Centre mark -->
      <circle cx="180" cy="105" r="4" stroke="#009746" stroke-width="0.75" fill="none"/>
      <line x1="174" y1="105" x2="186" y2="105" stroke="#009746" stroke-width="0.5"/>
      <line x1="180" y1="99" x2="180" y2="111" stroke="#009746" stroke-width="0.5"/>
      <!-- Alloy badge -->
      <text x="180" y="12" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="8" fill="#4A5260" letter-spacing="0.14em">BILLET CROSS SECTION · 6063</text>
      <text x="180" y="210" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="8" fill="#4A5260" letter-spacing="0.14em">L = 5800 MM STD · SCADA TRACED</text>
    `,
  },
];
---

<section class="section-alt section-pad" aria-label="Product pillars">
  <div class="container">
    <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:60px;flex-wrap:wrap;gap:24px">
      <div>
        <div class="eyebrow">What we make</div>
        <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
          Three market<br/><em class="accent">segments.</em> One source.
        </h2>
      </div>
      <p class="t-body" style="color:var(--color-stone-700);max-width:44ch">
        From structural industrial profiles to architectural building systems and
        foundry-grade billets — choose your segment to find the right product family.
      </p>
    </div>

    <!-- Three-column card grid -->
    <div class="pillars-grid">
      {pillars.map((p) => (
        <article class="product-card">
          <!-- Visual: image or CAD drawing -->
          <div class="card-visual">
            {p.image ? (
              <img 
                src={p.image} 
                alt={p.imageAlt}
                style="width:100%;height:360px;object-fit:cover;display:block"
                loading="lazy"
              />
            ) : (
              <svg viewBox="0 0 360 220" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto" aria-hidden="true">
                <Fragment set:html={p.svgContent} />
              </svg>
            )}
          </div>

          <div class="card-body">
            <span class="card-index t-mono">{p.index}</span>
            <h3 class="t-h3 card-h3" style="color:var(--color-navy)">
              {p.titleParts[0]}<br/>
              <em>{p.titleParts[1]}</em>
            </h3>
            <p class="t-body" style="color:var(--color-stone-700)">{p.description}</p>

            <ul class="card-list">
              {p.capabilities.map((cap) => (
                <li>{cap}</li>
              ))}
            </ul>

            <a href={p.href} class="card-link">
              Explore {p.titleParts[0].toLowerCase()}
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
