---
import '../styles/global.css';

interface Props {
  title: string;
  catalogRef: string;
  subtitle?: string;
}

const { title, catalogRef, subtitle } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Banco Aluminium Product Catalogue</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
</head>
<body class="cl-body">

  <!-- Sticky toolbar — hidden on print -->
  <div class="cl-toolbar no-print">
    <a href="/downloads" class="cl-back">
      <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
        <path d="M8.5 1.5L3.5 6.5l5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      All catalogues
    </a>
    <div class="cl-toolbar-right">
      <span class="cl-toolbar-ref">{catalogRef}</span>
      <button onclick="window.print()" class="cl-print-btn" type="button">
        <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
          <path d="M3.5 5V1.5h8V5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          <rect x="1.5" y="5" width="12" height="5" rx=".5" stroke="currentColor" stroke-width="1.2"/>
          <path d="M3.5 8.5h8V13h-8V8.5z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
          <circle cx="11.5" cy="7.2" r=".6" fill="currentColor"/>
        </svg>
        Save as PDF
      </button>
    </div>
  </div>

  <!-- Catalogue document -->
  <div class="cl-document">

    <!-- Cover header -->
    <header class="cl-cover">
      <div class="cl-cover-brand">
        <img src="/banco-logo-light.png" alt="Banco Aluminium" width="148" height="34" />
        <span class="cl-brand-divider"></span>
        <span class="cl-brand-label">Product Catalogue</span>
        <span class="cl-brand-ref">{catalogRef}</span>
      </div>
      <div class="cl-cover-body">
        <h1 class="cl-cover-title">{title}</h1>
        {subtitle && <p class="cl-cover-sub">{subtitle}</p>}
      </div>
    </header>

    <!-- 2 px green rule -->
    <div class="cl-rule"></div>

    <!-- Content -->
    <main class="cl-main">
      <slot />
    </main>

    <!-- Document footer -->
    <footer class="cl-footer">
      <div class="cl-footer-inner">
        <span>Banco Aluminium Private Limited · Vadodara, Gujarat, India</span>
        <span>bancoaluminium.com · {catalogRef}</span>
      </div>
    </footer>

  </div>

</body>
</html>

<style>
  /* ── Base ──────────────────────────────────────────────────────────────── */
  .cl-body {
    margin: 0;
    padding: 0;
    background: var(--color-stone-100, #EFEDE6);
    font-family: var(--font-sans, 'Inter', sans-serif);
  }

  /* ── Toolbar (screen only) ─────────────────────────────────────────────── */
  .cl-toolbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-navy-deep, #081B30);
    border-bottom: 1px solid var(--color-navy-line, #28456A);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 clamp(16px, 3vw, 40px);
    height: 52px;
  }
  .cl-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-silver, #C5C7C9);
    text-decoration: none;
    transition: color 0.15s;
  }
  .cl-back:hover { color: var(--color-platinum, #E4E5E3); }
  .cl-toolbar-right {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .cl-toolbar-ref {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-nickel, #A8A9A6);
  }
  .cl-print-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    background: var(--color-green, #009746);
    color: white;
    border: none;
    cursor: pointer;
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.01em;
    transition: background 0.15s;
  }
  .cl-print-btn:hover { background: #007a39; }

  /* ── Document wrapper ──────────────────────────────────────────────────── */
  .cl-document {
    max-width: 900px;
    margin: 32px auto 60px;
    background: white;
    border: 1px solid var(--color-stone-200, #DDD9CE);
    box-shadow: 0 2px 24px rgba(14,42,71,0.08);
  }

  /* ── Cover header ──────────────────────────────────────────────────────── */
  .cl-cover {
    background: var(--color-navy, #0E2A47);
    padding: 32px 48px 40px;
  }
  .cl-cover-brand {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 32px;
  }
  .cl-brand-divider {
    width: 1px;
    height: 24px;
    background: var(--color-navy-line, #28456A);
  }
  .cl-brand-label {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-nickel, #A8A9A6);
  }
  .cl-brand-ref {
    margin-left: auto;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-navy-line, #28456A);
  }
  .cl-cover-title {
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.0;
    color: var(--color-platinum, #E4E5E3);
    margin: 0;
  }
  .cl-cover-sub {
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-silver, #C5C7C9);
    margin-top: 12px;
    max-width: 64ch;
  }

  /* 2px green rule */
  .cl-rule {
    height: 2px;
    background: var(--color-green, #009746);
  }

  /* ── Content area ──────────────────────────────────────────────────────── */
  .cl-main {
    padding: 0 48px 48px;
  }

  /* ── Document footer ───────────────────────────────────────────────────── */
  .cl-footer {
    border-top: 1px solid var(--color-stone-200, #DDD9CE);
    padding: 16px 48px;
  }
  .cl-footer-inner {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-stone-400, #9CA3AE);
  }

  /* ── Print ─────────────────────────────────────────────────────────────── */
  @media print {
    @page {
      size: A4;
      margin: 14mm 12mm 16mm;
    }

    .no-print { display: none !important; }

    .cl-body { background: white; }

    .cl-document {
      max-width: none;
      margin: 0;
      border: none;
      box-shadow: none;
    }

    .cl-cover { padding: 0 0 28px; }
    .cl-main  { padding: 0; }

    .cl-footer {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 8px 0;
      border-top: 1px solid #DDD9CE;
      background: white;
    }
    .cl-footer-inner { font-size: 8px; }
  }
</style>
