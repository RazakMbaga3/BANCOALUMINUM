---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Banco Aluminium — Integrated Aluminium Extrusion Solutions',
  description = 'Banco Aluminium Private Limited — integrated aluminium extrusion company established 1967. 35,000 MT annual capacity, full value chain from billet to finished profile. ISO 9001 · IATF 16949 · CE certified.',
  image = '/og-image.jpg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://bancoaluminium.com');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
</head>
<body>

  <!-- Minimal transparent landing header — logo only, no nav menu -->
  <header class="router-header" id="router-header">
    <div class="container rh-nav">
      <a href="/" class="rh-logo" aria-label="Banco Aluminium — home">
        <img
          src="/banco-logo-light.png"
          alt="Banco Aluminium"
          width="148"
          height="34"
          loading="eager"
        />
      </a>
      <a href="/contact#quote" class="rh-cta">
        Request a quote
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2 8h12M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </header>

  <main id="router-main">
    <slot />
  </main>

</body>
</html>

<style is:global>
  html, body {
    height: 100%;
  }
  body {
    background: var(--color-navy-deep);
    height: 100dvh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* ── Minimal landing header ──────────────────────────────── */
  .router-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    /* transparent navy — background video bleeds through */
    background: linear-gradient(
      180deg,
      rgba(8, 27, 48, 0.62) 0%,
      rgba(14, 42, 71, 0.30) 100%
    );
    backdrop-filter: blur(6px) saturate(1.1);
    -webkit-backdrop-filter: blur(6px) saturate(1.1);
    border-bottom: 1px solid rgba(40, 69, 106, 0.28);
    pointer-events: auto;
  }
  .rh-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
  }
  .rh-logo img {
    display: block;
    height: 30px;
    width: auto;
  }
  .rh-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-platinum);
    text-decoration: none;
    border: 1px solid rgba(40, 69, 106, 0.55);
    padding: 7px 14px;
    transition: border-color 0.2s, color 0.2s;
  }
  .rh-cta svg { color: var(--color-green); flex-shrink: 0; }
  .rh-cta:hover { border-color: var(--color-green); color: var(--color-green); }

  /* ── Main content — full viewport, no padding-top (header overlays) */
  #router-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    /* content fills behind transparent header — no offset */
    padding-top: 0;
  }

  /* ── Mobile: revert overflow so page is scrollable below 900px ── */
  @media (max-width: 900px) {
    body {
      height: auto;
      min-height: 100dvh;
      overflow: auto;
    }
    .rh-cta { display: none; }
  }
</style>
