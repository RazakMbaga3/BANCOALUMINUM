---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Banco Aluminium: Integrated Aluminium Extrusion Solutions',
  description = 'Banco Aluminium is an integrated aluminium extrusion company established in 1967. Industrial profiles, architectural systems and billets. 35,000 MT capacity.',
  image = '/og-image.jpg',
} = Astro.props;

const SITE = Astro.site ?? new URL('https://bancoaluminium.com');
const canonicalURL = new URL(Astro.url.pathname, SITE);
const ogImageURL = new URL(image, SITE);

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Banco Aluminium Private Limited',
  url: SITE.href,
  logo: new URL('/banco-logo-light-480.webp', SITE).href,
  foundingDate: '1967',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Vadodara',
    addressRegion: 'Gujarat',
    addressCountry: 'IN',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    email: 'info@bancoaluminium.com',
    availableLanguage: ['en'],
  },
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Banco Aluminium" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Banco Aluminium wordmark on a navy field" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />

  <!-- Fonts: self-hosted latin-subset variable woff2, declared in global.css -->
  <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-var-latin.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/jetbrains-mono-var-latin.woff2" crossorigin />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#0E2A47" />
  <link rel="sitemap" href="/sitemap.xml" />

  <!-- Poster paints the hero instantly; autoplay streams the 720p video on its own -->
  <link rel="preload" as="image" href="/herovideo-poster.jpg" fetchpriority="high" />

  <title>{title}</title>
</head>
<body>
  <a href="#router-main" class="skip-link">Skip to content</a>

  <!-- Minimal transparent landing header — logo only, no nav menu -->
  <header class="router-header" id="router-header">
    <div class="container rh-nav">
      <a href="/" class="rh-logo" aria-label="Return to the Banco Aluminium homepage">
        <img
          src="/banco-logo-light-480.webp"
          alt="Banco Aluminium"
          width="148"
          height="34"
          loading="eager"
        />
      </a>
      <a href="/contact#quote" class="rh-cta">
        Request a quote
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2 8h12M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </header>

  <main id="router-main">
    <slot />
  </main>

</body>
</html>

<style is:global>
  html, body {
    height: 100%;
  }
  body {
    background: var(--color-navy-deep);
    height: 100dvh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* ── Minimal landing header ──────────────────────────────── */
  .router-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    /* transparent navy — background video bleeds through */
    background: linear-gradient(
      180deg,
      rgba(8, 27, 48, 0.62) 0%,
      rgba(14, 42, 71, 0.30) 100%
    );
    backdrop-filter: blur(6px) saturate(1.1);
    -webkit-backdrop-filter: blur(6px) saturate(1.1);
    border-bottom: 1px solid rgba(40, 69, 106, 0.28);
    pointer-events: auto;
  }
  .rh-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
  }
  .rh-logo img {
    display: block;
    height: 30px;
    width: auto;
  }
  .rh-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-platinum);
    text-decoration: none;
    border: 1px solid rgba(40, 69, 106, 0.55);
    padding: 7px 14px;
    transition: border-color 0.2s, color 0.2s;
  }
  .rh-cta svg { color: var(--color-green); flex-shrink: 0; }
  .rh-cta:hover { border-color: var(--color-green); color: var(--color-green); }

  /* ── Main content — full viewport, no padding-top (header overlays) */
  #router-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    /* content fills behind transparent header — no offset */
    padding-top: 0;
  }

  /* ── Mobile: revert overflow so page is scrollable below 900px ── */
  @media (max-width: 900px) {
    body {
      height: auto;
      min-height: 100dvh;
      overflow: auto;
    }
    /* Panels stack from the top on mobile — clear the fixed header so the
       first panel's segment tag isn't clipped behind it */
    #router-main { padding-top: 60px; }
  }
  /* Keep logo + quote CTA on one 60px line at the narrowest widths */
  @media (max-width: 380px) {
    .rh-logo img { height: 24px; }
    .rh-cta { font-size: 9px; padding: 6px 10px; letter-spacing: 0.12em; gap: 6px; }
  }
</style>
