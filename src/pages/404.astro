---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found — Banco Aluminium"
  description="The page you are looking for has moved or never existed."
>
  <section style="background:var(--color-navy);min-height:100vh;display:flex;align-items:center;padding-top:148px;padding-bottom:80px">
    <div class="container">
      <div style="font-family:var(--font-sans);font-size:clamp(120px,20vw,240px);font-weight:800;letter-spacing:-0.05em;line-height:1;color:var(--color-platinum);user-select:none">
        404
      </div>
      <div style="margin-top:32px">
        <div class="eyebrow on-dark">Page not found</div>
        <h2 class="t-h2" style="color:var(--color-stone-50);margin-top:16px;max-width:24ch">
          This page doesn't exist.
        </h2>
        <p class="t-lead" style="color:var(--color-stone-400);margin-top:20px;max-width:52ch">
          The page you're looking for has moved or never existed. Try the navigation above or go back to the homepage.
        </p>
        <div style="display:flex;gap:16px;flex-wrap:wrap;margin-top:40px">
          <a href="/" class="btn btn-primary-dark">Go to homepage</a>
          <a href="/products/industrial" class="btn btn-secondary-dark">Browse solutions</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
