---
import Layout from '../../layouts/Layout.astro';
import Pic from '../../components/Pic.astro';
import { optSrcset } from '../../lib/img';

const coreValues = [
  { title: 'Safety first', desc: 'Every shift starts with a safety briefing. No production target overrides a safe stop.' },
  { title: 'Ownership', desc: 'Decisions made by people close to the work, with direct accountability for outcomes.' },
  { title: 'Craftsmanship', desc: 'Pride in the profile that leaves the plant, whether it is one piece or one thousand.' },
  { title: 'Team, not hierarchy', desc: 'Shop floor and management share the same canteen, the same safety rules, and the same goals.' },
  { title: 'Continuous improvement', desc: 'Kaizen-driven process reviews across foundry, extrusion, and finishing, every quarter.' },
  { title: 'Community', desc: 'Local hiring, apprenticeships, and long-term careers built in Vadodara.' },
];

const moreThanWork = [
  { title: 'Health & safety', desc: 'Daily toolbox talks, PPE issued and tracked per role, and a shop floor where any operator can call a safe stop without asking permission first.' },
  { title: 'Learning & apprenticeships', desc: 'Structured apprenticeship intake for diploma and ITI graduates, paired with senior operators on the press and machining floor.' },
  { title: 'Community & local hiring', desc: 'The large majority of our workforce is hired locally in and around Vadodara. Long tenure is the norm, not the exception, across shifts.' },
  { title: 'Shared ground', desc: 'One canteen for shop floor and management. Long-service recognition and shift-wise celebrations mark the calendar as much as production targets do.' },
];

const departments = [
  { id: '01', name: 'Manufacturing',  desc: 'Press operators, foundry technicians, shift supervisors, and production planners across all five press lines and foundry operations.' },
  { id: '02', name: 'Engineering',    desc: 'Mechanical and metallurgical engineers for process improvement, die design, capital projects, and equipment maintenance.' },
  { id: '03', name: 'Quality',        desc: 'Quality engineers, CMM operators, lab technicians, and QA managers. ISO 9001 and IATF 16949 environment.' },
  { id: '04', name: 'Sales',          desc: 'Technical sales executives and account managers for domestic and export markets. Customer-facing and CRM-driven.' },
  { id: '05', name: 'Finance',        desc: 'Commercial finance, cost accounting, management accounts, and export documentation for a large manufacturing business.' },
  { id: '06', name: 'IT',             desc: 'ERP implementation, manufacturing systems, network infrastructure, and digital transformation projects.' },
  { id: '07', name: 'HR',             desc: 'Talent acquisition, learning & development, compliance, and employee engagement for a workforce of 900+.' },
  { id: '08', name: 'Logistics',      desc: 'Warehouse, dispatch, freight forwarding coordination, and export packing for domestic and international shipments.' },
];
---

<Layout
  title="Careers at Banco Aluminium"
  description="Build your career at Banco Aluminium: 58 years of family-owned aluminium manufacturing heritage, real core values, and roles from foundry engineering to sales and logistics."
  transparentNav={true}
  heroImage="/assets/careers/careers-team-hero.jpg"
>

  <!-- ══════════════════════════════════════════
       HERO — Build your career in aluminium
       ══════════════════════════════════════════ -->
  <section class="ca-hero">
    <div class="ca-hero-media" aria-hidden="true">
      <picture>
        <source type="image/avif" srcset={optSrcset('/assets/careers/careers-team-hero.jpg', 'avif')} sizes="100vw" />
        <source type="image/webp" srcset={optSrcset('/assets/careers/careers-team-hero.jpg', 'webp')} sizes="100vw" />
        <img src="/assets/careers/careers-team-hero.jpg" alt="" loading="eager" fetchpriority="high" class="ca-hero-vid" />
      </picture>
      <div class="ca-hero-scrim"></div>
      <div class="ca-hero-grad"></div>
    </div>

    <div class="container ca-hero-body">
      <div class="eyebrow on-dark" data-reveal="fade" data-reveal-delay="1">
        Careers
      </div>
      <h1 class="t-h1 ca-hero-h1" data-reveal data-reveal-delay="2">
        Build your career<br/><em class="accent">in aluminium.</em>
      </h1>
      <p class="ca-hero-lede" data-reveal data-reveal-delay="3">
        We hire people who want to build something real: a career, a craft, and a
        manufacturing business that lasts. If you want to work somewhere that actually
        makes things, and see your work leave the plant, Banco is that place.
      </p>

      <div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:36px" data-reveal data-reveal-delay="4">
        <a href="#find-your-place" class="btn btn-primary-dark">Find your place</a>
        <a href="/about/why-banco" class="btn btn-secondary-dark">Why Banco</a>
      </div>
    </div>

    <div class="ca-scroll-cue" aria-hidden="true">
      <span class="ca-scroll-line"></span>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       WHAT HOLDS OUR CULTURE TOGETHER
       ══════════════════════════════════════════ -->
  <section class="ca-culture section-dark" data-reveal="fade">
    <div class="container">
      <div class="ca-culture-head">
        <div>
          <div class="eyebrow on-dark">/ 01 · Culture</div>
          <h2 class="t-h2" style="color:var(--color-stone-50);margin-top:16px">
            What holds the<br/><em class="accent">culture together.</em>
          </h2>
        </div>
        <p class="t-lead" style="color:var(--color-stone-400);max-width:46ch;align-self:end">
          58 years in, Banco is still run by people who have spent decades on this
          same shop floor. That continuity, more than any policy document, is what
          shapes how people here actually work together.
        </p>
      </div>

      <div class="ca-culture-photos">
        {[
          ['/assets/careers/careers-team-outdoor.jpg',  'Banco Aluminium team together after a team-building day',    'Team-building day · Everyone together',   '50% 40%'],
          ['/assets/careers/careers-team-workshop.jpg', 'Banco Aluminium colleagues working through a team exercise', 'Team exercise · Working it out together', '50% 50%'],
        ].map(([src, alt, cap, pos]) => (
          <figure class="ca-culture-fig">
            <Pic src={src} alt={alt} loading="lazy" sizes="(max-width: 1024px) 100vw, 50vw" maxW={1200} style={`object-position:${pos}`} />
            <figcaption>{cap}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       OUR CORE VALUES
       ══════════════════════════════════════════ -->
  <section class="ca-values section-alt" data-reveal="fade">
    <div class="container">
      <div class="eyebrow">/ 02 · Our core values</div>
      <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px;margin-bottom:40px">
        Six things we<br/>ask of each other.
      </h2>

      <div class="ca-values-grid">
        {coreValues.map((v, i) => (
          <div class="ca-value-card" style={`--delay:${i * 45}ms`}>
            <div class="ca-value-n">{String(i + 1).padStart(2, '0')}</div>
            <h3 class="ca-value-h">{v.title}</h3>
            <p class="ca-value-d">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       MORE THAN WORK
       ══════════════════════════════════════════ -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="ca-mtw-grid">
        <div data-reveal="left">
          <div class="eyebrow">/ 03 · More than work</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            Beyond the<br/>production target.
          </h2>
          <p class="t-body" style="color:var(--color-stone-700);margin-top:20px;line-height:1.7">
            A manufacturing career at Banco is not only about output. It is safety
            habits that hold under pressure, skills passed from one shift to the
            next, and a workforce drawn mostly from Vadodara itself.
          </p>
          <figure class="ca-mtw-fig">
            <picture>
              <source type="image/avif" srcset={optSrcset('/assets/careers/careers-team-present.jpg', 'avif')} sizes="(max-width: 1024px) 100vw, 45vw" />
              <source type="image/webp" srcset={optSrcset('/assets/careers/careers-team-present.jpg', 'webp')} sizes="(max-width: 1024px) 100vw, 45vw" />
              <img src="/assets/careers/careers-team-present.jpg" alt="Banco Aluminium colleagues presenting together at a team event" loading="lazy" style="object-position: center 40%;" />
            </picture>
            <figcaption>Team event · Vadodara</figcaption>
          </figure>
        </div>
        <div class="ca-mtw-list" data-reveal="right">
          {moreThanWork.map((m) => (
            <div class="ca-mtw-row">
              <div class="ca-mtw-title">{m.title}</div>
              <div class="ca-mtw-desc">{m.desc}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       FIND YOUR PLACE AT BANCO + APPLICATION FORM
       ══════════════════════════════════════════ -->
  <section class="section-alt section-pad" id="find-your-place">
    <div class="container">
      <div class="eyebrow">/ 04 · Find your place</div>
      <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px;margin-bottom:16px">
        Eight departments.<br/>One factory.
      </h2>
      <p class="t-lead" style="color:var(--color-stone-700);max-width:60ch;margin-bottom:40px">
        Manufacturing is the core of Banco, but it takes seven other departments to
        run a 35,000 MT operation. Somewhere in this list is where you fit.
      </p>

      <div class="ca-dept-grid" data-reveal="fade">
        {departments.map((d) => (
          <div class="ca-dept-card">
            <div class="ca-dept-id">{d.id}</div>
            <h3 class="ca-dept-name">{d.name}</h3>
            <p class="ca-dept-desc">{d.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       APPLICATION FORM
       ══════════════════════════════════════════ -->
  <section class="section-light section-pad" id="apply">
    <div class="container">
      <div class="ca-form-layout">

        <!-- Left: context -->
        <div class="ca-form-context" data-reveal="left">
          <div class="eyebrow">/ 05 · Apply</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            Apply for a role<br/>at Banco.
          </h2>
          <p style="color:var(--color-stone-700);font-size:15px;line-height:1.7;margin-top:20px">
            Our HR team reviews all applications and responds within 10 working days.
            For manufacturing and technical roles, shortlisted candidates are invited
            for a plant visit and technical interview at our facility in Vadodara.
          </p>

          <div class="ca-notes">
            {[
              'Applications reviewed within 10 working days.',
              'We do not use recruitment agents; apply directly only.',
              'CV should be PDF format. Maximum 5 MB.',
              'We hire at all levels: fresher, experienced, and senior management.',
            ].map(note => (
              <div class="ca-note">
                <div class="ca-note-dot" aria-hidden="true"></div>
                <span>{note}</span>
              </div>
            ))}
          </div>

          <div class="ca-contact-block">
            <div class="ca-contact-label">Direct enquiries</div>
            <a href="mailto:careers@bancoaluminium.com" class="ca-contact-email">
              careers@bancoaluminium.com
            </a>
          </div>
        </div>

        <!-- Right: form -->
        <form class="ca-form" data-reveal="right" action="/contact/success" method="post" enctype="multipart/form-data">
          <div class="ca-form-section-label">Personal details</div>

          <div class="ca-field">
            <label class="ca-label" for="full-name">Full name <span class="ca-req">*</span></label>
            <input class="ca-input" type="text" id="full-name" name="full_name" required autocomplete="name" placeholder="Your full name" />
          </div>

          <div class="ca-field-row">
            <div class="ca-field">
              <label class="ca-label" for="email">Email address <span class="ca-req">*</span></label>
              <input class="ca-input" type="email" id="email" name="email" required autocomplete="email" placeholder="your@email.com" />
            </div>
            <div class="ca-field">
              <label class="ca-label" for="phone">Phone number <span class="ca-req">*</span></label>
              <input class="ca-input" type="tel" id="phone" name="phone" required autocomplete="tel" placeholder="+91 00000 00000" />
            </div>
          </div>

          <div class="ca-form-section-label" style="margin-top:8px">Role details</div>

          <div class="ca-field-row">
            <div class="ca-field">
              <label class="ca-label" for="department">Department <span class="ca-req">*</span></label>
              <div class="ca-select-wrap">
                <select class="ca-select" id="department" name="department" required>
                  <option value="" disabled selected>Select department</option>
                  {departments.map(d => <option value={d.name}>{d.name}</option>)}
                </select>
              </div>
            </div>
            <div class="ca-field">
              <label class="ca-label" for="experience">Total experience <span class="ca-req">*</span></label>
              <div class="ca-select-wrap">
                <select class="ca-select" id="experience" name="experience" required>
                  <option value="" disabled selected>Select range</option>
                  <option>0–1 years (Fresher)</option>
                  <option>1–3 years</option>
                  <option>3–5 years</option>
                  <option>5–10 years</option>
                  <option>10–15 years</option>
                  <option>15+ years</option>
                </select>
              </div>
            </div>
          </div>

          <div class="ca-field">
            <label class="ca-label" for="position">Position applied for <span class="ca-req">*</span></label>
            <input class="ca-input" type="text" id="position" name="position" required placeholder="e.g. Metallurgical Engineer, Quality Manager, Press Operator" />
          </div>

          <div class="ca-field-row">
            <div class="ca-field">
              <label class="ca-label" for="organisation">Current / last organisation</label>
              <input class="ca-input" type="text" id="organisation" name="organisation" autocomplete="organization" placeholder="Company name" />
            </div>
            <div class="ca-field">
              <label class="ca-label" for="education">Education <span class="ca-req">*</span></label>
              <input class="ca-input" type="text" id="education" name="education" placeholder="e.g. B.Tech Metallurgy, Diploma" />
            </div>
          </div>

          <div class="ca-form-section-label" style="margin-top:8px">Your application</div>

          <div class="ca-field">
            <label class="ca-label" for="reason">Why Banco? <span class="ca-req">*</span></label>
            <textarea class="ca-textarea" id="reason" name="reason" required rows="4" placeholder="Tell us why you want to join Banco and what you'd bring to the role."></textarea>
          </div>

          <div class="ca-field">
            <label class="ca-label" for="cv">Upload CV (PDF) <span class="ca-req">*</span></label>
            <input class="ca-file" type="file" id="cv" name="cv" accept=".pdf" required />
            <div class="ca-file-hint">PDF only · Maximum 5 MB</div>
          </div>

          <button type="submit" class="btn btn-primary ca-submit">Submit application →</button>
        </form>

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       CTA CLOSE
       ══════════════════════════════════════════ -->
  <section class="section-dark" style="padding:72px 0;border-top:2px solid var(--color-green)">
    <div class="container">
      <div class="ca-cta-row" data-reveal="fade">
        <div>
          <div class="eyebrow on-dark">Hiring</div>
          <h2 class="t-h2" style="color:var(--color-platinum);margin-top:14px">
            We respond to every<br/>application within 10 working days.
          </h2>
          <p style="color:var(--color-stone-400);font-size:15px;line-height:1.65;margin-top:14px;max-width:52ch">
            Questions about a specific role or department? Contact our HR team directly.
          </p>
          <a href="mailto:careers@bancoaluminium.com" style="color:var(--color-silver);font-size:15px;text-decoration:underline;text-underline-offset:4px;margin-top:12px;display:inline-block">
            careers@bancoaluminium.com
          </a>
        </div>
        <div class="ca-cta-btns">
          <a href="/about/why-banco" class="btn btn-primary-dark">Why Banco</a>
          <a href="/about" class="btn btn-secondary-dark">About Banco</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── HERO ───────────────────────────────────────────────────── */
  .ca-hero {
    position: relative; background: var(--color-navy-deep);
    min-height: 88vh; display: flex; align-items: center; overflow: hidden;
  }
  .ca-hero-media { position: absolute; inset: 0; z-index: 0; }
  .ca-hero-vid { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 45%; }
  .ca-hero-scrim { position: absolute; inset: 0; background: rgba(6,21,37,0.60); }
  .ca-hero-grad {
    position: absolute; inset: 0;
    background:
      linear-gradient(120deg, rgba(6,21,37,0.78) 0%, rgba(6,21,37,0.25) 55%, rgba(6,21,37,0.05) 100%),
      linear-gradient(to bottom, transparent 55%, var(--color-navy-deep) 100%);
  }
  .ca-hero-body { position: relative; z-index: 2; width: 100%; padding-top: 160px; padding-bottom: 100px; }
  .ca-hero-h1 { color: var(--color-stone-50); margin-top: 20px; }
  .ca-hero-lede { color: var(--color-stone-400); font-size: clamp(15px,1.4vw,18px); line-height: 1.65; max-width: 54ch; margin-top: 24px; }

  .ca-scroll-cue { position: absolute; bottom: 44px; left: 50%; transform: translateX(-50%); z-index: 3; }
  .ca-scroll-line { display: block; width: 1px; height: 52px; background: linear-gradient(to bottom, var(--color-green), transparent); animation: ca-drop 2s ease-in-out infinite; }
  @keyframes ca-drop {
    0%   { transform: scaleY(0); transform-origin: top; opacity: 1; }
    50%  { transform: scaleY(1); transform-origin: top; }
    51%  { transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; opacity: 0; }
  }

  /* ── CULTURE ───────────────────────────────────────────────────── */
  .ca-culture { border-top: 2px solid var(--color-green); padding: 80px 0; }
  .ca-culture-head {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 80px); align-items: start; margin-bottom: 40px;
  }
  .ca-culture-photos { display: grid; grid-template-columns: 1fr 1fr; gap: 3px; }
  .ca-culture-fig { overflow: hidden; border: 1px solid var(--color-navy-line); margin: 0; display: flex; flex-direction: column; }
  .ca-culture-fig :global(img) {
    width: 100%; aspect-ratio: 16/9; object-fit: cover; display: block;
    transition: transform 0.5s ease;
  }
  .ca-culture-fig:hover :global(img) { transform: scale(1.05); }
  .ca-culture-fig figcaption {
    font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--color-stone-400); padding: 7px 10px;
    border-top: 1px solid var(--color-navy-line); background: var(--color-navy-soft);
  }

  /* ── CORE VALUES ───────────────────────────────────────────────── */
  .ca-values { padding: 80px 0; }
  .ca-values-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--color-stone-200); border: 1px solid var(--color-stone-200); }
  .ca-value-card {
    background: var(--color-stone-50); padding: 28px 24px;
    position: relative; overflow: hidden; border-top: 2px solid transparent;
    transition: background 0.25s ease, border-top-color 0.25s ease;
    transition-delay: var(--delay, 0ms);
  }
  .ca-value-card:hover { background: white; border-top-color: var(--color-green); }
  .ca-value-n  { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.2em; color: var(--color-green); margin-bottom: 14px; }
  .ca-value-h  { font-family: var(--font-sans); font-size: 17px; font-weight: 600; color: var(--color-navy); letter-spacing: -0.01em; margin-bottom: 8px; }
  .ca-value-d  { font-size: 13px; color: var(--color-stone-700); line-height: 1.6; }

  /* ── MORE THAN WORK ────────────────────────────────────────────── */
  .ca-mtw-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 100px); align-items: start; }
  .ca-mtw-fig { margin: 32px 0 0; overflow: hidden; border: 1px solid var(--color-stone-200); }
  .ca-mtw-fig img { width: 100%; aspect-ratio: 4/3; object-fit: cover; display: block; transition: transform 0.5s ease; }
  .ca-mtw-fig:hover img { transform: scale(1.05); }
  .ca-mtw-fig figcaption {
    font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--color-stone-700); padding: 7px 10px;
    border-top: 1px solid var(--color-stone-200); background: var(--color-stone-50);
  }
  .ca-mtw-list { display: flex; flex-direction: column; border-top: 1px solid var(--color-stone-200); }
  .ca-mtw-row  { padding: 22px 0; border-bottom: 1px solid var(--color-stone-200); }
  .ca-mtw-title{ font-size: 16px; font-weight: 600; color: var(--color-navy); letter-spacing: -0.01em; margin-bottom: 6px; }
  .ca-mtw-desc { font-size: 13.5px; line-height: 1.65; color: var(--color-stone-700); }

  /* ── FIND YOUR PLACE / DEPARTMENTS ────────────────────────────── */
  .ca-dept-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--color-stone-200); border: 1px solid var(--color-stone-200); }
  .ca-dept-card { background: white; padding: 24px 20px; border-top: 2px solid transparent; transition: border-top-color 0.2s ease; }
  .ca-dept-card:hover { border-top-color: var(--color-green); }
  .ca-dept-id   { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.16em; color: var(--color-green); margin-bottom: 10px; }
  .ca-dept-name { font-family: var(--font-sans); font-size: 15px; font-weight: 700; color: var(--color-navy); margin-bottom: 8px; }
  .ca-dept-desc { font-family: var(--font-sans); font-size: 12.5px; line-height: 1.6; color: var(--color-stone-700); }

  /* ── FORM LAYOUT ────────────────────────────────────────────── */
  .ca-form-layout { display: grid; grid-template-columns: 1fr 1.5fr; gap: clamp(48px,7vw,96px); align-items: start; }
  .ca-notes { margin-top: 28px; display: flex; flex-direction: column; gap: 12px; }
  .ca-note { display: flex; align-items: flex-start; gap: 12px; }
  .ca-note-dot { width: 5px; height: 5px; background: var(--color-green); border-radius: 50%; flex-shrink: 0; margin-top: 7px; }
  .ca-note span { font-size: 13.5px; line-height: 1.55; color: var(--color-stone-700); }
  .ca-contact-block { margin-top: 36px; padding-top: 28px; border-top: 1px solid var(--color-stone-200); }
  .ca-contact-label { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-stone-700); margin-bottom: 6px; }
  .ca-contact-email { font-size: 15px; color: var(--color-navy); text-decoration: underline; text-underline-offset: 3px; font-weight: 500; }
  .ca-contact-email:hover { color: var(--color-green); }

  /* ── FORM ───────────────────────────────────────────────────── */
  .ca-form { display: flex; flex-direction: column; gap: 16px; }
  .ca-form-section-label {
    font-family: var(--font-mono); font-size: 9.5px;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--color-stone-700);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--color-stone-200);
