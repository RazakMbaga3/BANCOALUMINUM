---
import Layout from '../../layouts/Layout.astro';

const regions = [
  {
    id: '01',
    name: 'Europe',
    flag: 'EU',
    markets: 'Germany · Netherlands · France · Italy · Poland · Nordics',
    demand: 'Structural, architectural, automotive, renewable energy',
    standards: 'EN 755 · EN 12020 · EN 15088',
    cert: 'CE marked · CBAM-ready · ISO 14064-1',
    desc: 'Europe is Banco\'s primary export region. CE Declaration of Performance issued under EN 15088 for structural aluminium. CBAM carbon data, required from January 2026, is supplied with all EU-bound shipments. 6082-T6 structural and 6063-T6 architectural are primary export grades.',
  },
  {
    id: '02',
    name: 'North America',
    flag: 'NA',
    markets: 'USA · Canada · Mexico',
    demand: 'Engineering, automotive, structural fabrication',
    standards: 'ASTM B221 · ASTM B241 · AA specification',
    cert: 'ASTM certified · ISO 9001 · IATF 16949',
    desc: 'Banco exports to North American customers requiring ASTM-documented aluminium for engineering and structural applications. Material test certificates issued to ASTM B221 and B241. Hard alloys 2xxx and 6xxx series for automotive and precision engineering.',
  },
  {
    id: '03',
    name: 'Asia-Pacific',
    flag: 'AP',
    markets: 'Japan · South Korea · Australia · Singapore · Vietnam',
    demand: 'Architectural, industrial, automotive supply chain',
    standards: 'JIS H4100 · AS/NZS 1734 · market-specific',
    cert: 'ISO 9001 · IATF 16949 · customer-specific audit',
    desc: 'APAC markets cover a wide range of applications, from Japanese automotive supply chain (IATF 16949) to Australian construction and South-East Asian architectural projects. Banco supplies 1xxx through 7xxx alloys to APAC customers.',
  },
  {
    id: '04',
    name: 'Middle East',
    flag: 'ME',
    markets: 'UAE · Saudi Arabia · Qatar · Kuwait · Oman',
    demand: 'Structural and architectural. High-volume construction.',
    standards: 'ASTM B221 · EN standards · client specification',
    cert: 'ISO 9001 · CE available · material certificates',
    desc: 'Middle East demand is driven by large-scale infrastructure and construction projects requiring structural and architectural aluminium profiles. Banco supplies standard and custom sections to UAE and KSA fabricators. Volume orders with ASTM or EN documentation.',
  },
];

const exportDocs = [
  { doc: 'Commercial invoice',            req: 'All markets',                   note: 'HS code, Incoterms, country of origin, unit price' },
  { doc: 'Packing list',                  req: 'All markets',                   note: 'Bundle-level: profile reference, quantity, length, weight, packing type' },
  { doc: 'Material test certificate',     req: 'All markets',                   note: 'EN 10204 Type 3.1: composition + mechanical properties per lot' },
  { doc: 'Mill / works certificate',      req: 'All markets',                   note: 'Banco works cert, with extrusion date, die, press, lot number' },
  { doc: 'CBAM carbon data',              req: 'EU (mandatory Jan 2026)',        note: 'tCO₂e/t per EN ISO 14064-1, direct and indirect emissions' },
  { doc: 'CE Declaration of Performance', req: 'EU structural (EN 15088)',       note: 'Performance declared against load-bearing application class' },
  { doc: 'ASTM test report',              req: 'North America',                  note: 'B221 / B241 tensile, yield, elongation, on request' },
  { doc: 'IATF 16949 documentation',      req: 'Automotive supply chain',        note: 'PPAP documents, dimensional reports, process audit records' },
];

const keyCerts = [
  { code: 'CE',           std: 'EN 15088',        scope: 'Structural aluminium profiles for construction use in Europe' },
  { code: 'ISO 14064-1',  std: 'GHG Protocol',    scope: 'Carbon inventory and per-lot CBAM emission declarations' },
  { code: 'IATF 16949',   std: 'Automotive QMS',  scope: 'Quality management for automotive production supply chain' },
  { code: 'ISO 9001:2015',std: 'Quality mgmt',    scope: 'Quality management system across all manufacturing and export operations' },
];
---

<Layout
  title="Global reach: Banco Aluminium"
  description="Exporting aluminium extrusions to Europe, North America, Asia-Pacific and the Middle East. CE certified, CBAM-ready, IATF 16949. Serving 900+ customers."
  transparentNav={true}
>

  <!-- ══════════════════════════════════════════
       HERO
       ══════════════════════════════════════════ -->
  <section class="gr-hero">
    <div class="gr-hero-media" aria-hidden="true">
      <video class="gr-hero-vid" autoplay muted loop playsinline preload="metadata" poster="/herovideo-poster.jpg">
        <source src="/herovideo-720.mp4" type="video/mp4" />
      </video>
      <div class="gr-hero-scrim"></div>
      <div class="gr-hero-grad"></div>
    </div>

    <div class="container gr-hero-body">
      <div class="eyebrow on-dark" data-reveal="fade" data-reveal-delay="1">
        Global reach
      </div>
      <h1 class="t-h1 gr-hero-h1" data-reveal data-reveal-delay="2">
        Exporting to<br/><em class="accent">four regions.</em>
      </h1>
      <p class="gr-hero-lede" data-reveal data-reveal-delay="3">
        Banco Aluminium exports to 900+ customers across Europe, North America,
        Asia-Pacific, and the Middle East. CE certified, CBAM-ready, IATF 16949 qualified.
        Full export documentation, from packing list to carbon data.
      </p>

      <!-- Region flags row -->
      <div class="gr-regions-row" data-reveal data-reveal-delay="4">
        {regions.map(r => (
          <div class="gr-region-pill">
            <span class="gr-region-flag">{r.flag}</span>
            <span class="gr-region-pname">{r.name}</span>
          </div>
        ))}
      </div>

      <div class="gr-hero-stats" data-reveal data-reveal-delay="5">
        {[
          { val: '4',     label: 'Export regions' },
          { val: '900+',  label: 'Customers worldwide' },
          { val: 'Jan 26',label: 'CBAM-ready' },
          { val: 'CE + IATF', label: 'Certified for export' },
        ].map(({ val, label }) => (
          <div class="gr-stat">
            <div class="gr-stat-n">{val}</div>
            <div class="gr-stat-l">{label}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="gr-scroll-cue" aria-hidden="true">
      <span class="gr-scroll-line"></span>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       FOUR REGIONS
       ══════════════════════════════════════════ -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="gr-section-head" data-reveal="left">
        <div class="eyebrow">/ 01 · Export regions</div>
        <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
          Four regions.<br/><em class="accent">Market-specific</em> documentation.
        </h2>
      </div>

      <div class="gr-regions-grid" data-reveal="fade">
        {regions.map((r, i) => (
          <div class="gr-region-card" style={`--delay:${i * 80}ms`}>
            <div class="gr-rc-top">
              <div class="gr-rc-id">{r.id}</div>
              <div class="gr-rc-flag">{r.flag}</div>
            </div>
            <h3 class="gr-rc-name">{r.name}</h3>
            <div class="gr-rc-markets">{r.markets}</div>
            <p class="gr-rc-desc">{r.desc}</p>
            <div class="gr-rc-meta">
              {[
                ['Applications', r.demand],
                ['Standards',    r.standards],
                ['Certifications', r.cert],
              ].map(([k, v]) => (
                <div class="gr-meta-row">
                  <span class="gr-meta-key">{k}</span>
                  <span class="gr-meta-val">{v}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       EXPORT DOCS TABLE
       ══════════════════════════════════════════ -->
  <section class="section-dark section-pad">
    <div class="container">
      <div class="gr-section-head" data-reveal="left">
        <div class="eyebrow on-dark">/ 02 · Export documentation</div>
        <h2 class="t-h2" style="color:var(--color-platinum);margin-top:16px">
          Complete document package<br/><em class="accent">with every shipment.</em>
        </h2>
      </div>

      <div class="gr-doc-wrap" data-reveal="fade">
        <table class="gr-doc-table">
          <thead>
            <tr>
              <th>Document</th>
              <th>Required for</th>
              <th>Notes</th>
            </tr>
          </thead>
          <tbody>
            {exportDocs.map((d, i) => (
              <tr class={i % 2 === 0 ? 'gr-row-even' : 'gr-row-odd'}>
                <td class="gr-cell-doc">{d.doc}</td>
                <td class="gr-cell-req">{d.req}</td>
                <td class="gr-cell-note">{d.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="gr-footnote" data-reveal="fade">
        Documents issued electronically (PDF) before loading. CBAM carbon data calculated per
        ISO 14064-1 and attached to the material certificate for all EU-bound shipments.
      </p>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       KEY CERTS + CBAM
       ══════════════════════════════════════════ -->
  <section class="section-alt section-pad">
    <div class="container">
      <div class="gr-cert-layout" data-reveal="fade">
        <div class="gr-cert-copy">
          <div class="eyebrow">/ 03 · Export certifications</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            Certified for<br/><em class="accent">regulated markets.</em>
          </h2>
          <p style="color:var(--color-stone-700);font-size:16px;line-height:1.7;margin-top:20px">
            Banco's certification portfolio covers the major regulated import markets.
            CE marking under EN 15088 allows structural aluminium to be used in CE-marked
            construction projects across Europe. IATF 16949 allows supply into automotive
            OEM supply chains globally. ISO 14064-1 supports CBAM declarations for EU customers.
          </p>
          <p style="color:var(--color-stone-700);font-size:15px;line-height:1.7;margin-top:16px">
            Audit trails, process documentation, and measurement system analysis are maintained
            at the facility and available for customer or third-party audit on request.
          </p>
        </div>

        <div class="gr-certs-cards">
          {keyCerts.map((c, i) => (
            <div class="gr-cert-card" style={`--delay:${i * 60}ms`}>
              <div class="gr-cert-code">{c.code}</div>
              <div class="gr-cert-std">{c.std}</div>
              <div class="gr-cert-rule"></div>
              <div class="gr-cert-scope">{c.scope}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       CBAM CALLOUT BAND
       ══════════════════════════════════════════ -->
  <section class="gr-cbam-band" data-reveal="fade">
    <div class="container gr-cbam-inner">
      <div>
        <div class="gr-cbam-badge">CBAM: Carbon Border Adjustment Mechanism</div>
        <h2 class="t-h2" style="color:var(--color-stone-50);margin-top:20px">
          CBAM-ready<br/><em class="accent">for EU importers.</em>
        </h2>
        <p style="color:var(--color-stone-400);font-size:15px;line-height:1.65;max-width:52ch;margin-top:20px">
          From January 2026, all aluminium imported into the EU requires embedded carbon
          emission data under the CBAM regulation. Banco has implemented ISO 14064-1
          carbon accounting across its foundry and extrusion operations, calculated per lot rather than per year.
        </p>
      </div>
      <div class="gr-cbam-tags">
        {['ISO 14064-1 verified', 'Direct emissions: Scope 1', 'Indirect emissions: Scope 2', 'Per-lot production reporting', 'CBAM declaration document', '0.763 kg CO₂e / kg Al'].map(tag => (
          <div class="gr-cbam-tag">{tag}</div>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       CTA CLOSE
       ══════════════════════════════════════════ -->
  <section class="section-dark" style="padding:72px 0;border-top:2px solid var(--color-green)">
    <div class="container">
      <div class="gr-cta-row" data-reveal="fade">
        <div>
          <div class="eyebrow on-dark">Export enquiries</div>
          <h2 class="t-h2" style="color:var(--color-platinum);margin-top:14px">
            Documentation confirmed<br/>before every order.
          </h2>
          <p style="color:var(--color-stone-400);font-size:15px;line-height:1.65;margin-top:14px;max-width:48ch">
            Export pricing, documentation requirements, and shipping terms confirmed
            in writing before order placement.
          </p>
        </div>
        <div class="gr-cta-btns">
          <a href="/contact#export" class="btn btn-primary-dark">Contact for export</a>
          <a href="/about/quality" class="btn btn-secondary-dark">Quality & certifications</a>
          <a href="/capabilities/packing" class="btn btn-secondary-dark">Packing options</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── HERO ───────────────────────────────────────────────────── */
  .gr-hero {
    position: relative; background: var(--color-navy-deep);
    min-height: 90vh; display: flex; align-items: center; overflow: hidden;
  }
  .gr-hero-media { position: absolute; inset: 0; z-index: 0; }
  .gr-hero-vid { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 50%; }
  .gr-hero-scrim { position: absolute; inset: 0; background: rgba(6,21,37,0.65); }
  .gr-hero-grad {
    position: absolute; inset: 0;
    background:
      linear-gradient(115deg, rgba(6,21,37,0.75) 0%, rgba(6,21,37,0.22) 60%, rgba(6,21,37,0.05) 100%),
      linear-gradient(to bottom, transparent 55%, var(--color-navy-deep) 100%);
  }
  .gr-hero-body { position: relative; z-index: 2; width: 100%; padding-top: 160px; padding-bottom: 80px; }
  .gr-hero-h1 { color: var(--color-stone-50); margin-top: 20px; }
  .gr-hero-lede { color: var(--color-stone-400); font-size: clamp(15px,1.4vw,18px); line-height: 1.65; max-width: 56ch; margin-top: 24px; }

  /* Region pills */
  .gr-regions-row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 36px; }
  .gr-region-pill {
    display: flex; align-items: center; gap: 8px;
    border: 1px solid rgba(255,255,255,0.15);
    padding: 8px 16px;
    font-family: var(--font-mono); font-size: 10px;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--color-stone-400);
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .gr-region-pill:hover { border-color: var(--color-green); color: var(--color-stone-50); }
  .gr-region-flag { font-size: 9px; color: var(--color-green); font-weight: 700; }
  .gr-hero-stats { display: flex; gap: 0; flex-wrap: wrap; margin-top: 40px; padding-top: 28px; border-top: 1px solid rgba(255,255,255,0.10); }
  .gr-stat { padding-right: 40px; margin-right: 40px; border-right: 1px solid rgba(255,255,255,0.10); }
  .gr-stat:last-child { border-right: none; }
  .gr-stat-n { font-family: var(--font-sans); font-size: clamp(20px,2.5vw,32px); font-weight: 400; letter-spacing: -0.02em; color: var(--color-stone-50); line-height: 1; }
  .gr-stat-l { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-stone-400); margin-top: 7px; }

  .gr-scroll-cue { position: absolute; bottom: 44px; left: 50%; transform: translateX(-50%); z-index: 3; }
  .gr-scroll-line { display: block; width: 1px; height: 52px; background: linear-gradient(to bottom, var(--color-green), transparent); animation: gr-drop 2s ease-in-out infinite; }
  @keyframes gr-drop {
    0%   { transform: scaleY(0); transform-origin: top; opacity: 1; }
    50%  { transform: scaleY(1); transform-origin: top; }
    51%  { transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; opacity: 0; }
  }

  /* ── SECTION HEADS ──────────────────────────────────────────── */
  .gr-section-head { max-width: 560px; margin-bottom: 40px; }

  /* ── REGIONS GRID ───────────────────────────────────────────── */
  .gr-regions-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--color-stone-200); }
  .gr-region-card {
    background: var(--color-stone-50); padding: 36px 28px;
    display: flex; flex-direction: column; gap: 12px;
    border-top: 2px solid transparent;
    transition: border-top-color 0.25s ease, background 0.25s ease;
    transition-delay: var(--delay, 0ms);
  }
  .gr-region-card:hover { border-top-color: var(--color-green); background: white; }
  .gr-rc-top { display: flex; justify-content: space-between; align-items: center; }
  .gr-rc-id { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.18em; color: var(--color-green); }
  .gr-rc-flag { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.14em; font-weight: 700; color: var(--color-stone-700); border: 1px solid var(--color-stone-200); padding: 3px 8px; }
  .gr-rc-name { font-size: clamp(20px,2vw,26px); font-weight: 700; letter-spacing: -0.02em; color: var(--color-navy); line-height: 1; }
  .gr-rc-markets { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-stone-700); }
  .gr-rc-desc { font-size: 13.5px; line-height: 1.65; color: var(--color-stone-700); }
  .gr-rc-meta { border-top: 1px solid var(--color-stone-200); padding-top: 14px; display: flex; flex-direction: column; gap: 10px; margin-top: 4px; }
  .gr-meta-row { display: grid; grid-template-columns: 100px 1fr; gap: 10px; align-items: baseline; }
  .gr-meta-key { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-stone-700); }
  .gr-meta-val { font-size: 13px; color: var(--color-stone-700); }

  /* ── DOCS TABLE ─────────────────────────────────────────────── */
  .gr-doc-wrap { overflow-x: auto; border: 1px solid var(--color-navy-line); }
  .gr-doc-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .gr-doc-table thead tr { background: var(--color-navy-soft); }
  .gr-doc-table th { padding: 12px 20px; text-align: left; font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-nickel); border-right: 1px solid var(--color-navy-line); white-space: nowrap; }
  .gr-doc-table th:last-child { border-right: none; }
  .gr-row-even { background: rgba(255,255,255,0.04); }
  .gr-row-odd  { background: rgba(255,255,255,0.02); }
  .gr-doc-table td { padding: 14px 20px; border-right: 1px solid var(--color-navy-line); border-bottom: 1px solid rgba(255,255,255,0.06); vertical-align: top; }
  .gr-doc-table td:last-child { border-right: none; }
  .gr-cell-doc  { font-weight: 500; color: var(--color-platinum); min-width: 200px; }
  .gr-cell-req  { font-family: var(--font-mono); font-size: 11px; color: var(--color-silver); min-width: 180px; }
  .gr-cell-note { color: var(--color-stone-400); font-size: 12px; min-width: 220px; }
  .gr-footnote  { margin-top: 14px; font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.08em; color: var(--color-nickel); line-height: 1.7; }

  /* ── CERTS ──────────────────────────────────────────────────── */
  .gr-cert-layout { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px,6vw,80px); align-items: start; }
  .gr-certs-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--color-stone-200); }
  .gr-cert-card {
    background: var(--color-stone-50); padding: 24px 20px;
    border-top: 2px solid var(--color-green);
    display: flex; flex-direction: column;
    transition: background 0.2s ease;
    transition-delay: var(--delay,0ms);
  }
  .gr-cert-card:hover { background: white; }
  .gr-cert-code { font-size: clamp(18px,2vw,24px); font-weight: 800; letter-spacing: -0.02em; color: var(--color-navy); line-height: 1; }
  .gr-cert-std  { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-stone-700); margin-top: 4px; }
  .gr-cert-rule { width: 24px; height: 1px; background: var(--color-stone-200); margin: 12px 0; }
  .gr-cert-scope { font-size: 12.5px; line-height: 1.55; color: var(--color-stone-700); }

  /* ── CBAM BAND ──────────────────────────────────────────────── */
  .gr-cbam-band { background: var(--color-navy); border-top:1px solid var(--color-navy-line); border-bottom:1px solid var(--color-navy-line); padding: 64px 0; }
  .gr-cbam-inner { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px,6vw,100px); align-items: center; }
  .gr-cbam-badge {
    display: inline-flex; align-items: center;
    font-family: var(--font-mono); font-size: 10px;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--color-green); border: 1px solid var(--color-green); padding: 6px 14px;
  }
  .gr-cbam-tags { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--color-navy-line); }
  .gr-cbam-tag {
    background: var(--color-navy-soft); padding: 18px 16px;
    font-family: var(--font-mono); font-size: 10.5px;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--color-stone-400); line-height: 1.5;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .gr-cbam-tag:hover { background: var(--color-navy); color: var(--color-stone-50); }

  /* ── CTA ────────────────────────────────────────────────────── */
  .gr-cta-row { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 40px; }
  .gr-cta-btns { display: flex; flex-direction: column; gap: 12px; flex-shrink: 0; }

  /* ── RESPONSIVE ─────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .gr-cert-layout  { grid-template-columns: 1fr; }
    .gr-cbam-inner   { grid-template-columns: 1fr; }
    .gr-cta-row      { flex-direction: column; }
    .gr-cta-btns     { flex-direction: row; flex-wrap: wrap; }
  }
  @media (max-width: 640px) {
    .gr-hero-vid     { display: none; }
    .gr-hero-grad    { background: rgba(6,21,37,0.88); }
    .gr-scroll-cue   { display: none; }
    .gr-regions-grid { grid-template-columns: 1fr; }
    .gr-certs-cards  { grid-template-columns: 1fr; }
    .gr-cbam-tags    { grid-template-columns: 1fr; }
    .gr-meta-row     { grid-template-columns: 80px 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .gr-hero-vid { display: none; }
    .gr-scroll-line { animation: none; opacity: 0.5; }
  }
</style>

<script>
  const v = document.querySelector<HTMLVideoElement>('.gr-hero-vid');
  if (v) document.addEventListener('visibilitychange', () => document.hidden ? v.pause() : v.play().catch(() => {}));
</script>
