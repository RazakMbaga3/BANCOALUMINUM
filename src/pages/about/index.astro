---
import Layout from '../../layouts/Layout.astro';
import Pic from '../../components/Pic.astro';
import { optSrcset } from '../../lib/img';

const milestones = [
  { year: '1967', event: 'Founded in Vadodara, Gujarat by the Thakkar family' },
  { year: '1970s', event: 'First hydraulic extrusion press commissioned' },
  { year: '1980s', event: 'In-house foundry and die shop established' },
  { year: '1990s', event: 'Export operations begin: first European customers' },
  { year: '2000s', event: 'Capacity expanded to five presses; IATF 16949 certification' },
  { year: '2010s', event: 'Cold drawing, CNC machining and surface finishing integrated' },
  { year: '2020s', event: 'CBAM-ready; 960 kW solar commissioned; 35,000 MT milestone' },
];

const testimonials = [
  { client: 'Aavid Metalalloys',  location: 'India',       quote: 'Reliable supply partner with consistent quality across hard alloy specifications.' },
  { client: 'Schneider Electric', location: 'Bangalore',   quote: 'Dependable extrusion partner for our busbar and T&D profile requirements.' },
  { client: 'Truetzschler',       location: 'India',       quote: 'Long-standing relationship built on technical competence and delivery reliability.' },
  { client: 'IMS Netherlands',    location: 'Netherlands', quote: 'Banco\'s lead-free machining alloys meet our RoHS requirements with consistent dimensional quality.' },
  { client: 'INOX India',         location: 'India',       quote: 'Strong quality systems and traceability, key for our engineering applications.' },
];

const applications = [
  { name: 'Automotive',  href: '/industries/automotive',  img: '/assets/industries/hero/automotive-hero.jpg',       hook: 'Structural body sections, door sills, and seat-track extrusions to IATF 16949.' },
  { name: 'Railways',    href: '/industries/railways',    img: '/assets/industries/hero/railways-hero.jpg',         hook: 'IRS Works Approval holder. Structural and interior profiles for rolling stock.' },
  { name: 'Aerospace',   href: '/industries/aerospace',   img: '/assets/industries/hero/aerospace-hero.jpg',        hook: 'High-performance 2xxx / 7xxx sections with full chemical traceability.' },
  { name: 'Electrical',  href: '/industries/electrical',  img: '/assets/industries/hero/electrical-hero.jpg',       hook: 'Busbars, switchgear housings, and T&D profiles in high-conductivity alloys.' },
  { name: 'Building',    href: '/industries/building',    img: '/assets/industries/hero/building-hero.jpg',         hook: 'Curtain wall mullions and structural glazing sections, Class 20 anodised.' },
  { name: 'Solar',       href: '/industries/solar',       img: '/assets/industries/hero/solar-hero.jpg',            hook: 'Module frames and racking systems, anodised for 25-year outdoor durability.' },
];
---

<Layout
  title="About Banco Aluminium: established 1967"
  description="Banco Aluminium Private Limited: integrated aluminium extrusion company established 1967 in Vadodara, Gujarat. 35,000 MT capacity, 1100+ customers worldwide."
  transparentNav={true}
  heroImage="/assets/images/people/group-discussing.png"
>

  <!-- ══════════════════════════════════════════════════════════
       HERO — full-viewport photo
       ══════════════════════════════════════════════════════════ -->
  <section class="ab-hero">
    <div class="ab-hero-media" aria-hidden="true">
      <picture>
        <source type="image/avif" srcset={optSrcset('/assets/images/people/group-discussing.png', 'avif')} sizes="100vw" />
        <source type="image/webp" srcset={optSrcset('/assets/images/people/group-discussing.png', 'webp')} sizes="100vw" />
        <img src="/assets/images/people/group-discussing.png" alt="" loading="eager" fetchpriority="high" class="ab-hero-video" />
      </picture>
      <div class="ab-hero-scrim"></div>
      <div class="ab-hero-grad"></div>
    </div>

    <div class="container ab-hero-body">
      <div class="ab-hero-inner">
        <div class="eyebrow on-dark" data-reveal="fade" data-reveal-delay="1">
          About Banco · Est. 1967
        </div>

        <h1 class="t-h1 ab-hero-h1" data-reveal data-reveal-delay="2">
          Family-run<br/>aluminium,<br/><em class="accent">since 1967.</em>
        </h1>

        <p class="ab-hero-lede" data-reveal data-reveal-delay="3">
          Integrated aluminium extrusion since 1967. Five presses. Full value chain.
          Still family-owned. Serving 1100+ customers across four export regions.
        </p>

        <!-- Stat row -->
        <div class="ab-hero-stats" data-reveal data-reveal-delay="4">
          {[
            { n: 58,    s: '+',   sep: false, label: 'Years in extrusion' },
            { n: 35000, s: ' MT', sep: true,  label: 'Annual capacity' },
            { n: 1100,  s: '+',   sep: false, label: 'Customers worldwide' },
            { n: 5,     s: '',    sep: false, label: 'Extrusion presses' },
          ].map(({ n, s, sep, label }) => (
            <div class="ab-stat">
              <div class="ab-stat-n" data-countup={n} data-suffix={s} data-separator={sep ? ',' : ''}>
                {sep ? n.toLocaleString() : n}{s}
              </div>
              <div class="ab-stat-l">{label}</div>
            </div>
          ))}
        </div>

        <div class="ab-hero-ctas" data-reveal data-reveal-delay="5">
          <a href="/contact#quote" class="btn btn-primary-dark">Send Enquiry</a>
          <a href="/about/why-banco" class="btn btn-secondary-dark">Why Banco</a>
        </div>
      </div>
    </div>

    <div class="ab-scroll-cue" aria-hidden="true">
      <span class="ab-scroll-line"></span>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       OUR STORY — sticky headline + editorial copy + photos
       ══════════════════════════════════════════════════════════ -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="ab-story-grid">

        <div class="ab-story-anchor" data-reveal="left">
          <div class="eyebrow">/ 01 · Our story</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:20px">
            Integrated.<br/>
            <em class="accent">Independent.</em><br/>
            Dependable.
          </h2>
          <div class="ab-story-rule"></div>
          <div class="ab-story-meta">
            <span>Vadodara, Gujarat</span>
            <span>·</span>
            <span>Est. 1967</span>
            <span>·</span>
            <span>Family-owned</span>
          </div>
        </div>

        <div class="ab-story-body" data-reveal="right">
          <p class="ab-story-lead">
            Banco Aluminium delivers the control of an integrated manufacturer
            with the flexibility of a customer-focused aluminium solutions partner.
          </p>
          <p class="ab-story-p">
            In an industry where most suppliers are either pure extruders or pure traders,
            Banco owns the complete production chain, from melting and billet casting
            through extrusion, heat treatment, machining, cold drawing, and surface finishing.
            This integration is not just a manufacturing advantage. It is a quality and
            responsiveness advantage.
          </p>
          <p class="ab-story-p">
            When a customer requests an alloy modification, a die correction, or a downstream
            value-add, the answer does not depend on a third party. It happens in-house,
            on our schedule, under our quality systems.
          </p>
          <p class="ab-story-p">
            With five extrusion presses ranging from 1,100 T to 3,300 T and a 55,000 MT
            foundry, Banco operates at a scale that supports both high-volume OEM supply
            and specialised low-volume development programmes.
          </p>

          <!-- 2-up editorial photos -->
          <div class="ab-story-photos">
            <figure class="ab-story-fig">
              <Pic src="/assets/manufacturing/melting-2.webp" alt="Liquid aluminium at Banco foundry, Vadodara" loading="lazy" sizes="(max-width: 1024px) 100vw, 60vw" />
              <figcaption>Melting · Foundry floor · Vadodara</figcaption>
            </figure>
            <figure class="ab-story-fig">
              <Pic src="/assets/manufacturing/homo-2.webp" alt="Controlled-atmosphere homogenising furnace" loading="lazy" sizes="(max-width: 1024px) 100vw, 60vw" />
              <figcaption>Homogenising · Controlled atmosphere furnace</figcaption>
            </figure>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       HERITAGE — timeline vertical
       ══════════════════════════════════════════════════════════ -->
  <section class="ab-timeline-section section-alt section-pad" style="border-top:2px solid var(--color-green)">
    <div class="container ab-timeline-wrap">
      <div class="ab-timeline-head" data-reveal="left">
        <div class="eyebrow">/ 02 · Heritage</div>
        <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
          58 years of<br/><em class="accent">aluminium</em> experience.
        </h2>
      </div>

      <div class="ab-timeline">
        <div class="ab-timeline-line" aria-hidden="true"></div>
        {milestones.map((m, i) => (
          <div class="ab-timeline-row" data-reveal="fade" style={`--delay:${i * 70}ms`}>
            <div class="ab-timeline-dot" aria-hidden="true"></div>
            <div class="ab-timeline-year">{m.year}</div>
            <div class="ab-timeline-event">{m.event}</div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       TRUSTED BY INDUSTRY LEADERS — logos + testimonials
       ══════════════════════════════════════════════════════════ -->
  <section class="section-dark section-pad">
    <div class="container">
      <div class="ab-testi-head" data-reveal="fade">
        <div>
          <div class="eyebrow on-dark">/ 03 · Trusted by industry leaders</div>
          <h2 class="t-h2" style="color:var(--color-stone-50);margin-top:16px">
            1,100+ customers.<br/><em class="accent">Four export regions.</em>
          </h2>
        </div>
        <p class="t-lead" style="color:var(--color-stone-400);max-width:44ch;align-self:end">
          Across industrial, automotive, electrical, and architectural sectors,
          in India and export markets spanning Europe, North America, APAC,
          and the Middle East.
        </p>
      </div>
    </div>

    <div class="ab-logos-track-wrap" aria-label="Notable clients" style="margin:44px 0">
      <div class="ab-logos-track">
        {/* Duplicated for seamless loop */}
        {[...Array(2)].map(() =>
          [
            { src: '/assets/logos/reliance.png',  alt: 'Reliance Industries',  h: 30 },
            { src: '/assets/logos/lt.svg',         alt: 'Larsen & Toubro',      h: 38 },
            { src: '/assets/logos/siemens.svg',    alt: 'Siemens',              h: 28 },
            { src: '/assets/logos/abb.svg',        alt: 'ABB',                  h: 34 },
            { src: '/assets/logos/schneider.svg',  alt: 'Schneider Electric',   h: 40 },
            { src: '/assets/logos/alstom.svg',     alt: 'Alstom',               h: 32 },
          ].map(({ src, alt, h }) => (
            <div class="ab-logo-item">
              <img src={src} alt={alt} style={`height:${h}px;width:auto`} loading="lazy" />
            </div>
          ))
        )}
      </div>
    </div>

    <div class="container">
      <div class="ab-testi-grid" data-reveal="fade">
        {testimonials.map((t, i) => (
          <div class="ab-testi-card" style={`--delay:${i * 60}ms`}>
            <div class="ab-testi-open-quote" aria-hidden="true">"</div>
            <p class="ab-testi-quote">{t.quote}</p>
            <div class="ab-testi-foot">
              <div class="ab-testi-client">{t.client}</div>
              <div class="ab-testi-loc">{t.location}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       SELECTED APPLICATIONS
       ══════════════════════════════════════════════════════════ -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="ab-apps-head" data-reveal="fade">
        <div>
          <div class="eyebrow">/ 04 · Selected applications</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            One factory.<br/>Six different industries.
          </h2>
        </div>
        <p class="t-lead" style="color:var(--color-stone-700);max-width:44ch;align-self:end">
          The same integrated process, qualified to very different standards
          depending on where the profile ends up.
        </p>
      </div>

      <div class="ab-apps-grid" data-reveal="fade">
        {applications.map((a) => (
          <a href={a.href} class="ab-apps-card">
            <div class="ab-apps-img">
              <Pic src={a.img} alt={a.name} loading="lazy" sizes="(max-width: 900px) 100vw, 33vw" maxW={900} />
            </div>
            <div class="ab-apps-body">
              <h3 class="ab-apps-name">{a.name}</h3>
              <p class="ab-apps-hook">{a.hook}</p>
              <span class="ab-apps-link">Explore →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       CTA CLOSE
       ══════════════════════════════════════════════════════════ -->
  <section class="section-dark" style="padding:72px 0;border-top:2px solid var(--color-green)">
    <div class="container">
      <div class="ab-cta-row" data-reveal="fade">
        <div>
          <div class="eyebrow on-dark">Get in touch</div>
          <h2 class="t-h2" style="color:var(--color-platinum);margin-top:14px">
            See the certifications.<br/>Meet the team.
          </h2>
        </div>
        <div class="ab-cta-btns">
          <a href="/contact#quote" class="btn btn-primary-dark">Send Enquiry</a>
          <a href="/about/quality" class="btn btn-secondary-dark">Quality & certifications</a>
          <a href="/about/global-reach" class="btn btn-secondary-dark">Global reach</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<!-- ═══════════════════════════════════════════════════════════ -->
<style>
  /* ── HERO ──────────────────────────────────────────────────── */
  .ab-hero {
    position: relative;
    background: var(--color-navy-deep);
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .ab-hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .ab-hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .ab-hero-scrim {
    position: absolute;
    inset: 0;
    background: rgba(6, 21, 37, 0.58);
  }
  .ab-hero-grad {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(110deg, rgba(6,21,37,0.72) 0%, rgba(6,21,37,0.18) 60%),
      linear-gradient(to bottom, transparent 55%, var(--color-navy-deep) 100%);
  }
  .ab-hero-body {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-top: 140px;
    padding-bottom: 120px;
  }
  .ab-hero-inner { max-width: 680px; }
  .ab-hero-h1 {
    color: var(--color-stone-50);
    margin-top: 20px;
  }
  .ab-hero-lede {
    color: var(--color-stone-400);
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.65;
    max-width: 52ch;
    margin-top: 24px;
  }
  .ab-hero-stats {
    display: flex;
    gap: 0;
    flex-wrap: nowrap;
    margin-top: 52px;
    padding-top: 32px;
    border-top: 1px solid rgba(255,255,255,0.10);
  }
  .ab-stat {
    padding-right: 40px;
    margin-right: 40px;
    border-right: 1px solid rgba(255,255,255,0.10);
  }
  .ab-stat:last-child { border-right: none; }
  .ab-stat-n {
    font-family: var(--font-sans);
    font-size: clamp(30px, 3.6vw, 46px);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--color-stone-50);
    line-height: 1;
  }
  .ab-stat-l {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-stone-400);
    margin-top: 8px;
  }
  .ab-hero-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 40px;
  }

  /* Scroll cue */
  .ab-scroll-cue {
    position: absolute;
    bottom: 44px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
  }
  .ab-scroll-line {
    display: block;
    width: 1px;
    height: 56px;
    background: linear-gradient(to bottom, var(--color-green), transparent);
    animation: ab-drop 2s ease-in-out infinite;
  }
  @keyframes ab-drop {
    0%   { transform: scaleY(0); transform-origin: top; opacity: 1; }
    50%  { transform: scaleY(1); transform-origin: top; }
    51%  { transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; opacity: 0; }
  }

  /* ── STORY ─────────────────────────────────────────────────── */
  .ab-story-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: clamp(48px, 7vw, 100px);
    align-items: start;
  }
  .ab-story-anchor {
    position: sticky;
    top: 100px;
  }
  .ab-story-rule {
    width: 40px;
    height: 1px;
    background: var(--color-stone-400);
    margin: 28px 0;
  }
  .ab-story-meta {
    display: flex;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-stone-700);
    flex-wrap: wrap;
  }
  .ab-story-lead {
    font-size: clamp(18px, 1.8vw, 20px);
    font-weight: 500;
    line-height: 1.55;
    color: var(--color-navy);
    margin-bottom: 24px;
    letter-spacing: -0.01em;
  }
  .ab-story-p {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-stone-700);
    margin-bottom: 18px;
  }
  .ab-story-photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3px;
    margin-top: 40px;
  }
  .ab-story-fig {
    overflow: hidden;
    border: 1px solid var(--color-stone-200);
    margin: 0;
  }
  .ab-story-fig img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .ab-story-fig:hover img { transform: scale(1.05); }
  .ab-story-fig figcaption {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-stone-700);
    padding: 7px 10px;
    border-top: 1px solid var(--color-stone-200);
    background: var(--color-stone-50);
  }

  /* ── TIMELINE ──────────────────────────────────────────────── */
  .ab-timeline-wrap {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .ab-timeline-head { position: sticky; top: 100px; }
  .ab-timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-left: 32px;
  }
  .ab-timeline-line {
    position: absolute;
    left: 7px;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: linear-gradient(to bottom, var(--color-green), var(--color-stone-200));
  }
  .ab-timeline-row {
    position: relative;
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid var(--color-stone-200);
    align-items: start;
    transition-delay: var(--delay, 0ms);
  }
  .ab-timeline-row:last-child { border-bottom: none; }
  .ab-timeline-dot {
    position: absolute;
    left: -32px;
    top: 26px;
    width: 14px;
    height: 14px;
    border: 2px solid var(--color-green);
    background: var(--color-stone-100);
    border-radius: 50%;
  }
  .ab-timeline-year {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-green);
    padding-top: 3px;
    white-space: nowrap;
  }
  .ab-timeline-event {
    font-family: var(--font-sans);
    font-size: clamp(16px, 1.5vw, 20px);
    font-weight: 400;
    color: var(--color-navy);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  /* ── LOGO MARQUEE ──────────────────────────────────────────── */
  .ab-logos-track-wrap {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }
  .ab-logos-track {
    display: flex;
    width: max-content;
    animation: logo-scroll 28s linear infinite;
  }
  .ab-logos-track:hover { animation-play-state: paused; }
  @keyframes logo-scroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .ab-logo-item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px 56px;
    filter: grayscale(100%) brightness(2);
    opacity: 0.55;
    transition: filter 0.25s ease, opacity 0.25s ease;
    flex-shrink: 0;
  }
  .ab-logo-item:hover { filter: grayscale(0%) brightness(1); opacity: 1; }

  /* ── TESTIMONIALS ──────────────────────────────────────────── */
  .ab-testi-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
    margin-bottom: 8px;
  }
  .ab-testi-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--color-navy-line);
    border: 1px solid var(--color-navy-line);
  }
  .ab-testi-card {
    background: var(--color-navy-soft);
    padding: 32px 28px 28px;
    display: flex;
    flex-direction: column;
    border-top: 2px solid transparent;
    transition: border-top-color 0.2s ease, background 0.2s ease;
    transition-delay: var(--delay, 0ms);
  }
  .ab-testi-card:hover {
    border-top-color: var(--color-green);
    background: var(--color-navy);
  }
  .ab-testi-open-quote {
    font-family: Georgia, serif;
    font-size: 48px;
    line-height: 0.8;
    color: var(--color-green);
    margin-bottom: 16px;
    opacity: 0.7;
  }
  .ab-testi-quote {
    font-size: 14.5px;
    line-height: 1.72;
    color: var(--color-silver);
    flex: 1;
    font-style: italic;
    margin-bottom: 24px;
  }
  .ab-testi-foot {
    padding-top: 18px;
    border-top: 1px solid var(--color-navy-line);
  }
  .ab-testi-client {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-stone-50);
    letter-spacing: -0.01em;
  }
  .ab-testi-loc {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.14em;
