---
import Layout from '../../layouts/Layout.astro';
import Pic from '../../components/Pic.astro';
import { optSrcset } from '../../lib/img';

const milestones = [
  { year: '1967', event: 'Founded in Vadodara, Gujarat by the Thakkar family' },
  { year: '1970s', event: 'First hydraulic extrusion press commissioned' },
  { year: '1980s', event: 'In-house foundry and die shop established' },
  { year: '1990s', event: 'Export operations begin: first European customers' },
  { year: '2000s', event: 'Capacity expanded to five presses; IATF 16949 certification' },
  { year: '2010s', event: 'Cold drawing, CNC machining and surface finishing integrated' },
  { year: '2020s', event: 'CBAM-ready; 960 kW solar commissioned; 35,000 MT milestone' },
];

const process = [
  { n: '01', title: 'Foundry',       sub: 'Billet casting', desc: 'In-house melting and casting of standard and special alloys in the 6xxx, 2xxx and 7xxx series.' },
  { n: '02', title: 'Extrusion',     sub: '5 presses',      desc: '1100–3300T press force. Direct and indirect extrusion of complex hollow and solid profiles.' },
  { n: '03', title: 'Die Shop',      sub: 'In-house',       desc: 'Full die design, manufacture and correction capability, with no third-party dependency.' },
  { n: '04', title: 'Heat Treatment',sub: 'Age & anneal',   desc: 'Controlled atmosphere ageing and annealing furnaces ensuring consistent T5/T6 properties.' },
  { n: '05', title: 'Machining',     sub: 'CNC + cold draw', desc: 'Multi-axis CNC machining, cold drawing and fabrication for near-net-shape output.' },
  { n: '06', title: 'Finishing',     sub: 'Surface & pack',  desc: 'Anodising, powder coating, chromating and precision packing for OEM and export shipments.' },
];

const reasons = [
  ['Complete solution provider',     'In-house product development, die design and manufacturing, end to end under one roof.'],
  ['900+ customers served',          'Customised product development and experience of servicing 900+ clients across diverse industries.'],
  ['High-strength alloy specialist', 'In-house foundry development and supply of special high-strength and lead-free machining alloys.'],
  ['Certified to global standards',  'ISO 14001:2015, ISO 9001:2015, IATF 16949 and CE certified: quality assured at every stage.'],
  ['Value-added processing',         'Machining & fabrication facilities for assemblies, customised products, and cold drawing.'],
  ['Quickest response time',         'Extremely responsive team with short lead times and direct customer communication at all levels.'],
  ['58 years of experience',         'Established 1967 in Vadodara, Gujarat. Family-owned. Exporting to Europe, North America, APAC, and the Middle East.'],
];

const testimonials = [
  { client: 'Aavid Metalalloys',  location: 'India',       quote: 'Reliable supply partner with consistent quality across hard alloy specifications.' },
  { client: 'Schneider Electric', location: 'Bangalore',   quote: 'Dependable extrusion partner for our busbar and T&D profile requirements.' },
  { client: 'Truetzschler',       location: 'India',       quote: 'Long-standing relationship built on technical competence and delivery reliability.' },
  { client: 'IMS Netherlands',    location: 'Netherlands', quote: 'Banco\'s lead-free machining alloys meet our RoHS requirements with consistent dimensional quality.' },
  { client: 'INOX India',         location: 'India',       quote: 'Strong quality systems and traceability, key for our engineering applications.' },
];
---

<Layout
  title="About Banco Aluminium: established 1967"
  description="Banco Aluminium Private Limited: integrated aluminium extrusion company established 1967 in Vadodara, Gujarat. 35,000 MT capacity, 900+ customers worldwide."
  transparentNav={true}
  heroImage="/assets/images/people/group-discussing.png"
>

  <!-- ══════════════════════════════════════════════════════════
       HERO — full-viewport photo
       ══════════════════════════════════════════════════════════ -->
  <section class="ab-hero">
    <div class="ab-hero-media" aria-hidden="true">
      <picture>
        <source type="image/avif" srcset={optSrcset('/assets/images/people/group-discussing.png', 'avif')} sizes="100vw" />
        <source type="image/webp" srcset={optSrcset('/assets/images/people/group-discussing.png', 'webp')} sizes="100vw" />
        <img src="/assets/images/people/group-discussing.png" alt="" loading="eager" fetchpriority="high" class="ab-hero-video" />
      </picture>
      <div class="ab-hero-scrim"></div>
      <div class="ab-hero-grad"></div>
    </div>

    <div class="container ab-hero-body">
      <div class="ab-hero-inner">
        <div class="eyebrow on-dark" data-reveal="fade" data-reveal-delay="1">
          About Banco · Est. 1967
        </div>

        <h1 class="t-h1 ab-hero-h1" data-reveal data-reveal-delay="2">
          Engineering <em class="accent">aluminium</em><br/>
          with precision,<br/>at scale.
        </h1>

        <p class="ab-hero-lede" data-reveal data-reveal-delay="3">
          Integrated aluminium extrusion since 1967. Five presses. Full value chain.
          Still family-owned. Serving 900+ customers across four export regions.
        </p>

        <!-- Stat row -->
        <div class="ab-hero-stats" data-reveal data-reveal-delay="4">
          {[
            { n: 58,    s: '+',   sep: false, label: 'Years in extrusion' },
            { n: 35000, s: ' MT', sep: true,  label: 'Annual capacity' },
            { n: 900,   s: '+',   sep: false, label: 'Customers worldwide' },
            { n: 5,     s: '',    sep: false, label: 'Extrusion presses' },
          ].map(({ n, s, sep, label }) => (
            <div class="ab-stat">
              <div class="ab-stat-n" data-countup={n} data-suffix={s} data-separator={sep ? ',' : ''}>
                {sep ? n.toLocaleString() : n}{s}
              </div>
              <div class="ab-stat-l">{label}</div>
            </div>
          ))}
        </div>

        <div class="ab-hero-ctas" data-reveal data-reveal-delay="5">
          <a href="/contact#quote" class="btn btn-primary-dark">Request a quote</a>
          <a href="/about/quality" class="btn btn-secondary-dark">Quality & certifications</a>
        </div>
      </div>
    </div>

    <div class="ab-scroll-cue" aria-hidden="true">
      <span class="ab-scroll-line"></span>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       VALUMINIUM — dark identity band
       ══════════════════════════════════════════════════════════ -->
  <section class="ab-ethos" data-reveal="fade">
    <div class="container ab-ethos-inner">
      <div class="ab-ethos-left">
        <div class="eyebrow on-dark">Our ethos</div>
        <div class="ab-ethos-word">Valuminium</div>
        <div class="ab-ethos-rule"></div>
      </div>
      <blockquote class="ab-ethos-quote">
        <p>
          At Banco, we live by <strong>Valuminium</strong>: a commitment to delivering genuine
          value through aluminium. It pushes each team member to think beyond the profile
          and consider the downstream impact of every decision: on cost, on lead time,
          on quality, and on the customer's end application.
        </p>
      </blockquote>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       STORY — sticky headline + editorial copy + photos
       ══════════════════════════════════════════════════════════ -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="ab-story-grid">

        <div class="ab-story-anchor" data-reveal="left">
          <div class="eyebrow">Our story</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:20px">
            Integrated.<br/>
            <em class="accent">Independent.</em><br/>
            Dependable.
          </h2>
          <div class="ab-story-rule"></div>
          <div class="ab-story-meta">
            <span>Vadodara, Gujarat</span>
            <span>·</span>
            <span>Est. 1967</span>
            <span>·</span>
            <span>Family-owned</span>
          </div>
        </div>

        <div class="ab-story-body" data-reveal="right">
          <p class="ab-story-lead">
            Banco Aluminium delivers the control of an integrated manufacturer
            with the flexibility of a customer-focused aluminium solutions partner.
          </p>
          <p class="ab-story-p">
            In an industry where most suppliers are either pure extruders or pure traders,
            Banco owns the complete production chain, from melting and billet casting
            through extrusion, heat treatment, machining, cold drawing, and surface finishing.
            This integration is not just a manufacturing advantage. It is a quality and
            responsiveness advantage.
          </p>
          <p class="ab-story-p">
            When a customer requests an alloy modification, a die correction, or a downstream
            value-add, the answer does not depend on a third party. It happens in-house,
            on our schedule, under our quality systems.
          </p>
          <p class="ab-story-p">
            With five extrusion presses ranging from 1100T to 3300T and a 55,000 MT
            foundry, Banco operates at a scale that supports both high-volume OEM supply
            and specialised low-volume development programmes.
          </p>

          <!-- 2-up editorial photos -->
          <div class="ab-story-photos">
            <figure class="ab-story-fig">
              <Pic src="/assets/manufacturing/melting-2.webp" alt="Liquid aluminium at Banco foundry, Vadodara" loading="lazy" sizes="(max-width: 1024px) 100vw, 60vw" />
              <figcaption>Melting · Foundry floor · Vadodara</figcaption>
            </figure>
            <figure class="ab-story-fig">
              <Pic src="/assets/manufacturing/homo-2.webp" alt="Controlled-atmosphere homogenising furnace" loading="lazy" sizes="(max-width: 1024px) 100vw, 60vw" />
              <figcaption>Homogenising · Controlled atmosphere furnace</figcaption>
            </figure>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       STATS STRIP — 4-cell on white
       ══════════════════════════════════════════════════════════ -->
  <section class="section-white" style="padding:0">
    <div class="stat-strip ab-stats-strip" data-reveal="fade">
      {[
        { n: 35000, s: ' MT', sep: true,  u: '',   label: 'Annual extrusion capacity' },
        { n: 55000, s: ' MT', sep: true,  u: '',   label: 'Annual foundry capacity' },
        { n: 900,   s: '+',   sep: false, u: '',   label: 'Customers worldwide' },
        { n: 58,    s: '+',   sep: false, u: 'yrs',label: 'Years of extrusion heritage' },
      ].map(({ n, s, sep, u, label }) => (
        <div class="stat-strip-cell">
          <div style="display:flex;align-items:baseline;gap:4px">
            <span class="ssn" data-countup={n} data-suffix={s} data-separator={sep ? ',' : ''}>
              {sep ? n.toLocaleString() : n}{s}
            </span>
            {u && <span class="ssu">{u}</span>}
          </div>
          <div class="ssl">{label}</div>
        </div>
      ))}
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       PROCESS CHAIN — 6-step integrated production
       ══════════════════════════════════════════════════════════ -->
  <section class="ab-process section-dark">
    <div class="container">
      <div class="ab-process-head" data-reveal="fade">
        <div>
          <div class="eyebrow on-dark">/ Integrated manufacturing</div>
          <h2 class="t-h2" style="color:var(--color-stone-50);margin-top:16px">
            Six stages.<br/><em class="accent">One address.</em>
          </h2>
        </div>
        <p class="t-lead" style="color:var(--color-stone-400);max-width:44ch;align-self:end">
          Every stage of aluminium production under one roof in Vadodara.
          Owned, operated and quality-controlled by Banco.
        </p>
      </div>

      <div class="ab-process-grid">
        {process.map((p, i) => (
          <div class="ab-process-cell" data-reveal="fade" style={`--delay:${i * 55}ms`}>
            <div class="ab-process-num">{p.n}</div>
            <div class="ab-process-title">{p.title}</div>
            <div class="ab-process-sub">{p.sub}</div>
            <div class="ab-process-rule"></div>
            <div class="ab-process-desc">{p.desc}</div>
          </div>
        ))}
      </div>

      <div style="margin-top:40px;text-align:center" data-reveal="fade">
        <a href="/capabilities/extrusion" class="btn btn-secondary-dark">
          Explore all capabilities →
        </a>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       VIDEO WINDOW — cinematic mid-page
       ══════════════════════════════════════════════════════════ -->
  <section class="ab-vwin">
    <video class="ab-vwin-vid" autoplay muted loop playsinline preload="none" poster="/herovideo-poster.jpg">
      <source src="/herovideo-720.mp4" type="video/mp4" />
    </video>
    <div class="ab-vwin-overlay"></div>
    <div class="container ab-vwin-body">
      <div class="ab-vwin-content" data-reveal="left">
        <div class="eyebrow on-dark">Live operations</div>
        <h2 class="t-h2 ab-vwin-h2">
          From liquid metal<br/>to finished profile.
        </h2>
        <p class="ab-vwin-p">
          Foundry. Extrusion. Die shop. Heat treatment.
          Machining. Surface finishing. All in Vadodara.
        </p>
        <div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:32px">
          <a href="/capabilities/foundry" class="btn btn-primary-dark">Foundry & casting</a>
          <a href="/capabilities/extrusion" class="btn btn-secondary-dark">Extrusion</a>
        </div>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       FACILITY — editorial photo grid
       ══════════════════════════════════════════════════════════ -->
  <section class="section-alt" style="padding:72px 0 80px">
    <div class="container">
      <div class="ab-fac-head" data-reveal="fade">
        <div>
          <div class="eyebrow">/ Vadodara, Gujarat · Est. 1967</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            The integrated<br/>manufacturing facility.
          </h2>
        </div>
        <p class="t-lead" style="color:var(--color-stone-700);max-width:44ch;align-self:end">
          35,000 MT annual extrusion capacity across five presses.
          55,000 MT in-house foundry. All under one roof.
        </p>
      </div>

      <!-- Editorial mosaic: 1 large + 4 supporting -->
      <div class="ab-fac-mosaic" data-reveal="fade">
        <div class="ab-fac-main">
          <Pic src="/assets/manufacturing/casting-1.webp" alt="Hot-Top billet casting at Banco foundry, Vadodara" loading="lazy" sizes="(max-width: 1024px) 100vw, 60vw" />
          <div class="ab-fac-caption">Hot-Top casting · Banco foundry · Vadodara</div>
        </div>
        {[
          ['/assets/manufacturing/melting-4.webp',  'Metal tapping during melting furnace operations'],
          ['/assets/manufacturing/casting-5.webp',  'Casting pit, a controlled cooling zone'],
          ['/assets/manufacturing/billet-1.webp',   'Press-ready finished extrusion billets'],
          ['/assets/manufacturing/quality-1.webp',  'Spectromax OES for 100% chemical analysis'],
        ].map(([src, alt]) => (
          <div class="ab-fac-thumb">
            <Pic src={src} alt={alt} loading="lazy" sizes="(max-width: 640px) 100vw, 25vw" maxW={768} />
            <div class="ab-fac-caption">{alt}</div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       TIMELINE — heritage vertical
       ══════════════════════════════════════════════════════════ -->
  <section class="section-alt section-pad" style="border-top:1px solid var(--color-stone-200)">
    <div class="container ab-timeline-wrap">
      <div class="ab-timeline-head" data-reveal="left">
        <div class="eyebrow">Heritage</div>
        <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
          58 years of<br/><em class="accent">aluminium</em> experience.
        </h2>
      </div>

      <div class="ab-timeline">
        <div class="ab-timeline-line" aria-hidden="true"></div>
        {milestones.map((m, i) => (
          <div class="ab-timeline-row" data-reveal="fade" style={`--delay:${i * 70}ms`}>
            <div class="ab-timeline-dot" aria-hidden="true"></div>
            <div class="ab-timeline-year">{m.year}</div>
            <div class="ab-timeline-event">{m.event}</div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       CLIENT LOGOS — animated marquee
       ══════════════════════════════════════════════════════════ -->
  <section class="ab-logos-section" data-reveal="fade">
    <div class="ab-logos-label">
      <span class="eyebrow">Trusted by industry leaders</span>
    </div>
    <div class="ab-logos-track-wrap" aria-label="Notable clients">
      <div class="ab-logos-track">
        {/* Duplicated for seamless loop */}
        {[...Array(2)].map(() =>
          [
            { src: '/assets/logos/reliance.svg',  alt: 'Reliance Industries',  h: 30 },
            { src: '/assets/logos/lt.svg',         alt: 'Larsen & Toubro',      h: 38 },
            { src: '/assets/logos/siemens.svg',    alt: 'Siemens',              h: 28 },
            { src: '/assets/logos/abb.svg',        alt: 'ABB',                  h: 34 },
            { src: '/assets/logos/schneider.svg',  alt: 'Schneider Electric',   h: 40 },
            { src: '/assets/logos/alstom.svg',     alt: 'Alstom',               h: 32 },
          ].map(({ src, alt, h }) => (
            <div class="ab-logo-item">
              <img src={src} alt={alt} style={`height:${h}px;width:auto`} loading="lazy" />
            </div>
          ))
        )}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       TESTIMONIALS — client voices
       ══════════════════════════════════════════════════════════ -->
  <section class="section-light" style="padding:80px 0">
    <div class="container">
      <div class="ab-testi-head" data-reveal="fade">
        <div>
          <div class="eyebrow">Client portfolio</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            Better relationships.<br/>Better solutions.
          </h2>
        </div>
        <p class="t-lead" style="color:var(--color-stone-700);max-width:44ch;align-self:end">
          900+ customers across industrial, automotive, electrical, and architectural
          sectors in India and four export regions.
        </p>
      </div>

      <div class="ab-testi-grid" data-reveal="fade">
        {testimonials.map((t, i) => (
          <div class="ab-testi-card" style={`--delay:${i * 60}ms`}>
            <div class="ab-testi-open-quote" aria-hidden="true">"</div>
            <p class="ab-testi-quote">{t.quote}</p>
            <div class="ab-testi-foot">
              <div class="ab-testi-client">{t.client}</div>
              <div class="ab-testi-loc">{t.location}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       WHY BANCO — 7 reasons, alternating hover
       ══════════════════════════════════════════════════════════ -->
  <section class="section-dark section-pad">
    <div class="container">
      <div data-reveal="left">
        <div class="eyebrow on-dark">Why customers choose Banco</div>
        <h2 class="t-h2" style="color:var(--color-stone-50);margin-top:16px;margin-bottom:56px">
          Seven reasons.<br/><em class="accent">One partner.</em>
        </h2>
      </div>

      <div class="ab-why-grid" data-reveal="fade">
        {reasons.map(([heading, desc], i) => (
          <div class="ab-why-card">
            <div class="ab-why-n">{String(i + 1).padStart(2, '0')}</div>
            <h3 class="ab-why-h">{heading}</h3>
            <p class="ab-why-d">{desc}</p>
          </div>
        ))}
      </div>

      <div class="ab-why-ctas" data-reveal="fade">
        <a href="/contact#quote" class="btn btn-primary-dark">Request a quote</a>
        <a href="/about/quality" class="btn btn-secondary-dark">Quality & certifications</a>
        <a href="/about/global-reach" class="btn btn-secondary-dark">Global reach</a>
      </div>
    </div>
  </section>

</Layout>

<!-- ═══════════════════════════════════════════════════════════ -->
<style>
  /* ── HERO ──────────────────────────────────────────────────── */
  .ab-hero {
    position: relative;
    background: var(--color-navy-deep);
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .ab-hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .ab-hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .ab-hero-scrim {
    position: absolute;
    inset: 0;
    background: rgba(6, 21, 37, 0.58);
  }
  .ab-hero-grad {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(110deg, rgba(6,21,37,0.72) 0%, rgba(6,21,37,0.18) 60%),
      linear-gradient(to bottom, transparent 55%, var(--color-navy-deep) 100%);
  }
  .ab-hero-body {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-top: 140px;
    padding-bottom: 120px;
  }
  .ab-hero-inner { max-width: 680px; }
  .ab-hero-h1 {
    color: var(--color-stone-50);
    margin-top: 20px;
  }
  .ab-hero-lede {
    color: var(--color-stone-400);
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.65;
    max-width: 52ch;
    margin-top: 24px;
  }
  .ab-hero-stats {
    display: flex;
    gap: 0;
    flex-wrap: nowrap;
    margin-top: 52px;
    padding-top: 32px;
    border-top: 1px solid rgba(255,255,255,0.10);
  }
  .ab-stat {
    padding-right: 40px;
    margin-right: 40px;
    border-right: 1px solid rgba(255,255,255,0.10);
  }
  .ab-stat:last-child { border-right: none; }
  .ab-stat-n {
    font-family: var(--font-sans);
    font-size: clamp(30px, 3.6vw, 46px);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--color-stone-50);
    line-height: 1;
  }
  .ab-stat-l {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-stone-400);
    margin-top: 8px;
  }
  .ab-hero-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 40px;
  }

  /* Scroll cue */
  .ab-scroll-cue {
    position: absolute;
    bottom: 44px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
  }
  .ab-scroll-line {
    display: block;
    width: 1px;
    height: 56px;
    background: linear-gradient(to bottom, var(--color-green), transparent);
    animation: ab-drop 2s ease-in-out infinite;
  }
  @keyframes ab-drop {
    0%   { transform: scaleY(0); transform-origin: top; opacity: 1; }
    50%  { transform: scaleY(1); transform-origin: top; }
    51%  { transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; opacity: 0; }
  }

  /* ── ETHOS ─────────────────────────────────────────────────── */
  .ab-ethos {
    background: var(--color-navy-deep);
    border-top: 2px solid var(--color-green);
    border-bottom: 1px solid var(--color-navy-line);
    padding: 52px 0;
  }
  .ab-ethos-inner {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 64px;
    align-items: center;
  }
  .ab-ethos-left .eyebrow { margin-bottom: 12px; }
  .ab-ethos-word {
    font-family: var(--font-sans);
    font-size: clamp(28px, 3vw, 40px);
