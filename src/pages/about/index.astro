---
import Layout from '../../layouts/Layout.astro';

const milestones = [
  { year: '1967', event: 'Founded in Vadodara, Gujarat' },
  { year: '1970s', event: 'First extrusion press commissioned' },
  { year: '1980s', event: 'In-house foundry and die shop established' },
  { year: '1990s', event: 'Export operations begin' },
  { year: '2000s', event: 'Capacity expansion to 5 presses; IATF 16949 certification' },
  { year: '2010s', event: 'Cold drawing, machining and surface finishing integrated' },
  { year: '2020s', event: 'CBAM certification; 960 kW solar; 35,000 MT capacity milestone' },
];

const reasons = [
  ['Complete solution provider',     'In-house product development, die design and manufacturing — end to end, under one roof.'],
  ['900+ customers served',          'Customised product development and experience of servicing 900+ clients across diverse industries.'],
  ['High-strength alloy specialist', 'In-house foundry development and supply of special high-strength and lead-free machining alloys.'],
  ['Certified to global standards',  'ISO 14001:2015, ISO 9001:2015, IATF 16949 and CE certified — quality assured at every stage.'],
  ['Value-added processing',         'Machining & fabrication facilities for assemblies, customised products, and cold drawing.'],
  ['Quickest response time',         'Extremely responsive team with short lead times and direct customer communication at all levels.'],
  ['58 years of experience',         'Established 1967 in Vadodara, Gujarat. Family-owned. Exporting to Europe, North America, APAC, and the Middle East.'],
];

const testimonials = [
  { client: 'Aavid Metalalloys', location: 'India',       quote: 'Reliable supply partner with consistent quality across hard alloy specifications.' },
  { client: 'Schneider Electric', location: 'Bangalore',  quote: 'Dependable extrusion partner for our busbar and T&D profile requirements.' },
  { client: 'Truetzschler',       location: 'India',       quote: 'Long-standing relationship built on technical competence and delivery reliability.' },
  { client: 'IMS Netherlands',    location: 'Netherlands', quote: 'Banco\'s lead-free machining alloys meet our RoHS requirements with consistent dimensional quality.' },
  { client: 'INOX India',         location: 'India',       quote: 'Strong quality systems and traceability — key for our engineering applications.' },
];
---

<Layout
  title="About Banco Aluminium — established 1967"
  description="Banco Aluminium Private Limited — integrated aluminium extrusion company established 1967 in Vadodara, Gujarat. 58+ years experience. 35,000 MT capacity. 900+ customers worldwide. ISO 9001 · IATF 16949 · CE."
>
  <!-- Hero — casting photo background with navy overlay -->
  <section class="about-hero">
    <div class="about-hero-bg" aria-hidden="true">
      <img
        src="/assets/manufacturing/Casting%209.JPG"
        alt=""
        loading="eager"
      />
    </div>
    <div class="container" style="position:relative;z-index:2">
      <div class="eyebrow on-dark">About Banco</div>
      <h1 class="t-h1" style="color:var(--color-stone-50);margin-top:20px;max-width:18ch">
        Engineering <em class="accent">aluminium</em> since 1967.
      </h1>
      <p class="t-lead" style="color:var(--color-stone-400);margin-top:24px;max-width:56ch">
        Banco Aluminium Private Limited is an integrated aluminium extrusion company
        established in Vadodara, Gujarat, India — still family-owned after 58 years.
        We own the full value chain from billet casting to finished profile, serving
        900+ customers across four export regions.
      </p>

      <!-- Key stats -->
      <div style="display:flex;gap:48px;flex-wrap:wrap;margin-top:48px;padding-top:32px;border-top:1px solid var(--color-navy-line)">
        {[
          ['58+', 'years', 'Years in extrusion'],
          ['35,000', 'MT', 'Annual extrusion capacity'],
          ['55,000', 'MT', 'Annual foundry capacity'],
          ['900+', '', 'Customers worldwide'],
        ].map(([num, unit, label]) => (
          <div>
            <div>
              <span style="font-family:var(--font-display);font-size:clamp(28px,3.5vw,44px);color:var(--color-stone-50)">{num}</span>
              {unit && <span style="font-family:var(--font-display);font-size:18px;color:var(--color-green);margin-left:4px">{unit}</span>}
            </div>
            <div style="font-family:var(--font-mono);font-size:10px;letter-spacing:0.14em;text-transform:uppercase;color:var(--color-stone-400);margin-top:6px">{label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Valuminium — narrow dark band -->
  <section style="background:var(--color-navy-deep);padding:40px 0;border-top:2px solid var(--color-green);border-bottom:1px solid var(--color-navy-line)">
    <div class="container">
      <div style="display:grid;grid-template-columns:200px 1fr;gap:48px;align-items:center">
        <div>
          <div style="font-family:var(--font-mono);font-size:9px;letter-spacing:0.2em;text-transform:uppercase;color:var(--color-nickel);margin-bottom:10px">Our ethos</div>
          <div style="font-family:var(--font-sans);font-size:32px;font-weight:800;letter-spacing:-0.03em;color:var(--color-platinum);line-height:1">Valuminium</div>
          <div style="width:32px;height:2px;background:var(--color-green);margin-top:12px"></div>
        </div>
        <div style="font-family:var(--font-sans);font-size:15px;line-height:1.7;color:var(--color-silver);max-width:68ch">
          At Banco, we live by our ethos of <strong style="color:var(--color-platinum);font-weight:600">Valuminium</strong> — a commitment to delivering
          genuine value through aluminium. It pushes each of our team members to think beyond the
          profile and consider the downstream impact of every decision: on cost, on lead time, on quality,
          and on the customer's end application. Valuminium is the standard by which we measure
          every engagement, every shipment, and every relationship.
        </div>
      </div>
    </div>
  </section>

  <!-- Company description -->
  <section class="section-light section-pad">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 1.4fr;gap:80px;align-items:start">
        <div style="position:sticky;top:120px">
          <div class="eyebrow">Our story</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            Integrated.<br/><em class="accent">Independent.</em><br/>Dependable.
          </h2>
        </div>
        <div>
          <p style="color:var(--color-stone-700);font-size:17px;line-height:1.7;margin-bottom:20px">
            Banco Aluminium delivers the control of an integrated manufacturer with the
            flexibility of a customer-focused aluminium solutions partner. In an industry
            where most suppliers are either pure extruders or pure traders, Banco owns
            the complete production chain — from melting and billet casting through
            extrusion, heat treatment, machining, cold drawing, and surface finishing.
          </p>
          <p style="color:var(--color-stone-700);font-size:16px;line-height:1.65;margin-bottom:20px">
            This integration is not just a manufacturing advantage — it is a quality and
            responsiveness advantage. When a customer requests an alloy modification, a
            die correction, or a downstream value-add, the answer does not depend on a
            third party. It happens in-house, on our schedule, under our quality systems.
          </p>
          <p style="color:var(--color-stone-700);font-size:16px;line-height:1.65">
            With five extrusion presses ranging from 1,100 MT to 3,300 MT, 35,000 MT
            of annual extrusion capacity, and a 55,000 MT foundry, Banco operates at a
            scale that supports both high-volume OEM supply and specialised low-volume
            development — making us a credible single source for industrial, architectural,
            and cast product requirements.
          </p>

          <!-- Feature photos — 2-up grid -->
          <div class="about-story-photos" style="margin-top:36px">
            <div class="about-story-photo">
              <img
                src="/assets/manufacturing/Melting%202.JPG"
                alt="Liquid aluminium — Banco foundry melting operations"
                loading="lazy"
              />
              <div class="about-sp-caption">Melting · Foundry floor · Vadodara</div>
            </div>
            <div class="about-story-photo">
              <img
                src="/assets/manufacturing/Homo%202.JPG"
                alt="Batch homogenising furnace — Banco Aluminium"
                loading="lazy"
              />
              <div class="about-sp-caption">Homogenising · Controlled atmosphere furnace</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Facility — curated 6-photo feature grid -->
  <section class="section-alt" style="padding:64px 0 72px">
    <div class="container">
      <div class="about-fac-head">
        <div>
          <div class="eyebrow">/ Vadodara, Gujarat · Est. 1967</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            The integrated<br>manufacturing facility.
          </h2>
        </div>
        <p class="t-lead" style="color:var(--color-stone-700);max-width:44ch;align-self:end">
          From liquid aluminium to finished profile — every stage under one roof.
          35,000 MT annual extrusion capacity. 55,000 MT foundry.
        </p>
      </div>
      <div class="about-fac-grid">
        <!-- Large feature photo -->
        <div class="about-fac-feature">
          <img
            src="/assets/manufacturing/Casting%201.JPG"
            alt="Cylinder-guided Hot-Top billet casting — Banco Aluminium foundry, Vadodara"
            loading="lazy"
          />
          <div class="about-fac-label">Hot-Top casting · Banco foundry</div>
        </div>
        <!-- 4 supporting photos -->
        {[
          ['/assets/manufacturing/Melting%204.JPG',  'Metal tapping — melting furnace operations'],
          ['/assets/manufacturing/Casting%205.JPG',  'Casting pit — controlled cooling zone'],
          ['/assets/manufacturing/Billet%201.JPG',   'Finished extrusion billets — ready for press'],
          ['/assets/manufacturing/Quality%201.JPG',  'Spectromax OES — 100% chemical analysis'],
        ].map(([src, alt]) => (
          <div class="about-fac-thumb">
            <img src={src} alt={alt} loading="lazy" />
            <div class="about-fac-label">{alt}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="section-alt section-pad">
    <div class="container">
      <div class="eyebrow">Heritage</div>
      <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px;margin-bottom:48px">
        58 years of <em class="accent">aluminium</em> experience.
      </h2>
      <div style="display:flex;flex-direction:column;gap:0;max-width:800px">
        {milestones.map((m) => (
          <div style="display:grid;grid-template-columns:120px 1fr;gap:24px;padding:20px 0;border-bottom:1px solid var(--color-stone-200);align-items:start">
            <div style="font-family:var(--font-mono);font-size:12px;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-green);padding-top:2px">{m.year}</div>
            <div style="font-family:var(--font-display);font-size:20px;color:var(--color-navy)">{m.event}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Better Relationships | Better Solutions -->
  <section class="section-light" style="padding:64px 0;border-top:1px solid var(--color-stone-200)">
    <div class="container">
      <div class="about-testi-head">
        <div>
          <div class="eyebrow">Client portfolio</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            Better relationships.<br>Better solutions.
          </h2>
        </div>
        <p class="t-lead" style="color:var(--color-stone-700);max-width:44ch;align-self:end">
          900+ customers across industrial, automotive, electrical, and architectural
          sectors in India and four export regions.
        </p>
      </div>
      <div class="about-testi-grid">
        {testimonials.map((t) => (
          <div class="about-testi-card">
            <p class="about-testi-quote">"{t.quote}"</p>
            <div class="about-testi-foot">
              <div class="about-testi-client">{t.client}</div>
              <div class="about-testi-loc">{t.location}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Banco -->
  <section class="section-dark section-pad">
    <div class="container">
      <div class="eyebrow on-dark">Why customers choose Banco</div>
      <h2 class="t-h2" style="color:var(--color-stone-50);margin-top:16px;margin-bottom:48px">
        Seven reasons.<br/><em class="accent">One partner.</em>
      </h2>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--color-navy-line)">
        {reasons.map(([heading, desc], i) => (
          <div style="background:var(--color-navy-soft);padding:28px 24px">
            <div style="font-family:var(--font-mono);font-size:10px;letter-spacing:0.16em;text-transform:uppercase;color:var(--color-green);margin-bottom:8px">
              {String(i + 1).padStart(2, '0')}
            </div>
            <div style="font-family:var(--font-display);font-size:20px;color:var(--color-stone-50);margin-bottom:8px">{heading}</div>
            <div style="font-size:14px;color:var(--color-stone-400);line-height:1.55">{desc}</div>
          </div>
        ))}
      </div>
      <div style="margin-top:48px;display:flex;gap:16px;flex-wrap:wrap">
        <a href="/contact#quote" class="btn btn-primary-dark">Request a quote</a>
        <a href="/about/quality" class="btn btn-secondary-dark">Quality & certifications</a>
        <a href="/about/global-reach" class="btn btn-secondary-dark">Global reach</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── Hero with photo background ────────────────────────────────────────── */
  .about-hero {
    position: relative;
    background: var(--color-navy);
    padding-top: 140px;
    padding-bottom: 80px;
    overflow: hidden;
  }
  .about-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .about-hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.14;
    filter: grayscale(60%);
  }
  .about-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(135deg, var(--color-navy) 45%, transparent 100%);
  }

  /* ── Company description — feature photos ──────────────────────────────── */
  .about-story-photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
  }
  .about-story-photo {
    overflow: hidden;
    border: 1px solid var(--color-stone-200);
  }
  .about-story-photo img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
  }
  .about-story-photo:hover img { transform: scale(1.04); }
  .about-sp-caption {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-stone-400);
    padding: 7px 10px;
    border-top: 1px solid var(--color-stone-200);
    background: var(--color-stone-50);
  }

  /* ── Facility feature grid ──────────────────────────────────────────────── */
  .about-fac-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 4vw, 80px);
    align-items: start;
    margin-bottom: 32px;
  }
  .about-fac-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 4px;
  }
  .about-fac-feature {
    grid-row: 1 / 3;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-stone-200);
  }
  .about-fac-feature img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
    min-height: 320px;
  }
  .about-fac-feature:hover img { transform: scale(1.04); }
  .about-fac-thumb {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-stone-200);
  }
  .about-fac-thumb img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
  }
  .about-fac-thumb:hover img { transform: scale(1.05); }
  .about-fac-label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-stone-400);
    padding: 7px 10px;
    border-top: 1px solid var(--color-stone-200);
    background: var(--color-stone-50);
  }

  /* Testimonials */
  .about-testi-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 4vw, 80px);
    align-items: start;
    margin-bottom: 40px;
  }
  .about-testi-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--color-stone-200);
    border: 1px solid var(--color-stone-200);
  }
  .about-testi-card {
    background: var(--color-stone-50);
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    border-top: 2px solid transparent;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .about-testi-card:hover {
    border-top-color: var(--color-green);
    background: white;
  }
  .about-testi-quote {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.7;
    color: var(--color-stone-700);
    font-style: normal;
    flex: 1;
  }
  .about-testi-foot {
    padding-top: 16px;
    border-top: 1px solid var(--color-stone-200);
  }
  .about-testi-client {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
    color: var(--color-navy);
    letter-spacing: -0.01em;
  }
  .about-testi-loc {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-stone-400);
    margin-top: 3px;
  }

  .about-gallery {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
  }
  .about-photo {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-stone-200);
    border: 1px solid var(--color-stone-200);
  }
  .about-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .about-photo:hover img { transform: scale(1.04); }

  @media (max-width: 1024px) {
    .about-testi-grid  { grid-template-columns: repeat(2, 1fr); }
    .about-testi-head  { grid-template-columns: 1fr; }
    .about-fac-head    { grid-template-columns: 1fr; }
    .about-fac-grid    { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }
    .about-fac-feature { grid-row: auto; }
    .about-fac-feature img { min-height: auto; }
    .about-story-photos { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .about-testi-grid  { grid-template-columns: 1fr; }
    .about-fac-grid    { grid-template-columns: 1fr 1fr; }
    .about-story-photos { grid-template-columns: 1fr; }
  }
</style>
