<script>
  /* Pause videos on hidden tab */
  const vids = document.querySelectorAll<HTMLVideoElement>('.ab-vwin-vid');
  document.addEventListener('visibilitychange', () => {
    vids.forEach(v => document.hidden ? v.pause() : v.play().catch(() => {}));
  });

  /* Count-up animation (fires on first intersect) */
  function easeOut(t: number) { return 1 - (1 - t) ** 3; }

  function runCount(el: HTMLElement) {
    const target = parseInt(el.dataset.countup ?? '0', 10);
    const suffix = el.dataset.suffix ?? '';
    const useSep = !!el.dataset.separator;
    const dur = 1800;
    const t0 = performance.now();
    const fmt = (n: number) => {
      const s = Math.round(n).toString();
      return useSep ? s.replace(/\B(?=(\d{3})+(?!\d))/g, ',') : s;
    };
    const tick = (now: number) => {
      const p = Math.min((now - t0) / dur, 1);
      el.textContent = fmt(easeOut(p) * target) + suffix;
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          runCount(e.target as HTMLElement);
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.4 });
    document.querySelectorAll<HTMLElement>('[data-countup]').forEach(el => io.observe(el));
  }
</script>
