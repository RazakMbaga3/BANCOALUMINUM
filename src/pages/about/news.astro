---
import Layout from '../../layouts/Layout.astro';
import Pic from '../../components/Pic.astro';
import { DOCS } from '../../lib/documents';

const mag = DOCS.industrialReview;

// Section headings from the feature itself, in running order
const inside = [
  'From extrusion to engineering: moving up the value chain',
  'Where metallurgy meets microns',
  'Complex profiles are a die-design problem first',
  'Extrude, draw, machine: one dimensional chain',
  'Automotive & EV: lightweighting with repeatability',
  'Rail, electrical & renewable energy: performance over length',
  'Lower-carbon aluminium manufacturing',
];
---

<Layout
  title="News & Insights: Banco Aluminium"
  description="Press coverage and company news from Banco Aluminium, including the Banco cover story in The Industrial Review, August 2026."
  image={mag.cover}
  heroImage="/assets/downloads/industrial-review-news-hero.jpg"
>

  <section class="nw-hero photo-hero">
    <div class="nw-hero-media photo-hero-media" aria-hidden="true">
      <Pic src="/assets/downloads/industrial-review-news-hero.jpg" alt="" loading="eager" fetchpriority="high" class="nw-hero-img" sizes="100vw" focusMobile="50% 30%" />
      <div class="nw-hero-scrim photo-hero-scrim"></div>
      <div class="nw-hero-grad photo-hero-grad"></div>
    </div>
    <div class="container nw-hero-body photo-hero-body">
      <div class="eyebrow on-dark">About Banco / News &amp; Insights</div>
      <h1 class="nw-h1">News<br/>&amp; Insights.</h1>
      <p class="nw-lead">
        Company announcements, press coverage and articles from Banco Aluminium.
      </p>
    </div>
  </section>

  <!-- ── Featured: The Industrial Review cover story ─────────────────── -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="eyebrow">In the press · August 2026</div>

      <article class="nw-feature">
        <a href={mag.view} target="_blank" rel="noopener" class="nw-cover" aria-label="Read The Industrial Review feature">
          <Pic src={mag.cover} alt="The Industrial Review, August 2026 issue, with Banco Aluminium on the cover" loading="eager" sizes="(max-width: 900px) 80vw, 34vw" maxW={1200} />
        </a>

        <div class="nw-feature-body">
          <div class="nw-source">The Industrial Review · India 2026 Edition · Issue 09</div>
          <h2 class="nw-feature-h">
            From extrusion to engineering: how Banco Aluminium is moving up the value chain.
          </h2>
          <p class="nw-feature-p">
            Banco is the cover story of The Industrial Review's August 2026 issue,
            recognised for <strong>Excellence in Aluminium Extrusion &amp; Engineered
            Aluminium Solutions, India 2026</strong>. The feature traces nearly six
            decades from conventional extruder to integrated aluminium engineering
            company: billet casting and alloy control, in-house die design, five
            extrusion presses, cold drawing, precision machining and finishing, and
            the new press line planned for 2027, which takes extrusion capacity to about 43,500 tonnes a year.
          </p>
          <p class="nw-feature-p">
            It features Banco's leadership: Anil Kumar (CTO), Vijay Shethiya (CFO),
            SK Singh (Head of Foundry Operations) and Kapil Aggarwal (CMO).
          </p>

          <div class="nw-inside-label">Inside the feature</div>
          <ul class="nw-inside">
            {inside.map((h) => <li>{h}</li>)}
          </ul>

          <div class="nw-actions">
            <a href={mag.view} target="_blank" rel="noopener" class="btn btn-primary">Read the feature</a>
            <a href={mag.download} rel="noopener" class="btn btn-secondary">Download PDF</a>
          </div>
          <div class="nw-meta">{mag.meta}</div>
        </div>
      </article>
    </div>
  </section>

  <!-- ── Secondary articles grid ─────────────────────────────────────── -->
  <section class="section-alt section-pad" style="border-top:1px solid var(--color-stone-200)">
    <div class="container">
      <div class="eyebrow">In the press · More coverage</div>
      <div class="nw-articles-grid">

        <article class="nw-article-card">
          <div class="nw-article-source">Industry Outlook · December 2021</div>
          <h3 class="nw-article-h">Banco Aluminium: The Aluminium Extrusion &amp; Alloying Specialist</h3>
          <p class="nw-article-p">
            A company profile by Director Kush Patel, published in Industry Outlook's special Vadodara
            manufacturers issue. The article covers Banco's 54 years of extrusion expertise, in-house
            foundry capabilities for complex and lead-free alloys, SCADA-monitored process control,
            fabrication services, and expansion plans including a Rs. 110 crore investment in foundry
            and extrusion capacity. Markets covered span electrical T&amp;D, automotive, solar,
            aerospace, rail, and general engineering.
          </p>
          <a
            href="https://www.theindustryoutlook.com/states-and-cities/vendor/banco-aluminium-the-aluminium-extrusion-alloying-specialist-cid-2729.html"
            class="nw-article-link"
            target="_blank"
            rel="noopener"
          >
            Read the profile
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 10L10 2M10 2H4M10 2v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </article>

        <article class="nw-article-card nw-article-card--photo">
          <a href="https://www.instagram.com/p/DNSQdp7J-rA/" target="_blank" rel="noopener" class="nw-article-photo" aria-label="View the Green Model School Initiative post on Instagram">
            <Pic src="/assets/about/csr-green-school-initiative.jpg" alt="Banco Aluminium and United Way Baroda team at the Green Model School Initiative inauguration, Laxmipura Primary School, Padra" loading="lazy" sizes="(max-width: 900px) 100vw, 33vw" />
          </a>
          <div class="nw-article-source">United Way Baroda · Instagram · 12 August 2025</div>
          <h3 class="nw-article-h">Green Model School Initiative, Laxmipura Primary School</h3>
          <p class="nw-article-p">
            In collaboration with CSR partner Banco Aluminium Pvt. Ltd., United Way Baroda
            inaugurated the Green Model School Initiative at Laxmipura Primary School, Padra,
            transforming the campus with solar power, renovated classrooms with murals, clean
            drinking water facilities, a kitchen garden, paver-block pathways, and new classroom
            benches.
          </p>
          <a
            href="https://www.instagram.com/p/DNSQdp7J-rA/"
            class="nw-article-link"
            target="_blank"
            rel="noopener"
          >
            View on Instagram
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 10L10 2M10 2H4M10 2v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </article>

      </div>
    </div>
  </section>

</Layout>

<style>
  .nw-hero {
    position: relative;
    background: var(--color-navy-deep);
    padding: 148px 0 72px;
    overflow: hidden;
  }
  .nw-hero-media { position: absolute; inset: 0; z-index: 0; }
  :global(.nw-hero-img) {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: center 55%;
  }
  .nw-hero-scrim { position: absolute; inset: 0; background: rgba(6,21,37,0.62); }
  .nw-hero-grad {
    position: absolute; inset: 0;
    background: linear-gradient(105deg, rgba(6,21,37,0.75) 0%, rgba(6,21,37,0.25) 60%, rgba(6,21,37,0.05) 100%);
  }
  .nw-hero-body { position: relative; z-index: 1; }
  .nw-h1 {
    font-family: var(--font-sans);
    font-size: clamp(36px, 5vw, 60px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.98;
    color: var(--color-platinum);
    margin-top: 20px;
  }
  .nw-lead {
    font-family: var(--font-sans);
    font-size: clamp(15px, 1.4vw, 17px);
    line-height: 1.65;
    color: var(--color-silver);
    margin-top: 24px;
    max-width: 56ch;
  }

  /* ── Featured article ───────────────────────────────────────────── */
  .nw-feature {
    display: grid;
    grid-template-columns: minmax(240px, 0.8fr) 1.4fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
    margin-top: 28px;
    padding-top: 32px;
    border-top: 1px solid var(--color-stone-200);
  }
  .nw-cover {
    display: block;
    border: 1px solid var(--color-stone-200);
    background: #fff;
    overflow: hidden;
    aspect-ratio: 1276 / 1790;
  }
  .nw-cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .nw-cover:hover :global(img) { transform: scale(1.02); }
  .nw-source {
    font-family: var(--font-mono);
    font-size: max(10px, var(--fs-min, 0px));
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-green);
  }
  .nw-feature-h {
    font-family: var(--font-sans);
    font-size: clamp(22px, 2.4vw, 32px);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--color-navy);
    margin-top: 14px;
  }
  .nw-feature-p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-stone-700);
    margin-top: 18px;
    max-width: 62ch;
  }
  .nw-feature-p strong { color: var(--color-navy); font-weight: 600; }
  .nw-inside-label {
    font-family: var(--font-mono);
    font-size: max(10px, var(--fs-min, 0px));
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-stone-700);
    margin-top: 28px;
  }
  .nw-inside {
    list-style: none;
    margin-top: 10px;
    border-top: 1px solid var(--color-stone-200);
  }
  .nw-inside li {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--color-navy);
    padding: 9px 0 9px 16px;
    border-bottom: 1px solid var(--color-stone-200);
    position: relative;
  }
  .nw-inside li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 17px;
    width: 6px;
    height: 1px;
    background: var(--color-green);
  }
  .nw-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 28px;
  }
  .nw-meta {
    font-family: var(--font-mono);
    font-size: max(10px, var(--fs-min, 0px));
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-stone-700);
    margin-top: 12px;
  }

  /* ── More to come ───────────────────────────────────────────────── */
  .nw-more {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 32px;
    align-items: center;
  }
  .nw-spread {
    display: block;
    border: 1px solid var(--color-stone-200);
    overflow: hidden;
    aspect-ratio: 1276 / 1790;
  }
  .nw-spread :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .nw-more-p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-stone-700);
    margin-top: 10px;
    max-width: 52ch;
  }

  /* ── Secondary articles grid ────────────────────────────────────── */
  .nw-articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
    margin-top: 28px;
    padding-top: 32px;
    border-top: 1px solid var(--color-stone-200);
  }
  .nw-article-card {
    border: 1px solid var(--color-stone-200);
    border-top: 2px solid var(--color-green);
    background: #fff;
    padding: 24px 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .nw-article-card--photo { padding-top: 0; overflow: hidden; }
  .nw-article-photo {
    display: block;
    margin: 0 -24px 4px;
    aspect-ratio: 775 / 655;
    overflow: hidden;
  }
  .nw-article-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .nw-article-photo:hover :global(img) { transform: scale(1.03); }
  .nw-article-source {
    font-family: var(--font-mono);
    font-size: max(10px, var(--fs-min, 0px));
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-green);
  }
  .nw-article-h {
    font-family: var(--font-sans);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--color-navy);
  }
  .nw-article-p {
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--color-stone-700);
    flex: 1;
  }
  .nw-article-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: max(10px, var(--fs-min, 0px));
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-navy);
    text-decoration: none;
    margin-top: 6px;
    transition: color 0.2s ease;
  }
  .nw-article-link:hover { color: var(--color-green); }

  @media (max-width: 900px) {
    .nw-feature { grid-template-columns: minmax(0, 1fr); }
    .nw-cover { max-width: 320px; }
    .nw-more { grid-template-columns: 120px 1fr; gap: 20px; }
    .nw-articles-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
