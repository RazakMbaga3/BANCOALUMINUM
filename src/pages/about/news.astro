---
import Layout from '../../layouts/Layout.astro';
import Pic from '../../components/Pic.astro';
import { DOCS } from '../../lib/documents';

const mag = DOCS.industrialReview;

// Section headings from the feature itself, in running order
const inside = [
  'From extrusion to engineering: moving up the value chain',
  'Where metallurgy meets microns',
  'Complex profiles are a die-design problem first',
  'Extrude, draw, machine: one dimensional chain',
  'Automotive & EV: lightweighting with repeatability',
  'Rail, electrical & renewable energy: performance over length',
  'Lower-carbon aluminium manufacturing',
];
---

<Layout
  title="News & Insights: Banco Aluminium"
  description="Press coverage and company news from Banco Aluminium, including the Banco cover story in The Industrial Review, August 2026."
  image={mag.cover}
  heroImage="/assets/downloads/industrial-review-news-hero.jpg"
>

  <section class="nw-hero photo-hero">
    <div class="nw-hero-media photo-hero-media" aria-hidden="true">
      <Pic src="/assets/downloads/industrial-review-news-hero.jpg" alt="" loading="eager" fetchpriority="high" class="nw-hero-img" sizes="100vw" focusMobile="50% 30%" />
      <div class="nw-hero-scrim photo-hero-scrim"></div>
      <div class="nw-hero-grad photo-hero-grad"></div>
    </div>
    <div class="container nw-hero-body photo-hero-body">
      <div class="eyebrow on-dark">About Banco / News &amp; Insights</div>
      <h1 class="nw-h1">News<br/>&amp; Insights.</h1>
      <p class="nw-lead">
        Company announcements, press coverage and articles from Banco Aluminium.
      </p>
    </div>
  </section>

  <!-- ── Featured: The Industrial Review cover story ─────────────────── -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="eyebrow">In the press · August 2026</div>

      <article class="nw-feature">
        <a href={mag.view} target="_blank" rel="noopener" class="nw-cover" aria-label="Read The Industrial Review feature">
          <Pic src={mag.cover} alt="The Industrial Review, August 2026 issue, with Banco Aluminium on the cover" loading="eager" sizes="(max-width: 900px) 80vw, 34vw" maxW={1200} />
        </a>

        <div class="nw-feature-body">
          <div class="nw-source">The Industrial Review · India 2026 Edition · Issue 09</div>
          <h2 class="nw-feature-h">
            From extrusion to engineering: how Banco Aluminium is moving up the value chain.
          </h2>
          <p class="nw-feature-p">
            Banco is the cover story of The Industrial Review's August 2026 issue,
            recognised for <strong>Excellence in Aluminium Extrusion &amp; Engineered
            Aluminium Solutions, India 2026</strong>. The feature traces nearly six
            decades from conventional extruder to integrated aluminium engineering
            company: billet casting and alloy control, in-house die design, five
            extrusion presses, cold drawing, precision machining and finishing, and
            the new press line planned for 2027, which takes extrusion capacity to about 43,500 tonnes a year.
          </p>
          <p class="nw-feature-p">
            It features Banco's leadership: Anil Kumar (CTO), Vijay Shethiya (CFO),
            SK Singh (Head of Foundry Operations) and Kapil Aggarwal (CMO).
          </p>

          <div class="nw-inside-label">Inside the feature</div>
          <ul class="nw-inside">
            {inside.map((h) => <li>{h}</li>)}
          </ul>

          <div class="nw-actions">
            <a href={mag.view} target="_blank" rel="noopener" class="btn btn-primary">Read the feature</a>
            <a href={mag.download} rel="noopener" class="btn btn-secondary">Download PDF</a>
          </div>
          <div class="nw-meta">{mag.meta}</div>
        </div>
      </article>
    </div>
  </section>

  <!-- ── Secondary articles grid ─────────────────────────────────────── -->
  <section class="section-alt section-pad" style="border-top:1px solid var(--color-stone-200)">
    <div class="container">
      <div class="eyebrow">In the press · More coverage</div>
      <div class="nw-articles-grid">

        <article class="nw-article-card nw-article-card--photo">
          <div class="nw-article-photo">
            <Pic src="/assets/about/powerline-cover.jpg" alt="PowerLine magazine, Volume 31 No. 1, September 2026 cover" loading="lazy" sizes="(max-width: 900px) 100vw, 33vw" />
          </div>
          <div class="nw-article-body">
            <div class="nw-article-source">PowerLine · Volume 31, No. 1 · September 2026</div>
            <h3 class="nw-article-h">Extrusions Designed for Modern Power Infrastructure</h3>
            <p class="nw-article-p">
              Banco Aluminium features in PowerLine — India's first power magazine — highlighting
              58+ years of experience, 35,000 MT/year capacity, and products supplied to ABB,
              Schneider Electric, Siemens and CG across global markets.
            </p>
            <a href="https://drive.google.com/file/d/1xt4sTVHnJFadgFPIu6wZy00PL4xBgNzU/view?usp=sharing" class="nw-article-link" target="_blank" rel="noopener">
              View the issue
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 10L10 2M10 2H4M10 2v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </article>

        <article class="nw-article-card nw-article-card--photo">
          <a href="#" class="nw-article-photo" aria-label="Free Medical Camp, Channi Canal Road Community">
            <img src="/assets/about/news-thumb-1.jpg" alt="Free Medical Camp, Channi Canal Road Community" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;" />
          </a>
          <div class="nw-article-source">CSR Initiative · 2025</div>
          <h3 class="nw-article-h">Free Medical Camp, Channi Canal Road Community</h3>
          <p class="nw-article-p">
            Banco Aluminium organised a free medical camp for the Channi Canal Road community,
            providing health check-ups and medical support to residents in the area.
          </p>
        </article>

        <article class="nw-article-card nw-article-card--photo">
          <a href="#" class="nw-article-photo" aria-label="Community Development Program, Laxmipura Village">
            <img src="/assets/about/news-thumb-2.jpg" alt="Community Development Program, Laxmipura Village" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;" />
          </a>
          <div class="nw-article-source">CSR Initiative · 2025</div>
          <h3 class="nw-article-h">Community Development Program, Laxmipura Village</h3>
          <p class="nw-article-p">
            Banco Aluminium supported community development in Laxmipura Village, contributing
            to infrastructure and welfare programs for local residents.
          </p>
        </article>

        <article class="nw-article-card nw-article-card--photo">
          <a href="https://www.instagram.com/p/DNSQdp7J-rA/" target="_blank" rel="noopener" class="nw-article-photo" aria-label="View the Green Model School Initiative post on Instagram">
            <Pic src="/assets/about/csr-green-school-initiative.jpg" alt="Banco Aluminium and United Way Baroda team at the Green Model School Initiative inauguration, Laxmipura Primary School, Padra" loading="lazy" sizes="(max-width: 900px) 100vw, 33vw" />
          </a>
          <div class="nw-article-body">
            <div class="nw-article-source">United Way Baroda · Instagram · 12 August 2025</div>
            <h3 class="nw-article-h">Green Model School Initiative, Laxmipura Primary School</h3>
            <p class="nw-article-p">
              In collaboration with CSR partner Banco Aluminium, United Way Baroda inaugurated the
              Green Model School Initiative at Laxmipura Primary School, Padra — solar power,
              renovated classrooms, clean drinking water, and new classroom benches.
            </p>
            <a href="https://www.instagram.com/p/DNSQdp7J-rA/" class="nw-article-link" target="_blank" rel="noopener">
              View on Instagram
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 10L10 2M10 2H4M10 2v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </article>

        <article class="nw-article-card nw-article-card--photo">
          <a href="https://www.theindustryoutlook.com/states-and-cities/vendor/banco-aluminium-the-aluminium-extrusion-alloying-specialist-cid-2729.html" target="_blank" rel="noopener" class="nw-article-photo" aria-label="Read the Industry Outlook profile">
            <Pic src="/assets/about/kush-patel.jpg" alt="Kush Patel, Director, Banco Aluminium" loading="lazy" sizes="(max-width: 900px) 100vw, 33vw" />
          </a>
          <div class="nw-article-body">
            <div class="nw-article-source">Industry Outlook · December 2021</div>
            <h3 class="nw-article-h">Banco Aluminium: The Aluminium Extrusion &amp; Alloying Specialist</h3>
            <p class="nw-article-p">
              A company profile by Director Kush Patel covering Banco's 54 years of extrusion expertise,
              in-house foundry capabilities, SCADA-monitored process control, and a Rs. 110 crore
              investment in foundry and extrusion capacity.
            </p>
            <a href="https://www.theindustryoutlook.com/states-and-cities/vendor/banco-aluminium-the-aluminium-extrusion-alloying-specialist-cid-2729.html" class="nw-article-link" target="_blank" rel="noopener">
              Read the profile
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 10L10 2M10 2H4M10 2v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </article>

        <article class="nw-article-card nw-article-card--photo">
          <a href="https://www.facebook.com/reel/1590346415573546" target="_blank" rel="noopener" class="nw-article-photo nw-article-photo--wide" aria-label="Watch the Medical Camp reel on Facebook">
            <Pic src="/assets/about/csr-medical-camp.jpg" alt="Free Medical Camp banner — Banco Aluminium and United Way Baroda, Channi Canal Road" loading="lazy" sizes="(max-width: 900px) 100vw, 33vw" />
          </a>
          <div class="nw-article-body">
            <div class="nw-article-source">United Way Baroda · Facebook · CSR</div>
            <h3 class="nw-article-h">Free Medical Camp, Channi Canal Road Community</h3>
            <p class="nw-article-p">
              Banco Aluminium and United Way Baroda organised a free medical camp for the Channi Canal
              Road community, providing services from physicians, dentists, paediatricians and
              ophthalmologists — bringing essential healthcare to underserved families.
            </p>
            <a href="https://www.facebook.com/reel/1590346415573546" class="nw-article-link" target="_blank" rel="noopener">
              Watch on Facebook
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 10L10 2M10 2H4M10 2v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </article>

        <article class="nw-article-card nw-article-card--photo">
          <a href="https://www.facebook.com/watch/?v=742249553853900" target="_blank" rel="noopener" class="nw-article-photo nw-article-photo--wide" aria-label="Watch the Anganwadi inauguration on Facebook">
            <Pic src="/assets/about/csr-community-development.jpg" alt="Community Development Program banner — Banco Aluminium and United Way of Baroda, Laxmipura Padra 2022–23" loading="lazy" sizes="(max-width: 900px) 100vw, 33vw" />
          </a>
          <div class="nw-article-body">
            <div class="nw-article-source">United Way Baroda · Facebook · CSR · 2022–23</div>
            <h3 class="nw-article-h">Community Development Program, Laxmipura Village</h3>
            <p class="nw-article-p">
              Banco Aluminium, in partnership with United Way of Baroda, inaugurated an upgraded
              Anganwadi centre at Laxmipura, Padra — featuring a "Happy Tap" handwashing facility
              and educational murals to promote early childhood development. The broader programme
              spans Anganwadi development, skill development, health camps and school safety.
            </p>
            <a href="https://www.facebook.com/watch/?v=742249553853900" class="nw-article-link" target="_blank" rel="noopener">
              Watch on Facebook
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 10L10 2M10 2H4M10 2v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </article>

        <article class="nw-article-card nw-article-card--photo">
          <a href="https://www.facebook.com/UnitedWayBaroda/posts/driving-compassion-forward-with-every-meal-delivered-a-partnership-dedicated-to-/832320968925870/" target="_blank" rel="noopener" class="nw-article-photo nw-article-photo--wide" aria-label="Read the Akshay Patra van donation post on Facebook">
            <Pic src="/assets/about/csr-akshay-patra.jpg" alt="Banco Aluminium × United Way of Baroda Vehicle Flag-Off Ceremony banner — Akshay Patra van donation" loading="lazy" sizes="(max-width: 900px) 100vw, 33vw" />
          </a>
          <div class="nw-article-body">
            <div class="nw-article-source">United Way Baroda · Facebook · CSR</div>
            <h3 class="nw-article-h">Driving Compassion Forward: Akshay Patra Van Donation</h3>
            <p class="nw-article-p">
              Banco Aluminium donated a customised food-delivery van to Akshay Patra through implementing
              partner United Way of Baroda, ensuring hot, nutritious meals reach underprivileged students
              daily. The Vehicle Flag-Off Ceremony was graced by Mrs. Pritty Patel (Chairperson, Banco
              Aluminium), Mrs. Nilam Acharya (Executive Director, UWB) and Nikul Davda (Programme Lead, UWB).
            </p>
            <a href="https://www.facebook.com/UnitedWayBaroda/posts/driving-compassion-forward-with-every-meal-delivered-a-partnership-dedicated-to-/832320968925870/" class="nw-article-link" target="_blank" rel="noopener">
              Read on Facebook
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 10L10 2M10 2H4M10 2v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </article>

      </div>
    </div>
  </section>

</Layout>

<style>
  .nw-hero {
    position: relative;
    background: var(--color-navy-deep);
    padding: 148px 0 72px;
    overflow: hidden;
  }
  .nw-hero-media { position: absolute; inset: 0; z-index: 0; }
  :global(.nw-hero-img) {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: center 55%;
  }
  .nw-hero-scrim { position: absolute; inset: 0; background: rgba(6,21,37,0.62); }
  .nw-hero-grad {
    position: absolute; inset: 0;
    background: linear-gradient(105deg, rgba(6,21,37,0.75) 0%, rgba(6,21,37,0.25) 60%, rgba(6,21,37,0.05) 100%);
  }
  .nw-hero-body { position: relative; z-index: 1; }
  .nw-h1 {
    font-family: var(--font-sans);
    font-size: clamp(36px, 5vw, 60px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.98;
    color: var(--color-platinum);
    margin-top: 20px;
  }
  .nw-lead {
    font-family: var(--font-sans);
    font-size: clamp(15px, 1.4vw, 17px);
    line-height: 1.65;
    color: var(--color-silver);
    margin-top: 24px;
    max-width: 56ch;
  }

  /* ── Featured article ───────────────────────────────────────────── */
  .nw-feature {
    display: grid;
    grid-template-columns: minmax(240px, 0.8fr) 1.4fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
    margin-top: 28px;
    padding-top: 32px;
    border-top: 1px solid var(--color-stone-200);
  }
  .nw-cover {
    display: block;
    border: 1px solid var(--color-stone-200);
    background: #fff;
    overflow: hidden;
    aspect-ratio: 1276 / 1790;
  }
  .nw-cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .nw-cover:hover :global(img) { transform: scale(1.02); }
  .nw-source {
    font-family: var(--font-mono);
    font-size: max(10px, var(--fs-min, 0px));
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-green);
  }
  .nw-feature-h {
    font-family: var(--font-sans);
    font-size: clamp(22px, 2.4vw, 32px);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--color-navy);
    margin-top: 14px;
  }
  .nw-feature-p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-stone-700);
    margin-top: 18px;
    max-width: 62ch;
  }
  .nw-feature-p strong { color: var(--color-navy); font-weight: 600; }
  .nw-inside-label {
    font-family: var(--font-mono);
    font-size: max(10px, var(--fs-min, 0px));
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-stone-700);
    margin-top: 28px;
  }
  .nw-inside {
    list-style: none;
    margin-top: 10px;
    border-top: 1px solid var(--color-stone-200);
  }
  .nw-inside li {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--color-navy);
    padding: 9px 0 9px 16px;
    border-bottom: 1px solid var(--color-stone-200);
    position: relative;
  }
  .nw-inside li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 17px;
    width: 6px;
    height: 1px;
    background: var(--color-green);
  }
  .nw-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 28px;
  }
  .nw-meta {
    font-family: var(--font-mono);
    font-size: max(10px, var(--fs-min, 0px));
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-stone-700);
    margin-top: 12px;
  }

  /* ── More to come ───────────────────────────────────────────────── */
  .nw-more {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 32px;
    align-items: center;
  }
  .nw-spread {
    display: block;
    border: 1px solid var(--color-stone-200);
    overflow: hidden;
    aspect-ratio: 1276 / 1790;
  }
  .nw-spread :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .nw-more-p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-stone-700);
    margin-top: 10px;
    max-width: 52ch;
  }

  /* ── Secondary articles grid ────────────────────────────────────── */
  .nw-articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 28px;
    padding-top: 32px;
    border-top: 1px solid var(--color-stone-200);
    align-items: stretch;
  }
  .nw-article-card {
    border: 1px solid var(--color-stone-200);
    border-top: 2px solid var(--color-green);
    background: #fff;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .nw-article-card--photo { padding-top: 0; }
  .nw-article-photo {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    flex-shrink: 0;
  }
  .nw-article-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.5s ease;
  }
  .nw-article-photo:hover :global(img) { transform: scale(1.03); }
  .nw-article-photo--wide { aspect-ratio: 16 / 7; }
  .nw-article-body {
    padding: 20px 22px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }
  .nw-article-source {
    font-family: var(--font-mono);
    font-size: max(10px, var(--fs-min, 0px));
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-green);
  }
  .nw-article-h {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--color-navy);
  }
  .nw-article-p {
    font-size: 13px;
    line-height: 1.65;
    color: var(--color-stone-700);
    flex: 1;
  }
  .nw-article-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: max(10px, var(--fs-min, 0px));
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-navy);
    text-decoration: none;
    margin-top: 4px;
    transition: color 0.2s ease;
  }
  .nw-article-link:hover { color: var(--color-green); }

  @media (max-width: 900px) {
    .nw-feature { grid-template-columns: minmax(0, 1fr); }
    .nw-cover { max-width: 320px; }
    .nw-more { grid-template-columns: 120px 1fr; gap: 20px; }
    .nw-articles-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
