---
import Layout from '../../layouts/Layout.astro';

const certs = [
  { code: 'ISO 9001:2015', title: 'Quality Management System', desc: 'End-to-end quality management from billet casting to finished profile. Stage-wise inspection, MES-ERP integration, SCADA traceability.' },
  { code: 'ISO 14001:2015', title: 'Environmental Management System', desc: 'Systematic management of environmental impact. CBAM-certified carbon footprint of 0.763 kg CO₂e / kg aluminium.' },
  { code: 'ISO 45001:2018', title: 'Occupational Health & Safety', desc: 'Certified occupational health and safety management across all manufacturing operations.' },
  { code: 'IATF 16949:2016', title: 'Automotive Quality Systems', desc: 'Automotive-grade quality system. Supports supply to Tier 1 and Tier 2 automotive OEMs.' },
  { code: 'CE Certification', title: 'European Conformity', desc: 'CE marking for aluminium profiles supplied to European markets, confirming compliance with applicable EU directives.' },
  { code: 'IRS Works Approval', title: 'Indian Register of Shipping', desc: 'Approved manufacturer of aluminium profiles for shipbuilding and marine applications.' },
  { code: 'BIS IS 733', title: 'Wrought Aluminium — Bars, Rods', desc: 'Bureau of Indian Standards approval for wrought aluminium and aluminium alloy bars, rods and sections.' },
  { code: 'BIS IS 1285', title: 'Wrought Aluminium — Extruded Sections', desc: 'BIS approval for wrought aluminium and aluminium alloy extruded round tubes and hollow sections.' },
  { code: 'BIS IS 5082', title: 'Wrought Aluminium — Electrical', desc: 'BIS approval for wrought aluminium and aluminium alloy strips for electrical purposes.' },
];

const qcTools = [
  ['ASCONA optical measurement', 'Automated optical measurement system for dimensional inspection of complex profiles.'],
  ['Spectro-OES analysis', 'Optical emission spectrometry for chemical composition verification of every melt.'],
  ['SCADA online monitoring', 'Real-time process monitoring from foundry through extrusion. Billet marking by alloy and cast number.'],
  ['CMM inspection', 'Coordinate measuring machine for die verification and sample approval.'],
  ['MES-ERP integration', 'Manufacturing execution system integrated with ERP for full order traceability.'],
  ['Ultrasonic testing', 'Billet and profile ultrasonic inspection for internal defects.'],
  ['Mechanical property testing', 'Tensile strength, hardness and flaring tests to national and customer standards.'],
  ['Stage-wise quality gates', 'Quality hold points at every step: billet casting, extrusion, heat treatment, machining, packing.'],
];
---

<Layout
  title="Quality & certifications — Banco Aluminium"
  description="ISO 9001, ISO 14001, ISO 45001, IATF 16949, CE, IRS Works Approval, BIS certifications. SCADA traceability, Spectro-OES, ASCONA optical measurement, CMM inspection."
>
  <section style="background:var(--color-navy);padding-top:140px;padding-bottom:80px">
    <div class="container">
      <div class="eyebrow on-dark">Quality & certifications</div>
      <h1 class="t-h1" style="color:var(--color-stone-50);margin-top:20px;max-width:18ch">
        Certified quality.<br/><em class="accent">Traceable</em> output.
      </h1>
      <p class="t-lead" style="color:var(--color-stone-400);margin-top:24px;max-width:56ch">
        Nine certifications across quality, environmental, safety, automotive, marine, and
        national standards. SCADA traceability from billet to dispatch. Controlled process.
        Consistent performance.
      </p>
    </div>
  </section>

  <!-- Certifications grid -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="eyebrow">Certifications</div>
      <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px;margin-bottom:48px">
        Nine standards.<br/><em class="accent">One supplier.</em>
      </h2>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--color-stone-200)">
        {certs.map((c) => (
          <div style="background:var(--color-stone-50);padding:32px 24px">
            <div style="font-family:var(--font-mono);font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:var(--color-green);margin-bottom:8px">{c.code}</div>
            <div style="font-family:var(--font-display);font-size:20px;color:var(--color-navy);margin-bottom:12px">{c.title}</div>
            <p style="font-size:13px;color:var(--color-stone-700);line-height:1.6">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- QC tools -->
  <section class="section-dark section-pad">
    <div class="container">
      <div class="eyebrow on-dark">Quality systems</div>
      <h2 class="t-h2" style="color:var(--color-stone-50);margin-top:16px;margin-bottom:48px">
        Measurement at<br/><em class="accent">every step.</em>
      </h2>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border:1px solid var(--color-navy-line)">
        {qcTools.map(([name, desc]) => (
          <div style="padding:24px;border-bottom:1px solid var(--color-navy-line);border-right:1px solid var(--color-navy-line)">
            <div style="font-family:var(--font-mono);font-size:10.5px;letter-spacing:0.14em;text-transform:uppercase;color:var(--color-green);margin-bottom:6px">{name}</div>
            <div style="font-size:14px;color:var(--color-stone-400);line-height:1.55">{desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
