---
import Pic from '../../components/Pic.astro';
import Layout from '../../layouts/Layout.astro';

const whyPoints = [
  { title: 'Engineering Around the Requirement', desc: 'We start with the customer requirement and work towards the right alloy, profile and manufacturing route.' },
  { title: 'Metallurgy & Profile Development',   desc: 'Our foundry and in-house die capabilities support specialised alloys and the development of complex profile geometries.' },
  { title: 'Beyond Extrusion',                   desc: 'Cold drawing, CNC machining and fabrication extend the process beyond the extruded profile, helping deliver finished components.' },
  { title: 'One Connected Manufacturing Partner', desc: 'Connected capabilities from alloy and profile development through extrusion and downstream processing help keep the complete manufacturing route aligned.' },
  { title: 'Built for Repeat Production',        desc: 'Process control, quality systems and traceability support consistent production from development through repeat supply.' },
];
---

<Layout
  title="Why Banco: Banco Aluminium"
  description="More than an extrusion supplier: Banco connects metallurgy, extrusion and value-added processing around your requirement, from profile development to finished components."
  transparentNav={true}
  heroImage="/assets/capabilities/cold-drawing-hero.jpg"
>

  <!-- ══════════════════════════════════════════
       HERO — photo background
       ══════════════════════════════════════════ -->
  <section class="wb-hero photo-hero">
    <div class="wb-hero-media photo-hero-media" aria-hidden="true">
      <Pic src="/assets/capabilities/cold-drawing-hero.jpg" alt="" loading="eager" fetchpriority="high" class="wb-hero-vid" sizes="100vw" focusMobile="44% 6%" />
      <div class="wb-hero-scrim photo-hero-scrim"></div>
      <div class="wb-hero-grad photo-hero-grad"></div>
    </div>

    <div class="container wb-hero-body photo-hero-body">
      <div class="wb-hero-inner">
        <div class="eyebrow on-dark" data-reveal="fade" data-reveal-delay="1">
          Why Banco
        </div>
        <h1 class="t-h1 wb-hero-h1" data-reveal data-reveal-delay="2">
          More than an<br/><em class="accent">extrusion supplier.</em>
        </h1>
        <p class="wb-hero-lede" data-reveal data-reveal-delay="3">
          We connect metallurgy, extrusion and value-added processing around your
          requirement, from profile development to finished components.
        </p>
      </div>
    </div>

    <div class="wb-scroll-cue" aria-hidden="true">
      <span class="wb-scroll-line"></span>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       WHY CHOOSE BANCO — sticky + 5 points
       ══════════════════════════════════════════ -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="wb-why-layout">
        <div class="wb-why-sticky" data-reveal="left">
          <div class="eyebrow">/ 01 · Why choose Banco</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            Why choose<br/><em class="accent">Banco.</em>
          </h2>
          <div class="wb-why-rule"></div>
          <p style="color:var(--color-stone-700);font-size:15px;line-height:1.7">
            We connect metallurgy, extrusion and value-added processing around your
            requirement, from profile development through to finished components.
          </p>
        </div>

        <div class="wb-why-points" data-reveal="right">
          {whyPoints.map((p, i) => (
            <div class="wb-why-row" style={`--delay:${i * 60}ms`}>
              <div class="wb-why-n">{String(i + 1).padStart(2, '0')}</div>
              <div class="wb-why-body">
                <div class="wb-why-title">{p.title}</div>
                <div class="wb-why-desc">{p.desc}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       OUR SIX STAGES — integrated production
       ══════════════════════════════════════════ -->
  <section class="wb-process section-dark">
    <div class="container">
      <div class="wb-process-head" data-reveal="fade">
        <div>
          <div class="eyebrow on-dark">/ 02 · Our six stages</div>
          <h2 class="t-h2" style="color:var(--color-stone-50);margin-top:16px">
            One factory.<br/><em class="accent">Six controlled stages.</em>
          </h2>
        </div>
        <p class="t-lead" style="color:var(--color-stone-400);max-width:44ch;align-self:end">
          Every stage a customer would otherwise have to qualify across separate
          vendors, owned and quality-controlled by Banco, in Vadodara.
        </p>
      </div>

      <div class="wb-process-grid">
        {[
          { n: '01', title: 'Foundry',        sub: 'Billet casting',   desc: 'In-house melting and casting of standard and special alloys across the 1xxx–7xxx series.' },
          { n: '02', title: 'Extrusion',       sub: '5 presses',        desc: '1,100–3,300 T press force. Direct and indirect extrusion of complex hollow and solid profiles.' },
          { n: '03', title: 'Die Shop',        sub: 'In-house',         desc: 'Full die design, manufacture and correction, with no third-party dependency or lead-time risk.' },
          { n: '04', title: 'Heat Treatment',  sub: 'Age & anneal',     desc: 'Controlled atmosphere ageing and annealing furnaces for consistent T5/T6 properties.' },
          { n: '05', title: 'Machining',       sub: 'CNC + cold draw',  desc: 'Multi-axis CNC machining, cold drawing and fabrication for near-net-shape output.' },
          { n: '06', title: 'Finishing',       sub: 'Surface & pack',   desc: 'Anodising, powder coating, chromating and precision packing for OEM and export shipments.' },
        ].map((p, i) => (
          <div class="wb-process-cell" data-reveal="fade" style={`--delay:${i * 55}ms`}>
            <div class="wb-process-num">/ {p.n}</div>
            <div class="wb-process-title">{p.title}</div>
            <div class="wb-process-sub">{p.sub}</div>
            <div class="wb-process-rule"></div>
            <div class="wb-process-desc">{p.desc}</div>
          </div>
        ))}
      </div>

      <div style="margin-top:40px;text-align:center" data-reveal="fade">
        <a href="/capabilities/extrusion" class="btn btn-secondary-dark">
          Explore all capabilities →
        </a>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       THE BANCO DIFFERENCE
       ══════════════════════════════════════════ -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="eyebrow" data-reveal="fade">/ 03 · The Banco difference</div>
      <div class="wb-diff" data-reveal="fade">
        <h2 class="t-h2 wb-diff-h2">
          From profile to<br/><em class="accent">finished component.</em>
        </h2>
        <p class="wb-diff-p">
          The value is not only in extrusion. It is in how metallurgy, profile
          development, manufacturing and downstream processing work together to
          deliver the required component.
        </p>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       CTA CLOSE — per client, Why Banco keeps a
       closing CTA (the doc's own closing block).
       ══════════════════════════════════════════ -->
  <section class="cta-strip section-pad" aria-label="Get in touch">
    <div class="container" style="position:relative;z-index:1">
      <div class="cta-strip-inner">
        <div data-reveal="fade">
          <h2 class="t-h2" style="margin-top:0">
            Have a profile or component<br/><em class="accent">to develop?</em>
          </h2>
          <p class="t-lead" style="color:var(--color-stone-400);margin-top:20px;max-width:48ch">
            Share your drawing or requirement with our team.
          </p>
          <div class="cta-actions">
            <a href="/contact#quote" class="btn btn-primary-dark">Send Enquiry</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Concentric circle decoration -->
    <div class="cta-decoration" aria-hidden="true">
      <svg width="600" height="600" viewBox="0 0 600 600" fill="none">
        <circle cx="300" cy="300" r="280" stroke="white" stroke-width="1"/>
        <circle cx="300" cy="300" r="240" stroke="white" stroke-width="1"/>
        <circle cx="300" cy="300" r="200" stroke="white" stroke-width="1"/>
        <circle cx="300" cy="300" r="160" stroke="white" stroke-width="1"/>
        <circle cx="300" cy="300" r="120" stroke="white" stroke-width="1"/>
        <circle cx="300" cy="300" r="80" stroke="white" stroke-width="1"/>
      </svg>
    </div>
  </section>

</Layout>

<style>
  /* ── THE BANCO DIFFERENCE ───────────────────────────────────── */
  /* Heading left, body right: a single narrow column here left a large void
     on the right, the same imbalance the client flagged on heat treatment. */
  .wb-diff {
    display: grid; grid-template-columns: 1fr 1.1fr;
    gap: clamp(40px, 6vw, 80px); align-items: start; margin-top: 16px;
  }
  .wb-diff-h2 { color: var(--color-navy); }
  .wb-diff-p {
    color: var(--color-stone-700); font-size: clamp(15px, 1.4vw, 18px);
    line-height: 1.7; align-self: center;
  }
  @media (max-width: 900px) {
    .wb-diff { grid-template-columns: minmax(0, 1fr); gap: 20px; }
  }

  /* ── HERO ───────────────────────────────────────────────────── */
  .wb-hero {
    position: relative; background: var(--color-navy-deep);
    min-height: 78vh; display: flex; align-items: center; overflow: hidden;
  }
  .wb-hero-media { position: absolute; inset: 0; z-index: 0; }
  :global(.wb-hero-vid) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 38%; }
  .wb-hero-scrim { position: absolute; inset: 0; background: rgba(6,21,37,0.60); }
  .wb-hero-grad {
    position: absolute; inset: 0;
    background:
      linear-gradient(110deg, rgba(6,21,37,0.80) 0%, rgba(6,21,37,0.28) 58%, rgba(6,21,37,0.08) 100%),
      linear-gradient(to bottom, transparent 55%, var(--color-navy-deep) 100%);
  }
  .wb-hero-body { position: relative; z-index: 2; width: 100%; padding-top: 160px; padding-bottom: 100px; }
  .wb-hero-inner { max-width: 680px; }
  .wb-hero-h1 { color: var(--color-stone-50); margin-top: 20px; }
  .wb-hero-lede { color: var(--color-stone-400); font-size: clamp(15px,1.4vw,18px); line-height: 1.65; max-width: 54ch; margin-top: 24px; }

  .wb-scroll-cue { position: absolute; bottom: 44px; left: 50%; transform: translateX(-50%); z-index: 3; }
  .wb-scroll-line { display: block; width: 1px; height: 52px; background: linear-gradient(to bottom, var(--color-green), transparent); animation: wb-drop 2s ease-in-out infinite; }
  @keyframes wb-drop {
    0%   { transform: scaleY(0); transform-origin: top; opacity: 1; }
    50%  { transform: scaleY(1); transform-origin: top; }
    51%  { transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; opacity: 0; }
  }

  /* ── WHY CHOOSE BANCO ──────────────────────────────────────────── */
  .wb-why-layout { display: grid; grid-template-columns: 1fr 1.4fr; gap: clamp(48px,7vw,100px); align-items: start; }
  .wb-why-sticky { position: sticky; top: 100px; }
  .wb-why-rule { width: 40px; height: 1px; background: var(--color-stone-400); margin: 28px 0; }
  .wb-why-points { display: flex; flex-direction: column; }
  .wb-why-row {
    display: grid; grid-template-columns: 48px 1fr;
    gap: 20px; padding: 22px 0;
    border-bottom: 1px solid var(--color-stone-200);
    align-items: start;
    transition-delay: var(--delay, 0ms);
  }
  .wb-why-row:first-child { border-top: 1px solid var(--color-stone-200); }
  .wb-why-n { font-family: var(--font-mono); font-size: max(10px, var(--fs-min, 0px)); letter-spacing: 0.16em; color: var(--color-green); padding-top: 4px; }
  .wb-why-title { font-size: 16px; font-weight: 600; color: var(--color-navy); letter-spacing: -0.01em; margin-bottom: 6px; }
  .wb-why-desc  { font-size: 13.5px; line-height: 1.65; color: var(--color-stone-700); }

  /* ── OUR SIX STAGES ────────────────────────────────────────────── */
  .wb-process { padding: 80px 0; }
  .wb-process-head {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 80px); align-items: start; margin-bottom: 48px;
  }
  .wb-process-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 1px; background: var(--color-navy-line); }
  .wb-process-cell {
    background: var(--color-navy-soft); padding: 28px 20px;
    display: flex; flex-direction: column; position: relative;
    transition: background 0.25s ease;
    transition-delay: var(--delay, 0ms);
  }
  .wb-process-cell:hover { background: var(--color-navy); }
  .wb-process-cell::after {
    content: ''; position: absolute; bottom: 0; left: 0; width: 0; height: 2px;
    background: var(--color-green); transition: width 0.35s ease;
  }
  .wb-process-cell:hover::after { width: 100%; }
  .wb-process-num  { font-family: var(--font-mono); font-size: max(10px, var(--fs-min, 0px)); letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-green); margin-bottom: 16px; }
  .wb-process-title{ font-family: var(--font-sans); font-size: 18px; font-weight: 600; color: var(--color-stone-50); letter-spacing: -0.01em; line-height: 1.2; }
  .wb-process-sub  { font-family: var(--font-mono); font-size: max(9px, var(--fs-min, 0px)); letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-stone-400); margin-top: 4px; margin-bottom: 16px; }
  .wb-process-rule { width: 24px; height: 1px; background: var(--color-navy-line); margin-bottom: 16px; }
  .wb-process-desc { font-size: 12.5px; line-height: 1.55; color: var(--color-stone-400); margin-top: auto; }

  /* ── CTA ────────────────────────────────────────────────────── */
  .wb-cta-row { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 40px; }
  .wb-cta-btns { display: flex; flex-direction: column; gap: 12px; flex-shrink: 0; }

  @media (max-width: 1100px) {
    .wb-process-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 900px) {
    .wb-why-layout  { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .wb-why-sticky  { position: static; }
    .wb-process-head{ grid-template-columns: minmax(0, 1fr); }
    .wb-cta-row     { flex-direction: column; }
  }
  @media (max-width: 640px) {
    .wb-scroll-cue   { display: none; }
    .wb-process-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) {
    .wb-scroll-line { animation: none; opacity: 0.5; }
  }
</style>
