---
import Layout from '../../layouts/Layout.astro';
import { optSrcset } from '../../lib/img';

const whyPoints = [
  { title: '58 years of heritage', desc: 'One of India\'s oldest aluminium extrusion manufacturers, established 1967 by the Thakkar family and still family-owned.' },
  { title: 'Owner-managed',        desc: 'Decisions made on-site by people who understand manufacturing. Short chains. Clear accountability.' },
  { title: 'Integrated platform',  desc: 'Foundry, die shop, extrusion, heat treatment, machining, and finishing, all in-house. Every discipline has real depth.' },
  { title: 'Export markets',       desc: 'Europe, North America, Asia-Pacific, Middle East. International experience and market exposure from day one.' },
  { title: 'Growth track',         desc: 'Capacity expansion and digitalisation underway. Roles being created, not simply replaced.' },
];
---

<Layout
  title="Why Banco: Banco Aluminium"
  description="Why customers and employees choose Banco Aluminium: an integrated, owner-managed aluminium manufacturer with 58 years of heritage and a genuine manufacturing platform."
  transparentNav={true}
  heroImage="/assets/images/people/group-discussing.png"
>

  <!-- ══════════════════════════════════════════
       HERO — photo background
       ══════════════════════════════════════════ -->
  <section class="wb-hero">
    <div class="wb-hero-media" aria-hidden="true">
      <picture>
        <source type="image/avif" srcset={optSrcset('/assets/images/people/group-discussing.png', 'avif')} sizes="100vw" />
        <source type="image/webp" srcset={optSrcset('/assets/images/people/group-discussing.png', 'webp')} sizes="100vw" />
        <img src="/assets/images/people/group-discussing.png" alt="" loading="eager" fetchpriority="high" class="wb-hero-vid" />
      </picture>
      <div class="wb-hero-scrim"></div>
      <div class="wb-hero-grad"></div>
    </div>

    <div class="container wb-hero-body">
      <div class="eyebrow on-dark" data-reveal="fade" data-reveal-delay="1">
        Why Banco
      </div>
      <h1 class="t-h1 wb-hero-h1" data-reveal data-reveal-delay="2">
        Integrated.<br/>Genuinely <em class="accent">manufacturing.</em>
      </h1>
      <p class="wb-hero-lede" data-reveal data-reveal-delay="3">
        Most aluminium companies are traders. Banco is a manufacturer, with its own
        foundry, die shop, five extrusion presses, heat treatment, surface finishing,
        and machining, all under one roof in Vadodara.
      </p>
    </div>

    <div class="wb-scroll-cue" aria-hidden="true">
      <span class="wb-scroll-line"></span>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       WHY BANCO — sticky + 5 points
       ══════════════════════════════════════════ -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="wb-why-layout">
        <div class="wb-why-sticky" data-reveal="left">
          <div class="eyebrow">/ 01 · The case for Banco</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            Integrated.<br/>Growing.<br/><em class="accent">Genuinely</em><br/>manufacturing.
          </h2>
          <div class="wb-why-rule"></div>
          <p style="color:var(--color-stone-700);font-size:15px;line-height:1.7">
            Most aluminium companies are traders. Banco is a manufacturer,
            with its own foundry, die shop, five extrusion presses, heat
            treatment, surface finishing, and machining. If you work with
            Banco, you work with a place where things are actually made.
          </p>
        </div>

        <div class="wb-why-points" data-reveal="right">
          {whyPoints.map((p, i) => (
            <div class="wb-why-row" style={`--delay:${i * 60}ms`}>
              <div class="wb-why-n">{String(i + 1).padStart(2, '0')}</div>
              <div class="wb-why-body">
                <div class="wb-why-title">{p.title}</div>
                <div class="wb-why-desc">{p.desc}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       CTA CLOSE
       ══════════════════════════════════════════ -->
  <section class="section-dark" style="padding:72px 0;border-top:2px solid var(--color-green)">
    <div class="container">
      <div class="wb-cta-row" data-reveal="fade">
        <div>
          <div class="eyebrow on-dark">Learn more</div>
          <h2 class="t-h2" style="color:var(--color-platinum);margin-top:14px">
            See the certifications.<br/>Meet the team.
          </h2>
        </div>
        <div class="wb-cta-btns">
          <a href="/about/quality" class="btn btn-primary-dark">Quality & certifications</a>
          <a href="/about/careers" class="btn btn-secondary-dark">Careers</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── HERO ───────────────────────────────────────────────────── */
  .wb-hero {
    position: relative; background: var(--color-navy-deep);
    min-height: 72vh; display: flex; align-items: center; overflow: hidden;
  }
  .wb-hero-media { position: absolute; inset: 0; z-index: 0; }
  .wb-hero-vid { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  .wb-hero-scrim { position: absolute; inset: 0; background: rgba(6,21,37,0.60); }
  .wb-hero-grad {
    position: absolute; inset: 0;
    background:
      linear-gradient(110deg, rgba(6,21,37,0.76) 0%, rgba(6,21,37,0.22) 58%, rgba(6,21,37,0.05) 100%),
      linear-gradient(to bottom, transparent 55%, var(--color-navy-deep) 100%);
  }
  .wb-hero-body { position: relative; z-index: 2; width: 100%; padding-top: 160px; padding-bottom: 100px; max-width: 680px; }
  .wb-hero-h1 { color: var(--color-stone-50); margin-top: 20px; }
  .wb-hero-lede { color: var(--color-stone-400); font-size: clamp(15px,1.4vw,18px); line-height: 1.65; max-width: 54ch; margin-top: 24px; }

  .wb-scroll-cue { position: absolute; bottom: 44px; left: 50%; transform: translateX(-50%); z-index: 3; }
  .wb-scroll-line { display: block; width: 1px; height: 52px; background: linear-gradient(to bottom, var(--color-green), transparent); animation: wb-drop 2s ease-in-out infinite; }
  @keyframes wb-drop {
    0%   { transform: scaleY(0); transform-origin: top; opacity: 1; }
    50%  { transform: scaleY(1); transform-origin: top; }
    51%  { transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; opacity: 0; }
  }

  /* ── WHY BANCO ──────────────────────────────────────────────── */
  .wb-why-layout { display: grid; grid-template-columns: 1fr 1.4fr; gap: clamp(48px,7vw,100px); align-items: start; }
  .wb-why-sticky { position: sticky; top: 100px; }
  .wb-why-rule { width: 40px; height: 1px; background: var(--color-stone-400); margin: 28px 0; }
  .wb-why-points { display: flex; flex-direction: column; }
  .wb-why-row {
    display: grid; grid-template-columns: 48px 1fr;
    gap: 20px; padding: 22px 0;
    border-bottom: 1px solid var(--color-stone-200);
    align-items: start;
    transition-delay: var(--delay, 0ms);
  }
  .wb-why-row:first-child { border-top: 1px solid var(--color-stone-200); }
  .wb-why-n { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.16em; color: var(--color-green); padding-top: 4px; }
  .wb-why-title { font-size: 16px; font-weight: 600; color: var(--color-navy); letter-spacing: -0.01em; margin-bottom: 6px; }
  .wb-why-desc  { font-size: 13.5px; line-height: 1.65; color: var(--color-stone-700); }

  /* ── CTA ────────────────────────────────────────────────────── */
  .wb-cta-row { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 40px; }
  .wb-cta-btns { display: flex; flex-direction: column; gap: 12px; flex-shrink: 0; }

  @media (max-width: 900px) {
    .wb-why-layout { grid-template-columns: 1fr; gap: 40px; }
    .wb-why-sticky { position: static; }
    .wb-cta-row    { flex-direction: column; }
  }
  @media (max-width: 640px) {
    .wb-hero-grad  { background: rgba(6,21,37,0.88); }
    .wb-scroll-cue { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wb-scroll-line { animation: none; opacity: 0.5; }
  }
</style>
