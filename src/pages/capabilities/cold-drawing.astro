---
import Layout from '../../layouts/Layout.astro';
import Pic from '../../components/Pic.astro';

const toleranceComparison = [
  { param: 'OD tolerance (25 mm dia.)', extrusion: '±0.20 mm', cold: '±0.05 mm', note: '4× improvement' },
  { param: 'Surface finish (Ra)',       extrusion: '1.5–3 μm', cold: '0.4–0.8 μm', note: 'Scale-free, bright' },
  { param: 'Roundness (round bar)',    extrusion: '±0.15 mm', cold: '±0.03 mm', note: 'Suitable for direct turning' },
];

// One combined product range (client round 6, 2026-10-12) replaces the former
// separate "Rods & bars" and "Tubes" cards; the Applications row was dropped.
const sizeRange = [
  ['Solid profile range (CCD)', '6–36 mm'],
  ['Hollow profile range (OD)', '8–52 mm'],
  ['Hollow profile range (ID)', '7–50 mm'],
  ['Max. length',               '2,000–7,000 mm'],
];
---

<Layout
  title="Cold drawing | Banco Aluminium"
  description="Cold drawn aluminium solid and hollow sections beyond extrusion tolerances: h9 tolerance, scale-free surface, solid sections 6–36 mm CCD, hollow sections 8–52 mm OD and lengths up to 7,000 mm."
  transparentNav={true}
>

  <!-- ── HERO ─────────────────────────────────────────────── -->
  <section class="cap-hero photo-hero">
    <div class="cap-hero-media photo-hero-media" aria-hidden="true">
      <Pic
        src="/assets/capabilities/cold-drawing-hero.jpg"
        alt="Banco Aluminium technician checking a drawn tube on the straightening line"
        class="cap-hero-img"
        focus="60% 45%" focusMobile="65% 45%"
        loading="eager" sizes="100vw" />
      <div class="cap-hero-scrim photo-hero-scrim"></div>
      <div class="cap-hero-grad photo-hero-grad"></div>
    </div>

    <div class="container cap-hero-body photo-hero-body">
      <div class="eyebrow on-dark" data-reveal="fade" data-reveal-delay="1">Capabilities / Cold drawing</div>
      <h1 class="cap-h1" data-reveal data-reveal-delay="2">
        Beyond extrusion<br>tolerances.
      </h1>
      <p class="cap-lead" data-reveal data-reveal-delay="3">
        Cold drawing reduces extruded rod, bar, and tube through a precision die under
        tension. The result: tighter dimensional tolerances, improved surface finish,
        increased straightness, and a bright scale-free surface suitable for direct
        CNC machining without further preparation.
      </p>
      <div class="cap-stats" data-reveal data-reveal-delay="4">
        {[
          { n: '±0.05 mm', l: 'OD tolerance on round rod' },
          { n: '6–36 mm',  l: 'Solid profile range (CCD)' },
          { n: 'Ra 0.4–0.8', l: 'Surface finish μm' },
          { n: 'Direct CNC', l: 'No pre-machining required' },
        ].map(({ n, l }) => (
          <div class="cap-stat">
            <div class="cap-stat-n">{n}</div>
            <div class="cap-stat-l">{l}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="cap-scroll-cue" aria-hidden="true">
      <span class="cap-scroll-line"></span>
    </div>
  </section>

  <!-- Products -->
  <section class="section-dark section-pad">
    <div class="container">
      <div class="eyebrow on-dark" data-reveal="fade">/ 01 · Product range</div>
      <h2 class="t-h2" style="color:var(--color-platinum);margin-top:16px;margin-bottom:40px" data-reveal>
        Rods, bars, and tubes.
      </h2>
      <div class="cd-range" data-reveal="fade">
        <div class="cd-range-col cd-range-col--size">
          <div class="cd-range-head">Size range</div>
          <div class="cd-prod-specs">
            {sizeRange.map(([k, v]) => (
              <div class="cd-spec-row">
                <span class="cd-spec-key">{k}</span>
                <span class="cd-spec-val">{v}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="cd-range-col">
          <div class="cd-range-head">Tolerance</div>
          <div class="cd-range-big">h9</div>
          <div class="cd-range-note">ISO fit tolerance</div>
        </div>
        <div class="cd-range-col">
          <div class="cd-range-head">Typical alloys</div>
          <div class="cd-range-big cd-range-big--text">Various alloys</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Product photo strip -->
  <div class="cd-photo-strip">
    <div class="cd-photo-tile">
      <Pic
        src="/assets/capabilities/cold-drawing/drawn-hollow-profiles.jpg"
        alt="Cold drawn hollow aluminium profiles — round, oval and rectangular tubes"
        loading="lazy" sizes="(max-width:768px) 100vw, 50vw" />
      <div class="cd-photo-label">Hollow profiles</div>
    </div>
    <div class="cd-photo-tile">
      <Pic
        src="/assets/capabilities/cold-drawing/drawn-solid-bars.jpg"
        alt="Cold drawn solid aluminium bars — round, hexagonal and square sections"
        loading="lazy" sizes="(max-width:768px) 100vw, 50vw" />
      <div class="cd-photo-label">Solid bars</div>
    </div>
  </div>

  <!-- Tolerance comparison -->
  <section class="section-alt section-pad">
    <div class="container">
      <div class="eyebrow" data-reveal="fade">/ 02 · Tolerance comparison</div>
      <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px;margin-bottom:40px" data-reveal>
        Extrusion vs cold drawing.
      </h2>
      <div class="cd-table-wrap" data-reveal="fade">
        <table class="cd-table">
          <thead>
            <tr>
              <th>Parameter</th>
              <th>Extruded</th>
              <th>Cold drawn</th>
              <th>Benefit</th>
            </tr>
          </thead>
          <tbody>
            {toleranceComparison.map((r, i) => (
              <tr class={i % 2 === 0 ? 'cd-row-even' : 'cd-row-odd'}>
                <td class="cd-cell-param">{r.param}</td>
                <td class="cd-cell-ext">{r.extrusion}</td>
                <td class="cd-cell-cd">{r.cold}</td>
                <td class="cd-cell-note">{r.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Process photo strip -->
  <div class="cd-photo-strip cd-photo-strip--3">
    <div class="cd-photo-tile">
      <Pic
        src="/assets/capabilities/cold-drawing/drawing-pointing.jpg"
        alt="Operator pointing drawn aluminium rod ready for the draw bench"
        loading="lazy" sizes="(max-width:768px) 100vw, 33vw" />
      <div class="cd-photo-label">Pointing</div>
    </div>
    <div class="cd-photo-tile">
      <Pic
        src="/assets/capabilities/cold-drawing/drawing-chamfering.jpg"
        alt="Operator chamfering a cold drawn aluminium profile"
        loading="lazy" sizes="(max-width:768px) 100vw, 33vw" />
      <div class="cd-photo-label">Chamfering</div>
    </div>
    <div class="cd-photo-tile">
      <Pic
        src="/assets/capabilities/cold-drawing/drawing-straightening.jpg"
        alt="Operators feeding rod through a multi-roll straightening machine"
        loading="lazy" sizes="(max-width:768px) 100vw, 33vw" />
      <div class="cd-photo-label">Straightening</div>
    </div>
  </div>

  <!-- Applications -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="eyebrow" data-reveal="fade">/ 03 · Applications</div>
      <div class="cd-apps-grid" data-reveal="fade">
        {[
          { num: '01', title: 'CNC machining blanks',       desc: 'Close-tolerance rod fed directly to turning centre. Eliminates pre-turn, reduces per-part cycle time and material waste.' },
          { num: '02', title: 'Hydraulic cylinder rods',    desc: 'Consistent OD and straightness required for seal performance. Cold drawn rod to h9 tolerance, surface finish Ra 0.8 μm.' },
          { num: '03', title: 'Precision structural',       desc: 'Structural pins, shafts, and axles requiring interference fit or close-clearance assembly. Cold drawn to h9.' },
          { num: '04', title: 'Turned parts',               desc: 'Bright bar supplied to subcontract turning shops. Material certified and diameter verified.' },
          { num: '05', title: 'Pneumatic components',       desc: 'Cylinder barrels and piston rods. Tube drawn to precise ID and OD for pneumatic seal housings.' },
          { num: '06', title: 'Fasteners & hardware',       desc: 'Hexagonal bar for aluminium fastener manufacture: bolts, nuts, threaded rod. Close-tolerance hex for wrench engagement.' },
        ].map(({ num, title, desc }) => (
          <div class="cd-app-card">
            <div class="cd-app-num">{num}</div>
            <h3 class="cd-app-title">{title}</h3>
            <p class="cd-app-desc">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Single product-range block: size range | tolerance | alloys */
  .cd-range { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 1px; background: var(--color-navy-line); border: 1px solid var(--color-navy-line); border-top: 2px solid var(--color-green); }
  .cd-range-col { background: var(--color-navy-soft); padding: 28px 24px; display: flex; flex-direction: column; gap: 12px; }
  .cd-range-head { font-family: var(--font-sans); font-size: 18px; font-weight: 700; color: var(--color-platinum); }
  .cd-range-big { font-family: var(--font-sans); font-size: clamp(28px, 3vw, 40px); font-weight: 700; letter-spacing: -0.03em; line-height: 1; color: var(--color-platinum); border-top: 1px solid var(--color-navy-line); padding-top: 16px; }
  .cd-range-big--text { font-size: clamp(20px, 1.8vw, 24px); letter-spacing: -0.01em; line-height: 1.2; }
  .cd-range-note { font-family: var(--font-mono); font-size: max(9px, var(--fs-min, 0px)); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-nickel); }
  .cd-prod-specs { border-top: 1px solid var(--color-navy-line); padding-top: 12px; display: flex; flex-direction: column; gap: 0; }
  .cd-spec-row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 9px 0; border-bottom: 1px solid rgba(255,255,255,0.06); }
  .cd-spec-key { font-family: var(--font-mono); font-size: max(9px, var(--fs-min, 0px)); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-nickel); flex-shrink: 0; }
  .cd-spec-val { font-family: var(--font-sans); font-size: 13px; color: var(--color-platinum); text-align: right; white-space: nowrap; }

  .cd-table-wrap { overflow-x: auto; border: 1px solid var(--color-stone-200); }
  .cd-table { width: 100%; border-collapse: collapse; font-family: var(--font-mono); font-size: 11px; white-space: nowrap; }
  .cd-table thead tr { background: var(--color-stone-100); }
  .cd-table th { padding: 10px 16px; text-align: left; font-size: max(9.5px, var(--fs-min, 0px)); letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-stone-700); border-right: 1px solid var(--color-stone-200); }
  .cd-table th:last-child { border-right: none; }
  .cd-row-even { background: var(--color-stone-50); }
  .cd-row-odd  { background: white; }
  .cd-table td { padding: 12px 16px; border-right: 1px solid var(--color-stone-200); border-bottom: 1px solid var(--color-stone-200); vertical-align: middle; }
  .cd-table td:last-child { border-right: none; }
  .cd-cell-param { font-family: var(--font-sans); font-size: 13px; color: var(--color-navy); font-weight: 500; white-space: normal; min-width: 180px; }
  .cd-cell-ext  { color: var(--color-stone-700); }
  .cd-cell-cd   { color: var(--color-green); font-weight: 500; }
  .cd-cell-note { color: var(--color-stone-700); font-family: var(--font-sans); font-size: 12px; white-space: normal; min-width: 120px; }

  .cd-apps-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--color-stone-200); border: 1px solid var(--color-stone-200); margin-top: 32px; }
  .cd-app-card  { background: var(--color-stone-50); padding: 28px 24px; border-top: 2px solid var(--color-green); display: flex; flex-direction: column; gap: 8px; }
  .cd-app-num   { font-family: var(--font-mono); font-size: max(10px, var(--fs-min, 0px)); letter-spacing: 0.16em; color: var(--color-green); }
  .cd-app-title { font-family: var(--font-sans); font-size: 16px; font-weight: 700; color: var(--color-navy); }
  .cd-app-desc  { font-family: var(--font-sans); font-size: 13px; line-height: 1.65; color: var(--color-stone-700); }

  /* Photo strip */
  .cd-photo-strip { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
  .cd-photo-strip--3 { grid-template-columns: repeat(3, 1fr); }
  .cd-photo-tile { position: relative; aspect-ratio: 16/9; overflow: hidden; }
  .cd-photo-tile :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; filter: brightness(0.82); transition: transform 0.5s ease, filter 0.3s ease; }
  .cd-photo-tile:hover :global(img) { transform: scale(1.04); filter: brightness(1); }
  .cd-photo-label {
    position: absolute; bottom: 0; left: 0; right: 0;
    padding: 32px 24px 16px;
    background: linear-gradient(transparent, rgba(8,27,48,0.78));
    font-family: var(--font-mono); font-size: max(10px, var(--fs-min,0px)); letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--color-nickel);
  }

  @media (max-width: 1024px) {
    .cd-range { grid-template-columns: repeat(2, 1fr); }
    .cd-range-col--size { grid-column: 1 / -1; }
    .cd-apps-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .cd-apps-grid { grid-template-columns: 1fr 1fr; }
    .cd-photo-strip--3 { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .cd-spec-row { flex-direction: column; gap: 4px; }
    .cd-spec-val { text-align: left; }
  }

</style>
