---
import Layout from '../../layouts/Layout.astro';
import Pic from '../../components/Pic.astro';

const processSteps = [
  { num: '/ 01', name: 'Drawing review', desc: 'Customer drawings are reviewed for extrudability and potential complexities, including wall thickness, tongue ratio, and circumscribed circle diameter. Modifications are suggested where required to improve reliability, die life, and surface finish.' },
  { num: '/ 02', name: 'Q-Form simulation', desc: 'Designs are converted into 3D models and simulated using QForm – UK software to predict metal flow, temperature distribution, weld seams, and deflections.' },
  { num: '/ 03', name: 'Die manufacturing', desc: 'Manufacturing starts immediately using ready-stock raw materials, followed by CNC machining, heat treatment, and inspection.' },
  { num: '/ 04', name: 'Trial', desc: 'Ready dies are issued for trials, and samples are validated and submitted for customer approval.' },
];
---

<Layout
  title="Die shop & tooling: Banco Aluminium"
  description="In-house die shop converting customer drawings into production tooling: 5-axis CNC machining, Q-Form flow simulation and 2–3 week tooling lead times."
  transparentNav={true}
>

  <!-- ── HERO ─────────────────────────────────────────────── -->
  <section class="cap-hero photo-hero">
    <div class="cap-hero-media photo-hero-media" aria-hidden="true">
      <Pic
        src="/assets/capabilities/die-shop-hero.jpg"
        alt="Banco Aluminium die-shop technician checking extrusion dies in the die store"
        class="cap-hero-img"
        focus="50% 45%" focusMobile="56% 48%"
        loading="eager" sizes="100vw" />
      <div class="cap-hero-scrim photo-hero-scrim"></div>
      <div class="cap-hero-grad photo-hero-grad"></div>
    </div>

    <div class="container cap-hero-body photo-hero-body">
      <div class="eyebrow on-dark" data-reveal="fade" data-reveal-delay="1">Capabilities / Die shop</div>
      <h1 class="cap-h1" data-reveal data-reveal-delay="2">
        Customer drawings<br>into production<br>tooling.
      </h1>
      <p class="cap-lead" data-reveal data-reveal-delay="3">
        Banco's in-house Die Shop manages complete tooling for all five presses,
        from QForm flow simulation to trial extrusion and sample approval.
        Standard profiles have a typical 2–3 week die lead time, while critical
        or complex profiles are scheduled based on die and tooling complexity.
      </p>
      <div class="cap-stats cap-stats--five" data-reveal data-reveal-delay="4">
        {[
          { n: 'Design & feasibility', l: 'AutoCAD • Solid Edge • QExDD • Siemens NX' },
          { n: 'Extrusion simulation', l: 'QForm – UK' },
          { n: 'CNC machining', l: 'CNC Lathe • 5-Axis VMC • 3-Axis VMC • EDM • WEDM' },
          { n: 'Heat treatment', l: 'Vacuum heat treatment' },
          { n: 'Inspection', l: 'Validated before trial' },
        ].map(({ n, l }) => (
          <div class="cap-stat">
            <div class="cap-stat-n">{n}</div>
            <div class="cap-stat-l">{l}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="cap-scroll-cue" aria-hidden="true">
      <span class="cap-scroll-line"></span>
    </div>
  </section>

  <!-- Die design process -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="eyebrow" data-reveal="fade">/ 01 · Die design process</div>
      <div class="die-section-head" data-reveal="fade">
        <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
          Four stages from<br>drawing to trial.
        </h2>
        <p class="t-lead" style="color:var(--color-stone-700);max-width:52ch">
          Every die goes through a structured design and validation process before
          a single billet is loaded. Q-Form simulation eliminates the majority of
          first-off failures and reduces sampling iterations.
        </p>
      </div>
      <div class="die-process-grid" data-reveal="fade">
        {processSteps.map(({ num, name, desc }) => (
          <div class="die-proc-cell">
            <div class="die-proc-num">{num}</div>
            <h3 class="die-proc-name">{name}</h3>
            <p class="die-proc-desc">{desc}</p>
          </div>
        ))}
      </div>
      <div class="die-photo-strip" data-reveal="fade">
        {[
          ['/assets/capabilities/die-shop-cad.jpg',    'Die design & flow simulation'],
          ['/assets/capabilities/die-shop-polish.jpg', 'Bearing correction & polishing'],
        ].map(([src, cap]) => (
          <figure class="die-photo">
            <Pic src={src} alt={cap} loading="lazy" sizes="(max-width: 768px) 100vw, 50vw" />
            <figcaption>{cap}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Die machining -->
  <section class="section-alt section-pad">
    <div class="container">
      <div class="eyebrow" data-reveal="fade">/ 02 · Die machining</div>
      <div class="die-mach-grid">
        <div data-reveal="left">
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            5-axis CNC.<br>H13 tool steel.<br>Nitride hardened.
          </h2>
          <p class="t-body" style="color:var(--color-stone-700);margin-top:20px;line-height:1.7">
            5-axis CNC machining reduces manual intervention, improves die consistency,
            and supports faster delivery. Majority of dies are manufactured from H13
            hot-work tool steel, while critical dies use special-grade steels selected
            based on application and tooling requirements.
          </p>
        </div>
        <div class="die-img-main" data-reveal="right">
          <Pic src="/assets/capabilities/die-shop-finishing.jpg" alt="Banco technician hand-finishing a die at the bench, showing the port and bearing geometry" loading="lazy" sizes="(max-width: 1024px) 100vw, 45vw" focus="center 45%" />
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .die-section-head { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 4vw, 80px); align-items: start; margin-bottom: 48px; }

  .die-process-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--color-stone-200); border: 1px solid var(--color-stone-200); }
  .die-proc-cell { background: var(--color-stone-50); padding: 28px 24px; border-top: 2px solid var(--color-green); display: flex; flex-direction: column; gap: 10px; }
  .die-proc-num  { font-family: var(--font-mono); font-size: max(10px, var(--fs-min, 0px)); letter-spacing: 0.16em; color: var(--color-green); }
  .die-proc-name { font-family: var(--font-sans); font-size: 16px; font-weight: 700; color: var(--color-navy); }
  .die-proc-desc { font-family: var(--font-sans); font-size: 13px; line-height: 1.65; color: var(--color-stone-700); }


  .die-mach-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 80px); align-items: start; margin-top: 32px; }
  .die-img-main   { aspect-ratio: 4/3; overflow: hidden; }
  .die-img-main :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; filter: brightness(0.85); transition: filter 0.3s ease; }
  .die-img-main:hover :global(img) { filter: brightness(1); }


  @media (max-width: 1024px) {
    .die-section-head { grid-template-columns: minmax(0, 1fr); }
    .die-process-grid { grid-template-columns: repeat(2, 1fr); }
    .die-mach-grid { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    .die-process-grid { grid-template-columns: 1fr 1fr; }
  }


  .die-photo-strip { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; margin-top: 4px; }
  .die-photo { margin: 0; aspect-ratio: 16 / 9; overflow: hidden; position: relative; border: 1px solid var(--color-stone-200); }
  .die-photo :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .die-photo figcaption {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 7px 10px;
    background: var(--color-stone-50); border-top: 1px solid var(--color-stone-200);
    font-family: var(--font-mono); font-size: max(10px, var(--fs-min, 0px)); letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--color-stone-700);
  }
  @media (max-width: 768px) { .die-photo-strip { grid-template-columns: minmax(0, 1fr); } }
</style>

