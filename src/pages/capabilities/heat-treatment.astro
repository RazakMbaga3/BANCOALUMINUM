---
import Layout from '../../layouts/Layout.astro';
import Pic from '../../components/Pic.astro';

// Page content replaced wholesale with the client's heat-treatment copy
// (round 6, 2026-10-12). Only the Quality & certification section was kept,
// with its certificate list swapped for the tensile-testing photo.
const processes = [
  {
    name: 'Ageing',
    sub: 'Builds strength through controlled precipitation.',
    desc: 'Ageing is a controlled heat treatment process performed at specific temperatures to develop the desired mechanical properties, hardness and temper condition in aluminium alloys.',
    points: ['Improves strength and hardness', 'Enhances dimensional stability', 'Achieves desired temper (e.g., T6, T5)'],
    noteK: 'Commonly used for',
    noteV: '2xxx, 6xxx and 7xxx series alloys.',
  },
  {
    name: 'Solution heat treatment',
    sub: 'Dissolves unwanted phases for better properties.',
    desc: 'The aluminium is heated to a high temperature to dissolve soluble phases and create a homogeneous solid solution, followed by rapid quenching to retain the desired structure.',
    points: ['Increases formability', 'Provides a uniform microstructure', 'Prepares the material for ageing'],
    noteK: 'Typical temperature',
    noteV: '530–560°C (depending on alloy).',
  },
  {
    name: 'Annealing',
    sub: 'Restores softness and relieves stress.',
    desc: 'Annealing is a heat treatment process where the material is heated to a specific temperature and then cooled slowly. It reduces internal stresses, improves ductility and enhances workability.',
    points: ['Relieves residual stresses', 'Improves ductility and toughness', 'Restores workability for further processing'],
    noteK: 'Commonly used for',
    noteV: '1xxx, 3xxx and some 5xxx series alloys.',
  },
  {
    name: 'Special cycles',
    sub: 'Tailored treatments for unique requirements.',
    desc: 'We offer customised heat treatment cycles such as retrogression and re-ageing (RRA), over-ageing and multi-step cycles to meet specific customer needs and complex alloy requirements.',
    points: ['Improves stress corrosion resistance', 'Optimises strength-to-formability balance', 'Supports advanced aerospace and defence applications'],
    noteK: 'Used for',
    noteV: 'High-performance and specialised alloys.',
  },
];

const results = [
  'Higher strength',
  'Better hardness',
  'Improved dimensional stability',
  'Enhanced durability',
  'Greater application flexibility',
];
---

<Layout
  title="Heat treatment: Banco Aluminium"
  description="Ageing, solution heat treatment, annealing and special cycles (RRA, over-ageing, multi-step) that balance strength, formability and long-term reliability in aluminium. Every heat-treated lot tested."
  transparentNav={true}
>

  <!-- ── HERO ─────────────────────────────────────────────── -->
  <!-- Client supplied real ageing-furnace photos 2026-09-28, replacing the
       shared stock video placeholder used since the 2026-09-26 photo pull. -->
  <section class="cap-hero photo-hero">
    <div class="cap-hero-media photo-hero-media" aria-hidden="true">
      <Pic
        src="/assets/capabilities/heat-treatment-hero.jpg"
        alt="Banco Aluminium ageing furnace with loaded charge racks of extruded profiles"
        class="cap-hero-img"
        focus="50% 42%" focusMobile="44% 55%"
        loading="eager" sizes="100vw" />
      <div class="cap-hero-scrim photo-hero-scrim"></div>
      <div class="cap-hero-grad photo-hero-grad"></div>
    </div>

    <div class="container cap-hero-body photo-hero-body">
      <div class="eyebrow on-dark" data-reveal="fade" data-reveal-delay="1">Capabilities / Heat treatment</div>
      <h1 class="cap-h1" data-reveal data-reveal-delay="2">
        Enhancing strength,<br>stability and performance.
      </h1>
      <p class="cap-lead" data-reveal data-reveal-delay="3">
        Our advanced heat treatment processes bring out the best in aluminium, delivering
        the right balance of strength, formability and long-term reliability for diverse
        applications.
      </p>
      <div class="cap-stats" data-reveal data-reveal-delay="4">
        {[
          { n: 'Ageing',                  l: '2xxx · 6xxx · 7xxx series' },
          { n: 'Solution heat treatment', l: '530–560°C, alloy-dependent' },
          { n: 'Annealing',               l: '1xxx · 3xxx · some 5xxx' },
          { n: 'Special cycles',          l: 'RRA · over-ageing · multi-step' },
        ].map(({ n, l }) => (
          <div class="cap-stat">
            <div class="cap-stat-n">{n}</div>
            <div class="cap-stat-l">{l}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="cap-scroll-cue" aria-hidden="true">
      <span class="cap-scroll-line"></span>
    </div>
  </section>

  <!-- Processes -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="eyebrow" data-reveal="fade">/ 01 · Heat treatment processes</div>
      <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px;margin-bottom:40px" data-reveal>
        Right process.<br>Superior properties.
      </h2>
      <div class="ht-proc-grid" data-reveal="fade">
        {processes.map((p, i) => (
          <article class="ht-proc-card">
            <div class="ht-proc-num">/ {String(i + 1).padStart(2, '0')}</div>
            <h3 class="ht-proc-name">{p.name}</h3>
            <p class="ht-proc-sub">{p.sub}</p>
            <p class="ht-proc-desc">{p.desc}</p>
            <ul class="ht-proc-list">
              {p.points.map(pt => (
                <li><span class="ht-dot" aria-hidden="true"></span>{pt}</li>
              ))}
            </ul>
            <div class="ht-proc-note">
              <span class="ht-proc-note-k">{p.noteK}</span>
              <span class="ht-proc-note-v">{p.noteV}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Furnace floor photo band -->
  <div class="ht-band">
    {[
      ['/assets/capabilities/heat-treatment-furnace-bay.jpg',   'Ageing furnace bay · Vadodara'],
      ['/assets/capabilities/heat-treatment-charge-rack.jpg',   'Charge rack, loaded for the furnace'],
    ].map(([src, cap]) => (
      <figure class="ht-band-fig">
        <Pic src={src} alt={cap} loading="lazy" sizes="(max-width: 768px) 100vw, 50vw" maxW={1200} />
        <figcaption>{cap}</figcaption>
      </figure>
    ))}
  </div>

  <!-- The result -->
  <section class="section-dark section-pad">
    <div class="container">
      <div class="eyebrow on-dark" data-reveal="fade">/ 02 · The result</div>
      <h2 class="t-h2" style="color:var(--color-platinum);margin-top:16px;margin-bottom:40px" data-reveal>
        Consistent quality.<br>Superior performance.
      </h2>
      <ul class="ht-result-grid" data-reveal="fade">
        {results.map((r, i) => (
          <li class="ht-result">
            <span class="ht-result-num">/ {String(i + 1).padStart(2, '0')}</span>
            <span class="ht-result-name">{r}</span>
          </li>
        ))}
      </ul>
      <p class="ht-strap" data-reveal="fade">
        Advanced heat treatment<span class="ht-strap-sep" aria-hidden="true">|</span>Stronger aluminium. A brighter future.
      </p>
    </div>
  </section>

  <!-- Quality & certification (kept from the previous page) -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="eyebrow" data-reveal="fade">/ 03 · Quality & certification</div>
      <div class="ht-qual-grid">
        <div data-reveal="fade">
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            Every lot tested.<br>Certificate with every shipment.
          </h2>
          <p class="t-body" style="color:var(--color-stone-700);margin-top:20px;line-height:1.7">
            Mechanical property verification is standard for all heat-treated lots.
            A tensile specimen is machined from a representative profile from each
            ageing charge. Tensile strength, yield strength (Rp0.2), and elongation
            are measured and recorded. Brinell hardness is measured as a process check.
          </p>
        </div>
        <figure class="ht-qual-photo" data-reveal="fade">
          <Pic src="/assets/capabilities/heat-treatment-tensile-testing.jpg" alt="Universal testing machine used for tensile testing of aluminium specimens" loading="lazy" sizes="(max-width: 1024px) 100vw, 40vw" focus="50% 45%" />
          <figcaption>Tensile testing · Universal testing machine</figcaption>
        </figure>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Two-line stat names ("Solution heat treatment") need tighter leading */
  .cap-stat-n { line-height: 1.15; }

  /* Processes: 2 × 2 → 1 column, four cards so no empty cell at any width */
  .ht-proc-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--color-stone-200); border: 1px solid var(--color-stone-200); }
  .ht-proc-card { background: var(--color-stone-50); padding: clamp(24px, 3vw, 36px) clamp(20px, 3vw, 32px); border-top: 2px solid var(--color-green); display: flex; flex-direction: column; gap: 10px; }
  .ht-proc-num  { font-family: var(--font-mono); font-size: max(10px, var(--fs-min, 0px)); letter-spacing: 0.16em; color: var(--color-green); }
  .ht-proc-name { font-family: var(--font-sans); font-size: clamp(20px, 1.9vw, 24px); font-weight: 700; letter-spacing: -0.02em; color: var(--color-navy); }
  .ht-proc-sub  { font-family: var(--font-sans); font-size: 14px; font-weight: 600; line-height: 1.5; color: var(--color-navy-soft); }
  .ht-proc-desc { font-family: var(--font-sans); font-size: 13.5px; line-height: 1.68; color: var(--color-stone-700); }
  .ht-proc-list { list-style: none; margin: 4px 0 0; padding: 0; border-top: 1px solid var(--color-stone-200); }
  .ht-proc-list li { display: flex; align-items: flex-start; gap: 10px; padding: 8px 0; border-bottom: 1px solid var(--color-stone-200); font-family: var(--font-sans); font-size: 13px; line-height: 1.5; color: var(--color-stone-700); }
  .ht-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--color-green); flex-shrink: 0; margin-top: 7px; }
  /* margin-top:auto pins the note to the card foot so paired cards line up */
  .ht-proc-note { margin-top: auto; padding: 12px 14px; background: var(--color-stone-100); border: 1px solid var(--color-stone-200); display: flex; flex-direction: column; gap: 3px; }
  .ht-proc-note-k { font-family: var(--font-mono); font-size: max(9.5px, var(--fs-min, 0px)); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-stone-700); }
  .ht-proc-note-v { font-family: var(--font-sans); font-size: 13px; font-weight: 600; color: var(--color-navy); }

  /* Photo band */
  .ht-band { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; background: var(--color-navy-deep); }
  .ht-band-fig { position: relative; margin: 0; aspect-ratio: 16 / 9; overflow: hidden; }
  .ht-band-fig :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ht-band-fig figcaption {
    position: absolute; left: 0; right: 0; bottom: 0;
    padding: 28px 20px 14px;
    background: linear-gradient(transparent, rgba(8,27,48,0.85));
    font-family: var(--font-mono); font-size: max(10px, var(--fs-min, 0px)); letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--color-platinum);
  }

  /* Result: five in a row on desktop, a ruled list below 1024px */
  .ht-result-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 1px; background: var(--color-navy-line); border: 1px solid var(--color-navy-line); }
  .ht-result { background: var(--color-navy-soft); border-top: 2px solid var(--color-green); padding: 24px 20px 28px; display: flex; flex-direction: column; gap: 10px; }
  .ht-result-num  { font-family: var(--font-mono); font-size: max(10px, var(--fs-min, 0px)); letter-spacing: 0.16em; color: var(--color-green); }
  .ht-result-name { font-family: var(--font-sans); font-size: clamp(16px, 1.4vw, 19px); font-weight: 700; letter-spacing: -0.01em; line-height: 1.25; color: var(--color-platinum); }
  .ht-strap { margin-top: 28px; padding-top: 18px; border-top: 1px solid var(--color-navy-line); font-family: var(--font-mono); font-size: max(10px, var(--fs-min, 0px)); letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-nickel); line-height: 1.8; }
  .ht-strap-sep { color: var(--color-green); margin: 0 14px; }

  /* Quality & certification */
  .ht-qual-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(40px, 6vw, 80px); align-items: start; margin-top: 32px; }
  .ht-qual-photo { margin: 0; overflow: hidden; border: 1px solid var(--color-stone-200); }
  .ht-qual-photo :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; display: block; }
  .ht-qual-photo figcaption {
    font-family: var(--font-mono); font-size: max(9px, var(--fs-min, 0px)); letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--color-stone-700); padding: 7px 10px;
    border-top: 1px solid var(--color-stone-200); background: var(--color-stone-50);
  }

  @media (max-width: 1024px) {
    .ht-result-grid { grid-template-columns: minmax(0, 1fr); }
    .ht-result { flex-direction: row; align-items: baseline; gap: 18px; padding: 16px 20px; border-top: none; }
    .ht-result:first-child { border-top: 2px solid var(--color-green); }
    .ht-qual-grid { grid-template-columns: minmax(0, 1fr); }
    .ht-qual-photo { max-width: 560px; }
  }
  @media (max-width: 768px) {
    .ht-proc-grid { grid-template-columns: minmax(0, 1fr); }
    .ht-band { grid-template-columns: minmax(0, 1fr); }
    .ht-strap-sep { display: block; height: 0; overflow: hidden; margin: 0; }
  }
</style>
