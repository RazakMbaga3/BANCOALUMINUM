---
import Layout from '../../layouts/Layout.astro';

const operations = [
  { op: 'Cutting', desc: 'To-length, mitre, and compound angle cutting. CNC saw centres with stop accuracy ±0.5 mm. Single and gang cutting for high-volume orders.' },
  { op: 'Drilling', desc: 'Multi-spindle drilling heads for hole patterns in a single pass. CNC drilling centres for complex hole patterns, counterbores, and countersinks.' },
  { op: 'Milling', desc: 'Slots, pockets, end profiles, and complex 2D features. CNC machining centres on aluminium profiles up to 6.5 m in length.' },
  { op: 'Punching', desc: 'Holes, notches, slots, and knockouts. Hydraulic punching for high-volume production. Tooling held in-house for repeat orders.' },
  { op: 'Bending', desc: 'Press brake bending for profile flanges, brackets, and sheet components. Tooling matched to profile cross-section to eliminate deformation.' },
  { op: 'Tapping', desc: 'CNC tapping for threaded inserts and machine screw threads. M3 to M24 range. Thread gauged 100% for critical fastener applications.' },
];
---

<Layout
  title="Fabrication & machining — Banco Aluminium"
  description="10,000 parts per day. CNC cutting, drilling, milling, punching, bending, and tapping. Custom assembly and export packing. Downstream from the extrusion press."
>

  <section class="fab-hero">
    <div class="container">
      <div class="eyebrow on-dark">Capabilities / Fabrication & machining</div>
      <h1 class="fab-h1">
        10,000 parts<br>per day.
      </h1>
      <p class="fab-lead">
        Banco's fabrication and machining facility converts extruded profiles into finished
        components and sub-assemblies. Six machining operations, CNC precision, and throughput
        of 10,000 parts per day — direct from the press floor.
      </p>
      <div class="fab-stats">
        {[
          { n: '10,000', l: 'Parts per day throughput' },
          { n: '6',       l: 'CNC machining operations' },
          { n: 'OEM',     l: 'Sub-assembly capability' },
          { n: '±0.1 mm', l: 'Dimensional tolerance' },
        ].map(({ n, l }) => (
          <div class="fab-stat">
            <div class="fab-stat-n">{n}</div>
            <div class="fab-stat-l">{l}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Overview -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="eyebrow">/ 01 · Overview</div>
      <div class="fab-overview-grid">
        <div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            Profile into<br>finished component.
          </h2>
        </div>
        <div>
          <p class="t-lead" style="color:var(--color-stone-700)">
            Fabrication and machining sits directly downstream of the extrusion presses.
            Profiles move from cut-to-length saw, to heat treatment, to the fabrication
            floor — with no external handling or sub-contractor involvement. This integration
            eliminates dimensional variation introduced by multiple handling stages and
            ensures a continuous quality chain from billet to finished part.
          </p>
          <p class="t-body" style="color:var(--color-stone-700);margin-top:16px;line-height:1.7">
            The facility handles both high-volume repeat machining operations — drilling
            and cutting to standard patterns — and lower-volume complex machining for
            engineering and OEM customers requiring tight tolerances, multi-feature
            profiles, or sub-assembly into finished products.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Operations -->
  <section class="section-dark section-pad">
    <div class="container">
      <div class="eyebrow on-dark">/ 02 · Machining operations</div>
      <h2 class="t-h2" style="color:var(--color-platinum);margin-top:16px;margin-bottom:40px">
        Six operations.<br>One facility.
      </h2>
      <div class="fab-ops-grid">
        {operations.map((o, i) => (
          <div class="fab-op-card">
            <div class="fab-op-num">/ {String(i+1).padStart(2,'0')}</div>
            <h3 class="fab-op-name">{o.op}</h3>
            <p class="fab-op-desc">{o.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Assembly -->
  <section class="section-alt section-pad">
    <div class="container">
      <div class="eyebrow">/ 03 · Assembly & sub-assembly</div>
      <div class="fab-asm-grid">
        <div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            Profiles combined<br>into finished products.
          </h2>
          <p class="t-body" style="color:var(--color-stone-700);margin-top:20px;line-height:1.7">
            For OEM customers requiring finished sub-assemblies, Banco's assembly team
            combines extruded profiles with plastic accessories, steel hardware, gaskets,
            and fasteners. Window and door sub-assemblies, racking connectors, and
            structural brackets are built and packed to the customer's shipping specification.
          </p>
          <p class="t-body" style="color:var(--color-stone-700);margin-top:16px;line-height:1.7">
            Assembly operations follow customer-approved work instructions. First-off
            inspection and in-process dimensional checks ensure each assembly meets the
            drawing before packing. Traceability from profile lot number through to
            finished assembly carton is maintained throughout.
          </p>
        </div>
        <div class="fab-asm-list">
          {[
            ['Plastic accessories',    'Corner keys, weather strips, gaskets, end caps — assembled to profile.'],
            ['Steel hardware',         'Brackets, hinges, anchors, and fasteners fitted to profile and torqued to specification.'],
            ['Sub-frame assembly',     'Multi-profile window and door sub-frames assembled and packed flat.'],
            ['Custom cartons',         'Customer-specified packing — individual cartons, multi-unit trays, export pallets.'],
            ['Work instruction compliance', 'All assembly operations follow customer-approved WIs with first-off sign-off.'],
          ].map(([title, desc]) => (
            <div class="fab-asm-row">
              <div class="fab-asm-title">{title}</div>
              <div class="fab-asm-desc">{desc}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Throughput & tolerances -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="eyebrow">/ 04 · Throughput & tolerances</div>
      <div class="fab-tol-grid">
        <div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            Volume and precision<br>on the same floor.
          </h2>
          <p class="t-body" style="color:var(--color-stone-700);margin-top:20px;line-height:1.7">
            The fabrication floor runs two shifts. High-volume cutting and drilling operations
            run on dedicated CNC lines with automated part transfer. Complex machining and
            assembly operations are handled in a separate precision cell with CMM in-process
            verification.
          </p>
        </div>
        <div class="fab-tol-table">
          {[
            ['Daily throughput',     '10,000 parts / day (standard operations)'],
            ['Cut-to-length accuracy','±0.5 mm standard; ±0.2 mm precision'],
            ['Hole position',        '±0.1 mm CNC, ±0.3 mm jig drilling'],
            ['Milling tolerance',    '±0.05 mm on feature dimensions'],
            ['Profile length range', '50 mm – 6,500 mm'],
            ['Max. section weight',  '35 kg/m (Press 5 maximum)'],
            ['Min. wall (drill)',    '1.0 mm wall for standard drilling'],
          ].map(([k, v]) => (
            <div class="fab-trow">
              <span class="fab-tkey">{k}</span>
              <span class="fab-tval">{v}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-dark" style="padding:64px 0;border-top:2px solid var(--color-green)">
    <div class="container">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:32px">
        <div>
          <div class="eyebrow on-dark">Fabrication enquiries</div>
          <h2 class="t-h2" style="color:var(--color-platinum);margin-top:12px">
            Submit a drawing.<br>We'll quote machining and assembly.
          </h2>
        </div>
        <div style="display:flex;flex-direction:column;gap:12px">
          <a href="/contact#drawing" class="btn btn-primary-dark">Submit a drawing</a>
          <a href="/capabilities/extrusion" class="btn btn-secondary-dark">Extrusion</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .fab-hero {
    background: var(--color-navy);
    padding: 148px 0 0;
    position: relative;
    overflow: hidden;
  }
  .fab-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(90deg, transparent 0, transparent 3px, rgba(255,255,255,0.012) 3px, rgba(255,255,255,0.012) 4px);
    pointer-events: none;
  }
  .fab-hero > .container { position: relative; z-index: 1; }
  .fab-h1 { font-family: var(--font-sans); font-size: clamp(36px, 5vw, 64px); font-weight: 800; letter-spacing: -0.04em; line-height: 0.95; color: var(--color-platinum); margin-top: 20px; }
  .fab-lead { font-family: var(--font-sans); font-size: clamp(15px, 1.4vw, 17px); line-height: 1.65; color: var(--color-silver); margin-top: 24px; max-width: 56ch; }
  .fab-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--color-navy-line); border-top: 1px solid var(--color-navy-line); margin-top: 48px; }
  .fab-stat { background: var(--color-navy-deep); padding: 22px 24px; }
  .fab-stat-n { font-family: var(--font-sans); font-size: clamp(18px, 2.2vw, 28px); font-weight: 700; letter-spacing: -0.03em; color: var(--color-platinum); }
  .fab-stat-l { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-nickel); margin-top: 6px; }

  .fab-overview-grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: clamp(40px, 6vw, 100px); align-items: start; margin-top: 32px; }

  .fab-ops-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--color-navy-line); border: 1px solid var(--color-navy-line); }
  .fab-op-card { background: var(--color-navy-soft); padding: 28px 24px; border-top: 2px solid var(--color-green); display: flex; flex-direction: column; gap: 10px; }
  .fab-op-num  { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.16em; color: var(--color-green); }
  .fab-op-name { font-family: var(--font-sans); font-size: 18px; font-weight: 700; color: var(--color-platinum); }
  .fab-op-desc { font-family: var(--font-sans); font-size: 13px; line-height: 1.65; color: var(--color-silver); }

  .fab-asm-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(40px, 6vw, 80px); align-items: start; margin-top: 32px; }
  .fab-asm-list { display: flex; flex-direction: column; gap: 0; border-top: 1px solid var(--color-stone-200); }
  .fab-asm-row  { padding: 14px 0; border-bottom: 1px solid var(--color-stone-200); }
  .fab-asm-title { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-green); margin-bottom: 4px; }
  .fab-asm-desc  { font-family: var(--font-sans); font-size: 13px; line-height: 1.55; color: var(--color-stone-700); }

  .fab-tol-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(40px, 6vw, 80px); align-items: start; margin-top: 32px; }
  .fab-tol-table { border-top: 1px solid var(--color-stone-200); }
  .fab-trow { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 11px 0; border-bottom: 1px solid var(--color-stone-200); }
  .fab-tkey { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-stone-400); flex-shrink: 0; }
  .fab-tval { font-family: var(--font-sans); font-size: 13px; color: var(--color-stone-700); text-align: right; }

  @media (max-width: 1024px) {
    .fab-stats { grid-template-columns: repeat(2, 1fr); }
    .fab-overview-grid { grid-template-columns: 1fr; }
    .fab-ops-grid { grid-template-columns: repeat(2, 1fr); }
    .fab-asm-grid { grid-template-columns: 1fr; }
    .fab-tol-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .fab-stats { grid-template-columns: 1fr 1fr; }
    .fab-ops-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
