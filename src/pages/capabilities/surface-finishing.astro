---
import Layout from '../../layouts/Layout.astro';
import Pic from '../../components/Pic.astro';

const advantages = [
  'Single point of responsibility for extrusion, treatment, and packing under one roof',
  'No transport damage between extrusion and surface treatment',
  'Alloy chemistry and temper matched to finish requirement before production starts',
  'Single certificate covering dimensions, mechanical properties, and coating spec',
  'Colour consistency across multi-batch orders using reference panels',
];
---

<Layout
  title="Surface finishing | Banco Aluminium"
  description="Powder coating, anodising and wood finishing in-house: QUALICOAT-approved powder coating at 60–80 μm, anodising from 5 to 25 μm and sublimation wood-effect finishes."
  transparentNav={true}
>

  <!-- ── HERO — compact 68vh ───────────────────────────────── -->
  <section class="sf-hero">
    <div class="sf-hero-media" aria-hidden="true">
      <video class="sf-hero-vid" autoplay muted loop playsinline preload="metadata" poster="/herovideo-poster.jpg">
        <source src="/herovideo-720.mp4" type="video/mp4" />
      </video>
      <div class="sf-hero-scrim"></div>
      <div class="sf-hero-grad"></div>
    </div>

    <div class="container sf-hero-body">
      <div class="eyebrow on-dark" data-reveal="fade" data-reveal-delay="1">
        Capabilities / Surface finishing
      </div>
      <h1 class="sf-h1" data-reveal data-reveal-delay="2">
        <span class="sf-item">Powder coating<span class="sf-sep" aria-hidden="true">•</span></span>
        <span class="sf-item">Anodising<span class="sf-sep" aria-hidden="true">•</span></span>
        <span class="sf-item">Wood finishing</span>
      </h1>
      <p class="sf-lede" data-reveal data-reveal-delay="3">
        QUALICOAT powder coating, anodising, wood-effect finishing, brushed, sandblasted,
        and mill finish. All in-house, billet to finished profile. No external handling,
        no traceability gaps, no colour drift between batches.
      </p>
      <div class="cap-stats" data-reveal data-reveal-delay="4">
        {[
          { n: 'QUALICOAT',   l: 'Approved powder coating' },
          { n: '5–25 μm',     l: 'Anodising' },
          { n: 'Sublimation', l: 'Wood-effect finishing' },
          { n: '60–80 μm',    l: 'Powder coating thickness' },
        ].map(({ n, l }) => (
          <div class="cap-stat">
            <div class="cap-stat-n">{n}</div>
            <div class="cap-stat-l">{l}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="sf-scroll-cue" aria-hidden="true">
      <span class="sf-scroll-line"></span>
    </div>
  </section>


  <!-- ── Finish samples strip ──────────────────────────────── -->
  <div class="sf-photo-strip">
    <div class="sf-photo-tile">
      <Pic
        src="/assets/capabilities/surface-finishing/wood-effect-finish.jpg"
        alt="Wood-effect sublimation finish on aluminium profiles — four wood grain colours"
        loading="lazy" sizes="(max-width:768px) 100vw, 33vw" />
      <div class="sf-photo-label">Wood-effect finish</div>
    </div>
    <div class="sf-photo-tile">
      <Pic
        src="/assets/capabilities/surface-finishing/anodised-finish.jpg"
        alt="Anodised aluminium profiles — black, gold, bronze and silver anodising"
        loading="lazy" sizes="(max-width:768px) 100vw, 33vw" />
      <div class="sf-photo-label">Anodising</div>
    </div>
    <div class="sf-photo-tile">
      <Pic
        src="/assets/capabilities/surface-finishing/powder-coated-finish.jpg"
        alt="Powder-coated aluminium profiles — black, grey, champagne and white"
        loading="lazy" sizes="(max-width:768px) 100vw, 33vw" />
      <div class="sf-photo-label">Powder coating</div>
    </div>
  </div>

  <!-- ── CLOSING BAND — advantages + CTA ───────────────────── -->
  <section class="sf-close">
    <div class="container sf-close-grid">

      <!-- advantages -->
      <div class="sf-adv" data-reveal="fade">
        <div class="eyebrow" style="margin-bottom:16px">In-house advantage</div>
        <h2 class="sf-adv-h3">
          Quality continuity.<br>Billet to finished profile.
        </h2>
        <div class="sf-adv-list">
          {advantages.map(pt => (
            <div class="sf-adv-item">
              <div class="sf-adv-dot"></div>
              <span>{pt}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- CTA card -->
      <div class="sf-cta-card" data-reveal="right">
        <div class="eyebrow on-dark" style="margin-bottom:14px">Surface finishing enquiries</div>
        <p class="sf-cta-h">
          Specify a finish.<br>RAL, NCS, or custom.
        </p>
        <p class="sf-cta-sub">
          Powder coat, anodising, and brushed finishes specified with every order.
          Colour matching, batch consistency, and QUALICOAT certification included.
        </p>
        <div class="sf-cta-btns">
          <a href="/products/architectural" class="btn btn-secondary-dark">Architectural profiles</a>
        </div>
      </div>

    </div>
  </section>

</Layout>

<style>
  /* ── HERO ──────────────────────────────────────────────── */
  .sf-hero {
    position: relative;
    background: var(--color-navy-deep);
    min-height: 68vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
  }
  .sf-hero-media { position: absolute; inset: 0; z-index: 0; }
  .sf-hero-vid {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: center 30%;
  }
  .sf-hero-scrim { position: absolute; inset: 0; background: rgba(6,21,37,0.70); }
  .sf-hero-grad {
    position: absolute; inset: 0;
    background:
      linear-gradient(110deg, rgba(6,21,37,0.88) 0%, rgba(6,21,37,0.22) 60%, rgba(6,21,37,0) 100%),
      linear-gradient(to bottom, transparent 40%, rgba(6,21,37,0.90) 100%);
  }
  .sf-hero-body {
    position: relative; z-index: 2;
    padding-top: 148px; padding-bottom: 28px;
  }
  .sf-h1 {
    font-family: var(--font-sans);
    font-size: clamp(38px, 5vw, 68px);
    font-weight: 800; letter-spacing: -0.04em;
    line-height: 0.95; color: var(--color-platinum);
    margin-top: 18px;
  }
  /* Three-item title: items stay whole, separators ride the line end */
  .sf-h1 { line-height: 1.02; text-wrap: balance; }
  .sf-item { white-space: nowrap; }
  .sf-sep { color: var(--color-green); font-weight: 400; margin: 0 0.28em 0 0.32em; }
  .sf-lede {
    color: var(--color-stone-400);
    font-size: clamp(14px, 1.3vw, 16px);
    line-height: 1.65; max-width: 54ch;
    margin-top: 20px;
  }

.sf-scroll-cue {
    position: absolute; bottom: 56px; right: clamp(20px,4vw,60px);
    z-index: 3;
  }
  .sf-scroll-line {
    display: block; width: 1px; height: 44px;
    background: linear-gradient(to bottom, var(--color-green), transparent);
    animation: sf-drop 2s ease-in-out infinite;
  }
  @keyframes sf-drop {
    0%   { transform: scaleY(0); transform-origin: top; opacity: 1; }
    50%  { transform: scaleY(1); transform-origin: top; }
    51%  { transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; opacity: 0; }
  }


  /* ── Finish samples strip ──────────────────────────────── */
  .sf-photo-strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; }
  .sf-photo-tile { position: relative; aspect-ratio: 4/3; overflow: hidden; }
  .sf-photo-tile :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; filter: brightness(0.85); transition: transform 0.5s ease, filter 0.3s ease; }
  .sf-photo-tile:hover :global(img) { transform: scale(1.04); filter: brightness(1); }
  .sf-photo-label {
    position: absolute; bottom: 0; left: 0; right: 0;
    padding: 40px 20px 14px;
    background: linear-gradient(transparent, rgba(8,27,48,0.80));
    font-family: var(--font-mono); font-size: max(10px, var(--fs-min,0px)); letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--color-nickel);
  }

  /* ── CLOSING BAND ──────────────────────────────────────── */
  .sf-close {
    background: var(--color-stone-100);
    border-bottom: 1px solid var(--color-stone-200);
    padding: 52px 0;
  }
  .sf-close-grid {
    display: grid; grid-template-columns: 1fr 360px;
    gap: clamp(32px, 5vw, 72px); align-items: start;
  }
  .sf-adv-h3 {
    font-family: var(--font-sans);
    font-size: clamp(20px, 2vw, 28px);
    font-weight: 700; letter-spacing: -0.02em;
    color: var(--color-navy); line-height: 1.15; margin-bottom: 20px;
  }
  .sf-adv-list {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 0; border-top: 1px solid var(--color-stone-200);
  }
  .sf-adv-item {
    display: flex; align-items: flex-start; gap: 10px;
    font-size: 13px; line-height: 1.58;
    color: var(--color-stone-700);
    padding: 11px 0;
    border-bottom: 1px solid var(--color-stone-200);
    padding-right: 16px;
  }
  .sf-adv-dot {
    width: 5px; height: 5px;
    background: var(--color-green); border-radius: 50%;
    flex-shrink: 0; margin-top: 6px;
  }

  /* CTA card */
  .sf-cta-card {
    background: var(--color-navy-deep);
    border-top: 2px solid var(--color-green);
    padding: 28px 28px 28px;
    display: flex; flex-direction: column; gap: 12px;
  }
  .sf-cta-h {
    font-family: var(--font-sans);
    font-size: clamp(20px, 2vw, 26px);
    font-weight: 700; letter-spacing: -0.02em;
    color: var(--color-platinum); line-height: 1.15;
  }
  .sf-cta-sub {
    font-size: 13px; line-height: 1.62;
    color: var(--color-stone-400);
  }
  .sf-cta-btns { display: flex; flex-direction: column; gap: 10px; margin-top: 4px; }


  /* ── RESPONSIVE ────────────────────────────────────────── */
  @media (max-width: 960px) {
    .sf-close-grid { grid-template-columns: minmax(0, 1fr); }
    .sf-adv-list { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    .sf-hero-vid    { display: none; }
    .sf-hero-grad   { background: rgba(6,21,37,0.90); }
    .sf-scroll-cue  { display: none; }
    .sf-photo-strip { grid-template-columns: 1fr; }
    .sf-photo-tile  { aspect-ratio: 16/9; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sf-hero-vid { display: none; }
    .sf-scroll-line { animation: none; opacity: 0.5; }
  }
</style>

<script>
  const v = document.querySelector<HTMLVideoElement>('.sf-hero-vid');
  if (v) document.addEventListener('visibilitychange', () => document.hidden ? v.pause() : v.play().catch(() => {}));
</script>
