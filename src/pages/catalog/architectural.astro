---
import CatalogLayout from '../../layouts/CatalogLayout.astro';

const sliding = [
  { num: '01', name: '18mm Series',           width: '18 mm',       glazing: 'Single glaze',              tier: 'Entry-level residential',                              desc: 'Compact sliding window system for standard residential openings. Narrowest face width in the Banco sliding range, suited to minimal profile footprint and single-glaze specification.' },
  { num: '02', name: '25mm Cardinal Series',  width: '25 mm',       glazing: 'Single or double glaze',    tier: 'Low-rise residential, up to 3 storeys',                 desc: 'Slimline sliding system with single or double glazing compatibility. 2-track and 3-track frame configurations.' },
  { num: '03', name: '27mm Euro Series',       width: '27 mm',       glazing: 'Single/double · grill track', tier: 'Residential and light commercial',                  desc: 'Structural sliding system available in standard 2-track and grill-track configurations. Grill-track accepts integral aluminium grille profiles.' },
  { num: '04', name: '27mm Slim Series',       width: '27 mm slim',  glazing: 'Single or double glaze',    tier: 'Premium residential, bungalows and low-rise',          desc: 'Slim-profile variant of the 27mm family. Optimised for premium residential bungalows and low-floor developments where visual lightness is a design priority.' },
  { num: '05', name: '29mm Cardinal Series',   width: '29 mm',       glazing: 'Single or double glaze',    tier: 'Residential and commercial',                           desc: 'High-performance flexible sliding system. Standard and slim-interlock configurations. Rain-force interlock option provides enhanced weathertightness for exposed elevations.' },
  { num: '06', name: '31mm Gulf Series',       width: '31 mm',       glazing: 'Single or double glaze',    tier: 'Residential and commercial',                           desc: 'Clean 31mm visible face width suited to residential and commercial buildings where a modern unornamented elevation is specified.' },
  { num: '07', name: '35mm Gulf Series',       width: '35 mm',       glazing: 'Single or double glaze',    tier: 'Residential and commercial, larger openings',          desc: 'Heavy-duty sliding system for larger residential and commercial window openings. Increased frame depth provides structural rigidity in wider spans and higher wind load zones.' },
  { num: '08', name: '35 × 75mm Euro Series',  width: '35 × 75 mm',  glazing: 'Single or double glaze',    tier: 'High-end residential and commercial, large-span',      desc: 'Premium heavy-duty sliding system. 75mm frame depth provides maximum structural rigidity in wide-span and tall opening configurations.' },
];

const casement = [
  { num: '09', name: '40mm Casement Series',  width: '40 mm', type: 'Openable casement windows', glazing: 'Single or double glaze', tier: 'Residential and commercial, inward or outward opening', desc: 'Inward or outward-opening single-sash casement window. Available in 2-in-1 frame, standard frame, and round-pipe mullion configurations. 40mm slim face width with high weather resistance.' },
  { num: '10', name: '50mm Casement Series',  width: '50 mm', type: 'Casement · doors · sliding-folding', glazing: 'Single or double glaze', tier: 'Residential and commercial: windows, entrance doors, bi-fold', desc: 'Versatile 50mm frame system spanning casement windows, hinged entrance doors, and sliding-folding bi-fold configurations. Suited to larger openings and commercial entrances.' },
];

const performance = [
  { cat: 'Wind resistance', std: 'EN 12211 / EN 12210', note: 'Class 1–5 (rated values in data sheet)' },
  { cat: 'Watertightness',  std: 'EN 1027 / EN 12208',  note: 'Class 1A–9A, rated values in data sheet' },
  { cat: 'Air permeability', std: 'EN 1026 / EN 12207', note: 'Class 1–4 (rated values in data sheet)' },
  { cat: 'Sound insulation', std: 'EN ISO 10140',        note: 'Rw values, configuration dependent' },
  { cat: 'Impact resistance', std: 'EN 13049',           note: 'Soft and hard body impact, rated by series' },
];

const finishes = [
  { name: 'Powder coating', desc: 'QUALICOAT-class durable coatings in any RAL or NCS colour. 60–80 μm standard film thickness. Interior and exterior grades.' },
  { name: 'Anodising',      desc: 'Class 20 anodising to EN 12373. Natural, champagne, bronze, and black options. Controlled bath process for colour consistency.' },
  { name: 'Brushed finish', desc: 'Directional mechanical brushed surface for contemporary aesthetic. Available for interior and exterior applications.' },
  { name: 'Sand-blast',     desc: 'Uniform matte texture for architectural applications requiring diffused reflection and refined industrial appearance.' },
  { name: 'Mill finish',    desc: 'As-extruded aluminium surface for downstream fabricators and specialist coating applicators. Supplied without additional treatment.' },
];

const capability = [
  { cap: 'In-house billet casting',     desc: 'Alloys 6063, 6060, 6005, with controlled Mg/Si ratio for architectural surface quality.' },
  { cap: 'Precision die design',        desc: 'Q-Form flow simulation, full 3D assembly model, 5-axis CNC die machining.' },
  { cap: 'Five direct-drive presses',   desc: '1,100–3,300 MT. Profile weight 0.29–35 kg/m. 35,000 MT/yr extrusion capacity.' },
  { cap: 'Anodising and powder coating', desc: 'Class 20 anodising (EN 12373). QUALICOAT powder coating. Full RAL/NCS colour range.' },
  { cap: 'Quality control',             desc: 'Dimensional inspection, mechanical property verification, ASCONA optical measurement systems.' },
];

const certs = ['ISO 9001:2015', 'ISO 14001:2015', 'ISO 45001:2018', 'IATF 16949:2016', 'CE (EN 15088)', 'IS 733 · IS 1285'];
---

<CatalogLayout
  title="Architectural Aluminium Fenestration Systems"
  subtitle="Ten series spanning sliding windows, openable casement windows, entrance doors, and sliding-folding systems. In-house alloy development, precision die design, and full surface finishing in Vadodara, Gujarat."
  catalogRef="BAP-ARCH-2026"
>

  <!-- Stats strip -->
  <div class="cat-stats">
    {[
      { n: '10',          l: 'Fenestration series' },
      { n: '5',           l: 'Surface finishes' },
      { n: 'EN 14351-1',  l: 'Test standard for all series' },
      { n: '1967',        l: 'Established in Vadodara' },
    ].map(({ n, l }) => (
      <div class="cat-stat">
        <div class="cat-stat-n">{n}</div>
        <div class="cat-stat-l">{l}</div>
      </div>
    ))}
  </div>

  <!-- Sliding window series -->
  <section class="cat-section">
    <div class="cat-section-label">/ 01 · Sliding window systems</div>
    <h2 class="cat-h2">Eight sliding series, 18 mm to 35 × 75 mm.</h2>
    <p class="cat-body">
      The sliding range spans entry-level residential windows through to heavy-duty commercial systems
      for large-span openings in tall buildings. All series are available in 2-track and 3-track frame
      configurations unless otherwise noted.
    </p>
    <table class="cat-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Series</th>
          <th>Face width</th>
          <th>Glazing</th>
          <th>Application</th>
        </tr>
      </thead>
      <tbody>
        {sliding.map((s, i) => (
          <tr class={i % 2 === 0 ? 'cat-row-even' : 'cat-row-odd'}>
            <td class="cat-td-mono">{s.num}</td>
            <td class="cat-td-name">{s.name}</td>
            <td class="cat-td-width">{s.width}</td>
            <td class="cat-td-note">{s.glazing}</td>
            <td class="cat-td-body">{s.tier}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <!-- Extended descriptions -->
    <div class="cat-series-list">
      {sliding.map((s) => (
        <div class="cat-series-row">
          <div class="cat-series-head">
            <span class="cat-series-num">{s.num}</span>
            <span class="cat-series-name">{s.name}</span>
            <span class="cat-series-width">{s.width}</span>
          </div>
          <p class="cat-series-desc">{s.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Casement & folding series -->
  <section class="cat-section cat-page-break">
    <div class="cat-section-label">/ 02 · Casement, door &amp; folding systems</div>
    <h2 class="cat-h2">40mm and 50mm casement: windows, doors, bi-fold.</h2>
    <div class="cat-casement-grid">
      {casement.map((s) => (
        <div class="cat-casement-card">
          <div class="cat-casement-header">
            <span class="cat-series-num">{s.num}</span>
            <span class="cat-series-width">{s.width}</span>
          </div>
          <div class="cat-casement-name">{s.name}</div>
          <div class="cat-casement-type">{s.type}</div>
          <p class="cat-series-desc">{s.desc}</p>
          <div class="cat-casement-foot">
            <span class="cat-chip">{s.glazing}</span>
            <span class="cat-chip">{s.tier}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Performance standards -->
  <section class="cat-section">
    <div class="cat-section-label">/ 03 · Performance standards</div>
    <h2 class="cat-h2">Tested to EN 14351-1.</h2>
    <p class="cat-body">
      All Banco architectural series are manufactured and tested in accordance with EN 14351-1:2006+A2:2016
      (Windows and doors: performance characteristics and classification). Rated values per series are
      available in the product technical data sheets. Contact the technical team.
    </p>
    <table class="cat-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Performance category</th>
          <th>Test standard</th>
          <th>Classification</th>
        </tr>
      </thead>
      <tbody>
        {performance.map((p, i) => (
          <tr class={i % 2 === 0 ? 'cat-row-even' : 'cat-row-odd'}>
            <td class="cat-td-mono">{String(i + 1).padStart(2, '0')}</td>
            <td class="cat-td-name">{p.cat}</td>
            <td class="cat-td-note">{p.std}</td>
            <td class="cat-td-note">{p.note}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <!-- Surface finishes -->
  <section class="cat-section">
    <div class="cat-section-label">/ 04 · Surface finishing</div>
    <h2 class="cat-h2">Five finishes, full RAL and NCS range.</h2>
    <table class="cat-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Finish</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        {finishes.map((f, i) => (
          <tr class={i % 2 === 0 ? 'cat-row-even' : 'cat-row-odd'}>
            <td class="cat-td-mono">{String(i + 1).padStart(2, '0')}</td>
            <td class="cat-td-key">{f.name}</td>
            <td class="cat-td-body">{f.desc}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <!-- In-house capability -->
  <section class="cat-section cat-page-break">
    <div class="cat-section-label">/ 05 · In-house platform</div>
    <h2 class="cat-h2">From alloy to finished profile, under one roof.</h2>
    <p class="cat-body">
      Every architectural profile starts in Banco's in-house foundry with controlled alloy chemistry for
      anodising quality, typically 6063 or 6060. Custom dies are designed with Q-Form simulation and
      precision CNC machined. Profiles are extruded, heat-treated, and surface-finished without leaving
      the facility.
    </p>
    <table class="cat-table">
      <tbody>
        {capability.map((c, i) => (
          <tr class={i % 2 === 0 ? 'cat-row-even' : 'cat-row-odd'}>
            <td class="cat-td-key">{c.cap}</td>
            <td class="cat-td-body">{c.desc}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <!-- Certifications -->
  <section class="cat-section">
    <div class="cat-section-label">/ 06 · Certifications</div>
    <div class="cat-cert-row">
      {certs.map(c => <span class="cat-cert">{c}</span>)}
    </div>
  </section>

  <!-- Contact strip -->
  <div class="cat-contact">
    <div>
      <div class="cat-contact-label">System specification &amp; enquiries</div>
      <div class="cat-contact-detail">commercial@bancoaluminium.com · bancoaluminium.com/contact</div>
    </div>
    <div>
      <div class="cat-contact-label">Technical data sheets</div>
      <div class="cat-contact-detail">technical@bancoaluminium.com</div>
    </div>
    <div>
      <div class="cat-contact-label">Head office</div>
      <div class="cat-contact-detail">Vadodara, Gujarat, India · Est. 1967</div>
    </div>
  </div>

</CatalogLayout>

<style>
  /* Shared styles (same as industrial) */
  .cat-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--color-stone-200);
    border: 1px solid var(--color-stone-200);
    margin: 32px 0 0;
  }
  .cat-stat { background: var(--color-stone-50); padding: 16px 20px; }
  .cat-stat-n { font-family: var(--font-sans); font-size: 20px; font-weight: 700; letter-spacing: -0.03em; color: var(--color-navy); }
  .cat-stat-l { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-stone-400); margin-top: 4px; }

  .cat-section { padding: 32px 0 0; border-top: 1px solid var(--color-stone-200); margin-top: 32px; }
  .cat-section-label { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-green); margin-bottom: 8px; }
  .cat-h2 { font-family: var(--font-sans); font-size: 20px; font-weight: 700; letter-spacing: -0.02em; color: var(--color-navy); margin: 0 0 16px; line-height: 1.15; }
  .cat-body { font-family: var(--font-sans); font-size: 13px; line-height: 1.65; color: var(--color-stone-700); margin: 0 0 16px; max-width: 80ch; }

  .cat-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .cat-chip { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-navy); border: 1px solid var(--color-stone-200); padding: 3px 8px; background: white; }

  .cat-table { width: 100%; border-collapse: collapse; font-family: var(--font-sans); font-size: 12px; margin-top: 16px; border: 1px solid var(--color-stone-200); }
  .cat-table thead tr { background: var(--color-navy); }
  .cat-table th { padding: 9px 12px; text-align: left; font-family: var(--font-mono); font-size: 9px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-nickel); border-right: 1px solid var(--color-navy-line); }
  .cat-table th:last-child { border-right: none; }
  .cat-row-even { background: var(--color-stone-50); }
  .cat-row-odd  { background: white; }
  .cat-table td { padding: 9px 12px; border-right: 1px solid var(--color-stone-200); border-bottom: 1px solid var(--color-stone-200); vertical-align: top; }
  .cat-table td:last-child { border-right: none; }
  .cat-td-mono   { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em; color: var(--color-stone-400); white-space: nowrap; }
  .cat-td-name   { font-weight: 600; color: var(--color-navy); white-space: nowrap; }
  .cat-td-width  { font-family: var(--font-sans); font-size: 14px; font-weight: 700; letter-spacing: -0.02em; color: var(--color-navy); white-space: nowrap; }
  .cat-td-note   { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; color: var(--color-stone-400); }
  .cat-td-body   { color: var(--color-stone-700); line-height: 1.55; font-size: 12px; }
  .cat-td-key    { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-navy); white-space: nowrap; font-weight: 500; }

  /* Extended series list */
  .cat-series-list { display: flex; flex-direction: column; gap: 0; margin-top: 16px; border: 1px solid var(--color-stone-200); }
  .cat-series-row { padding: 12px 16px; border-bottom: 1px solid var(--color-stone-200); }
  .cat-series-row:last-child { border-bottom: none; }
  .cat-series-head { display: flex; align-items: baseline; gap: 10px; margin-bottom: 4px; }
  .cat-series-num  { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.14em; color: var(--color-green); }
  .cat-series-name { font-family: var(--font-sans); font-size: 13px; font-weight: 600; color: var(--color-navy); }
  .cat-series-width { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em; color: var(--color-stone-400); margin-left: auto; }
  .cat-series-desc { font-family: var(--font-sans); font-size: 12px; line-height: 1.6; color: var(--color-stone-700); margin: 0; }

  /* Casement cards */
  .cat-casement-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--color-stone-200); border: 1px solid var(--color-stone-200); margin-top: 16px; }
  .cat-casement-card { background: var(--color-stone-50); padding: 20px; display: flex; flex-direction: column; gap: 8px; border-top: 2px solid var(--color-green); }
  .cat-casement-header { display: flex; align-items: baseline; justify-content: space-between; }
  .cat-casement-name { font-family: var(--font-sans); font-size: 15px; font-weight: 700; color: var(--color-navy); }
  .cat-casement-type { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-stone-400); }
  .cat-casement-foot { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; padding-top: 8px; border-top: 1px solid var(--color-stone-200); }

  /* Certifications */
  .cat-cert-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .cat-cert { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-navy); border: 1px solid var(--color-navy-line); padding: 5px 12px; background: var(--color-stone-50); }

  /* Contact strip */
  .cat-contact { margin-top: 32px; padding: 20px 24px; background: var(--color-navy); display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .cat-contact-label { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-green); margin-bottom: 4px; }
  .cat-contact-detail { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; color: var(--color-silver); line-height: 1.5; }

  .cat-page-break { page-break-before: always; }

  @media print {
    .cat-stats { grid-template-columns: repeat(4, 1fr); }
    .cat-casement-grid { grid-template-columns: 1fr 1fr; }
    .cat-contact { grid-template-columns: repeat(3, 1fr); }
    .cat-section { break-inside: avoid; }
    .cat-table tr { break-inside: avoid; }
  }
  @media (max-width: 640px) {
    .cat-stats { grid-template-columns: 1fr 1fr; }
    .cat-casement-grid { grid-template-columns: 1fr; }
    .cat-contact { grid-template-columns: 1fr; }
  }
</style>
