---
import CatalogLayout from '../../layouts/CatalogLayout.astro';

const industries = [
  { num: '01', name: 'Electrical & power transmission',      note: 'Busbar · T&D profiles · cable management' },
  { num: '02', name: 'Automotive & commercial vehicles',     note: 'Structural · trim · thermal management' },
  { num: '03', name: 'Machinery & automation',               note: 'Machine frames · linear guides · housings' },
  { num: '04', name: 'Heat sinks & heat exchangers',         note: 'Extruded fin · skived · bonded assemblies' },
  { num: '05', name: 'Aerospace & defence',                  note: 'Cryogenic · structural · precision sections' },
  { num: '06', name: 'Hydraulics & pneumatics',              note: 'Cylinder tubes · manifold bodies · rods' },
  { num: '07', name: 'Railways & shipbuilding',              note: 'Structural · floor panels · marine profiles' },
  { num: '08', name: 'Solar & alternative energy',           note: 'Mounting frames · tracker rails · inverter housings' },
  { num: '09', name: 'Material handling & structural',       note: 'Modular rack · conveyor · frame sections' },
  { num: '10', name: 'Pumps, motors & general engineering',  note: 'Motor bodies · pump housings · shafts' },
  { num: '11', name: 'Forging & precision machining',        note: 'Machining billets · forging stock · turned parts' },
  { num: '12', name: 'Transport & elevator systems',         note: 'Vehicle profiles · elevator guide rails · enclosures' },
];

const alloyFamilies = [
  {
    title: 'Hard alloys',
    sub: 'Structural · automotive · aerospace',
    desc: 'High-strength alloys for demanding structural and mechanical applications. More flexible and corrosion-resistant than steel, suited to safety-critical and load-bearing profiles.',
    grades: ['2011', '2014', '2017A', '5083', '5754', '6026', '6061', '6066', '6082', '6262'],
    note: 'Series 2xxx · 5xxx · 6xxx',
  },
  {
    title: 'Lead-free machining alloys',
    sub: 'RoHS · automated CNC machining',
    desc: 'Specifically formulated machining grades that comply with the RoHS directive. Designed for automated CNC machining where lead-containing alloys cannot be specified.',
    grades: ['2111 LF', '2033 LF', '6026 LF'],
    note: 'RoHS compliant · custom compositions available',
  },
  {
    title: 'Soft and medium alloys',
    sub: 'General · architectural · electrical',
    desc: 'The 1xxx, 3xxx, and 6xxx series for architectural, electrical, and general engineering — from food-grade packaging and utensils to building profiles, transport, and renewables.',
    grades: ['1050', '1070', '1100', '3003', '3103', '6060', '6063'],
    note: 'Series 1xxx · 3xxx · 6xxx',
  },
];

const capabilities = [
  { num: '01', name: 'Die design and development', desc: 'Customer drawings translated into production tooling using Q-Form flow simulation and 3D assembly models. 5-axis CNC die machining. Trial extrusions and sample approval before production release.' },
  { num: '02', name: 'Extrusion',                  desc: 'Five direct-drive presses from 1,100 to 3,300 MT. Profile weight 0.29–35 kg/m. 35,000 MT annual capacity. Alloys 1xxx through 7xxx.' },
  { num: '03', name: 'Heat treatment',              desc: 'In-line and batch heat treatment to T5, T6, and T73 tempers. Controlled ageing ensures consistent tensile properties and hardness.' },
  { num: '04', name: 'Fabrication and machining',   desc: 'Cutting, drilling, milling, punching, and bending to dimensional specifications. Assembly of profiles with hardware components. 10,000 parts/day throughput.' },
  { num: '05', name: 'Cold drawing',                desc: 'Precision rods, bars, and tubes drawn through single or series of dies. Achieves dimensions beyond direct extrusion limits with consistent dimensional tolerance and superior surface finish.' },
  { num: '06', name: 'Surface finishing',           desc: 'Mill finish, anodising (Class 20, EN 12373), powder coating (QUALICOAT), and mechanical finishes. Full RAL and NCS colour range. In-house operations.' },
];

const workflow = [
  { num: '01', step: 'Customer drawing or sample submission',  note: 'DXF, DWG, STEP, PDF, or physical sample accepted' },
  { num: '02', step: 'Die design and Q-Form simulation',       note: 'Flow analysis · weld seam prediction · dimensional review' },
  { num: '03', step: 'Die manufacture and trial extrusion',    note: '5-axis CNC die machining · trial run · dimensional report' },
  { num: '04', step: 'Sample approval',                        note: 'Dimensional certificate · mechanical properties · surface report' },
  { num: '05', step: 'Value-added processing',                 note: 'Heat treatment · fabrication · cold drawing · finishing' },
  { num: '06', step: 'Repeat supply and quality control',      note: 'SCADA traceability · customer-specific packing · export documentation' },
];

const packingInternal = [
  { name: 'Bare',              desc: 'Profiles stacked without separation — standard for immediate processing.' },
  { name: 'Paper layer',       desc: 'Thin paper between rows prevents surface friction during transport.' },
  { name: 'Paper interleave',  desc: 'Paper interleaved between individual bars for additional surface protection.' },
  { name: 'Cardboard strip',   desc: 'Horizontal cardboard between layers. Spacing determined per profile specification.' },
  { name: 'Wrapped profiles',  desc: 'Individual bars wrapped in crepe paper, bubble wrap, or nylon.' },
];

const packingExternal = [
  { name: 'Wooden bundle',  desc: '8×10 cm base blocks, 2×9 cm side lumber, 2×18 cm upper lumber. Plastic strapped.' },
  { name: 'Cardboard box',  desc: 'Cardboard wrapped around the package. Protection for surface-sensitive profiles.' },
  { name: 'Wooden pallet',  desc: '2×9×300 cm boards at package base. Forklift handling compatibility.' },
  { name: 'Stretch film',   desc: 'Four-side stretch film wrap. Protection from moisture and dust in transit.' },
  { name: 'Plastic wrap',   desc: 'Nylon wrapping on four sides and edges. Protection from moisture and contamination.' },
];

const certs = ['ISO 9001:2015', 'ISO 14001:2015', 'ISO 45001:2018', 'IATF 16949:2016', 'CE (EN 15088)', 'IRS Works Approval', 'IS 733 · IS 1285 · IS 5082'];
---

<CatalogLayout
  title="Industrial & OEM Aluminium Profiles"
  subtitle="Drawing-led extrusion profiles for OEM applications. Hard alloys, lead-free machining grades, cold drawing, and full surface finishing under one roof in Vadodara, Gujarat, India."
  catalogRef="BAP-IND-2026"
>

  <!-- Stats strip -->
  <div class="cat-stats">
    {[
      { n: '35,000 MT', l: 'Annual extrusion capacity' },
      { n: '1,100+',   l: 'Customers worldwide' },
      { n: '10,000',   l: 'Parts/day — fabrication' },
      { n: '12',       l: 'Industry sectors' },
    ].map(({ n, l }) => (
      <div class="cat-stat">
        <div class="cat-stat-n">{n}</div>
        <div class="cat-stat-l">{l}</div>
      </div>
    ))}
  </div>

  <!-- Overview -->
  <section class="cat-section">
    <div class="cat-section-label">/ 01 · Industrial overview</div>
    <h2 class="cat-h2">From drawing to repeat supply.</h2>
    <p class="cat-body">
      Banco Aluminium operates as an integrated OEM extrusion partner — taking customer drawings into
      production with die design, trial, and approval managed in-house before a single production kilogram
      is extruded. The scope spans standard to complex cross-sections in alloys across the 1xxx to 7xxx
      series. Downstream from the press, profiles move directly into heat treatment, precision machining,
      cold drawing, and surface finishing — all on the same site.
    </p>
    <div class="cat-chips">
      {['Drawing-led die development', 'Hard alloy specialisation', 'Lead-free RoHS grades', 'Cold drawing capability', 'IATF 16949 certified', 'CBAM-ready export documentation'].map(c => (
        <span class="cat-chip">{c}</span>
      ))}
    </div>
  </section>

  <!-- Alloy families -->
  <section class="cat-section cat-page-break">
    <div class="cat-section-label">/ 02 · Alloy range</div>
    <h2 class="cat-h2">Hard alloys · Lead-free grades · Standard 6xxx series.</h2>
    <div class="cat-alloy-grid">
      {alloyFamilies.map((fam, i) => (
        <div class="cat-alloy-card">
          <div class="cat-alloy-num">{String(i + 1).padStart(2, '0')}</div>
          <div class="cat-alloy-title">{fam.title}</div>
          <div class="cat-alloy-sub">{fam.sub}</div>
          <p class="cat-alloy-desc">{fam.desc}</p>
          <div class="cat-alloy-grades">
            {fam.grades.map(g => <span class="cat-grade">{g}</span>)}
          </div>
          <div class="cat-alloy-note">{fam.note}</div>
        </div>
      ))}
    </div>
    <p class="cat-footnote">
      Custom alloy development available — including customer-specified Mg/Si ratios, lead-free conversions,
      and enhanced-machinability compositions. Alloy data sheets available on request.
    </p>
  </section>

  <!-- Industries served -->
  <section class="cat-section">
    <div class="cat-section-label">/ 03 · Industries served</div>
    <h2 class="cat-h2">12 industry sectors.</h2>
    <table class="cat-table">
      <thead>
        <tr>
          <th style="width:36px">#</th>
          <th>Sector</th>
          <th>Profile applications</th>
        </tr>
      </thead>
      <tbody>
        {industries.map((ind, i) => (
          <tr class={i % 2 === 0 ? 'cat-row-even' : 'cat-row-odd'}>
            <td class="cat-td-mono">{ind.num}</td>
            <td class="cat-td-name">{ind.name}</td>
            <td class="cat-td-note">{ind.note}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <!-- Capability chain -->
  <section class="cat-section cat-page-break">
    <div class="cat-section-label">/ 04 · Capability chain</div>
    <h2 class="cat-h2">Six integrated stages under one roof.</h2>
    <table class="cat-table">
      <thead>
        <tr>
          <th style="width:36px">#</th>
          <th>Stage</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        {capabilities.map((cap, i) => (
          <tr class={i % 2 === 0 ? 'cat-row-even' : 'cat-row-odd'}>
            <td class="cat-td-mono">{cap.num}</td>
            <td class="cat-td-name">{cap.name}</td>
            <td class="cat-td-body">{cap.desc}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <!-- How to order -->
  <section class="cat-section">
    <div class="cat-section-label">/ 05 · How to order</div>
    <h2 class="cat-h2">Submit a drawing. We handle the rest.</h2>
    <p class="cat-body" style="margin-bottom:16px">
      New profile development follows a six-step process from drawing submission to approved repeat
      production. Customer approval is required at each gate before the process advances.
    </p>
    <table class="cat-table">
      <thead>
        <tr>
          <th style="width:36px">Step</th>
          <th>Action</th>
          <th>Details</th>
        </tr>
      </thead>
      <tbody>
        {workflow.map((w, i) => (
          <tr class={i % 2 === 0 ? 'cat-row-even' : 'cat-row-odd'}>
            <td class="cat-td-green">{w.num}</td>
            <td class="cat-td-name">{w.step}</td>
            <td class="cat-td-note">{w.note}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <!-- Packing options -->
  <section class="cat-section cat-page-break">
    <div class="cat-section-label">/ 06 · Packing options</div>
    <h2 class="cat-h2">Customer-specified packing. Export-ready from despatch.</h2>
    <div class="cat-two-col">
      <div>
        <div class="cat-col-label">Internal protection</div>
        <table class="cat-table">
          <tbody>
            {packingInternal.map((p, i) => (
              <tr class={i % 2 === 0 ? 'cat-row-even' : 'cat-row-odd'}>
                <td class="cat-td-key">{p.name}</td>
                <td class="cat-td-body">{p.desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div>
        <div class="cat-col-label">External bundle packing</div>
        <table class="cat-table">
          <tbody>
            {packingExternal.map((p, i) => (
              <tr class={i % 2 === 0 ? 'cat-row-even' : 'cat-row-odd'}>
                <td class="cat-td-key">{p.name}</td>
                <td class="cat-td-body">{p.desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Certifications -->
  <section class="cat-section">
    <div class="cat-section-label">/ 07 · Certifications</div>
    <div class="cat-cert-row">
      {certs.map(c => <span class="cat-cert">{c}</span>)}
    </div>
  </section>

  <!-- Contact strip -->
  <div class="cat-contact">
    <div>
      <div class="cat-contact-label">New enquiries &amp; drawing submissions</div>
      <div class="cat-contact-detail">commercial@bancoaluminium.com · bancoaluminium.com/contact</div>
    </div>
    <div>
      <div class="cat-contact-label">Technical team</div>
      <div class="cat-contact-detail">technical@bancoaluminium.com · bancoaluminium.com</div>
    </div>
    <div>
      <div class="cat-contact-label">Head office</div>
      <div class="cat-contact-detail">Vadodara, Gujarat, India · Est. 1967</div>
    </div>
  </div>

</CatalogLayout>

<style>
  /* ── Shared catalog page styles ──────────────────────────────────────── */
  .cat-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--color-stone-200);
    border: 1px solid var(--color-stone-200);
    margin: 32px 0 0;
  }
  .cat-stat {
    background: var(--color-stone-50);
    padding: 16px 20px;
  }
  .cat-stat-n {
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-navy);
  }
  .cat-stat-l {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-stone-400);
    margin-top: 4px;
  }

  .cat-section {
    padding: 32px 0 0;
    border-top: 1px solid var(--color-stone-200);
    margin-top: 32px;
  }
  .cat-section:first-of-type { margin-top: 32px; }

  .cat-section-label {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-green);
    margin-bottom: 8px;
  }
  .cat-h2 {
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-navy);
    margin: 0 0 16px;
    line-height: 1.15;
  }
  .cat-body {
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.65;
    color: var(--color-stone-700);
    margin: 0 0 16px;
    max-width: 80ch;
  }
  .cat-footnote {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.08em;
    color: var(--color-stone-400);
    line-height: 1.6;
    margin-top: 12px;
  }

  /* Chips */
  .cat-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .cat-chip {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-navy);
    border: 1px solid var(--color-stone-200);
    padding: 3px 8px;
    background: white;
  }

  /* Alloy grid */
  .cat-alloy-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--color-stone-200);
    border: 1px solid var(--color-stone-200);
    margin-top: 16px;
  }
  .cat-alloy-card {
    background: var(--color-stone-50);
    padding: 20px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-top: 2px solid var(--color-green);
  }
  .cat-alloy-num { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.16em; color: var(--color-green); }
  .cat-alloy-title { font-family: var(--font-sans); font-size: 14px; font-weight: 700; color: var(--color-navy); }
  .cat-alloy-sub { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-stone-400); }
  .cat-alloy-desc { font-family: var(--font-sans); font-size: 12px; line-height: 1.6; color: var(--color-stone-700); }
  .cat-alloy-grades { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 6px; padding-top: 6px; border-top: 1px solid var(--color-stone-200); }
  .cat-grade { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.08em; color: var(--color-navy); background: white; border: 1px solid var(--color-stone-200); padding: 2px 7px; }
  .cat-alloy-note { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-stone-400); }

  /* Tables */
  .cat-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-sans);
    font-size: 12px;
    margin-top: 16px;
    border: 1px solid var(--color-stone-200);
  }
  .cat-table thead tr { background: var(--color-navy); }
  .cat-table th {
    padding: 9px 12px;
    text-align: left;
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-nickel);
    border-right: 1px solid var(--color-navy-line);
  }
  .cat-table th:last-child { border-right: none; }
  .cat-row-even { background: var(--color-stone-50); }
  .cat-row-odd  { background: white; }
  .cat-table td {
    padding: 9px 12px;
    border-right: 1px solid var(--color-stone-200);
    border-bottom: 1px solid var(--color-stone-200);
    vertical-align: top;
  }
  .cat-table td:last-child { border-right: none; }
  .cat-td-mono   { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em; color: var(--color-stone-400); white-space: nowrap; }
  .cat-td-green  { font-family: var(--font-mono); font-size: 13px; font-weight: 500; color: var(--color-green); }
  .cat-td-name   { font-weight: 600; color: var(--color-navy); white-space: nowrap; }
  .cat-td-note   { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; color: var(--color-stone-400); }
  .cat-td-body   { color: var(--color-stone-700); line-height: 1.55; }
  .cat-td-key    { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-navy); white-space: nowrap; font-weight: 500; }

  /* Two-column packing */
  .cat-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .cat-col-label {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-green);
    margin-bottom: 4px;
  }

  /* Certifications */
  .cat-cert-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .cat-cert {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-navy);
    border: 1px solid var(--color-navy-line);
    padding: 5px 12px;
    background: var(--color-stone-50);
  }

  /* Contact strip */
  .cat-contact {
    margin-top: 32px;
    padding: 20px 24px;
    background: var(--color-navy);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .cat-contact-label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-green);
    margin-bottom: 4px;
  }
  .cat-contact-detail {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--color-silver);
    line-height: 1.5;
  }

  /* Page break helpers */
  .cat-page-break { page-break-before: always; }

  /* ── Print adjustments ─────────────────────────────────────────────── */
  @media print {
    .cat-stats { grid-template-columns: repeat(4, 1fr); }
    .cat-alloy-grid { grid-template-columns: repeat(3, 1fr); }
    .cat-two-col { grid-template-columns: 1fr 1fr; }
    .cat-contact { grid-template-columns: repeat(3, 1fr); }
    .cat-section { break-inside: avoid; }
    .cat-table { break-inside: auto; }
    .cat-table tr { break-inside: avoid; }
  }

  @media (max-width: 640px) {
    .cat-stats      { grid-template-columns: 1fr 1fr; }
    .cat-alloy-grid { grid-template-columns: 1fr; }
    .cat-two-col    { grid-template-columns: 1fr; }
    .cat-contact    { grid-template-columns: 1fr; }
  }
</style>
