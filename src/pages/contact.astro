---
import Layout from '../layouts/Layout.astro';
import Pic from '../components/Pic.astro';

const localBusinessLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Banco Aluminium Private Limited',
  url: 'https://bancoaluminium.com/contact/',
  image: 'https://bancoaluminium.com/og-image.jpg',
  email: 'info@bancoaluminium.com',
  foundingDate: '1967',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Vadodara',
    addressRegion: 'Gujarat',
    addressCountry: 'IN',
  },
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'sales',
      email: 'info@bancoaluminium.com',
      areaServed: ['IN', 'EU', 'US', 'AE'],
      availableLanguage: ['en'],
    },
  ],
};
---

<Layout
  title="Request a Quote from Banco Aluminium"
  description="Request a quote, send a drawing or schedule a plant visit. Banco Aluminium, Vadodara, India, exporting to Europe, North America, APAC and the Middle East."
>
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessLd)} />

  <!-- Hero -->
  <section class="ct-hero">
    <div class="ct-hero-bg" aria-hidden="true">
      <Pic src="/assets/manufacturing/industrialOEMS.webp" alt="" loading="eager" sizes="100vw" />
    </div>
    <div class="ct-hero-overlay" aria-hidden="true"></div>
    <div class="container" style="position:relative;z-index:2">
      <div class="eyebrow on-dark">Get in touch</div>
      <h1 class="t-h1" style="color:var(--color-stone-50);margin-top:20px">
        Start with your<br/><em class="accent">drawing.</em>
      </h1>
      <p class="t-lead" style="color:var(--color-stone-400);margin-top:20px;max-width:52ch">
        Send us a drawing, a sample, or a specification. Our technical team will respond
        within one business day with material options, tooling feasibility, and lead-time
        indication.
      </p>
      <!-- Process: 3 steps inline -->
      <div class="ct-steps">
        {([
          { n: '01', step: 'Submit a drawing or requirement', note: 'DXF, DWG, STEP, PDF, or specification sheet' },
          { n: '02', step: 'Our team reviews feasibility',    note: 'Material options · tooling · lead time (within 1 business day)' },
          { n: '03', step: 'Receive a detailed quotation',    note: 'Price, delivery schedule, and sample plan' },
        ] as const).map(({ n, step, note }) => (
          <div class="ct-step">
            <div class="ct-step-n">{n}</div>
            <div class="ct-step-body">
              <div class="ct-step-title">{step}</div>
              <div class="ct-step-note">{note}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Forms + info -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="ct-split">

        <!-- Quote form -->
        <div id="quote">
          <div class="eyebrow">Request a quote</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px;margin-bottom:40px">
            Tell us about your<br/><em class="accent">requirement.</em>
          </h2>

          <form
            name="quote-request"
            method="POST"
            action="/contact/success"
            enctype="multipart/form-data"
            class="cform"
          >
            <!-- Netlify / static host honeypot field -->
            <input type="hidden" name="form-name" value="quote-request" />
            <input type="hidden" name="enquiry_source" id="f-enquiry-source" value="" />
            <p style="display:none"><input name="bot-field" /></p>

            <div class="cform-row">
              <div class="cform-field">
                <label for="f-company" class="cform-label">Company name *</label>
                <input id="f-company" type="text" name="company" required class="cform-input" autocomplete="organization" />
              </div>
              <div class="cform-field">
                <label for="f-name" class="cform-label">Contact name *</label>
                <input id="f-name" type="text" name="name" required class="cform-input" autocomplete="name" />
              </div>
            </div>

            <div class="cform-row">
              <div class="cform-field">
                <label for="f-email" class="cform-label">Email address *</label>
                <input id="f-email" type="email" name="email" required class="cform-input" autocomplete="email" />
              </div>
              <div class="cform-field">
                <label for="f-country" class="cform-label">Country</label>
                <input id="f-country" type="text" name="country" class="cform-input" autocomplete="country-name" />
              </div>
            </div>

            <div class="cform-field">
              <label for="f-product" class="cform-label">Product / application *</label>
              <div class="cform-select-wrap">
                <select id="f-product" name="product_type" required class="cform-input cform-select">
                  <option value="">Select a product family</option>
                  <option value="industrial">Industrial profiles (OEM)</option>
                  <option value="architectural">Architectural systems</option>
                  <option value="cast">Cast products (billets)</option>
                  <option value="standard">Standard sections</option>
                  <option value="custom">Custom profiles</option>
                  <option value="other">Other / not sure</option>
                </select>
                <svg class="cform-chevron" width="12" height="8" viewBox="0 0 12 8" fill="none" aria-hidden="true">
                  <path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </div>
            </div>

            <div class="cform-field">
              <label for="f-message" class="cform-label">Requirement details</label>
              <textarea
                id="f-message"
                name="message"
                rows="5"
                class="cform-input cform-textarea"
                placeholder="Alloy, profile dimensions, annual volume, end application, certifications required…"
              ></textarea>
            </div>

            <div class="cform-field">
              <label for="f-drawing" class="cform-label">Attach drawing / DXF (optional)</label>
              <input id="f-drawing" type="file" name="drawing" accept=".pdf,.dxf,.dwg,.step,.stp,.png,.jpg" class="cform-file" />
            </div>

            <button type="submit" class="btn btn-primary cform-submit">
              Send enquiry
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </button>
          </form>

          <script>
            // Tag enquiries with their originating page (?src=…) so the form
            // backend can route them (architectural → dedicated sales inboxes).
            const src = new URLSearchParams(window.location.search).get('src');
            if (src) {
              const tag = document.getElementById('f-enquiry-source') as HTMLInputElement | null;
              if (tag) tag.value = src;
              if (src === 'architectural') {
                const product = document.getElementById('f-product') as HTMLSelectElement | null;
                if (product && !product.value) product.value = 'architectural';
              }
            }
          </script>
        </div>

        <!-- Contact info -->
        <div style="display:flex;flex-direction:column;gap:40px">
          <div id="map">
            <div class="eyebrow">Our location</div>
            <div style="margin-top:16px;font-family:var(--font-display);font-size:20px;color:var(--color-navy);line-height:1.4">
              Banco Aluminium Private Limited
            </div>
            <address style="font-style:normal;margin-top:10px;font-size:14px;line-height:1.7;color:var(--color-stone-700)">
              Padra Road, Near Railway Station,<br/>
              Bil, Vadodara, Gujarat 391410, India
            </address>

            <div class="ct-reach">
              <div class="ct-reach-block">
                <div class="ct-reach-label">Sales enquiry</div>
                <a class="ct-reach-link" href="mailto:sales@bancoaluminium.com">sales@bancoaluminium.com</a>
                <a class="ct-reach-link" href="tel:+912652477200">+91 265 2477200</a>
              </div>
              <div class="ct-reach-block">
                <div class="ct-reach-label">Suppliers enquiry</div>
                <a class="ct-reach-link" href="mailto:purchase@bancoaluminium.com">purchase@bancoaluminium.com</a>
                <a class="ct-reach-link" href="tel:+912652477452">+91 265 2477452</a>
              </div>
            </div>
            <a
              href="https://www.google.com/maps/place/Banco+Aluminium+Private+Limited/@22.266708,73.133714,15z/data=!4m6!3m5!1s0x395fc7bb628805cf:0x20458466bd5a0ec1!8m2!3d22.266708!4d73.1337137!16s%2Fg%2F1tp2yssw"
              target="_blank"
              rel="noopener noreferrer"
              class="tap-link"
              style="display:inline-flex;align-items:center;gap:6px;margin-top:14px;font-family:var(--font-mono);font-size: max(10px, var(--fs-min, 0px));letter-spacing:0.14em;text-transform:uppercase;color:var(--color-green);text-decoration:none;"
            >
              <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <circle cx="8" cy="7" r="3" stroke="currentColor" stroke-width="1.4"/>
                <path d="M8 2C5.24 2 3 4.24 3 7c0 4.42 5 9 5 9s5-4.58 5-9c0-2.76-2.24-5-5-5z" stroke="currentColor" stroke-width="1.4"/>
              </svg>
              View on Google Maps
              <svg width="10" height="10" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M4 4h8v8M4 12L12 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </a>
            <!-- Embedded map -->
            <div style="margin-top:20px;border:1px solid var(--color-stone-200);overflow:hidden;aspect-ratio:16/9;max-height:220px">
              <iframe
                title="Banco Aluminium plant, Padra Road, Bil, Vadodara"
                src="https://www.google.com/maps?q=Banco+Aluminium+Private+Limited,+Padra+Road,+Bil,+Vadodara,+Gujarat+391410&hl=en&z=15&output=embed"
                width="100%"
                height="100%"
                style="border:0;display:block;"
                allowfullscreen
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          </div>

          <div style="padding:28px;background:var(--color-navy)" id="visit">
            <div style="font-family:var(--font-mono);font-size: max(10.5px, var(--fs-min, 0px));letter-spacing:0.14em;text-transform:uppercase;color:var(--color-green);margin-bottom:12px">Plant visit</div>
            <p style="color:var(--color-stone-400);font-size:14px;line-height:1.65;margin-bottom:20px">
              We welcome customers and prospective partners to visit our Vadodara facility:
              foundry, die shop, extrusion, and finishing under one roof.
            </p>
            <a href="mailto:info@bancoaluminium.com?subject=Plant%20visit%20request" class="btn btn-secondary-dark" style="font-size:12px;padding:12px 20px">
              Schedule a visit
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── Hero with photo ── */
  /* ── Direct contact details (map column) ── */
  .ct-reach { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 22px; padding-top: 20px; border-top: 1px solid var(--color-stone-200); }
  .ct-reach-label { font-family: var(--font-mono); font-size: max(10px, var(--fs-min, 0px)); letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-stone-700); margin-bottom: 8px; }
  .ct-reach-link { display: block; font-size: 13.5px; line-height: 1.7; color: var(--color-navy); text-decoration: none; word-break: break-word; transition: color 0.15s ease; }
  .ct-reach-link:hover { color: var(--color-green); }

  @media (max-width: 600px) {
    .ct-reach { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .ct-reach-link { display: flex; align-items: center; min-height: 44px; }
  }

  .ct-hero {
    position: relative;
    background: var(--color-navy);
    padding-top: 140px;
    padding-bottom: 80px;
    overflow: hidden;
  }
  .ct-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .ct-hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.14;
    filter: grayscale(70%);
  }
  .ct-hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(135deg, rgba(8,27,48,0.96) 50%, rgba(8,27,48,0.70) 100%);
  }

  /* ── 3-step process inside hero ── */
  .ct-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: rgba(40,69,106,0.45);
    border: 1px solid rgba(40,69,106,0.45);
    margin-top: 40px;
    max-width: 820px;
  }
  .ct-step {
    display: flex;
    gap: 16px;
    padding: 20px 20px;
    background: rgba(8,27,48,0.60);
    align-items: flex-start;
  }
  .ct-step-n {
    font-family: var(--font-mono);
    font-size: max(10px, var(--fs-min, 0px));
    letter-spacing: 0.18em;
    color: var(--color-green);
    padding-top: 2px;
    flex-shrink: 0;
  }
  .ct-step-title {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-platinum);
    line-height: 1.35;
    margin-bottom: 5px;
  }
  .ct-step-note {
    font-size: 11.5px;
    line-height: 1.5;
    color: var(--color-stone-400);
  }

  /* ── Form + info split ── */
  .ct-split {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 80px;
    align-items: start;
  }

  /* ── Form padding override ── */
  .section-pad { padding: clamp(48px, 7vw, 80px) 0; }

  @media (max-width: 1024px) {
    .ct-split { grid-template-columns: minmax(0, 1fr); gap: 56px; }
  }
  @media (max-width: 900px) {
    .ct-steps { grid-template-columns: minmax(0, 1fr); max-width: 420px; }
  }
</style>
