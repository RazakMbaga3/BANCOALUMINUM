---
import Layout from '../layouts/Layout.astro';
import Pic from '../components/Pic.astro';
import { DOCS } from '../lib/documents';

// Documents the client has supplied are live; the rest are issued on request
// until a soft copy exists (the full company catalogue is still being prepared).
const catalogs = [
  {
    ref: 'BAP-ARCH',
    title: DOCS.architecturalCatalogue.title,
    desc: 'Sliding and casement window series, door and partition systems, with profile cross-sections, section weights and system dimensions for every series.',
    cover: DOCS.architecturalCatalogue.cover,
    meta: DOCS.architecturalCatalogue.meta,
    view: DOCS.architecturalCatalogue.view,
    download: DOCS.architecturalCatalogue.download,
    tag: 'Architectural',
    fit: 'cover',
  },
  {
    ref: 'PRESS-2026',
    title: 'The Industrial Review, August 2026',
    desc: 'Banco Aluminium cover story: from extrusion to engineering, the leadership team, metallurgy, die design and lower-carbon manufacturing.',
    cover: DOCS.industrialReview.cover,
    meta: DOCS.industrialReview.meta,
    view: DOCS.industrialReview.view,
    download: DOCS.industrialReview.download,
    tag: 'Press feature',
    fit: 'contain',
  },
];

const onRequest = [
  { title: 'Industrial & OEM Profiles', desc: 'Alloy data, press range, fabrication and packing options for drawing-led OEM profiles.' },
  { title: 'Aluminium Extrusion Billets', desc: 'Alloy compositions, diameters, tolerances and CBAM carbon data for extrusion billets.' },
];
---

<Layout
  title="Download Banco Aluminium Product Catalogues"
  description="Download Banco Aluminium product catalogues: industrial and OEM profiles, architectural systems and extrusion billets, with alloy data and dimensions."
>

  <!-- ── Hero ──────────────────────────────────────────────────────────── -->
  <section class="dl-hero">
    <div class="container">
      <div class="eyebrow on-dark">Downloads</div>
      <h1 class="dl-h1">Product catalogues.</h1>
      <p class="dl-lead">
        Product catalogues and company publications. Open any document in your
        browser or download the PDF.
      </p>
    </div>
  </section>

  <!-- ── Catalogue cards ───────────────────────────────────────────────── -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="dl-grid">
        {catalogs.map((cat) => (
          <div class="dl-card">
            <a href={cat.view} target="_blank" rel="noopener" class={`dl-cover dl-cover--${cat.fit}`} aria-label={`Open ${cat.title}`}>
              <Pic src={cat.cover} alt="" loading="eager" sizes="(max-width: 1024px) 100vw, 50vw" maxW={1200} />
            </a>
            <div class="dl-card-top">
              <div class="dl-card-ref">{cat.ref}</div>
              <span class="pill">{cat.tag}</span>
            </div>

            <h2 class="dl-card-title">{cat.title}</h2>
            <p class="dl-card-desc">{cat.desc}</p>
            <div class="dl-card-meta">{cat.meta}</div>

            <div class="dl-card-actions">
              <a href={cat.view} target="_blank" rel="noopener" class="btn btn-primary dl-btn-main">
                View online
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M2.5 7h9M7 2.5L11.5 7 7 11.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
              <a href={cat.download} class="btn btn-secondary dl-btn-pdf" rel="noopener">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M8 2v9M4 8l4 4 4-4M2 14h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Download PDF
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Available on request ──────────────────────────────────────────── -->
  <section class="section-alt" style="padding:48px 0;border-top:1px solid var(--color-stone-200)">
    <div class="container">
      <div class="dl-how">
        <div class="dl-how-label">Available on request</div>
        <div class="dl-how-steps">
          {onRequest.map((d) => (
            <div class="dl-how-step">
              <div>
                <div class="dl-how-name">{d.title}</div>
                <div class="dl-how-note">{d.desc}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .dl-hero {
    background: var(--color-navy);
    padding: 148px 0 60px;
    position: relative;
    overflow: hidden;
  }
  .dl-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      90deg,
      transparent 0, transparent 3px,
      rgba(255,255,255,0.012) 3px, rgba(255,255,255,0.012) 4px
    );
    pointer-events: none;
  }
  .dl-hero > .container { position: relative; z-index: 1; }
  .dl-h1 {
    font-family: var(--font-sans);
    font-size: clamp(40px, 5vw, 72px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.95;
    color: var(--color-platinum);
    margin-top: 20px;
  }
  .dl-lead {
    font-family: var(--font-sans);
    font-size: clamp(15px, 1.4vw, 17px);
    line-height: 1.65;
    color: var(--color-silver);
    margin-top: 20px;
    max-width: 58ch;
  }
  .dl-lead strong { color: var(--color-platinum); font-weight: 600; }

  /* ── Grid ──────────────────────────────────────────────────────────── */
  .dl-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--color-stone-200);
    border: 1px solid var(--color-stone-200);
  }

  /* ── Card ──────────────────────────────────────────────────────────── */
  .dl-card {
    background: white;
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    border-top: 2px solid var(--color-green);
  }
  .dl-cover {
    display: block;
    margin: -36px -32px 8px;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-stone-100);
    border-bottom: 1px solid var(--color-stone-200);
  }
  .dl-cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: transform 0.5s ease;
  }
  .dl-cover--contain :global(img) { object-fit: contain; object-position: center; padding: 14px 0; }
  .dl-cover:hover :global(img) { transform: scale(1.03); }
  .dl-card-meta {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-stone-700);
  }
  .dl-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .dl-card-ref {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-stone-700);
  }
  .dl-card-title {
    font-family: var(--font-sans);
    font-size: clamp(16px, 1.4vw, 20px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-navy);
    line-height: 1.2;
    margin: 0;
  }
  .dl-card-desc {
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.65;
    color: var(--color-stone-700);
    flex: 1;
  }

  /* Actions */
  .dl-card-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 4px;
  }
  .dl-btn-main {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    justify-content: center;
    min-width: 0;
  }
  .dl-btn-pdf {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  /* ── How to download strip ─────────────────────────────────────────── */
  .dl-how {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: clamp(24px, 4vw, 60px);
    align-items: start;
  }
  .dl-how-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-green);
    padding-top: 2px;
  }
  .dl-how-steps {
    display: flex;
    gap: clamp(16px, 3vw, 48px);
    flex-wrap: wrap;
  }
  .dl-how-step {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    flex: 1;
    min-width: 180px;
  }
  .dl-how-num {
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 500;
    color: var(--color-green);
    line-height: 1;
    flex-shrink: 0;
    padding-top: 1px;
  }
  .dl-how-name {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-navy);
  }
  .dl-how-note {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--color-stone-700);
    margin-top: 4px;
    line-height: 1.5;
  }

  /* ── CTA ───────────────────────────────────────────────────────────── */
  .dl-cta {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: clamp(40px, 6vw, 100px);
    align-items: center;
  }
  .dl-cta-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex-shrink: 0;
  }

  /* ── Responsive ────────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .dl-grid { grid-template-columns: 1fr; }
    .dl-cta  { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .dl-how { grid-template-columns: 1fr; }
    .dl-how-steps { flex-direction: column; }
  }
</style>
