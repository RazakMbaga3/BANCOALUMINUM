---
import LayoutRouter from '../layouts/LayoutRouter.astro';
import Pic from '../components/Pic.astro';

const segments = [
  {
    num: '/ 01',
    tag: 'OEM · Drawing-led',
    name: 'Industrial & OEMs',
    desc: 'Manufacturing high-quality aluminium profiles for Industrial, Marine, Transportation, and OEM applications using integrated state-of-the-art manufacturing, precision engineering, and advanced testing facilities to deliver superior performance, reliability, and customer satisfaction.',
    chips: ['Electrical & T&D', 'Automotive', 'Heat sinks', 'Aerospace', 'Hydraulics'],
    href: '/products/industrial',
    img: '/assets/manufacturing/industrialOEMS.webp',
    imgPos: 'center center',
  },
  {
    num: '/ 02',
    tag: 'Windows · Doors · Façades',
    name: 'Architectural',
    desc: 'Precision-engineered aluminium systems for modern architecture, combining advanced profile manufacturing, refined aesthetics and long-term durability for any scale of project.',
    chips: ['Casement windows', 'Sliding doors', 'Partitions', 'Curtain wall', 'Façades'],
    href: '/products/architectural',
    img: '/assets/images/architectureheropage/aluminium-sliding-doors-modern-home.jpg',
    imgPos: 'center center',
  },
  {
    num: '/ 03',
    tag: 'Foundry · Billet',
    name: 'Billets',
    desc: 'High Quality Aluminium Billets: cylinder-guided casting, controlled homogenisation, customer-specific alloy chemistry and up to 50% recycled scrap input.',
    chips: ['Ø 127–254 mm', '1xxx–7xxx alloys', 'Lead-free', 'Green billet', 'CBAM'],
    href: '/products/cast-products',
    img: '/assets/manufacturing/aluminumbillets.avif',
    imgPos: 'center center',
  },
] as const;

const certs = [
  'ISO 9001:2015',
  'ISO 14001:2015',
  'ISO 45001:2018',
  'IATF 16949:2016',
  'CE',
  'IR Class Work Approved',
  'BIS',
];

/* h = display height in px — crest/emblem marks need more height than
   wordmarks to read at the same visual weight */
const clientLogos = [
  { name: 'Reliance Industries',        src: '/assets/logos/reliance.svg',           h: 42 },
  { name: 'Larsen & Toubro',            src: '/assets/logos/lt.svg',                 h: 42 },
  { name: 'Siemens',                    src: '/assets/logos/siemens.svg',            h: 22 },
  { name: 'ABB',                        src: '/assets/logos/abb.svg',                h: 26 },
  { name: 'Schneider Electric',         src: '/assets/logos/schneider.svg',          h: 28 },
  { name: 'Alstom',                     src: '/assets/logos/alstom.svg',             h: 22 },
  { name: 'INOXCVA',                    src: '/assets/logos/inoxcva.png',            h: 28 },
  { name: 'Cochin Shipyard Limited',    src: '/assets/logos/cochin-shipyard.png',    h: 42 },
  { name: 'Hindustan Shipyard Limited', src: '/assets/logos/hindustan-shipyard.svg', h: 42 },
  { name: 'Bharat Electronics',         src: '/assets/logos/bel.svg',                h: 28 },
  { name: 'Festo',                      src: '/assets/logos/festo.svg',              h: 22 },
  { name: 'Trützschler',                src: '/assets/logos/trutzschler.svg',        h: 24 },
];
---

<LayoutRouter
  title="Banco Aluminium: Integrated Aluminium Extrusion Since 1967"
  description="Banco Aluminium is an integrated aluminium extrusion company established in 1967. Industrial profiles, architectural systems and billets. 35,000 MT capacity."
>

  <!-- Fixed video background — covers entire viewport -->
  <video
    class="ri-video"
    src="/herovideo-720.mp4"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/herovideo-poster.jpg"
    aria-hidden="true"
  ></video>

  <!-- Navy overlay — tones video into Heritage palette -->
  <div class="ri-overlay" aria-hidden="true"></div>

  <!-- Video breathing space — video visible across top half -->
  <div class="ri-spacer" aria-hidden="true"></div>

  <!-- ── Three segment panels — primary navigation ────────── -->
  <nav class="router-panels" aria-label="Product segments">
    {segments.map((seg) => (
      <a
        href={seg.href}
        class="rp"
        aria-label={`Enter the ${seg.name} segment`}
      >

        <!-- Realistic photo background -->
        <div class="rp-bg" aria-hidden="true">
          <Pic
            src={seg.img}
            class="rp-bg-img"
            alt=""
            loading="eager"
            fetchpriority="high"
            sizes="(max-width: 900px) 100vw, 40vw"
            maxW={768}
            style={`object-position: ${seg.imgPos};`}
          />
        </div>

        <!-- Segment index — top-left watermark over photo -->
        <div class="rp-num" aria-hidden="true">{seg.num}</div>

        <!-- Info panel — solid frosted glass, anchored to bottom -->
        <div class="rp-content">
          <span class="rp-tag">{seg.tag}</span>
          <h2 class="rp-name">{seg.name}</h2>
          <p class="rp-desc">{seg.desc}</p>
          <div class="rp-enter">
            <span>Enter</span>
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M2 8h12M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>

      </a>
    ))}
  </nav>

  <!-- Equal space below panels — mirrors ri-spacer above -->
  <div class="ri-spacer" aria-hidden="true"></div>

  <!-- ── Stats band ─────────────────────────────────────── -->
  <div class="ri-stats-band" role="region" aria-label="Key figures">
    <div class="container ri-stats-inner">
      {([
        { value: '58+',    unit: 'years',    label: 'In extrusion since 1967' },
        { value: '35,000', unit: 'MT / yr',  label: 'Extrusion capacity' },
        { value: '55,000', unit: 'MT',       label: 'Foundry capacity' },
        { value: '5',      unit: 'presses',  label: '1100–3300T' },
        { value: '1000+',  unit: 'customers', label: 'Everywhere' },
      ] as const).map(({ value, unit, label }) => (
        <div class="ri-stat">
          <div class="ri-stat-num">
            {value}<span class="ri-stat-unit">{unit}</span>
          </div>
          <div class="ri-stat-label">{label}</div>
        </div>
      ))}
    </div>
  </div>

  <!-- ── Hero statement — minimal, at bottom ──────────────── -->
  <section class="router-hero" aria-label="Brand statement">
    <div class="container rhi">
      <h1 class="rhi-h1">Six decades shaping aluminium.</h1>
    </div>
  </section>

  <!-- ── Trusted-by logo strip ─────────────────────────────── -->
  <div class="ri-trusted" role="region" aria-label="Trusted by">
    <div class="container ri-trusted-inner">
      <span class="ri-trusted-label">Trusted by</span>
      <div class="ri-trusted-logos">
        {clientLogos.map((c) => (
          <img src={c.src} alt={c.name} class="ri-trusted-logo" loading="lazy" style={`--logo-h:${c.h}px`} />
        ))}
      </div>
    </div>
  </div>

  <!-- ── Cert strip ──────────────────────────────────────── -->
  <footer class="router-certs">
    <div class="container rc-inner">
      <div class="rc-certs">
        {certs.map((cert) => (
          <span class="rc-cert">
            <span class="rc-dot" aria-hidden="true"></span>
            {cert}
          </span>
        ))}
      </div>
      <div class="rc-location">
        <span>Vadodara, Gujarat · India</span>
        <span aria-hidden="true" class="rc-sep">·</span>
        <span>Est. 1967</span>
      </div>
    </div>
  </footer>

</LayoutRouter>

<style>
  /* ── Fixed video + overlay ───────────────────────────────── */
  .ri-video {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
    pointer-events: none;
  }
  .ri-overlay {
    position: fixed;
    inset: 0;
    /* single light wash — lets the video read clearly */
    background: rgba(8, 27, 48, 0.38);
    z-index: 1;
    pointer-events: none;
  }

  /* Video breathing space — grows to push panels down */
  .ri-spacer {
    flex: 1;
    min-height: 0;
    pointer-events: none;
  }

  /* ── Panel container ───────────────────────────────────── */
  .router-panels {
    display: flex;
    flex-shrink: 0;
    height: 42vh;
    min-height: 260px;
    gap: 0;
    position: relative;
    z-index: 2;
  }

  /* ── Individual panel ───────────────────────────────────── */
  .rp {
    position: relative;
    flex: 1;
    overflow: hidden;
    text-decoration: none;
    background: var(--color-navy-deep);
    border-right: 1px solid rgba(40, 69, 106, 0.55);
    transition: flex 0.55s cubic-bezier(0.4, 0, 0.2, 1);
    display: block;
    outline: none;
  }
  .rp:last-child { border-right: none; }
  .rp:hover, .rp:focus-visible { flex: 3.5; }
  .rp:focus-visible { outline: 2px solid var(--color-green); outline-offset: -2px; }

  /* Photo fills the panel — clean, no overlay on top */
  .rp-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .rp-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0.88;
    filter: brightness(0.80) saturate(0.80);
    transition: transform 0.55s ease, opacity 0.45s ease, filter 0.45s ease;
    transform: scale(1.04);
  }
  .rp:hover .rp-bg-img,
  .rp:focus-visible .rp-bg-img {
    transform: scale(1.0);
    opacity: 0.95;
    filter: brightness(0.88) saturate(0.92);
  }

  /* Segment index — subtle watermark top-left over photo */
  .rp-num {
    position: absolute;
    top: 16px;
    left: 20px;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.20em;
    color: rgba(228, 229, 227, 0.72); /* 0.40 failed contrast over dark photos */
  }

  /* ── Info panel — solid frosted glass, no gradient confusion ── */
  .rp-content {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    z-index: 3;
    padding: 14px 20px 0;
    background: rgba(8, 27, 48, 0.88);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-top: 1px solid rgba(40, 69, 106, 0.70);
    /* 2px green bottom rule via pseudo */
    padding-bottom: 18px;
  }
  .rp-content::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 2px;
    background: var(--color-green);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .rp:hover .rp-content::after,
  .rp:focus-visible .rp-content::after { transform: scaleX(1); }

  .rp-tag {
    display: block;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-nickel);
    padding-bottom: 8px;
  }

  /* Name — large, bold, high contrast */
  .rp-name {
    font-family: var(--font-sans);
    font-size: clamp(19px, 2vw, 29px);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.05;
    color: var(--color-platinum);
  }

  /* Description — hidden at rest, slides up on hover */
  .rp-desc {
    font-family: var(--font-sans);
    font-size: 12.5px;
    line-height: 1.62;
    color: var(--color-silver);
    margin-top: 0;
    max-width: 54ch;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height 0.38s ease 0.05s, opacity 0.28s ease 0.12s, margin-top 0.28s ease;
  }
  .rp:hover .rp-desc,
  .rp:focus-visible .rp-desc {
    max-height: 150px;
    opacity: 1;
    margin-top: 9px;
  }

  .rp-enter {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 12px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.20em;
    text-transform: uppercase;
    color: var(--color-platinum);
    transition: gap 0.25s ease;
  }
  .rp-enter svg { flex-shrink: 0; color: var(--color-green); transition: transform 0.25s ease; }
  .rp:hover .rp-enter,
  .rp:focus-visible .rp-enter { gap: 12px; }
  .rp:hover .rp-enter svg,
  .rp:focus-visible .rp-enter svg { transform: translateX(3px); }

  /* ── Stats band ─────────────────────────────────────────── */
  .ri-stats-band {
    background: rgba(8, 27, 48, 0.90);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid rgba(40, 69, 106, 0.45);
    border-bottom: 1px solid rgba(40, 69, 106, 0.45);
    flex-shrink: 0;
    position: relative;
    z-index: 2;
  }
  .ri-stats-inner {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0;
  }
  .ri-stat {
    padding: 14px 20px;
    border-right: 1px solid rgba(40, 69, 106, 0.45);
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .ri-stat:last-child { border-right: none; }
  .ri-stat-num {
    font-family: var(--font-sans);
    font-size: clamp(16px, 1.8vw, 22px);
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--color-platinum);
    line-height: 1;
    display: flex;
    align-items: baseline;
    gap: 5px;
  }
  .ri-stat-unit {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-green);
    font-weight: 400;
  }
  .ri-stat-label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-nickel);
  }
  @media (max-width: 640px) {
    .ri-stats-inner { grid-template-columns: repeat(2, 1fr); }
    .ri-stat:nth-child(2n) { border-right: none; }
    .ri-stat:nth-child(n+3) { border-top: 1px solid rgba(40, 69, 106, 0.45); }
    .ri-stat:nth-child(5) { grid-column: 1 / -1; border-right: none; }
  }

  /* ── Trusted-by logo strip ────────────────────────────────── */
  .ri-trusted {
    background: rgba(8, 27, 48, 0.80);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid rgba(40, 69, 106, 0.45);
    padding: 12px 0;
    flex-shrink: 0;
    position: relative;
    z-index: 2;
  }
  .ri-trusted-inner {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .ri-trusted-label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-nickel);
    flex-shrink: 0;
  }
  .ri-trusted-logos {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px clamp(14px, 1.5vw, 22px);
    flex-wrap: wrap;
  }
  /* Dark-navy strip: originals in full colour are illegible here, so all
     marks render as white silhouettes; hover lifts to full strength */
  .ri-trusted-logo {
    height: var(--logo-h, 26px);
    width: auto;
    filter: brightness(0) invert(1);
    opacity: 0.75;
    transition: opacity 0.2s ease;
  }
  .ri-trusted-logo:hover { opacity: 1; }
  @media (max-width: 640px) {
    .ri-trusted-logos { gap: 10px 18px; }
    .ri-trusted-logo { height: calc(var(--logo-h, 26px) * 0.72); }
  }

  /* ── Hero statement — compact bottom strip ───────────────── */
  .router-hero {
    background: rgba(8, 27, 48, 0.72);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid rgba(40, 69, 106, 0.45);
    padding: 16px 0;
    flex-shrink: 0;
    position: relative;
    z-index: 2;
  }
  .rhi {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .rhi-h1 {
    font-family: var(--font-sans);
    font-size: clamp(20px, 2.4vw, 34px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.0;
    color: var(--color-platinum);
    text-align: center;
  }

  /* ── Cert strip ────────────────────────────────────────────── */
  .router-certs {
    background: rgba(8, 27, 48, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-top: 1px solid rgba(40, 69, 106, 0.45);
    padding: 10px 0;
    flex-shrink: 0;
    position: relative;
    z-index: 2;
  }
  .rc-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .rc-certs {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .rc-cert {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-nickel);
    white-space: nowrap;
  }
  .rc-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-green);
    flex-shrink: 0;
  }
  .rc-location {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-stone-400);
    white-space: nowrap;
  }
  .rc-sep { color: var(--color-navy-line); }

  /* ── Below 900px — vertical stack, scrollable ───────────── */
  @media (max-width: 900px) {
    .ri-spacer { display: none; }
    .router-panels {
      flex-direction: column;
      height: auto;
      min-height: auto;
    }
    .rp {
      flex: none;
      min-height: 280px;
      border-right: none;
      border-bottom: 1px solid rgba(40, 69, 106, 0.55);
      transition: none;
    }
    .rp:last-child { border-bottom: none; }
    .rp:hover, .rp:focus-visible { flex: none; }
    .rp-desc  { max-height: 120px; opacity: 1; margin-top: 9px; }
    .rp-name  { font-size: 22px; }
    .router-hero { padding: 20px 0; }
    .rc-inner { flex-direction: column; align-items: flex-start; gap: 8px; }
    .rc-certs { gap: 10px; }
  }

  @media (max-width: 480px) {
    .rp { min-height: 280px; }
    .rp-content { padding: 0 18px 20px; }
    .rp-num { top: 18px; left: 18px; }
    .rc-certs { gap: 8px 12px; }
  }

  @media (hover: none) {
    .rp-desc { opacity: 1; transform: none; }
    .rp-line { transform: scaleX(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .rp, .rp-bg-img { transition: none; }
    .rp-desc { transition: none; max-height: 120px; opacity: 1; margin-top: 9px; }
    .rp-enter, .rp-enter svg { transition: none; }
    .rp-content::after { transition: none; transform: scaleX(1); }
  }
</style>
