---
import Layout from '../../layouts/Layout.astro';

const profiles = [
  { name: 'Structural aircraft sections', desc: 'Stringer, frame, and spar-cap extrusions in 2014-T6 and 7075-equivalent grades with tight chemical tolerances and full mechanical property certification.' },
  { name: 'Interior trim profiles', desc: 'Overhead bin rail, seat track surround, and cabin partition extrusions for civil aircraft interiors — supplied with individual material test certificates.' },
  { name: 'Floor beam extrusions', desc: 'Hollow and semi-hollow floor beam profiles in 6082-T6 for regional and commercial aircraft cabin floor structures — weight-optimised cross-sections.' },
  { name: 'Seat track profiles', desc: 'Precision seat rail extrusions to FAA and EASA dimensional standards — tight web and flange tolerances for positive seat engagement over the full track length.' },
  { name: 'Cryogenic application sections', desc: 'Low-temperature service profiles in 5083 and 2xxx alloys with validated low-temperature toughness for cryogenic tankage and space launch vehicle structures.' },
  { name: 'Defence structural profiles', desc: 'Armour support frames, vehicle body extrusions, and shelter structures in 7xxx and 2xxx alloys — supplied with full heat number traceability and batch certs.' },
];

const alloys = [
  { name: '2014', temper: 'T6', why: 'Primary aircraft structural alloy — UTS 485 MPa, fatigue-resistant, high strength-to-weight ratio. Used for wing spar caps, fuselage frames, and bulkheads.' },
  { name: '2017A', temper: 'T4', why: 'Free-machining aircraft-grade alloy for fastener blanks, spacers, and precision aerospace components requiring high strength and good dimensional stability after machining.' },
  { name: '6082', temper: 'T6', why: 'Structural alloy for secondary aircraft structures, interior profiles, and floor beam applications where high strength is needed with improved weldability over 2xxx alloys.' },
  { name: '7075 equiv.', temper: 'T6', why: 'Ultra-high-strength structural grade — yield strength 503 MPa. For primary load-bearing aircraft structures and defence applications demanding maximum specific strength.' },
];
---

<Layout
  title="Aerospace & defence — Banco Aluminium"
  description="High-performance 2xxx and 7xxx alloy sections with tight tolerances, full chemical traceability, and mechanical property certification for structural, interior, and cryogenic applications."
>
  <!-- Hero -->
  <section style="background:var(--color-navy);padding-top:148px;padding-bottom:0">
    <div class="container">
      <div class="eyebrow on-dark">Industries / Aerospace</div>
      <h1 class="t-h1" style="color:var(--color-stone-50);margin-top:20px;max-width:20ch">
        Aerospace &amp; defence profiles.
      </h1>
      <p class="t-lead" style="color:var(--color-stone-400);margin-top:24px;max-width:58ch">
        High-performance 2xxx and 7xxx alloy sections with tight dimensional tolerances, full chemical traceability, and mechanical property certification — for structural, interior, and cryogenic applications.
      </p>

      <!-- Stats strip -->
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--color-navy-line);margin-top:56px;border-top:1px solid var(--color-navy-line)">
        {[
          ['2xxx · 7xxx alloys', 'High-performance grades'],
          ['Full traceability', 'Heat number to despatch'],
          ['SCADA-monitored', 'Every press cycle logged'],
          ['Chemical cert', 'Every cast verified'],
        ].map(([val, label]) => (
          <div style="background:var(--color-navy-soft);padding:28px 24px">
            <div style="font-family:var(--font-display);font-size:clamp(14px,1.8vw,22px);font-weight:700;color:var(--color-stone-50)">{val}</div>
            <div style="font-family:var(--font-mono);font-size:10px;letter-spacing:0.14em;text-transform:uppercase;color:var(--color-nickel);margin-top:6px">{label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 01: Application overview -->
  <section class="section-light section-pad">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start">
        <div>
          <div class="eyebrow">01 — Application overview</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            Traceable alloys for <em class="accent">critical structures.</em>
          </h2>
          <p class="t-body" style="margin-top:20px;color:var(--color-stone-700)">
            Aerospace and defence applications demand a level of material certainty that goes
            beyond standard industrial extrusion. Banco's in-house foundry produces 2xxx and
            7xxx billets with spectrometric analysis on every cast, and our SCADA-monitored
            extrusion presses record time, temperature, and pressure data for the full length
            of every profile — data that is archived and retrievable for the product lifetime.
          </p>
          <p class="t-body" style="margin-top:16px;color:var(--color-stone-700)">
            Each batch is accompanied by a material test certificate covering chemical
            composition, mechanical properties (tensile, yield, elongation), and hardness.
            For structural aircraft applications, we can arrange third-party witnessing of
            mechanical testing at our accredited laboratory partners.
          </p>

          <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:28px">
            {['Civil aviation', 'Defence vehicles', 'Space structures', 'Satellite systems', 'Cryogenic tanks', 'UAV structures', 'Naval vessels'].map(tag => (
              <span class="pill">{tag}</span>
            ))}
          </div>
        </div>

        <div style="position:relative">
          <img
            src="/assets/manufacturing/quality-2.jpg"
            alt="Dimensional quality inspection at Banco Aluminium"
            loading="lazy"
            style="width:100%;aspect-ratio:4/3;object-fit:cover"
          />
          <div style="position:absolute;bottom:0;left:0;right:0;padding:16px 20px;background:var(--color-navy-deep)">
            <span style="font-family:var(--font-mono);font-size:10px;letter-spacing:0.14em;text-transform:uppercase;color:var(--color-nickel)">
              Full dimensional inspection — material test certificates on every shipment
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 02: Profile types -->
  <section class="section-alt section-pad">
    <div class="container">
      <div class="eyebrow">02 — Profile types</div>
      <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px;max-width:28ch">
        Six profile families for aerospace and defence.
      </h2>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--color-stone-200);margin-top:40px">
        {profiles.map(p => (
          <div style="background:var(--color-stone-50);padding:32px 28px">
            <div style="width:2px;height:24px;background:var(--color-green);margin-bottom:16px"></div>
            <h3 style="font-family:var(--font-sans);font-size:16px;font-weight:700;color:var(--color-navy);line-height:1.3">{p.name}</h3>
            <p style="font-size:14px;color:var(--color-stone-700);line-height:1.6;margin-top:10px">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 03: Alloys -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="eyebrow">03 — Alloys</div>
      <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px;max-width:28ch">
        High-performance alloys for aerospace.
      </h2>
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:40px">
        {alloys.map(a => (
          <div style="border:1px solid var(--color-stone-200);padding:32px 28px">
            <div style="font-family:var(--font-mono);font-size:22px;font-weight:500;color:var(--color-navy)">{a.name}</div>
            <div style="font-family:var(--font-mono);font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--color-green);margin-top:6px">{a.temper}</div>
            <p style="font-size:14px;color:var(--color-stone-700);line-height:1.6;margin-top:16px">{a.why}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 04: Quality -->
  <section class="section-alt section-pad">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start">
        <div>
          <div class="eyebrow">04 — Quality &amp; certifications</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            Documentation for <em class="accent">safety-critical supply.</em>
          </h2>
          <p class="t-body" style="margin-top:20px;color:var(--color-stone-700)">
            Banco's aerospace quality documentation package includes material test certificates
            per EN 10204 3.1, full SCADA extrusion logs, chemical composition from in-house
            spectrometry cross-checked against cast analysis, mechanical test results from
            tensile coupons cut from production profiles, and dimensional inspection reports.
            Third-party verification can be arranged on request.
          </p>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
          {[
            ['ISO 9001:2015', 'Quality management system'],
            ['IATF 16949:2016', 'Automotive/defence quality'],
            ['EN 10204 3.1', 'Material test certificates'],
            ['SCADA traceability', 'Full production data archive'],
          ].map(([cert, scope]) => (
            <div style="border-left:2px solid var(--color-green);padding-left:16px">
              <div style="font-family:var(--font-mono);font-size:13px;font-weight:500;color:var(--color-navy)">{cert}</div>
              <div style="font-size:13px;color:var(--color-stone-700);margin-top:4px">{scope}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-dark" style="padding:80px 0;border-top:2px solid var(--color-green)">
    <div class="container">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:32px">
        <div>
          <div class="eyebrow on-dark">Get started</div>
          <h2 class="t-h2" style="color:var(--color-stone-50);margin-top:12px">
            Submit a <em class="accent">drawing.</em>
          </h2>
          <p style="color:var(--color-stone-400);margin-top:12px;font-size:16px;max-width:46ch">
            Share your cross-section and certification requirements — our aerospace team will confirm alloy availability, tolerances, and documentation package.
          </p>
        </div>
        <a href="/contact#quote" class="btn btn-primary-dark">Submit a drawing</a>
      </div>
    </div>
  </section>
</Layout>
