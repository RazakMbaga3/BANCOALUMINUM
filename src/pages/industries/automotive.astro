---
import Layout from '../../layouts/Layout.astro';
import Pic from '../../components/Pic.astro';
import IndustryHero from '../../components/IndustryHero.astro';

const profiles = [
  { name: 'Structural components', items: ['Bumper beams', 'Battery enclosures', 'Roof rails'] },
  { name: 'Chassis', items: ['ICMS', 'Steering knuckles', 'Anti-vibration systems'] },
  { name: 'Brake systems', items: ['ABS systems', 'Brake drum', 'Brake disc'] },
  { name: 'Trucks & trailer', items: ['Bumper beams', 'Underrun protection', 'Trailer parts'] },
  { name: 'Electronics', items: ['Powertrain housings', 'Fuse boxes', 'Wiper mechanisms'] },
  { name: 'Safety products', items: ['Airbags', 'Safety belts'] },
  { name: 'Seat systems', items: ['Seat frame', 'Head rest', 'Seat guide system'] },
  { name: 'Fuel systems', items: ['Fuel distribution', 'Fuel lines', 'Fuel cooler'] },
  { name: 'Heating, AC & cooling', items: ['A/C lines', 'Compressors', 'Heat exchanger'] },
  { name: 'Multi-purpose parts', items: ['Bolts & screws', 'Clamps & fasteners', 'Tubes'] },
  { name: 'Accessories', items: ['Bike carrier', 'Bull bar', 'Luggage carrier'] },
];

const galleryImages = ['1', '2', '3', '4', '5', '6', '7'];

const alloys = [
  { name: '6082', temper: 'T6', why: 'Premier structural automotive alloy with UTS 310 MPa and yield 260 MPa. Preferred for crash-critical body sections and roof rail applications.' },
  { name: '6061', temper: 'T6', why: 'Versatile engineering alloy for seat tracks, door components, and general automotive extrusions requiring good machinability alongside structural performance.' },
  { name: '6063', temper: 'T5 / T6', why: 'General-purpose automotive extrusion grade with excellent surface finish. Used in trim, brackets, and commercial vehicle body structures.' },
  { name: '6005A', temper: 'T5 / T6', why: 'Lead-free, medium-strength alloy for precision automotive components subject to RoHS and ELV Directive restrictions.' },
];
---

<Layout
  title="Automotive & commercial vehicles: Banco Aluminium"
  description="Structural body sections, thermal management profiles, door sills, roof rails and seat track extrusions in IATF 16949 certified supply to automotive OEMs."
  heroImage="/assets/industries/hero/automotive-hero.jpg"
>
  <!-- Hero -->
  <IndustryHero
    image="/assets/industries/hero/automotive-hero.jpg"
    eyebrow="Industries / Automotive"
    stats={[
    ['IATF 16949:2016', 'Automotive quality system'],
    ['Special alloys', 'Custom & Standard alloys'],
    ['Lead-free grades', 'RoHS & ELV compliant'],
    ['35,000 MT', 'Annual capacity'],
    ]}
  >
    <Fragment slot="h1">Automotive, Commercial Vehicle &amp; EV Profiles.</Fragment>
    <Fragment slot="lead">Structural body sections, battery cages, impact-resistant profiles, door sills, roof rails, and seat track extrusions—manufactured under IATF 16949 certification for Tier 1 and Tier 2 automotive OEMs.</Fragment>
  </IndustryHero>

  <!-- Gallery strip -->
  <section class="section-alt auto-gallery-section" style="padding:40px 0;border-top:1px solid var(--color-stone-200)">
    <div class="auto-gallery-viewport">
      <div class="auto-gallery-track">
        {[...galleryImages, ...galleryImages].map((id, i) => (
          <div class="auto-gallery-item" aria-hidden={i >= galleryImages.length ? 'true' : undefined}>
            <Pic
              src={`/assets/industries/automotive-gallery/${id}.jpg`}
              alt={i < galleryImages.length ? 'Banco Aluminium automotive extrusion component' : ''}
              class="auto-gallery-img"
              sizes="220px"
              loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 01: Application overview -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="ind-split">
        <div>
          <div class="eyebrow">01 · Application overview</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            Tier-1 quality from an <em class="accent">IATF 16949 supplier.</em>
          </h2>
          <p class="t-body" style="margin-top:20px;color:var(--color-stone-700)">
            Banco has supplied aluminium extrusions to the automotive sector for over two decades,
            holding IATF 16949:2016 certification for design, manufacture, and supply of extruded
            profiles and precision-machined components to passenger vehicle and commercial vehicle
            OEMs and Tier 1 suppliers.
          </p>
          <p class="t-body" style="margin-top:16px;color:var(--color-stone-700)">
            Our specialized alloy expertise makes us a preferred source for crash-relevant
            structural sections, where weight reduction and load performance must be
            achieved simultaneously. PPAP documentation, First Article Inspection Reports
            (FAIR), and dimensional data are verified for all automotive programmes.
          </p>

          <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:28px">
            {['Passenger vehicles', 'Commercial vehicles', 'EV platforms', 'HEV platforms', 'Tier 1 supply', 'Tier 2 supply', 'Bus & coach bodywork'].map(tag => (
              <span class="pill">{tag}</span>
            ))}
          </div>
        </div>

        <div style="position:relative">
          <Pic
            src="/assets/industries/automotive.jpg"
            alt="Automotive manufacturing plant: aluminium extrusions in vehicle production"
            loading="lazy"
            class="ind-photo" sizes="(max-width: 1024px) 100vw, 60vw" />
          <div class="ind-caption">
            <span class="ind-caption-t">
              IATF 16949:2016 automotive quality, from billet to despatch
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 02: Profile types -->
  <section class="section-alt section-pad" id="autoProfilesSection">
    <div class="container">
      <div class="eyebrow">02 · Profile types</div>
      <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px;max-width:32ch">
        Segments in the Automotive Industry.
      </h2>
    </div>

    <div class="ind-hscroll-pin" id="autoProfilesPin">
      <div class="ind-hscroll-sticky">
        <div class="container">
          <div class="ind-tiles ind-tiles-scroll" id="autoProfilesTrack">
            {profiles.map((p, i) => (
              <div class="ind-tile">
                <div class="ind-tile-num">{String(i + 1).padStart(2, '0')}</div>
                <h3 class="ind-tile-h">{p.name}</h3>
                <ul class="ind-tile-list">
                  {p.items.map(item => <li>{item}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 03: Alloys -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="eyebrow">03 · Alloys</div>
      <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px;max-width:28ch">
        Alloy selection for automotive applications.
      </h2>
      <div class="ind-cards cols-4">
        {alloys.map(a => (
          <div class="ind-card">
            <div class="ind-card-n">{a.name}</div>
            <div class="ind-card-t">{a.temper}</div>
            <p class="ind-card-p">{a.why}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 04: Quality & certifications -->
  <section class="section-alt section-pad">
    <div class="container">
      <div class="ind-split">
        <div>
          <div class="eyebrow">04 · Quality &amp; certifications</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            Automotive quality <em class="accent">at every stage.</em>
          </h2>
          <p class="t-body" style="margin-top:20px;color:var(--color-stone-700)">
            Banco's automotive quality system covers supplier approval, incoming billet inspection,
            in process MES (Manufacturing Execution System), SCADA monitoring, outgoing dimensional
            inspection, and full PPAP capability. We maintain IATF 16949:2016, ISO 9001:2015, and
            ISO 14001:2015 simultaneously, giving OEM customers a single certified partner for
            structural and functional profiles.
          </p>
        </div>
        <div class="ind-certs">
          {[
            ['IATF 16949:2016', 'Automotive quality management'],
            ['ISO 9001:2015', 'Quality management system'],
            ['ISO 14001:2015', 'Environmental management'],
            ['Customer Specific Capabilities', 'Level 1–3 documentation'],
          ].map(([cert, scope]) => (
            <div class="ind-cert">
              <div class="ind-cert-c">{cert}</div>
              <div class="ind-cert-s">{scope}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-dark" style="padding:80px 0;border-top:2px solid var(--color-green)">
    <div class="container">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:32px">
        <div>
          <div class="eyebrow on-dark">Get started</div>
          <h2 class="t-h2" style="color:var(--color-stone-50);margin-top:12px">
            Submit a <em class="accent">drawing.</em>
          </h2>
          <p style="color:var(--color-stone-400);margin-top:12px;font-size:16px;max-width:46ch">
            Upload your DXF and our automotive team will respond with PPAP readiness, alloy recommendation, and lead time.
          </p>
        </div>
        <a href="/contact#quote" class="btn btn-primary-dark">Submit a drawing</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .auto-gallery-viewport {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent 0, black 64px, black calc(100% - 64px), transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, black 64px, black calc(100% - 64px), transparent 100%);
  }
  .auto-gallery-track {
    display: flex;
    width: max-content;
    padding: 4px 0 12px;
    animation: auto-marquee 30s linear infinite;
  }
  .auto-gallery-section:hover .auto-gallery-track { animation-play-state: paused; }
  .auto-gallery-item {
    position: relative;
    flex: 0 0 auto;
    width: 170px;
    margin-right: 20px;
    aspect-ratio: 290 / 376;
    overflow: hidden;
    background: var(--color-stone-100);
    border: 1px solid var(--color-stone-200);
    border-radius: 3px;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    transition: box-shadow 0.35s ease, border-color 0.35s ease, transform 0.35s ease;
  }
  .auto-gallery-item::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.5);
    pointer-events: none;
  }
  .auto-gallery-item:hover {
    border-color: var(--color-green);
    box-shadow: 0 14px 28px -12px rgba(15, 23, 42, 0.28);
    transform: translateY(-3px);
    z-index: 1;
  }
  :global(.auto-gallery-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(0.55) contrast(1.02);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), filter 0.45s ease;
  }
  .auto-gallery-item:hover :global(.auto-gallery-img) {
    transform: scale(1.08);
    filter: grayscale(0) contrast(1.02);
  }
  @keyframes auto-marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @media (min-width: 640px) {
    .auto-gallery-item { width: 200px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .auto-gallery-track { animation: none; }
  }

  /* Section 02 — cards reveal by translating as the page scrolls past a pinned strip.
     Driven entirely by JS (fixed/absolute toggled on scroll) rather than native
     position:sticky, because body has overflow-x:hidden sitewide, which makes body
     a scroll container and silently breaks sticky descendants. */
  /* global.css applies content-visibility:auto to main > section:nth-of-type(n+3)
     for perf; that implies CSS containment, which turns this section into a
     containing block for position:fixed descendants and breaks the pin below */
  #autoProfilesSection {
    content-visibility: visible;
  }
  .ind-hscroll-pin {
    position: relative;
  }
  .ind-hscroll-sticky {
    overflow: hidden;
  }
  .ind-hscroll-sticky.is-fixed {
    position: fixed;
    top: calc(var(--nav-height) + 24px);
    left: 0;
    right: 0;
    z-index: 5;
    background: var(--color-stone-100);
  }
  .ind-hscroll-sticky.is-end {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
  }
  .ind-tiles-scroll {
    display: flex;
    flex-wrap: nowrap;
    padding-bottom: 4px;
    /* fallback so the row is still reachable without JS: swipeable, no visible scrollbar */
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .ind-tiles-scroll::-webkit-scrollbar { display: none; }
  .ind-tiles-scroll .ind-tile {
    flex: 0 0 260px;
  }
  .js-hscroll .ind-tiles-scroll {
    overflow: visible;
    will-change: transform;
  }
  @media (max-width: 640px) {
    .ind-tiles-scroll .ind-tile { flex: 0 0 220px; }
  }
</style>

<script>
  function initProfileHScroll() {
    const pin = document.getElementById('autoProfilesPin');
    const sticky = pin?.querySelector<HTMLElement>('.ind-hscroll-sticky');
    const track = document.getElementById('autoProfilesTrack');
    if (!pin || !sticky || !track) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const navHeight = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--nav-height')) || 72;
    const stickAt = navHeight + 24;

    let distance = 0;
    let stickyHeight = 0;

    function measure() {
      sticky!.classList.remove('is-fixed', 'is-end');
      stickyHeight = sticky!.offsetHeight;
      // track's own clientWidth (not its padded .container parent's) is what's
      // actually visible through the overflow:hidden sticky wrapper
      distance = Math.max(track!.scrollWidth - track!.clientWidth, 0);
      pin!.style.height = distance > 0 ? `${stickyHeight + distance}px` : 'auto';
      pin!.classList.toggle('js-hscroll', distance > 0);
      onScroll();
    }

    function onScroll() {
      if (distance <= 0) {
        sticky!.classList.remove('is-fixed', 'is-end');
        track!.style.transform = '';
        return;
      }
      const rect = pin!.getBoundingClientRect();
      if (rect.top > stickAt) {
        sticky!.classList.remove('is-fixed', 'is-end');
        track!.style.transform = '';
      } else if (rect.top + pin!.offsetHeight - stickyHeight <= stickAt) {
        sticky!.classList.remove('is-fixed');
        sticky!.classList.add('is-end');
        track!.style.transform = `translateX(-${distance.toFixed(1)}px)`;
      } else {
        sticky!.classList.add('is-fixed');
        sticky!.classList.remove('is-end');
        const progress = (stickAt - rect.top) / distance;
        track!.style.transform = `translateX(-${(progress * distance).toFixed(1)}px)`;
      }
    }

    measure();
    // layout can still shift after first paint (web fonts swapping, lazy images
    // above this section loading in) — re-measure once things settle so the
    // pinned scroll distance matches the track's final width
    window.addEventListener('load', measure, { passive: true });
    document.fonts?.ready?.then(measure).catch(() => {});
    window.addEventListener('resize', measure, { passive: true });
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProfileHScroll);
  } else {
    initProfileHScroll();
  }
</script>
