---
import Layout from '../../layouts/Layout.astro';
import Pic from '../../components/Pic.astro';
import IndustryHero from '../../components/IndustryHero.astro';

const profiles = [
  { name: 'Curtain wall mullion profiles', desc: 'Thermally broken and non-thermal curtain wall vertical and horizontal member extrusions, compatible with standard European DGU cassette widths and full-height glazing systems.' },
  { name: 'Structural glazing sections', desc: 'Silicone structural glazing (SSG) carrier extrusions and pressure plate sections for four-sided and two-sided structural glass façade systems.' },
  { name: 'Cladding carrier profiles', desc: 'Hat channel, Z-section, and bracket extrusions for aluminium composite panel (ACP) and solid aluminium cladding carrier systems: fire-rated construction available.' },
  { name: 'Roofing trim extrusions', desc: 'Ridge cap, eave closure, barge board, and verge trim extrusions for standing seam and profiled sheet roof systems, QUALICOAT powder coated to RAL specification.' },
  { name: 'Partition frame sections', desc: 'Demountable partition wall frame, track, and jamb extrusions for office fit-out and cleanroom construction, with slim sightlines and integral cable management provisions.' },
  { name: 'Louvre blade profiles', desc: 'Fixed and adjustable louvre blade extrusions for ventilated façade panels, mechanical plant screens, and architectural sun shading systems.' },
];

const galleryImages = ['8b', '8c', '8d', '8e', '8f'];

const alloys = [
  { name: '6063', temper: 'T6', why: 'The architectural standard: smooth mill finish, excellent anodising response, and consistent extrudability for complex multi-chamber curtain wall and window profiles.' },
  { name: '6060', temper: 'T6', why: 'Premium anodising quality alloy that yields a bright, uniform oxide layer free from streaking, specified for exposed architectural elements where appearance is a primary design criterion.' },
  { name: '6082', temper: 'T6', why: 'High-strength structural alloy for cladding carrier systems, curtain wall transom spans, and load-bearing architectural extrusions requiring structural calculation compliance.' },
];
---

<Layout
  title="Building & construction: Banco Aluminium"
  description="Curtain wall mullions, structural glazing sections, cladding profiles, roofing trim and partitions in Class 20 anodised or QUALICOAT coated finishes."
  heroImage="/assets/industries/hero/building-hero.jpg"
>
  <!-- Hero -->
  <IndustryHero
    image="/assets/industries/hero/building-hero.jpg"
    eyebrow="Industries / Building"
    stats={[
    ['QUALICOAT certified', 'Powder coating quality'],
    ['Class 20 anodising', 'In-house oxide treatment'],
    ['6063 · 6082 alloys', 'Architectural & structural'],
    ['EN 14351-1', 'Window & door standard'],
    ]}
  >
    <Fragment slot="h1">Building &amp; construction profiles.</Fragment>
    <Fragment slot="lead">Curtain wall mullions, structural glazing sections, cladding profiles, roofing trim, and partition extrusions in Class 20 anodised or QUALICOAT powder coated finishes.</Fragment>
  </IndustryHero>

  <!-- Gallery strip -->
  <section class="section-alt bld-gallery-section" style="padding:40px 0;border-top:1px solid var(--color-stone-200)">
    <div class="bld-gallery-viewport">
      <div class="bld-gallery-track">
        {[...galleryImages, ...galleryImages].map((id, i) => (
          <div class="bld-gallery-item" aria-hidden={i >= galleryImages.length ? 'true' : undefined}>
            <Pic
              src={`/assets/industries/building-gallery/${id}.jpg`}
              alt={i < galleryImages.length ? 'Banco Aluminium building and construction profile component' : ''}
              class="bld-gallery-img"
              sizes="240px"
              loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 01: Application overview -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="ind-split">
        <div>
          <div class="eyebrow">01 · Application overview</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            Profiles that define <em class="accent">building envelopes.</em>
          </h2>
          <p class="t-body" style="margin-top:20px;color:var(--color-stone-700)">
            Banco's building and construction profile range covers the complete spectrum of
            aluminium applications in the building envelope: from curtain wall systems and
            structural glazing to cladding carriers, louvre systems, and internal partition
            frames. Our 6063 and 6060 alloys are specifically selected for architectural
            applications where anodising and powder coating quality determine the long-term
            appearance of the finished building.
          </p>
          <p class="t-body" style="margin-top:16px;color:var(--color-stone-700)">
            In-house QUALICOAT certified powder coating and Class 20 anodising provide a
            complete supply-chain solution for architects and façade contractors who need
            consistent colour, texture, and surface quality across large project volumes,
            without the risk of batch-to-batch variation from multiple surface treatment
            subcontractors.
          </p>

          <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:28px">
            {['Curtain wall systems', 'Structural glazing', 'Rainscreen cladding', 'Louvre systems', 'Sun shading', 'Office partitions', 'Cleanroom construction'].map(tag => (
              <span class="pill">{tag}</span>
            ))}
          </div>
        </div>

        <div style="position:relative">
          <Pic
            src="/assets/industries/building.jpg"
            alt="Modern glass curtain wall building, showing an aluminium structural glazing system"
            loading="lazy"
            class="ind-photo" sizes="(max-width: 1024px) 100vw, 60vw" />
          <div class="ind-caption">
            <span class="ind-caption-t">
              6063 homogenisation: consistent billet structure for smooth anodising quality
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 02: Profile types -->
  <section class="section-alt section-pad">
    <div class="container">
      <div class="eyebrow">02 · Profile types</div>
      <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px;max-width:28ch">
        Six profile families for building and construction.
      </h2>
      <div class="ind-tiles mt-10">
        {profiles.map(p => (
          <div class="ind-tile">
            <div class="ind-tick"></div>
            <h3 class="ind-tile-h">{p.name}</h3>
            <p class="ind-tile-p">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 03: Alloys -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="eyebrow">03 · Alloys</div>
      <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px;max-width:28ch">
        Alloy selection for architectural applications.
      </h2>
      <div class="ind-cards cols-3 mt-10">
        {alloys.map(a => (
          <div class="ind-card">
            <div class="ind-card-n">{a.name}</div>
            <div class="ind-card-t">{a.temper}</div>
            <p class="ind-card-p">{a.why}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 04: Quality -->
  <section class="section-alt section-pad">
    <div class="container">
      <div class="ind-split">
        <div>
          <div class="eyebrow">04 · Quality &amp; certifications</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            QUALICOAT and CE certified <em class="accent">finishing.</em>
          </h2>
          <p class="t-body" style="margin-top:20px;color:var(--color-stone-700)">
            Banco's in-house surface finishing operations hold QUALICOAT certification for
            powder coating and Qualanod certification for anodising, ensuring that colour,
            gloss, film thickness, and adhesion meet the quality levels expected by architects
            and façade contractors on commercial building projects. CE marking under EN 15088
            covers structural profile supply to the European market.
          </p>
        </div>
        <div class="ind-certs">
          {[
            ['QUALICOAT', 'Powder coating certification'],
            ['Class 20 anodising', 'Oxide thickness 20 µm min'],
            ['CE marked', 'EN 15088 structural profiles'],
            ['IS 733 / IS 1285', 'Bureau of Indian Standards'],
          ].map(([cert, scope]) => (
            <div class="ind-cert">
              <div class="ind-cert-c">{cert}</div>
              <div class="ind-cert-s">{scope}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-dark" style="padding:80px 0;border-top:2px solid var(--color-green)">
    <div class="container">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:32px">
        <div>
          <div class="eyebrow on-dark">Get started</div>
          <h2 class="t-h2" style="color:var(--color-stone-50);margin-top:12px">
            Submit a <em class="accent">drawing.</em>
          </h2>
          <p style="color:var(--color-stone-400);margin-top:12px;font-size:16px;max-width:46ch">
            Share your curtain wall or façade cross-section and we'll provide alloy selection, QUALICOAT colour options, and volume pricing.
          </p>
        </div>
        <a href="/contact#quote" class="btn btn-primary-dark">Submit a drawing</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .bld-gallery-viewport {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent 0, black 64px, black calc(100% - 64px), transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, black 64px, black calc(100% - 64px), transparent 100%);
  }
  .bld-gallery-track {
    display: flex;
    width: max-content;
    padding: 4px 0 12px;
    animation: bld-marquee 28s linear infinite;
  }
  .bld-gallery-section:hover .bld-gallery-track { animation-play-state: paused; }
  .bld-gallery-item {
    position: relative;
    flex: 0 0 auto;
    width: 220px;
    margin-right: 20px;
    aspect-ratio: 290 / 244;
    overflow: hidden;
    background: var(--color-stone-100);
    border: 1px solid var(--color-stone-200);
    border-radius: 3px;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    transition: box-shadow 0.35s ease, border-color 0.35s ease, transform 0.35s ease;
  }
  .bld-gallery-item::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.5);
    pointer-events: none;
  }
  .bld-gallery-item:hover {
    border-color: var(--color-green);
    box-shadow: 0 14px 28px -12px rgba(15, 23, 42, 0.28);
    transform: translateY(-3px);
    z-index: 1;
  }
  :global(.bld-gallery-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(0.55) contrast(1.02);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), filter 0.45s ease;
  }
  .bld-gallery-item:hover :global(.bld-gallery-img) {
    transform: scale(1.08);
    filter: grayscale(0) contrast(1.02);
  }
  @keyframes bld-marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @media (min-width: 640px) {
    .bld-gallery-item { width: 260px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bld-gallery-track { animation: none; }
  }
</style>
