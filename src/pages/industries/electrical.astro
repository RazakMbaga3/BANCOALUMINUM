---
import Layout from '../../layouts/Layout.astro';
import Pic from '../../components/Pic.astro';
import IndustryHero from '../../components/IndustryHero.astro';

const profiles = [
  { name: 'Busbar profiles', desc: 'Flat, hollow, and shaped busbars for LV/MV/HV switchgear assemblies, supplied to tight dimensional tolerances in high-conductivity alloys.' },
  { name: 'Cable tray sections', desc: 'Perforated and solid-bottom cable tray extrusions for industrial cable management systems.' },
  { name: 'Switchgear housing profiles', desc: 'Tubular conductors, structural support frames, heat sinks, panel enclosure extrusions, door frame sections, and base channel profiles for switchgear cabinets.' },
  { name: 'Transformer spacer profiles', desc: 'Precision spacer and winding support sections for dry-type and oil-cooled transformer assemblies.' },
  { name: 'Control panel extrusions', desc: 'Mounting rail, DIN rail carrier, and panel frame sections for control and automation cabinet construction.' },
  { name: 'Cable management channels', desc: 'Open-slot and closed cable ducting profiles for overhead and floor-level electrical distribution runs.' },
];

const galleryImages = ['3a', '3b', '3c', '3d', '3e', '3f', '3g'];

const alloys = [
  { name: '6101', temper: 'T6 / T61', why: 'High electrical conductivity (≥52.5% IACS) with sufficient mechanical strength: the primary alloy for busbar and T&D conductors to IEC 60889.' },
  { name: '6063', temper: 'T5 / T6', why: 'For heat sinks, housings, and frames.' },
  { name: '1xxx', temper: 'O / H14', why: 'Near-pure aluminium for applications demanding maximum conductivity. Used for transformer windings and specialist conductor profiles.' },
];
---

<Layout
  title="Electrical & power transmission: Banco Aluminium"
  description="Busbars, cable management, switchgear housings, transformer sections and T&D profiles in high-conductivity alloys. CE certified, 35,000 MT annual capacity."
  heroImage="/assets/industries/hero/electrical-hero.jpg"
>
  <!-- Hero -->
  <IndustryHero
    image="/assets/industries/hero/electrical-hero.jpg"
    eyebrow="Industries / Electrical"
    stats={[
    ['Electrical Conductivity Alloys', 'Electrical conductor grade'],
    ['CE certified', 'EN 15088 compliant'],
    ['ISO 9001:2015', 'Quality management'],
    ['35,000 MT', 'Annual capacity'],
    ]}
  >
    <Fragment slot="h1">Electrical &amp; power transmission profiles.</Fragment>
    <Fragment slot="lead">Busbars, cable management, switchgear housings, transformer sections, and T&amp;D profiles in high-conductivity alloys, manufactured to EN and IEC standards.</Fragment>
  </IndustryHero>

  <!-- Gallery strip -->
  <section class="section-alt elec-gallery-section" style="padding:40px 0;border-top:1px solid var(--color-stone-200)">
    <div class="elec-gallery-viewport">
      <div class="elec-gallery-track">
        {[...galleryImages, ...galleryImages].map((id, i) => (
          <div class="elec-gallery-item" aria-hidden={i >= galleryImages.length ? 'true' : undefined}>
            <Pic
              src={`/assets/industries/electrical-gallery/${id}.jpg`}
              alt={i < galleryImages.length ? 'Banco Aluminium electrical profile component' : ''}
              class="elec-gallery-img"
              sizes="240px"
              loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 01: Application overview -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="ind-split">
        <div>
          <div class="eyebrow">01 · Application overview</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            Profiles engineered for <em class="accent">power distribution.</em>
          </h2>
          <p class="t-body" style="margin-top:20px;color:var(--color-stone-700)">
            Banco supplies a comprehensive range of extruded aluminium profiles to the electrical
            and power transmission sector. Our busbars are manufactured to IEC 60889 and
            EN 12020 standards, with conductivity verified by in-house laboratory analysis
            on every cast.
          </p>
          <p class="t-body" style="margin-top:16px;color:var(--color-stone-700)">
            Whether your application is in high-voltage applications, low-voltage switchgear,
            medium-voltage T&amp;D, transformer construction, or industrial cable management,
            our dedicated electrical profiles team can assist with alloy selection, temper
            optimisation, and surface finish specification.
          </p>

          <!-- Application chips -->
          <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:28px">
            {['LV Switchgear', 'MV Switchgear', 'HV Application', 'T&D infrastructure', 'Transformer construction', 'Industrial cable management', 'Control panel assembly', 'Substation equipment'].map(tag => (
              <span class="pill">{tag}</span>
            ))}
          </div>
        </div>

        <div style="position:relative">
          <Pic
            src="/assets/industries/electrical.jpg"
            alt="Electrical panel inspection: switchgear and power distribution enclosures"
            loading="lazy"
            class="ind-photo" sizes="(max-width: 1024px) 100vw, 60vw" />
          <div class="ind-caption">
            <span class="ind-caption-t">
              In-house foundry, from billet to busbar under one roof
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 02: Profile types -->
  <section class="section-alt section-pad">
    <div class="container">
      <div class="eyebrow">02 · Profile types</div>
      <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px;max-width:28ch">
        Sections in the Electrical Sector.
      </h2>
      <div class="ind-tiles">
        {profiles.map(p => (
          <div class="ind-tile">
            <div class="ind-tick"></div>
            <h3 class="ind-tile-h">{p.name}</h3>
            <p class="ind-tile-p">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 03: Alloys -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="eyebrow">03 · Alloys</div>
      <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px;max-width:28ch">
        Alloy selection for electrical applications.
      </h2>
      <div class="ind-cards cols-3">
        {alloys.map(a => (
          <div class="ind-card">
            <div class="ind-card-n">{a.name}</div>
            <div class="ind-card-t">{a.temper}</div>
            <p class="ind-card-p">{a.why}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 04: Quality & certifications -->
  <section class="section-alt section-pad">
    <div class="container">
      <div class="ind-split">
        <div>
          <div class="eyebrow">04 · Quality &amp; certifications</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            Certified for <em class="accent">electrical applications.</em>
          </h2>
          <p class="t-body" style="margin-top:20px;color:var(--color-stone-700)">
            Every batch of electrical-grade aluminium profiles leaves our facility with a full
            material test certificate covering chemical composition, mechanical properties, and
            electrical conductivity where applicable. Our MES / SCADA-monitored production system
            provides full traceability from billet cast to despatch.
          </p>
        </div>
        <div class="ind-certs">
          {[
            ['CE', 'EN 15088 structural profiles'],
            ['ISO 9001:2015', 'Quality management system'],
            ['BIS IS 5082', 'Electrical conductor alloys'],
            ['IEC 60889', 'Hard-drawn aluminium wire'],
            ['ERDA Certified', 'Electrical Research & Development Association'],
          ].map(([cert, scope]) => (
            <div class="ind-cert">
              <div class="ind-cert-c">{cert}</div>
              <div class="ind-cert-s">{scope}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-dark" style="padding:80px 0;border-top:2px solid var(--color-green)">
    <div class="container">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:32px">
        <div>
          <div class="eyebrow on-dark">Get started</div>
          <h2 class="t-h2" style="color:var(--color-stone-50);margin-top:12px">
            Submit a <em class="accent">Requirement.</em>
          </h2>
          <p style="color:var(--color-stone-400);margin-top:12px;font-size:16px;max-width:46ch">
            Upload a CAD file, PDF, or any image, and our Electrical Profiles team will respond
            with a quotation, including alloy recommendations, a feasibility assessment, and
            indicative pricing.
          </p>
        </div>
        <a href="/contact#quote" class="btn btn-primary-dark">Submit a requirement</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .elec-gallery-viewport {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent 0, black 64px, black calc(100% - 64px), transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, black 64px, black calc(100% - 64px), transparent 100%);
  }
  .elec-gallery-track {
    display: flex;
    width: max-content;
    padding: 4px 0 12px;
    animation: elec-marquee 34s linear infinite;
  }
  .elec-gallery-section:hover .elec-gallery-track { animation-play-state: paused; }
  .elec-gallery-item {
    position: relative;
    flex: 0 0 auto;
    width: 220px;
    margin-right: 20px;
    aspect-ratio: 290 / 244;
    overflow: hidden;
    background: var(--color-stone-100);
    border: 1px solid var(--color-stone-200);
    border-radius: 3px;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    transition: box-shadow 0.35s ease, border-color 0.35s ease, transform 0.35s ease;
  }
  .elec-gallery-item::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.5);
    pointer-events: none;
  }
  .elec-gallery-item:hover {
    border-color: var(--color-green);
    box-shadow: 0 14px 28px -12px rgba(15, 23, 42, 0.28);
    transform: translateY(-3px);
    z-index: 1;
  }
  :global(.elec-gallery-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(0.55) contrast(1.02);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), filter 0.45s ease;
  }
  .elec-gallery-item:hover :global(.elec-gallery-img) {
    transform: scale(1.08);
    filter: grayscale(0) contrast(1.02);
  }
  @keyframes elec-marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @media (min-width: 640px) {
    .elec-gallery-item { width: 260px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .elec-gallery-track { animation: none; }
  }
</style>
