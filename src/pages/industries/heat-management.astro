---
import Layout from '../../layouts/Layout.astro';
import Pic from '../../components/Pic.astro';
import IndustryHero from '../../components/IndustryHero.astro';

const profiles = [
  { name: 'Extruded fin heat sinks', desc: 'Single-piece fin arrays with base plate in 6063; fin pitches from 1.5 mm, heights up to 80 mm, for natural and forced convection cooling.' },
  { name: 'Bonded fin base profiles', desc: 'Wide base extrusions designed to accept aluminium fin inserts for ultra-high surface area bonded fin assemblies in power electronics cooling.' },
  { name: 'Liquid-cooled channel sections', desc: 'Hollow multi-port channel profiles for cold plate and liquid cooling loop integration in EV battery thermal management systems.' },
  { name: 'LED heatsink extrusions', desc: 'Star-fin, round, and flat-bar LED heatsink profiles in 6063-T5 with Class 20 anodised finish for high-bay, street, and architectural luminaire applications.' },
  { name: 'Power inverter cooling profiles', desc: 'Double-sided fin extrusions and channel-fin hybrids for IGBT module mounting in solar inverters, motor drives, and UPS systems.' },
  { name: 'HVAC fin sections', desc: 'Thin-wall corrugated and louvre fin extrusions for air-cooled condenser and evaporator assemblies in commercial HVAC equipment.' },
];

const alloys = [
  { name: '6063', temper: 'T5', why: 'Thermal conductivity 201 W/m·K. The standard heatsink alloy, with excellent surface quality after extrusion, ideal for Class 20 anodising and powder coating.' },
  { name: '6060', temper: 'T5', why: 'Superior anodising quality with bright, uniform oxide layer. Preferred for visible LED heatsinks and architectural lighting where appearance is critical.' },
  { name: '1100', temper: 'O', why: 'Maximum thermal conductivity at 222 W/m·K: near-pure aluminium for specialist high-flux cooling applications where mechanical strength is secondary.' },
];
---

<Layout
  title="Heat sinks & heat exchangers: Banco Aluminium"
  description="Precision fin profiles for LED lighting, power electronics, EV battery management and HVAC systems, extruded in 6063 for optimum thermal conductivity."
  heroImage="/assets/industries/hero/heat-management-hero.jpg"
>
  <!-- Hero -->
  <IndustryHero
    image="/assets/industries/hero/heat-management-hero.jpg"
    eyebrow="Industries / Heat management"
    stats={[
    ['6063 thermal alloy', '201 W/m·K conductivity'],
    ['Fin pitch from 1.5 mm', 'High surface area arrays'],
    ['Class 20 anodising', 'In-house surface finishing'],
    ['10,000 parts/day', 'Heatsink production rate'],
    ]}
  >
    <Fragment slot="h1">Heat sinks &amp; heat exchangers.</Fragment>
    <Fragment slot="lead">Precision fin profiles for LED lighting, power electronics, EV battery management, and HVAC systems, extruded in 6063 for optimum thermal conductivity and surface quality.</Fragment>
  </IndustryHero>

  <!-- Section 01: Application overview -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="ind-split">
        <div>
          <div class="eyebrow">01 · Application overview</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            Engineered for <em class="accent">thermal performance.</em>
          </h2>
          <p class="t-body" style="margin-top:20px;color:var(--color-stone-700)">
            As power densities increase in LED lighting, power electronics, and EV battery
            systems, effective thermal management becomes a critical design challenge. Banco's
            heatsink extrusion programme addresses this with a dedicated 6063-T5 profile range:
            fin geometries are produced with tight pitch and height tolerances to ensure
            predictable thermal resistance calculations.
          </p>
          <p class="t-body" style="margin-top:16px;color:var(--color-stone-700)">
            Our in-house Class 20 anodising line provides hard, electrically insulating surface
            treatment with emissivity up to 0.95, significantly improving radiative cooling
            performance over bare aluminium. Custom fin geometries can be developed with
            tooling lead times from 3–5 weeks.
          </p>

          <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:28px">
            {['LED street lighting', 'High-bay luminaires', 'Solar inverters', 'Motor drives', 'EV battery cooling', 'IGBT modules', 'UPS systems', 'HVAC coils'].map(tag => (
              <span class="pill">{tag}</span>
            ))}
          </div>
        </div>

        <div style="position:relative">
          <Pic
            src="/assets/industries/heat-management.jpg"
            alt="Aluminium heat sink fins: thermal management profiles for electronics cooling"
            loading="lazy"
            class="ind-photo" sizes="(max-width: 1024px) 100vw, 60vw" />
          <div class="ind-caption">
            <span class="ind-caption-t">
              In-house quality lab: fin pitch and surface emissivity verified per batch
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 02: Profile types -->
  <section class="section-alt section-pad">
    <div class="container">
      <div class="eyebrow">02 · Profile types</div>
      <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px;max-width:28ch">
        Six profile families for thermal management.
      </h2>
      <div class="ind-tiles mt-10">
        {profiles.map(p => (
          <div class="ind-tile">
            <div class="ind-tick"></div>
            <h3 class="ind-tile-h">{p.name}</h3>
            <p class="ind-tile-p">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 03: Alloys -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="eyebrow">03 · Alloys</div>
      <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px;max-width:28ch">
        Alloy selection for thermal applications.
      </h2>
      <div class="ind-cards cols-3 mt-10">
        {alloys.map(a => (
          <div class="ind-card">
            <div class="ind-card-n">{a.name}</div>
            <div class="ind-card-t">{a.temper}</div>
            <p class="ind-card-p">{a.why}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 04: Quality -->
  <section class="section-alt section-pad">
    <div class="container">
      <div class="ind-split">
        <div>
          <div class="eyebrow">04 · Quality &amp; certifications</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            Certified finish for <em class="accent">exacting thermal design.</em>
          </h2>
          <p class="t-body" style="margin-top:20px;color:var(--color-stone-700)">
            Heatsink profiles are supplied with full dimensional reports and, where specified,
            thermal resistance test data. Our anodising line holds Class 20 qualification with
            coating thickness verified by eddy-current gauge on every batch. CE marking is
            standard on structural heatsink base profiles.
          </p>
        </div>
        <div class="ind-certs">
          {[
            ['ISO 9001:2015', 'Quality management system'],
            ['CE marked', 'EN 15088 structural profiles'],
            ['Class 20 anodising', 'Oxide thickness 20 µm min'],
            ['Thermal test reports', 'On request per batch'],
          ].map(([cert, scope]) => (
            <div class="ind-cert">
              <div class="ind-cert-c">{cert}</div>
              <div class="ind-cert-s">{scope}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-dark" style="padding:80px 0;border-top:2px solid var(--color-green)">
    <div class="container">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:32px">
        <div>
          <div class="eyebrow on-dark">Get started</div>
          <h2 class="t-h2" style="color:var(--color-stone-50);margin-top:12px">
            Submit a <em class="accent">drawing.</em>
          </h2>
          <p style="color:var(--color-stone-400);margin-top:12px;font-size:16px;max-width:46ch">
            Share your fin geometry, thermal load, and target junction temperature. Our thermal profiles team will recommend the optimal cross-section.
          </p>
        </div>
        <a href="/contact#quote" class="btn btn-primary-dark">Submit a drawing</a>
      </div>
    </div>
  </section>
</Layout>
