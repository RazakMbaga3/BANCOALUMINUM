---
import Layout from '../../layouts/Layout.astro';
import Pic from '../../components/Pic.astro';
import IndustryHero from '../../components/IndustryHero.astro';

const profiles = [
  { name: 'Hydraulic cylinder tubes', desc: 'Seamless extruded and cold-drawn cylinder tube profiles in 6082-T6, with honed bore available and tight OD and wall thickness tolerances for reliable seal engagement.' },
  { name: 'Valve manifold profiles', desc: 'Solid and semi-hollow manifold block extrusions with pre-ported geometry, machined from extruded stock for dimensional consistency and reduced wastage.' },
  { name: 'Pneumatic actuator bodies', desc: 'Round and square pneumatic cylinder body extrusions in 6061 and 6082, with an anodised bore surface for low friction and long seal life.' },
  { name: 'Pump housing extrusions', desc: 'Flanged and unflanged pump body extrusions with close concentricity between bore and outer diameter for gear pump and vane pump applications.' },
  { name: 'Cylinder rod profiles', desc: 'Cold-drawn solid round bar in 6082-T6 for hydraulic and pneumatic cylinder rod applications; hardness and surface finish stay consistent across the full bar length.' },
  { name: 'Porting manifold sections', desc: 'Multi-port distribution manifold extrusions for hydraulic circuit construction, supplied as extruded stock for customer drilling and porting.' },
  { name: 'High pressure booster pump', desc: 'High-pressure booster pumps require high-quality extrusions with excellent seam welding to ensure reliable performance. We manufacture these extrusion profiles with the required strength, dimensional accuracy, and robust weld joints to meet demanding applications.' },
];

const galleryImages = ['6a', '6b', '6c', '6d', '6e', '6f', '6g', '6h'];

const alloys = [
  { name: '6063', temper: '', why: 'This alloy offers excellent extrudability, smooth surface finish, corrosion resistance, seam weldability, and adequate strength for high-pressure applications in pneumatic devices.' },
  { name: '6061, 6082', temper: '', why: 'These alloys deliver superior strength, durability, corrosion resistance, and structural integrity, making them suitable for demanding high-pressure applications on hydraulic devices.' },
  { name: 'Cold drawn products', temper: '', why: 'Cold-drawn aluminium provides higher strength, tighter tolerances, improved surface finish, straightness and dimensional stability. It is ideal for high-pressure components requiring reliable sealing and consistent wall thickness.' },
];
---

<Layout
  title="Hydraulics & pneumatics: Banco Aluminium"
  description="Actuator cylinder tubes, valve manifold bodies and pneumatic housing profiles, extruded and cold-drawn in hard alloys with tight concentricity control."
  heroImage="/assets/industries/hero/hydraulics-hero.jpg"
>
  <!-- Hero -->
  <IndustryHero
    image="/assets/industries/hero/hydraulics-hero.jpg"
    focus="38% 55%"
    focusMobile="34% 55%"
    eyebrow="Industries / Hydraulics"
    stats={[
    ['Cold drawing available', 'Precision profile sizes'],
    ['Multiple alloys', 'Low to high strength profiles'],
    ['Tight OD tolerance', 'EN 12020-2 / EN 754-2'],
    ]}
  >
    <Fragment slot="h1">Hydraulics &amp; pneumatics profiles.</Fragment>
    <Fragment slot="lead">Actuator cylinder tubes, valve manifold bodies, and pneumatic housing profiles, extruded and cold-drawn in hard alloys with controlled inner surface finish and tight concentricity.</Fragment>
  </IndustryHero>

  <!-- Gallery strip -->
  <section class="section-alt hyd-gallery-section" style="padding:40px 0;border-top:1px solid var(--color-stone-200)">
    <div class="hyd-gallery-viewport">
      <div class="hyd-gallery-track">
        {[...galleryImages, ...galleryImages].map((id, i) => (
          <div class="hyd-gallery-item" aria-hidden={i >= galleryImages.length ? 'true' : undefined}>
            <Pic
              src={`/assets/industries/hydraulics-gallery/${id}.jpg`}
              alt={i < galleryImages.length ? 'Banco Aluminium hydraulics and pneumatics component' : ''}
              class="hyd-gallery-img"
              sizes="240px"
              loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 01: Application overview -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="ind-split">
        <div>
          <div class="eyebrow">01 · Application overview</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            Profiles that <em class="accent">hold pressure.</em>
          </h2>
          <p class="t-body" style="margin-top:20px;color:var(--color-stone-700)">
            Hydraulic and pneumatic applications impose strict requirements on dimensional
            accuracy, surface finish, and mechanical consistency that go well beyond standard
            extrusion tolerances. Banco's fluid power profile range is manufactured with
            these demands at the centre of process design, starting with using multiple alloys
            made in our in-house casting facility with controlled composition for predictable
            strength and fatigue performance.
          </p>
          <p class="t-body" style="margin-top:16px;color:var(--color-stone-700)">
            Our cold drawing facility converts extruded tubes and rod profiles to achieve bore
            and OD tolerances tighter than H8. Concentricity between bore and OD is controlled
            and verified dimensionally on every production batch.
          </p>

          <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:28px">
            {['Hydraulic cylinders', 'Pneumatic actuators', 'Valve manifolds', 'Gear pumps', 'Vane pumps', 'Fluid power distribution', 'Industrial press systems', 'Pressure booster'].map(tag => (
              <span class="pill">{tag}</span>
            ))}
          </div>
        </div>

        <div style="position:relative">
          <Pic
            src="/assets/capabilities/cold-drawing-floor-a.jpg"
            alt="Banco operator running an aluminium profile through the cold drawing bench"
            loading="lazy"
            class="ind-photo" sizes="(max-width: 1024px) 100vw, 60vw" />
          <div class="ind-caption">
            <span class="ind-caption-t">
              Cold drawing bench: sizing extruded tube and rod to bore and OD tolerances tighter than H8
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 02: Profile types -->
  <section class="section-alt section-pad">
    <div class="container">
      <div class="eyebrow">02 · Profile types</div>
      <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px;max-width:28ch">
        Hydraulics and pneumatics profiles.
      </h2>
      <div class="ind-tiles">
        {profiles.map((p, i) => (
          <div class:list={['ind-tile', i === profiles.length - 1 && 'ind-tile--wide']}>
            <div class="ind-tick"></div>
            <h3 class="ind-tile-h">{p.name}</h3>
            <p class="ind-tile-p">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 03: Alloys -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="eyebrow">03 · Alloys</div>
      <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px;max-width:28ch">
        Alloy selection for fluid power applications.
      </h2>
      <div class="ind-cards cols-3">
        {alloys.map(a => (
          <div class="ind-card">
            <div class="ind-card-n">{a.name}</div>
            {a.temper && <div class="ind-card-t">{a.temper}</div>}
            <p class="ind-card-p">{a.why}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 04: Quality -->
  <section class="section-alt section-pad">
    <div class="container">
      <div class="ind-split">
        <div>
          <div class="eyebrow">04 · Quality &amp; certifications</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            Dimensional traceability for <em class="accent">pressure-rated parts.</em>
          </h2>
          <p class="t-body" style="margin-top:20px;color:var(--color-stone-700)">
            Every hydraulic and pneumatic profile batch is supplied with dimensional inspection
            reports covering bore diameter, OD, wall thickness, concentricity, and straightness.
            Material test certificates confirm chemical composition and mechanical properties.
            For cold-drawn profiles, hardness testing is performed after drawing to confirm
            consistent through-section properties.
          </p>
        </div>
        <div class="ind-certs">
          {[
            ['ISO 9001:2015', 'Quality management system'],
            ['CE marked', 'EN 15088 structural profiles'],
            ['EN 755-9', 'Dimensional tolerance class A'],
            ['Dimensional traceability', 'Full inspection reports & test certifications'],
          ].map(([cert, scope]) => (
            <div class="ind-cert">
              <div class="ind-cert-c">{cert}</div>
              <div class="ind-cert-s">{scope}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .hyd-gallery-viewport {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent 0, black 64px, black calc(100% - 64px), transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, black 64px, black calc(100% - 64px), transparent 100%);
  }
  .hyd-gallery-track {
    display: flex;
    width: max-content;
    padding: 4px 0 12px;
    animation: hyd-marquee 36s linear infinite;
  }
  .hyd-gallery-section:hover .hyd-gallery-track { animation-play-state: paused; }
  .hyd-gallery-item {
    position: relative;
    flex: 0 0 auto;
    width: 220px;
    margin-right: 20px;
    aspect-ratio: 290 / 244;
    overflow: hidden;
    background: var(--color-stone-100);
    border: 1px solid var(--color-stone-200);
    border-radius: 3px;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    transition: box-shadow 0.35s ease, border-color 0.35s ease, transform 0.35s ease;
  }
  .hyd-gallery-item::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.5);
    pointer-events: none;
  }
  .hyd-gallery-item:hover {
    border-color: var(--color-green);
    box-shadow: 0 14px 28px -12px rgba(15, 23, 42, 0.28);
    transform: translateY(-3px);
    z-index: 1;
  }
  :global(.hyd-gallery-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(0.55) contrast(1.02);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), filter 0.45s ease;
  }
  .hyd-gallery-item:hover :global(.hyd-gallery-img) {
    transform: scale(1.08);
    filter: grayscale(0) contrast(1.02);
  }
  @keyframes hyd-marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @media (min-width: 640px) {
    .hyd-gallery-item { width: 260px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hyd-gallery-track { animation: none; }
  }
</style>
