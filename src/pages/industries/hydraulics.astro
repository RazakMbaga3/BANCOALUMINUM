---
import Layout from '../../layouts/Layout.astro';

const profiles = [
  { name: 'Hydraulic cylinder tubes', desc: 'Seamless extruded and cold-drawn cylinder tube profiles in 6082-T6 — honed bore available, tight OD and wall thickness tolerances for reliable seal engagement.' },
  { name: 'Valve manifold profiles', desc: 'Solid and semi-hollow manifold block extrusions with pre-ported geometry — machined from extruded stock for dimensional consistency and reduced wastage.' },
  { name: 'Pneumatic actuator bodies', desc: 'Round and square pneumatic cylinder body extrusions in 6061 and 6082 — anodised bore surface for low friction and long seal life.' },
  { name: 'Pump housing extrusions', desc: 'Flanged and unflanged pump body extrusions with close concentricity between bore and outer diameter for gear pump and vane pump applications.' },
  { name: 'Cylinder rod profiles', desc: 'Cold-drawn solid round bar in 6082-T6 for hydraulic and pneumatic cylinder rod applications — hardness and surface finish consistent across the full bar length.' },
  { name: 'Porting manifold sections', desc: 'Multi-port distribution manifold extrusions for hydraulic circuit construction — supplied as extruded stock for customer drilling and porting.' },
];

const alloys = [
  { name: '6082', temper: 'T6', why: 'Primary hydraulic alloy — UTS 310 MPa, excellent pressure fatigue resistance, and consistent hardness for reliable thread and seal engagement in cylinder and manifold applications.' },
  { name: '6061', temper: 'T6', why: 'Versatile engineering alloy for pneumatic actuator bodies and valve housings — good machinability and corrosion resistance for fluid power components.' },
  { name: 'Cold drawn', temper: '6082-T6', why: 'Post-extrusion cold drawing improves dimensional accuracy, surface finish, and hardness uniformity across the cross-section — essential for cylinder rod and bore applications.' },
];
---

<Layout
  title="Hydraulics & pneumatics — Banco Aluminium"
  description="Actuator cylinder tubes, valve manifold bodies, and pneumatic housing profiles — extruded and cold-drawn in hard alloys with controlled inner surface finish and tight concentricity."
>
  <!-- Hero -->
  <section style="background:var(--color-navy);padding-top:148px;padding-bottom:0">
    <div class="container">
      <div class="eyebrow on-dark">Industries / Hydraulics</div>
      <h1 class="t-h1" style="color:var(--color-stone-50);margin-top:20px;max-width:22ch">
        Hydraulics &amp; pneumatics profiles.
      </h1>
      <p class="t-lead" style="color:var(--color-stone-400);margin-top:24px;max-width:58ch">
        Actuator cylinder tubes, valve manifold bodies, and pneumatic housing profiles — extruded and cold-drawn in hard alloys with controlled inner surface finish and tight concentricity.
      </p>

      <!-- Stats strip -->
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--color-navy-line);margin-top:56px;border-top:1px solid var(--color-navy-line)">
        {[
          ['Cold drawing available', 'Post-extrusion sizing'],
          ['6082 · 6061 alloys', 'High strength grades'],
          ['Tight OD tolerance', 'EN 755-9 Class A'],
          ['10,000 parts/day', 'Production capacity'],
        ].map(([val, label]) => (
          <div style="background:var(--color-navy-soft);padding:28px 24px">
            <div style="font-family:var(--font-display);font-size:clamp(13px,1.7vw,20px);font-weight:700;color:var(--color-stone-50)">{val}</div>
            <div style="font-family:var(--font-mono);font-size:10px;letter-spacing:0.14em;text-transform:uppercase;color:var(--color-nickel);margin-top:6px">{label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 01: Application overview -->
  <section class="section-light section-pad">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start">
        <div>
          <div class="eyebrow">01 — Application overview</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            Profiles that <em class="accent">hold pressure.</em>
          </h2>
          <p class="t-body" style="margin-top:20px;color:var(--color-stone-700)">
            Hydraulic and pneumatic applications impose strict requirements on dimensional
            accuracy, surface finish, and mechanical consistency that go well beyond standard
            extrusion tolerances. Banco's fluid power profile range is manufactured with
            these demands at the centre of process design — starting with 6082 billet cast
            in-house to controlled composition for predictable strength and fatigue performance.
          </p>
          <p class="t-body" style="margin-top:16px;color:var(--color-stone-700)">
            Our cold drawing facility post-processes extruded tube and rod profiles to achieve
            bore and OD tolerances tighter than H8/h8, with Ra surface finish values suitable
            for direct seal engagement without additional honing. Concentricity between bore
            and OD is controlled and verified dimensionally on every production batch.
          </p>

          <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:28px">
            {['Hydraulic cylinders', 'Pneumatic actuators', 'Valve manifolds', 'Gear pumps', 'Vane pumps', 'Fluid power distribution', 'Industrial press systems'].map(tag => (
              <span class="pill">{tag}</span>
            ))}
          </div>
        </div>

        <div style="position:relative">
          <img
            src="/assets/manufacturing/casting-7.jpg"
            alt="Aluminium casting at Banco Aluminium"
            loading="lazy"
            style="width:100%;aspect-ratio:4/3;object-fit:cover"
          />
          <div style="position:absolute;bottom:0;left:0;right:0;padding:16px 20px;background:var(--color-navy-deep)">
            <span style="font-family:var(--font-mono);font-size:10px;letter-spacing:0.14em;text-transform:uppercase;color:var(--color-nickel)">
              In-house foundry — 6082 billet cast to controlled chemistry for hydraulic applications
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 02: Profile types -->
  <section class="section-alt section-pad">
    <div class="container">
      <div class="eyebrow">02 — Profile types</div>
      <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px;max-width:28ch">
        Six profile families for hydraulics and pneumatics.
      </h2>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--color-stone-200);margin-top:40px">
        {profiles.map(p => (
          <div style="background:var(--color-stone-50);padding:32px 28px">
            <div style="width:2px;height:24px;background:var(--color-green);margin-bottom:16px"></div>
            <h3 style="font-family:var(--font-sans);font-size:16px;font-weight:700;color:var(--color-navy);line-height:1.3">{p.name}</h3>
            <p style="font-size:14px;color:var(--color-stone-700);line-height:1.6;margin-top:10px">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 03: Alloys -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="eyebrow">03 — Alloys</div>
      <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px;max-width:28ch">
        Alloy selection for fluid power applications.
      </h2>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:40px">
        {alloys.map(a => (
          <div style="border:1px solid var(--color-stone-200);padding:32px 28px">
            <div style="font-family:var(--font-mono);font-size:22px;font-weight:500;color:var(--color-navy)">{a.name}</div>
            <div style="font-family:var(--font-mono);font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--color-green);margin-top:6px">{a.temper}</div>
            <p style="font-size:14px;color:var(--color-stone-700);line-height:1.6;margin-top:16px">{a.why}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 04: Quality -->
  <section class="section-alt section-pad">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start">
        <div>
          <div class="eyebrow">04 — Quality &amp; certifications</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            Dimensional traceability for <em class="accent">pressure-rated parts.</em>
          </h2>
          <p class="t-body" style="margin-top:20px;color:var(--color-stone-700)">
            Every hydraulic and pneumatic profile batch is supplied with dimensional inspection
            reports covering bore diameter, OD, wall thickness, concentricity, and straightness.
            Material test certificates confirm chemical composition and mechanical properties.
            For cold-drawn profiles, hardness testing is performed after drawing to confirm
            consistent through-section properties.
          </p>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
          {[
            ['ISO 9001:2015', 'Quality management system'],
            ['CE marked', 'EN 15088 structural profiles'],
            ['EN 755-9', 'Dimensional tolerance class A'],
            ['Dimensional traceability', 'Full inspection reports'],
          ].map(([cert, scope]) => (
            <div style="border-left:2px solid var(--color-green);padding-left:16px">
              <div style="font-family:var(--font-mono);font-size:13px;font-weight:500;color:var(--color-navy)">{cert}</div>
              <div style="font-size:13px;color:var(--color-stone-700);margin-top:4px">{scope}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-dark" style="padding:80px 0;border-top:2px solid var(--color-green)">
    <div class="container">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:32px">
        <div>
          <div class="eyebrow on-dark">Get started</div>
          <h2 class="t-h2" style="color:var(--color-stone-50);margin-top:12px">
            Submit a <em class="accent">drawing.</em>
          </h2>
          <p style="color:var(--color-stone-400);margin-top:12px;font-size:16px;max-width:46ch">
            Share your cylinder bore, OD, and pressure rating — our hydraulics team will confirm tolerance achievability and cold drawing options.
          </p>
        </div>
        <a href="/contact#quote" class="btn btn-primary-dark">Submit a drawing</a>
      </div>
    </div>
  </section>
</Layout>
