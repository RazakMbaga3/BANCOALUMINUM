---
import Layout from '../../layouts/Layout.astro';
import Pic from '../../components/Pic.astro';
import IndustryHero from '../../components/IndustryHero.astro';

const profiles = [
  { name: 'T-slot machine frame profiles', desc: 'Standard 20, 30, 40, 45, and 80 series T-slot profiles compatible with off-the-shelf T-nut hardware, built for modular machine frame and jig construction.' },
  { name: 'Linear guide rails', desc: 'Precision linear rail extrusions with ground or milled bearing surfaces, used in CNC machines, pick-and-place systems, and gantry structures.' },
  { name: 'Conveyor frame sections', desc: 'Side frame, cross-brace, and roller bed extrusions for belt and roller conveyor systems in food, pharmaceutical, and industrial processing.' },
  { name: 'Automation housing profiles', desc: 'Panel housing, control enclosure, and cable duct extrusions for robotic cells and PLC cabinet integration.' },
  { name: 'Motor mount extrusions', desc: 'Servo and stepper motor mounting profiles with integral cooling fins and pre-drilled attachment geometry for rapid machine assembly.' },
  { name: 'Enclosure panels', desc: 'Flat and ribbed panel extrusions with tongue-and-groove edges for fast, screw-less machine guard and safety enclosure assembly.' },
];

const alloys = [
  { name: '6063', temper: 'T6', why: 'Smooth surface quality, consistent dimensional tolerance, and excellent machinability make it the standard alloy for T-slot profiles and enclosure sections.' },
  { name: '6082', temper: 'T6', why: 'Higher structural strength for load-bearing machine frames, gantry beams, and conveyor side frames where deflection under load must be minimised.' },
  { name: '6061', temper: 'T6', why: 'Engineering alloy for precision-machined motor mounts, guide rail carriages, and components requiring close bore and thread tolerances.' },
];
---

<Layout
  title="Machinery & automation: Banco Aluminium"
  description="Machine frames, linear guides, T-slot profiles, conveyor sections and automation housings: lightweight, precise, compatible with standard T-nut hardware."
  heroImage="/assets/industries/hero/machinery-hero.jpg"
>
  <!-- Hero -->
  <IndustryHero
    image="/assets/industries/hero/machinery-hero.jpg"
    eyebrow="Industries / Machinery"
    stats={[
    ['T-slot compatible', '20 · 30 · 40 · 45 · 80 series'],
    ['6063 · 6082', 'Primary alloys'],
    ['0.29–35 kg/m', 'Weight range'],
    ['35,000 MT', 'Annual capacity'],
    ]}
  >
    <Fragment slot="h1">Machinery &amp; automation profiles.</Fragment>
    <Fragment slot="lead">Machine frames, linear guides, T-slot profiles, conveyor sections, and automation housings; lightweight, dimensionally precise, and compatible with standard T-nut hardware.</Fragment>
  </IndustryHero>

  <!-- Section 01: Application overview -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="ind-split">
        <div>
          <div class="eyebrow">01 · Application overview</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            Precision profiles for <em class="accent">machine builders.</em>
          </h2>
          <p class="t-body" style="margin-top:20px;color:var(--color-stone-700)">
            Banco's machinery and automation profile range spans from lightweight T-slot frames
            for modular jig construction through to heavy structural extrusions for industrial
            conveyor systems and automated manufacturing cells. Our die shop designs and
            manufactures tooling in-house, enabling custom cross-sections to be developed
            quickly for OEM machine builders.
          </p>
          <p class="t-body" style="margin-top:16px;color:var(--color-stone-700)">
            Dimensional consistency is particularly important in machine-build applications:
            our presses maintain cross-section tolerances to EN 755-9 class A, and profiles
            destined for precision linear guide applications receive additional straightness
            correction and surface inspection before despatch.
          </p>

          <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:28px">
            {['CNC machine frames', 'Robotics', 'Conveyor systems', 'Assembly automation', 'Packaging machinery', 'Food processing equipment', 'Pharmaceutical equipment'].map(tag => (
              <span class="pill">{tag}</span>
            ))}
          </div>
        </div>

        <div style="position:relative">
          <Pic
            src="/assets/industries/machinery.jpg"
            alt="Large industrial manufacturing machinery, aluminium structural profiles in equipment"
            loading="lazy"
            class="ind-photo" sizes="(max-width: 1024px) 100vw, 60vw" />
          <div class="ind-caption">
            <span class="ind-caption-t">
              Homogenisation furnace, producing consistent billet structure for precise extrusion
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 02: Profile types -->
  <section class="section-alt section-pad">
    <div class="container">
      <div class="eyebrow">02 · Profile types</div>
      <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px;max-width:28ch">
        Six profile families for machinery and automation.
      </h2>
      <div class="ind-tiles">
        {profiles.map(p => (
          <div class="ind-tile">
            <div class="ind-tick"></div>
            <h3 class="ind-tile-h">{p.name}</h3>
            <p class="ind-tile-p">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 03: Alloys -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="eyebrow">03 · Alloys</div>
      <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px;max-width:28ch">
        Alloy selection for machinery applications.
      </h2>
      <div class="ind-cards cols-3">
        {alloys.map(a => (
          <div class="ind-card">
            <div class="ind-card-n">{a.name}</div>
            <div class="ind-card-t">{a.temper}</div>
            <p class="ind-card-p">{a.why}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 04: Quality -->
  <section class="section-alt section-pad">
    <div class="container">
      <div class="ind-split">
        <div>
          <div class="eyebrow">04 · Quality &amp; certifications</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            Quality systems that <em class="accent">machine builders trust.</em>
          </h2>
          <p class="t-body" style="margin-top:20px;color:var(--color-stone-700)">
            Every profile is measured against drawing at our in-house metrology lab before
            release. We can provide EN 755-9 dimensional compliance certificates, material
            test certificates, and hardness reports on request. SCADA-monitored extrusion
            parameters ensure process consistency across production runs.
          </p>
        </div>
        <div class="ind-certs">
          {[
            ['ISO 9001:2015', 'Quality management system'],
            ['CE marked', 'EN 15088 structural'],
            ['EN 755-9', 'Dimensional tolerance class'],
            ['SCADA traceability', 'Full production logging'],
          ].map(([cert, scope]) => (
            <div class="ind-cert">
              <div class="ind-cert-c">{cert}</div>
              <div class="ind-cert-s">{scope}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-dark" style="padding:80px 0;border-top:2px solid var(--color-green)">
    <div class="container">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:32px">
        <div>
          <div class="eyebrow on-dark">Get started</div>
          <h2 class="t-h2" style="color:var(--color-stone-50);margin-top:12px">
            Submit a <em class="accent">drawing.</em>
          </h2>
          <p style="color:var(--color-stone-400);margin-top:12px;font-size:16px;max-width:46ch">
            Send your T-slot or custom frame cross-section and we'll quote tooling, lead time, and price per metre.
          </p>
        </div>
        <a href="/contact#quote" class="btn btn-primary-dark">Submit a drawing</a>
      </div>
    </div>
  </section>
</Layout>
