  .ah-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(6, 18, 34, 0.52);
  }
  /* Left-heavy directional gradient so text is readable */
  .ah-grad {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      105deg,
      rgba(6, 18, 34, 0.80) 0%,
      rgba(6, 18, 34, 0.52) 42%,
      rgba(6, 18, 34, 0.10) 75%,
      transparent 100%
    );
  }
  /* Bottom fade — blends into stats bar */
  .ah-bottom {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 220px;
    z-index: 3;
    background: linear-gradient(to bottom, transparent, rgba(6, 18, 34, 0.88));
    pointer-events: none;
