  { name: 'Anodising',      desc: 'Class 20 anodising to EN 12373. Natural, champagne, bronze, and black. Controlled bath for colour consistency.' },
  { name: 'Brushed finish', desc: 'Directional mechanical brushed surface for contemporary aesthetic. Available for interior and exterior applications.' },
  { name: 'Sand-blast',     desc: 'Uniform matte texture for architectural applications requiring diffused reflection and industrial appearance.' },
