    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    display: block;
    animation: ah-kb 14s ease-out forwards;
  }
  @keyframes ah-kb {
    from { transform: scale(1.0); }
    to   { transform: scale(1.06); }
  }

