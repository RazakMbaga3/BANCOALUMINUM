---

<Layout
  title="Architectural aluminium systems — windows, doors, façades — Banco Aluminium"
  description="Precision-engineered aluminium window, door, façade and architectural profile systems for residential, commercial and institutional projects. EN 14351-1 tested. In-house extrusion, Vadodara."
  image="/assets/images/architectureheropage/aluminum-architectural-systems-solutions-that-combine-aesthetics-and-functionality.webp"
  transparentNav={true}
>

  <!-- ══════════════════════════════════════════════════════════
       01 · HERO — FULL-BLEED SINGLE IMAGE
  ══════════════════════════════════════════════════════════════ -->
  <section class="ah-wrap" aria-label="Architectural systems hero">

    <!-- Background image with Ken Burns -->
    <div class="ah-bg" aria-hidden="true">
      <img
        src="/assets/images/architectureheropage/blog_thumb_1760685500.webp"
        alt=""
        class="ah-bg-img"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <!-- Layered overlays: base scrim + directional gradient -->
    <div class="ah-scrim"  aria-hidden="true"></div>
    <div class="ah-grad"   aria-hidden="true"></div>
    <div class="ah-bottom" aria-hidden="true"></div>

    <!-- Content — bottom-left anchored, full two-col grid -->
    <div class="ah-content">
      <div class="container ah-inner">

        <!-- Left: eyebrow + headline + rule + desc + CTAs -->
        <div class="ah-copy">

          <div class="eyebrow on-dark ah-eyebrow">
            <span>/ Architectural Systems</span>
            <span class="ah-eyebrow-sep" aria-hidden="true"></span>
            <span>Banco Aluminium</span>
          </div>

          <h1 class="ah-h1">
            <span class="ah-h1-line1">Aluminium systems</span>
            <span class="ah-rule" aria-hidden="true"></span>
            <span class="ah-h1-line2">for modern<br/>architecture.</span>
          </h1>

          <p class="ah-desc">
            Precision-engineered aluminium window, door, façade and profile
            systems for contemporary residential, commercial and institutional
            projects.
          </p>

          <!-- Action buttons -->
          <div class="ah-actions">
            <a href="/downloads" class="btn ah-btn-primary">
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M8 2v8M4 7l4 4 4-4M2 14h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Download catalogue
            </a>
            <a href="/contact#quote" class="btn ah-btn-outline">
              Send enquiry
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              </svg>
            </a>
          </div>

        </div>

        <!-- Right: scrolling thumbnail strip (decorative) -->
        <div class="ah-thumbs" aria-hidden="true">
          {[
            '/assets/architectural/0fa274d34eaac9f8ed5881ccbca5660c.jpg',
            '/assets/architectural/41f468e4f12973012f865d065f5f3b44.jpg',
            '/assets/architectural/810f32deb5c2a2a7f3d0719cf87348fa.jpg',
            '/assets/images/architectureheropage/Large-apartment-louvres.jpg',
          ].map((src, i) => (
            <div class="ah-thumb" style={`animation-delay:${i * 0.15}s`}>
              <img src={src} alt="" loading="lazy" />
            </div>
          ))}
        </div>

      </div>
    </div>

    <!-- Bottom stats ribbon -->
    <div class="ah-stats-bar">
      <div class="container ah-stats-inner">
        {heroStats.map((s) => (
          <div class="ah-stat">
            <span class="ah-stat-val">{s.value}<em>{s.unit}</em></span>
            <span class="ah-stat-lbl">{s.label}</span>
          </div>
        ))}
        <a href="/contact#quote" class="ah-stat-cta">
          Get a quote
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </a>
      </div>
    </div>

  </section>


  <!-- ══════════════════════════════════════════════════════════
       02 · INTRO — 2-COL SPLIT
  ══════════════════════════════════════════════════════════════ -->
  <section class="section-white section-pad" style="border-bottom:1px solid var(--color-stone-200)">
    <div class="container">
      <div class="arc-intro-grid">
        <div class="arc-intro-body" data-reveal="left">
          <div class="eyebrow">Banco Architectural Systems</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            Precision extrusion.<br/><em class="accent">Architectural finish.</em>
          </h2>
          <p class="t-lead" style="color:var(--color-stone-700);margin-top:24px">
            Every system starts on a Banco extrusion press. In-house die design, 6063/6060 alloys
            formulated for surface quality, and Class 20 anodising — all under one roof in Vadodara.
          </p>
          <p class="t-body" style="color:var(--color-stone-700);margin-top:16px">
            Designed to support residential, commercial and institutional developments,
            our systems combine functionality, durability and clean aesthetics to meet
            the demands of contemporary building design.
          </p>
          <p class="t-body" style="color:var(--color-stone-700);margin-top:16px">
            Backed by decades of aluminium extrusion expertise, we provide architectural
            solutions that support architects, fabricators, builders and developers
            across diverse project requirements.
          </p>
          <div style="display:flex;gap:16px;flex-wrap:wrap;margin-top:36px">
            <a href="/contact#quote" class="btn btn-primary">Send enquiry</a>
            <a href="/downloads" class="btn btn-secondary">Download catalogue</a>
          </div>
        </div>
        <div class="arc-intro-visual" data-reveal="right">
          <img
            src="/assets/images/architectureheropage/aluminum-architectural-systems-solutions-that-combine-aesthetics-and-functionality.webp"
            alt="Aluminium architectural profile cross-section — Banco"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       03 · FEATURED ARCHITECTURAL SOLUTIONS — 4-COL
  ══════════════════════════════════════════════════════════════ -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="arc-section-head" data-reveal="fade">
        <div class="eyebrow">Our solutions</div>
        <h2 class="arc-sh" style="color:var(--color-navy);margin-top:12px">Featured Architectural Solutions</h2>
        <p class="t-body arc-sub" style="color:var(--color-stone-700)">
          Performance, flexibility and refined aesthetics — designed for contemporary architecture.
        </p>
      </div>

      <div class="arc-feat-grid">
        {featured.map((f, i) => (
          <div class="arc-feat-card" data-reveal data-reveal-delay={String(i + 1)}>
            <div class="arc-feat-img">
              <img src={f.img} alt={f.title} loading="lazy" />
            </div>
            <!-- System type icon -->
            <div class="arc-feat-icon" aria-hidden="true">
              {i === 0 && (
                <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
                  <rect x="2" y="4" width="24" height="20" rx="0" stroke="currentColor" stroke-width="1.4"/>
                  <line x1="14" y1="4" x2="14" y2="24" stroke="currentColor" stroke-width="1.4"/>
                  <line x1="2" y1="14" x2="26" y2="14" stroke="currentColor" stroke-width="1.4"/>
                  <circle cx="12" cy="14" r="1.2" fill="currentColor"/>
                  <circle cx="16" cy="14" r="1.2" fill="currentColor"/>
                </svg>
              )}
              {i === 1 && (
                <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
                  <rect x="2" y="4" width="24" height="20" rx="0" stroke="currentColor" stroke-width="1.4"/>
                  <path d="M14 4 L14 24" stroke="currentColor" stroke-width="1.4"/>
                  <path d="M14 9 Q20 14 14 19" stroke="currentColor" stroke-width="1.4" fill="none"/>
                  <circle cx="21" cy="14" r="1.2" fill="currentColor"/>
                </svg>
              )}
              {i === 2 && (
                <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
                  <rect x="5" y="2" width="18" height="24" rx="0" stroke="currentColor" stroke-width="1.4"/>
                  <line x1="5" y1="14" x2="23" y2="14" stroke="currentColor" stroke-width="1.4"/>
                  <circle cx="20" cy="14" r="1.4" fill="currentColor"/>
                  <line x1="5" y1="26" x2="5" y2="26" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              )}
              {i === 3 && (
                <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
                  <rect x="2" y="2" width="24" height="24" rx="0" stroke="currentColor" stroke-width="1.4"/>
                  <line x1="2"  y1="10" x2="26" y2="10" stroke="currentColor" stroke-width="1.4"/>
                  <line x1="2"  y1="18" x2="26" y2="18" stroke="currentColor" stroke-width="1.4"/>
                  <line x1="10" y1="2"  x2="10" y2="26" stroke="currentColor" stroke-width="1.4"/>
                  <line x1="18" y1="2"  x2="18" y2="26" stroke="currentColor" stroke-width="1.4"/>
                </svg>
              )}
            </div>
            <div class="arc-feat-body">
              <h3 class="arc-feat-title">{f.title}</h3>
              <p class="arc-feat-desc">{f.desc}</p>
              <ul class="arc-feat-bullets">
                {f.bullets.map((b) => (
                  <li>
                    <span class="arc-feat-dot" aria-hidden="true"></span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
              <a href="/contact#quote" class="arc-feat-link">
                Specify a system
                <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       04 · COMPREHENSIVE SYSTEMS TABLE — 5-COL
  ══════════════════════════════════════════════════════════════ -->
  <section class="section-white section-pad" style="border-bottom:1px solid var(--color-stone-200)">
    <div class="container">
      <div class="arc-section-head" data-reveal="fade">
        <div class="eyebrow">Full range</div>
        <h2 class="arc-sh" style="color:var(--color-navy);margin-top:12px">Comprehensive Architectural Systems</h2>
        <p class="t-body arc-sub" style="color:var(--color-stone-700)">
          A complete aluminium system range — from windows and doors to façades, profiles and accessories.
        </p>
      </div>

      <div class="arc-sys-grid" data-reveal>
        {systems.map((sys, i) => (
          <div class="arc-sys-col">
            <div class="arc-sys-icon" aria-hidden="true">
              <!-- Consistent square icon per column -->
              <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
                <rect x="1" y="1" width="20" height="20" stroke="currentColor" stroke-width="1.4"/>
                <line x1="1"  y1="8"  x2="21" y2="8"  stroke="currentColor" stroke-width="1"/>
                <line x1="1"  y1="14" x2="21" y2="14" stroke="currentColor" stroke-width="1"/>
                <line x1="8"  y1="1"  x2="8"  y2="21" stroke="currentColor" stroke-width="1"/>
                <line x1="14" y1="1"  x2="14" y2="21" stroke="currentColor" stroke-width="1"/>
              </svg>
            </div>
            <h3 class="arc-sys-label">{sys.label}</h3>
            <ul class="arc-sys-list">
              {sys.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       05 · ENVIRONMENTS — 8-COL THUMBNAIL GRID
  ══════════════════════════════════════════════════════════════ -->
  <section class="section-alt section-pad" style="border-bottom:1px solid var(--color-stone-200)">
    <div class="container">
      <div class="arc-section-head" data-reveal="fade">
        <div class="eyebrow">Applications</div>
        <h2 class="arc-sh" style="color:var(--color-navy);margin-top:12px">Diverse Architectural Environments</h2>
        <p class="t-body arc-sub" style="color:var(--color-stone-700)">
          Supporting a wide range of building typologies — from residential to large-scale commercial.
        </p>
      </div>

      <div class="arc-env-grid" data-reveal>
        {environments.map((env) => (
          <div class="arc-env-item">
            <div class="arc-env-img">
              <img src={env.img} alt={env.label} loading="lazy" />
            </div>
            <span class="arc-env-label">{env.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       06 · WHY BANCO — 2-COL WITH FEATURE CHIPS
  ══════════════════════════════════════════════════════════════ -->
  <section class="section-white section-pad" style="border-bottom:1px solid var(--color-stone-200)">
    <div class="container">
      <div class="arc-why-grid">
        <div data-reveal="left">
          <div class="eyebrow">Why choose us</div>
          <h2 class="arc-sh" style="color:var(--color-navy);margin-top:16px">Why Banco Architectural Systems</h2>
          <p class="t-body" style="color:var(--color-stone-700);margin-top:20px">
            Supported by advanced aluminium extrusion capabilities and profile development
            expertise, Banco delivers architectural systems engineered for consistency,
            precision and long-term performance.
          </p>
          <p class="t-body" style="color:var(--color-stone-700);margin-top:14px">
            Our manufacturing foundation enables the development of aluminium solutions
            suitable for modern architectural requirements across residential, commercial
            and institutional applications.
          </p>
          <div class="arc-why-chips">
            {whyFeatures.map((f) => (
              <div class="arc-why-chip">
                <span class="arc-chip-dot" aria-hidden="true"></span>
                <span>{f}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="arc-why-visual" data-reveal="right">
          <img
            src="/assets/manufacturing/industrialOEMS.webp"
            alt="Banco aluminium extrusion manufacturing — Vadodara"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       06B · FOR ARCHITECTS & FOR FABRICATORS — SPLIT
  ══════════════════════════════════════════════════════════════ -->
  <section class="section-dark section-pad" style="border-bottom:1px solid var(--color-navy-line)">
    <div class="container">
      <div class="arc-af-head" data-reveal="fade">
        <div class="eyebrow on-dark">Who we work with</div>
        <h2 class="arc-sh" style="color:var(--color-platinum);margin-top:12px">Architects, Fabricators & Developers</h2>
      </div>
      <div class="arc-af-grid">
        <!-- For Architects -->
        <div class="arc-af-col" data-reveal="left">
          <div class="arc-af-num" aria-hidden="true">01</div>
          <div class="arc-af-type">For Architects</div>
          <h3 class="arc-af-h3">Design freedom with aluminium precision.</h3>
