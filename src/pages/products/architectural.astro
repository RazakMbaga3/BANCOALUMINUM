// ── Featured system cards ─────────────────────────────────────────────────────
const featured = [
  {
    img:   '/assets/architectural/0fa274d34eaac9f8ed5881ccbca5660c.jpg',
    title: 'Sliding Window Systems',
    desc:  '8 series from 18–75 mm frame width for residential to large commercial spans.',
    bullets: [
      'Single & double glaze from 18 mm to 35×75 mm frame width',
      'Grill-track options · entry-level to premium residential',
      'EN 12210 wind resistance · EN 12208 watertightness tested',
    ],
  },
  {
    img:   '/assets/architectural/1c425a807b29256caece389fa7ed010f.jpg',
    title: 'Casement Window Systems',
    desc:  '40 mm and 50 mm systems for inward/outward opening and high-ventilation applications.',
    bullets: [
      '40 mm slim face · 2-in-1 frame and standard frame configurations',
