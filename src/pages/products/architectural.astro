---
import Layout from '../../layouts/Layout.astro';

// ── Sliding window series — source: Banco Architectural Series Catalogue ────
const sliding = [
  {
    num: '/ 01',
    name: '18mm Series',
    type: 'Sliding windows',
    width: '18 mm',
    glazing: 'Single glaze',
    tier: 'Entry-level residential',
    desc: 'Compact sliding window system for standard residential openings. The narrowest face width in the Banco sliding range — suited to applications where a minimal profile footprint and straightforward single-glaze specification are required.',
  },
  {
    num: '/ 02',
    name: '25mm Cardinal Series',
    type: 'Sliding windows',
    width: '25 mm',
    glazing: 'Single or double glaze',
    tier: 'Low-rise residential, up to 3 storeys',
    desc: 'Slimline sliding system with single or double glazing compatibility. 25mm visible face width delivers a contemporary, unobtrusive elevation for bungalows and low-rise residential construction. 2-track and 3-track frame configurations.',
  },
  {
    num: '/ 03',
    name: '27mm Euro Series',
    type: 'Sliding windows',
    width: '27 mm',
    glazing: 'Single or double glaze · grill track',
    tier: 'Residential and light commercial',
    desc: 'Structural sliding system for residential and commercial openings. Available in standard 2-track and grill-track configurations — the grill-track variant accepts integral aluminium grille profiles for traditional fenestration aesthetics.',
  },
  {
    num: '/ 04',
    name: '27mm Slim Series',
    type: 'Sliding windows',
    width: '27 mm slim',
    glazing: 'Single or double glaze',
    tier: 'Premium residential, bungalows and low-rise',
    desc: 'Slim-profile variant of the 27mm family, optimised for premium residential bungalows and low-floor developments where visual lightness is a design priority alongside weathering performance.',
  },
  {
    num: '/ 05',
    name: '29mm Cardinal Series',
    type: 'Sliding windows',
    width: '29 mm',
    glazing: 'Single or double glaze',
    tier: 'Residential and commercial',
    desc: 'High-performance flexible sliding system for modern construction. Standard and slim-interlock configurations. The rain-force interlock option provides enhanced weathertightness for exposed elevations and taller buildings.',
  },
  {
    num: '/ 06',
    name: '31mm Gulf Series',
    type: 'Sliding windows',
    width: '31 mm',
    glazing: 'Single or double glaze',
    tier: 'Residential and commercial',
    desc: 'Clean profile with a 31mm visible face width. Suited to residential and commercial buildings where a modern, unornamented elevation is specified. Known for structural durability and consistent weathering performance.',
  },
  {
    num: '/ 07',
    name: '35mm Gulf Series',
    type: 'Sliding windows',
    width: '35 mm',
    glazing: 'Single or double glaze',
    tier: 'Residential and commercial, larger openings',
    desc: 'Heavy-duty sliding system for larger residential and commercial window openings. Increased frame depth provides structural rigidity in wider spans, taller elevations, and higher wind load zones.',
  },
  {
    num: '/ 08',
    name: '35 × 75mm Euro Series',
    type: 'Sliding windows',
    width: '35 × 75 mm',
    glazing: 'Single or double glaze',
    tier: 'High-end residential and commercial, large-span',
    desc: 'Premium heavy-duty sliding system for high-end residential and commercial projects. 75mm frame depth provides maximum structural rigidity in wide-span and tall opening configurations — the highest-performance sliding system in the range.',
  },
];

// ── Casement and folding series ───────────────────────────────────────────────
const casement = [
  {
    num: '/ 09',
    name: '40mm Casement Series',
    type: 'Openable casement windows',
    width: '40 mm',
    glazing: 'Single or double glaze',
    tier: 'Residential and commercial, inward or outward opening',
    desc: 'Inward or outward-opening single-sash casement window for residential and commercial use. Available in 2-in-1 frame (combined frame and mullion), standard frame, and round-pipe mullion configurations. 40mm slim face width with high weather resistance performance.',
  },
  {
    num: '/ 10',
    name: '50mm Casement Series',
    type: 'Casement windows · doors · sliding-folding',
    width: '50 mm',
    glazing: 'Single or double glaze',
    tier: 'Residential and commercial — windows, entrance doors, bi-fold systems',
    desc: 'Versatile 50mm frame system spanning casement windows, hinged entrance doors, and sliding-folding bi-fold configurations. The widest face width in the Banco casement range — suited to larger openings, commercial entrances, and multi-leaf folding door applications.',
  },
];

// ── Performance categories — EN 14351-1 ──────────────────────────────────────
const performance = [
  { cat: 'Wind resistance', std: 'EN 12211 / EN 12210', note: 'Class 1–5 — rated values in data sheet' },
  { cat: 'Watertightness', std: 'EN 1027 / EN 12208', note: 'Class 1A–9A — rated values in data sheet' },
  { cat: 'Air permeability', std: 'EN 1026 / EN 12207', note: 'Class 1–4 — rated values in data sheet' },
  { cat: 'Sound insulation', std: 'EN ISO 10140',       note: 'Rw values — configuration dependent' },
  { cat: 'Impact resistance', std: 'EN 13049',           note: 'Soft and hard body impact — rated by series' },
];

// ── Surface finishes ──────────────────────────────────────────────────────────
const finishes = [
  { name: 'Powder coating',  desc: 'QUALICOAT-class durable coatings in any RAL or NCS colour. 60–80 μm standard film thickness. Interior and exterior grades.' },
  { name: 'Anodising',       desc: 'Class 20 anodising to EN 12373. Natural, champagne, bronze, and black options. Controlled bath process for colour consistency.' },
  { name: 'Brushed finish',  desc: 'Directional mechanical brushed surface for contemporary aesthetic. Available for interior and exterior applications.' },
  { name: 'Sand-blast',      desc: 'Uniform matte texture for architectural applications requiring diffused reflection and a refined industrial appearance.' },
  { name: 'Mill finish',     desc: 'As-extruded aluminium surface for downstream fabricators and specialist coating applicators. Supplied without additional treatment.' },
];

// ── Hero slideshow ────────────────────────────────────────────────────────────
const slides = [
  {
    img:      '/assets/architectural/0fa274d34eaac9f8ed5881ccbca5660c.jpg',
    alt:      'Modern residential aluminium sliding windows — Banco Aluminium',
    eyebrow:  '/ Architectural systems · Banco Aluminium',
    headline: 'Aluminium that <span class="highlight">opens</span> spaces.',
    sub:      'Sliding, casement and folding systems for contemporary architecture.',
    cta:      true,
  },
  {
    img:      '/assets/architectural/31fb5ee618906c778bc0ed433a7b5757.jpg',
    alt:      'Floor-to-ceiling glazed façade — Banco Aluminium fenestration',
    eyebrow:  '/ Modern fenestration',
    headline: 'Where light becomes <span class="highlight">architecture</span>.',
    sub:      'Ten fenestration series. Five finishes. One integrated source.',
    cta:      false,
  },
  {
    img:      '/assets/architectural/810f32deb5c2a2a7f3d0719cf87348fa.jpg',
    alt:      'Commercial aluminium curtain wall façade — Banco Aluminium',
    eyebrow:  '/ From bungalow to high-rise',
    headline: 'Precision profiles for every <span class="highlight">elevation</span>.',
    sub:      '18mm slim residential to 75mm heavy-duty commercial systems.',
    cta:      false,
  },
  {
    img:      '/assets/architectural/9908256f57e8df7b37302e330865c1b4.jpg',
    alt:      'Powder coated and anodised aluminium window finish — Banco Aluminium',
    eyebrow:  '/ Surface & finish',
    headline: 'Colour. Texture. <span class="highlight">Character.</span>',
    sub:      'Powder coated, anodised, brushed — any RAL or NCS colour.',
    cta:      false,
  },
  {
    img:      '/assets/architectural/f664f77f50d42d2087d86bdaced9f248.jpg',
    alt:      'EN 14351-1 tested aluminium fenestration — Banco Aluminium',
    eyebrow:  '/ EN 14351-1 · ISO certified',
    headline: 'Built to perform. <span class="highlight">Tested</span> to prove it.',
    sub:      'In-house extrusion. EN 14351-1 performance tested. Export-ready.',
    cta:      false,
  },
];

// ── Real project photos from public/assets/architectural ─────────────────────
const photos = [
  '/assets/architectural/0fa274d34eaac9f8ed5881ccbca5660c.jpg',
  '/assets/architectural/10763b613df21d191d0c3bd40ad9926a.jpg',
  '/assets/architectural/128b984100c3b740d5f9d382a67b3de3.jpg',
  '/assets/architectural/1c425a807b29256caece389fa7ed010f.jpg',
  '/assets/architectural/31fb5ee618906c778bc0ed433a7b5757.jpg',
  '/assets/architectural/41f468e4f12973012f865d065f5f3b44.jpg',
  '/assets/architectural/45f8373ce3619411f301b794325c9ca5.jpg',
  '/assets/architectural/5974d8840b94d09843822186b59c527e.jpg',
  '/assets/architectural/6de0a5d9e19749b6f1e136347b188ed6.jpg',
  '/assets/architectural/810f32deb5c2a2a7f3d0719cf87348fa.jpg',
  '/assets/architectural/89a06dd9b7f65108e3bc376404f17998.jpg',
  '/assets/architectural/95cdec405d6955cb06255832ff203365.jpg',
  '/assets/architectural/9a30d7b0cacc131a0e0771ea36141d5b.jpg',
  '/assets/architectural/9908256f57e8df7b37302e330865c1b4.jpg',
  '/assets/architectural/f664f77f50d42d2087d86bdaced9f248.jpg',
];
---

<Layout
  title="Architectural aluminium systems — windows, doors, façades — Banco Aluminium"
  description="10 aluminium fenestration series for modern construction — sliding windows 18–75mm, casement windows and doors, sliding-folding. Powder coated, anodised, brushed and mill finishes. EN 14351-1 tested. In-house extrusion, Vadodara."
>

  <!-- ── Hero slideshow ──────────────────────────────────────────────────── -->
  <section class="a-hero-wrap">

    <div class="a-slideshow" id="arch-slideshow">

      {slides.map((slide, i) => (
        <div class={`a-slide${i === 0 ? ' is-active' : ''}`} data-index={i}>
          <img
            src={slide.img}
            alt={slide.alt}
            class="a-slide-img"
            loading={i === 0 ? 'eager' : 'lazy'}
          />
          <div class="a-slide-overlay" />
          <div class="a-slide-content">
            <div class="a-slide-inner container">
              <div class="eyebrow on-dark">{slide.eyebrow}</div>
              <h1 class="a-slide-h1" set:html={slide.headline} />
              <p class="a-slide-sub">{slide.sub}</p>
              {slide.cta && (
                <div class="a-slide-actions">
                  <a href="/contact#quote" class="btn btn-primary-dark">Specify a system</a>
                  <a href="/downloads" class="btn btn-secondary-dark">Technical data sheets</a>
                </div>
              )}
            </div>
          </div>
        </div>
      ))}

      <!-- Slide indicators -->
      <div class="a-slide-nav" id="arch-nav">
        {slides.map((_, i) => (
          <button
            class={`a-dot${i === 0 ? ' is-active' : ''}`}
            data-target={String(i)}
            aria-label={`Slide ${i + 1}`}
          />
        ))}
      </div>

      <!-- Arrow controls -->
      <button class="a-arrow a-arrow-prev" id="arch-prev" aria-label="Previous slide">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
          <path d="M11 3L5 9L11 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button class="a-arrow a-arrow-next" id="arch-next" aria-label="Next slide">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
          <path d="M7 3L13 9L7 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

    </div>

    <!-- Stats strip — flush below slideshow -->
    <div class="a-stats">
      {[
        { n: '10',         l: 'Fenestration series — sliding and casement' },
        { n: '5',          l: 'Surface finishes — powder, anodise, brushed, blast, mill' },
        { n: 'EN 14351-1', l: 'Test standard — all series' },
        { n: '1967',       l: 'Established — Vadodara, Gujarat, India' },
      ].map(({ n, l }) => (
        <div class="a-stat">
          <div class="a-stat-num">{n}</div>
          <div class="a-stat-label">{l}</div>
        </div>
      ))}
    </div>

  </section>

  <!-- ── Photo gallery ─────────────────────────────────────────────────────── -->
  <section class="section-light a-gallery-section">
    <div class="container">
      <div class="eyebrow">/ 01 · Systems in practice</div>
      <h2 class="t-h2 a-h2-navy">
        Residential, commercial,<br>and high-rise applications.
      </h2>
      <div class="a-gallery">
        {photos.map((src, i) => (
          <div class="a-photo">
            <img
              src={src}
              alt={`Banco architectural aluminium system — application ${i + 1}`}
              loading={i < 4 ? 'eager' : 'lazy'}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Sliding window series ─────────────────────────────────────────────── -->
  <section class="section-alt section-pad">
    <div class="container">
      <div class="eyebrow">/ 02 · Sliding window systems</div>
      <div class="a-section-head">
        <h2 class="t-h2 a-h2-navy">
          Eight sliding series.<br>18mm to 35 × 75mm.
        </h2>
        <p class="t-lead a-body-text" style="max-width:52ch">
          The sliding range spans entry-level residential windows through to
          heavy-duty commercial systems for large-span openings in tall buildings.
          All series are available in 2-track and 3-track frame configurations
          unless otherwise noted.
        </p>
      </div>

      <div class="a-series-grid">
        {sliding.map((s) => (
          <div class="a-series-card">
            <div class="a-card-header">
              <span class="a-card-num">{s.num}</span>
              <span class="a-card-type">{s.type}</span>
            </div>
            <div class="a-card-width">{s.width}</div>
            <h3 class="a-card-name">{s.name}</h3>
            <div class="a-card-tier">{s.tier}</div>
            <p class="a-card-desc">{s.desc}</p>
            <div class="a-card-footer">
              <span class="pill">{s.glazing}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Casement & folding series ─────────────────────────────────────────── -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="eyebrow">/ 03 · Casement, door &amp; folding systems</div>
      <div class="a-section-head">
        <h2 class="t-h2 a-h2-navy">
          40mm and 50mm casement.<br>Windows, doors, bi-fold.
        </h2>
        <p class="t-lead a-body-text" style="max-width:52ch">
          The casement range covers single-sash openable windows, hinged entrance
          doors, and sliding-folding bi-fold configurations — all within the same
          50mm profile family.
        </p>
      </div>

      <div class="a-casement-grid">
        {casement.map((s) => (
          <div class="a-casement-card">
            <div class="a-card-header">
              <span class="a-card-num">{s.num}</span>
              <span class="a-card-type">{s.type}</span>
            </div>
            <div class="a-card-width">{s.width}</div>
            <h3 class="a-card-name">{s.name}</h3>
            <div class="a-card-tier">{s.tier}</div>
            <p class="a-card-desc">{s.desc}</p>
            <div class="a-card-footer">
              <span class="pill">{s.glazing}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Performance standards ─────────────────────────────────────────────── -->
  <section class="section-dark section-pad">
    <div class="container">
      <div class="eyebrow on-dark">/ 04 · Performance standards</div>
      <div class="a-section-head">
        <h2 class="t-h2" style="color:var(--color-platinum)">
          Tested to EN 14351-1.<br>Rated values on request.
        </h2>
        <p class="t-lead" style="color:var(--color-silver);max-width:52ch">
          All Banco architectural series are manufactured and tested in accordance
          with EN 14351-1:2006+A2:2016 (Windows and doors — performance characteristics
          and classification). Rated values per series are available in the
          product technical data sheets — contact the technical team.
        </p>
      </div>

      <div class="a-perf-grid">
        {performance.map((p, i) => (
          <div class="a-perf-cell">
            <div class="a-perf-num">{String(i + 1).padStart(2, '0')}</div>
            <div class="a-perf-cat">{p.cat}</div>
            <div class="a-perf-std">{p.std}</div>
            <div class="a-perf-note">{p.note}</div>
          </div>
        ))}
      </div>

      <div class="a-perf-note-strip">
        <span class="a-perf-note-label">System specification support:</span>
        <span class="a-perf-note-text">
          Banco's technical team provides system selection guidance, performance data sheets,
          and die development support for custom profile specifications.
          Export documentation for CE marking available on all orders.
        </span>
        <a href="/contact#technical" class="btn btn-secondary-dark a-perf-cta">Request data sheet</a>
      </div>
    </div>
  </section>

  <!-- ── Surface finishes ──────────────────────────────────────────────────── -->
  <section class="section-alt section-pad">
    <div class="container">
      <div class="eyebrow">/ 05 · Surface finishing</div>
      <div class="a-section-head">
        <h2 class="t-h2 a-h2-navy">Five finishes. Full RAL and NCS range.</h2>
        <p class="t-lead a-body-text" style="max-width:52ch">
          All surface finishing is carried out in-house, ensuring colour
          consistency and quality control from extrusion to finished profile.
          Custom RAL and NCS colour matching is available across powder coating
          and anodising processes.
        </p>
      </div>
      <div class="a-finish-grid">
        {finishes.map((f, i) => (
          <div class="a-finish-cell">
            <div class="a-finish-num">{String(i + 1).padStart(2, '0')}</div>
            <div class="a-finish-name">{f.name}</div>
            <p class="a-finish-desc">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── In-house capability ───────────────────────────────────────────────── -->
  <section class="section-dark section-pad">
    <div class="container">
      <div class="a-cap-grid">
        <div>
          <div class="eyebrow on-dark">/ 06 · In-house platform</div>
          <h2 class="t-h2" style="color:var(--color-platinum);margin-top:20px">
            From alloy to finished<br>profile, under one roof.
          </h2>
          <p class="t-body" style="color:var(--color-silver);margin-top:20px;max-width:44ch;line-height:1.65">
            Every architectural profile starts in Banco's in-house foundry with
            controlled alloy chemistry for anodising quality — typically 6063 or
            6060. Custom dies are designed with Q-Form simulation and precision
            CNC machined. Profiles are extruded, heat-treated, and surface-finished
            without leaving the facility.
          </p>
          <div style="display:flex;gap:16px;flex-wrap:wrap;margin-top:36px">
            <a href="/contact#quote" class="btn btn-primary-dark">Specify a system</a>
            <a href="/capabilities" class="btn btn-secondary-dark">All capabilities</a>
          </div>
        </div>
        <div class="a-cap-list">
          {[
            ['In-house billet casting',       'Alloys 6063, 6060, 6005 — controlled Mg/Si ratio for architectural surface quality.'],
            ['Precision die design',           'Q-Form flow simulation, full 3D assembly model, 5-axis CNC die machining.'],
            ['Five direct-drive presses',      '1,100–3,300 MT. Profile weight 0.29–35 kg/m. 35,000 MT/yr extrusion capacity.'],
            ['Anodising and powder coating',   'Class 20 anodising (EN 12373). QUALICOAT powder coating. Full RAL/NCS colour range.'],
            ['Quality control and testing',    'Dimensional inspection, mechanical property verification, ASCONA optical measurement systems.'],
          ].map(([cap, desc]) => (
            <div class="a-cap-row">
              <div class="a-cap-label">{cap}</div>
              <div class="a-cap-desc">{desc}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── Certifications ────────────────────────────────────────────────────── -->
  <section class="section-light" style="padding:40px 0;border-bottom:1px solid var(--color-stone-200)">
    <div class="container">
      <div class="a-cert-row">
        <div class="a-cert-label">Certified to:</div>
        <div class="a-cert-chips">
          {['ISO 9001:2015', 'ISO 14001:2015', 'ISO 45001:2018', 'IATF 16949:2016', 'CE (EN 15088)', 'IS 733 · IS 1285'].map(c => (
            <span class="pill">{c}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────────────────────── -->
  <section class="section-dark" style="padding:80px 0;border-top:2px solid var(--color-green)">
    <div class="container">
      <div class="a-cta-grid">
        <div>
          <div class="eyebrow on-dark">System specification</div>
          <h2 class="t-h2" style="color:var(--color-platinum);margin-top:16px">
            Series selection, technical<br>data, and sample profiles.
          </h2>
          <p class="t-body" style="color:var(--color-silver);margin-top:16px;max-width:52ch;line-height:1.65">
            Banco's technical team supports architects, fabricators, and developers
            with series selection, performance data, custom profile development,
            and export documentation for European and export markets.
          </p>
        </div>
        <div class="a-cta-actions">
          <a href="/contact#quote" class="btn btn-primary-dark">Specify a system</a>
          <a href="/downloads" class="btn btn-secondary-dark">Technical data sheets</a>
          <a href="/contact#technical" class="btn btn-secondary-dark">Talk to technical</a>
        </div>
      </div>
    </div>
  </section>

<script>
  const ss     = document.getElementById('arch-slideshow');
  const slides = ss?.querySelectorAll('.a-slide');
  const dots   = document.querySelectorAll('#arch-nav .a-dot');
  const prev   = document.getElementById('arch-prev');
  const next   = document.getElementById('arch-next');

  if (slides && slides.length) {
    let current = 0;
    let timer;

    function goTo(n) {
      slides[current].classList.remove('is-active');
      dots[current]?.classList.remove('is-active');
      current = ((n % slides.length) + slides.length) % slides.length;
      slides[current].classList.add('is-active');
      dots[current]?.classList.add('is-active');
      resetTimer();
    }

    function resetTimer() {
      clearInterval(timer);
      timer = setInterval(() => goTo(current + 1), 6000);
    }

    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
    prev?.addEventListener('click', () => goTo(current - 1));
    next?.addEventListener('click', () => goTo(current + 1));

    ss.addEventListener('mouseenter', () => clearInterval(timer));
    ss.addEventListener('mouseleave', resetTimer);

    resetTimer();
  }
</script>

</Layout>

<style>
  /* ── Hero slideshow ─────────────────────────────────────────────────────── */
  .a-hero-wrap {
    position: relative;
  }

  .a-slideshow {
    position: relative;
    height: 100vh;
    min-height: 620px;
    overflow: hidden;
    background: var(--color-navy-deep);
  }

  /* Individual slides */
  .a-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.2s ease;
    z-index: 0;
  }
  .a-slide.is-active {
    opacity: 1;
    z-index: 1;
  }
  .a-slide.is-active .a-slide-img {
    animation: a-kb 9s ease forwards;
  }
  @keyframes a-kb {
    from { transform: scale(1.0); }
    to   { transform: scale(1.07); }
  }

  .a-slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    will-change: transform;
  }

  /* Gradient overlay — dark at bottom-left for text, light at top-right */
  .a-slide-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top,
        rgba(8, 27, 48, 0.96) 0%,
        rgba(8, 27, 48, 0.68) 28%,
        rgba(8, 27, 48, 0.22) 58%,
        transparent 100%),
      linear-gradient(to right,
        rgba(8, 27, 48, 0.52) 0%,
        transparent 55%);
  }

  /* Text content — anchored to bottom-left */
  .a-slide-content {
    position: absolute;
    inset: 0;
