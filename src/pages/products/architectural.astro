---
import Layout from '../../layouts/Layout.astro';
import Pic from '../../components/Pic.astro';

// ── Performance categories ────────────────────────────────────────────────────
const performance = [
  { cat: 'Wind resistance',  std: 'EN 12211 / EN 12210' },
  { cat: 'Watertightness',   std: 'EN 1027 / EN 12208' },
  { cat: 'Air permeability', std: 'EN 1026 / EN 12207' },
  { cat: 'Sound insulation', std: 'EN ISO 10140' },
  { cat: 'Impact resistance',std: 'EN 13049' },
];

// ── Surface finishes ──────────────────────────────────────────────────────────
const finishes = [
  { name: 'Powder coating', desc: 'QUALICOAT-class durable coatings in any RAL or NCS colour. 60–80 μm film thickness. Interior and exterior grades.' },
  { name: 'Anodising',      desc: 'Class 20 anodising to EN 12373. Natural, champagne, bronze, and black. Controlled bath for colour consistency.' },
  { name: 'Brushed finish', desc: 'Directional mechanical brushed surface for contemporary aesthetic. Available for interior and exterior applications.' },
  { name: 'Sand-blast',     desc: 'Uniform matte texture for architectural applications requiring diffused reflection and industrial appearance.' },
  { name: 'Mill finish',    desc: 'As-extruded aluminium surface for downstream fabricators and specialist coating applicators.' },
];

// ── Hero stats ribbon ─────────────────────────────────────────────────────────
const heroStats = [
  { value: '10', unit: '', label: 'Fenestration series' },
  { value: '5',  unit: '', label: 'Surface finishes' },
  { value: '35K', unit: 'MT', label: 'Annual extrusion capacity' },
  { value: 'EN 14351-1', unit: '', label: 'Tested & certified' },
];

// ── Comprehensive systems — clickable cards linking to detail subpages ────────
const systems = [
  {
    label: 'Window Systems',
    items: ['Sliding Window Systems', 'Casement Window Systems'],
    href: '/products/architectural/window-systems',
    img: '/assets/architectural-systems/aluminium-casement-window.webp',
  },
  {
    label: 'Door Systems',
    items: ['Sliding Doors', 'Folding Doors', 'Partition Systems', 'Door Frames'],
    href: '/products/architectural/door-systems',
    img: '/assets/architectural-systems/aluminium-folding-doors-poolside.png',
  },
  {
    label: 'Façade Systems',
    items: ['Curtain Wall Systems', 'Glazing Solutions', 'Louvers'],
    href: '/products/architectural/facade-systems',
    img: '/assets/architectural/6de0a5d9e19749b6f1e136347b188ed6.jpg',
  },
];

// ── Environments ──────────────────────────────────────────────────────────────
const environments = [
  { label: 'Residential Buildings',   img: '/assets/architectural/applications/residential-buildings.jpg' },
  { label: 'Villas & Luxury Homes',   img: '/assets/architectural/applications/villas-luxury-homes.jpeg' },
  { label: 'Commercial Developments', img: '/assets/architectural/applications/commercial-developments.jpg' },
  { label: 'Office Environments',     img: '/assets/architectural/applications/office-environments.jpg' },
  { label: 'Hospitality Projects',    img: '/assets/architectural/applications/hospitality-projects.jpg' },
  { label: 'Institutional Buildings', img: '/assets/architectural/applications/institutional-buildings.jpg' },
  { label: 'Urban Developments',      img: '/assets/architectural/applications/urban-developments.jpg' },
  { label: 'Mixed-Use Projects',      img: '/assets/architectural/applications/mixed-use-projects.jpg' },
];

// ── Why Banco / Architects / Fabricators — condensed 3-col partner grid ───────
const partnerCols = [
  {
    type: 'Why Banco',
    h3: 'Precision that scales with your project.',
    items: [
      'Extensive architectural product portfolio',
      'Contemporary design compatibility',
      'Multiple system configurations',
      'Reliable, repeatable manufacturing',
    ],
  },
  {
    type: 'For Architects',
    h3: 'Design freedom, precision engineered.',
    items: [
      'Wide system configurations for any façade',
      'Custom sightlines & profile dimensions',
      'Full RAL/NCS palette & anodising classes',
      'EN 14351-1 test data · BIM library',
    ],
    cta: ['Request system data', '/contact?src=architectural#quote'],
  },
  {
    type: 'For Fabricators',
    h3: 'Consistent extrusion, reliable supply.',
    items: [
      'ASCONA optical inspection, every batch',
      'New profiles in-house in 4–6 weeks',
      'Anodising Class 20 · QUALICOAT powder',
      'Export packing · CBAM & CE documentation',
    ],
    cta: ['Submit a requirement', '/contact?src=architectural#quote'],
  },
];

// ── Structured data: the five architectural system families ──────────────────
const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Banco Aluminium architectural systems',
  itemListElement: systems.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.label,
    url: `https://bancoaluminium.com${s.href}/`,
  })),
};

// ── Gallery photos ────────────────────────────────────────────────────────────
const galleryPhotos = [
  '/assets/architectural/0fa274d34eaac9f8ed5881ccbca5660c.jpg',
  '/assets/architectural/10763b613df21d191d0c3bd40ad9926a.jpg',
  '/assets/architectural/128b984100c3b740d5f9d382a67b3de3.jpg',
  '/assets/architectural/1c425a807b29256caece389fa7ed010f.jpg',
  '/assets/architectural/31fb5ee618906c778bc0ed433a7b5757.jpg',
  '/assets/architectural/41f468e4f12973012f865d065f5f3b44.jpg',
  '/assets/architectural/5974d8840b94d09843822186b59c527e.jpg',
];
---

<Layout
  title="Architectural aluminium systems: Banco Aluminium"
  description="Precision-engineered aluminium window, door, façade and profile systems for residential, commercial and institutional projects. EN 14351-1 tested."
  image="/assets/images/architectureheropage/aluminum-architectural-systems-solutions-that-combine-aesthetics-and-functionality.webp"
  heroImage="/architectural-hero-poster.jpg"
  transparentNav={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListLd)} />

  <!-- ══════════════════════════════════════════════════════════
       01 · HERO — FULL-BLEED SINGLE IMAGE
  ══════════════════════════════════════════════════════════════ -->
  <section class="ah-wrap" aria-label="Architectural systems hero">

    <!-- Background video -->
    <div class="ah-bg" aria-hidden="true">
      <video
        class="ah-bg-video"
        src="/architectural-hero-video.mp4"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster="/architectural-hero-poster.jpg"
      ></video>
    </div>

    <!-- Layered overlays: base scrim + directional gradient -->
    <div class="ah-scrim"  aria-hidden="true"></div>
    <div class="ah-grad"   aria-hidden="true"></div>
    <div class="ah-bottom" aria-hidden="true"></div>

    <!-- Content — bottom-left anchored, full two-col grid -->
    <div class="ah-content">
      <div class="container ah-inner">

        <!-- Left: eyebrow + headline + rule + desc + CTAs -->
        <div class="ah-copy">

          <div class="eyebrow on-dark ah-eyebrow">
            <span>/ Architectural Systems</span>
            <span class="ah-eyebrow-sep" aria-hidden="true"></span>
            <span>Banco Aluminium</span>
          </div>

          <h1 class="ah-h1">
            <span class="ah-h1-line1">Aluminium systems</span>
            <span class="ah-rule" aria-hidden="true"></span>
            <span class="ah-h1-line2">for modern<br/>architecture.</span>
          </h1>

          <p class="ah-desc">
            Precision-engineered aluminium window, door, façade and profile
            systems for contemporary residential, commercial and institutional
            projects.
          </p>

          <!-- Action buttons -->
          <div class="ah-actions">
          </div>

        </div>

        <!-- Right: scrolling thumbnail strip (decorative) -->
        <div class="ah-thumbs" aria-hidden="true">
          {[
            '/assets/architectural/0fa274d34eaac9f8ed5881ccbca5660c.jpg',
            '/assets/architectural/41f468e4f12973012f865d065f5f3b44.jpg',
            '/assets/architectural/810f32deb5c2a2a7f3d0719cf87348fa.jpg',
            '/assets/images/architectureheropage/Large-apartment-louvres.jpg',
          ].map((src, i) => (
            <div class="ah-thumb" style={`animation-delay:${i * 0.15}s`}>
              <Pic src={src} alt="" loading="lazy" sizes="(max-width: 1024px) 100vw, 50vw" maxW={1200} />
            </div>
          ))}
        </div>

      </div>
    </div>

    <!-- Bottom stats ribbon -->
    <div class="ah-stats-bar">
      <div class="container ah-stats-inner">
        {heroStats.map((s) => (
          <div class="ah-stat">
            <span class="ah-stat-val">{s.value}<em>{s.unit}</em></span>
            <span class="ah-stat-lbl">{s.label}</span>
          </div>
        ))}
        <a href="/contact?src=architectural#quote" class="ah-stat-cta">
          Get a quote
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </a>
      </div>
    </div>

  </section>


  <!-- ══════════════════════════════════════════════════════════
       02 · COMPREHENSIVE SYSTEMS — 5 CLICKABLE IMAGE CARDS
  ══════════════════════════════════════════════════════════════ -->
  <section class="section-white section-pad" style="border-bottom:1px solid var(--color-stone-200)">
    <div class="container">
      <div class="arc-section-head" data-reveal="fade">
        <div class="eyebrow">Full range</div>
        <h2 class="arc-sh" style="color:var(--color-navy);margin-top:12px">Comprehensive Architectural Systems</h2>
        <p class="t-body arc-sub" style="color:var(--color-stone-700)">
          Explore our aluminium systems range for windows, doors, and façades.
          Select a category for complete technical details.
        </p>
      </div>

      <div class="arc-sys-grid" data-reveal>
        {systems.map((sys) => (
          <a href={sys.href} class="arc-sys-card">
            <div class="arc-sys-card-bg" aria-hidden="true">
              <Pic src={sys.img} alt="" loading="lazy" sizes="(max-width: 1024px) 100vw, 50vw" maxW={1200} />
            </div>
            <div class="arc-sys-card-scrim" aria-hidden="true"></div>
            <div class="arc-sys-card-body">
              <h3 class="arc-sys-label">{sys.label}</h3>
              <ul class="arc-sys-list">
                {sys.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <span class="arc-sys-cta">
                View details
                <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>

      <div style="display:flex;justify-content:center;margin-top:36px" data-reveal="fade">
        <a href="/downloads" class="btn btn-primary">Download Catalogue</a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       03 · ENVIRONMENTS — 8-COL THUMBNAIL GRID
  ══════════════════════════════════════════════════════════════ -->
  <section class="section-alt section-pad" style="border-bottom:1px solid var(--color-stone-200)">
    <div class="container">
      <div class="arc-section-head" data-reveal="fade">
        <div class="eyebrow">Applications</div>
        <h2 class="arc-sh" style="color:var(--color-navy);margin-top:12px">Diverse Architectural Environments</h2>
        <p class="t-body arc-sub" style="color:var(--color-stone-700)">
          Supporting a wide range of building typologies, from residential to large-scale commercial.
        </p>
      </div>

      <div class="arc-env-grid" data-reveal>
        {environments.map((env) => (
          <div class="arc-env-item">
            <div class="arc-env-img">
              <Pic src={env.img} alt={env.label} loading="lazy" sizes="(max-width: 1024px) 100vw, 50vw" maxW={1200} />
            </div>
            <span class="arc-env-label">{env.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       04 · INTRO — 2-COL SPLIT
  ══════════════════════════════════════════════════════════════ -->
  <section class="section-white section-pad" style="border-bottom:1px solid var(--color-stone-200)">
    <div class="container">
      <div class="arc-intro-grid">
        <div class="arc-intro-body" data-reveal="left">
          <div class="eyebrow">Banco Architectural Systems</div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            Precision extrusion.<br/><em class="accent">Architectural finish.</em>
          </h2>
          <p class="t-lead" style="color:var(--color-stone-700);margin-top:24px">
            Every system starts on a Banco extrusion press, with in-house die design, 6063/6060 alloys
            formulated for surface quality, and Class 20 anodising all under one roof in Vadodara.
          </p>
          <p class="t-body" style="color:var(--color-stone-700);margin-top:16px">
            Designed to support residential, commercial and institutional developments,
            our systems combine functionality, durability and clean aesthetics to meet
            the demands of contemporary building design.
          </p>
          <p class="t-body" style="color:var(--color-stone-700);margin-top:16px">
            Backed by decades of aluminium extrusion expertise, we provide architectural
            solutions that support architects, fabricators, builders and developers
            across diverse project requirements.
          </p>
          <div style="display:flex;gap:16px;flex-wrap:wrap;margin-top:36px">
            <a href="/contact?src=architectural#quote" class="btn btn-primary">Send enquiry</a>
            <a href="/downloads" class="btn btn-secondary">Download catalogue</a>
          </div>
        </div>
        <div class="arc-intro-visual" data-reveal="right">
          <Pic
            src="/assets/images/architectureheropage/aluminum-architectural-systems-solutions-that-combine-aesthetics-and-functionality.webp"
            alt="Banco Aluminium architectural profile cross-section"
            loading="lazy" sizes="(max-width: 1024px) 100vw, 60vw" />
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       06 · WHY BANCO + WHO WE WORK WITH — CONDENSED 3-COL, ONE-SCREEN FIT
  ══════════════════════════════════════════════════════════════ -->
  <section class="section-dark arc-waf-sec">
    <div class="container">
      <div class="arc-waf-head" data-reveal="fade">
        <h2 class="arc-sh" style="color:var(--color-platinum);margin-top:12px">Engineered for Architects, Fabricators &amp; Developers</h2>
      </div>

      <div class="arc-waf-grid" data-reveal>
        {partnerCols.map((col, i) => (
          <>
            {i > 0 && <div class="arc-waf-divider" aria-hidden="true"></div>}
            <div class="arc-waf-col">
              <div class="arc-waf-type">{col.type}</div>
              <h3 class="arc-waf-h3">{col.h3}</h3>
              <ul class="arc-waf-list">
                {col.items.map((item) => <li>{item}</li>)}
              </ul>
              {col.cta && (
                <a href={col.cta[1]} class="btn btn-secondary-dark arc-waf-cta">{col.cta[0]}</a>
              )}
            </div>
          </>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       07 · CONTEMPORARY ARCHITECTURE — 2-COL TEXT + IMAGE
  ══════════════════════════════════════════════════════════════ -->
  <section class="section-light section-pad" style="border-bottom:1px solid var(--color-stone-200)">
    <div class="container">
      <div class="arc-contemp-grid">
        <div data-reveal="left">
          <div class="eyebrow">Design philosophy</div>
          <h2 class="arc-sh" style="color:var(--color-navy);margin-top:16px">Designed for Contemporary <em class="accent">Architecture</em></h2>
          <p class="t-body" style="color:var(--color-stone-700);margin-top:22px">
            Modern architecture demands solutions that balance performance, functionality
            and visual simplicity.
          </p>
          <p class="t-body" style="color:var(--color-stone-700);margin-top:14px">
            Banco Architectural Systems focuses on developing aluminium profile solutions
            that support evolving architectural design while maintaining durability,
            adaptability and long-term system usability.
          </p>
          <p class="t-body" style="color:var(--color-stone-700);margin-top:14px">
            From residential developments to commercial environments, our systems are
            designed to contribute to spaces that are both functional and visually refined.
          </p>
          <div style="display:flex;gap:16px;flex-wrap:wrap;margin-top:36px">
            <a href="/contact?src=architectural#quote" class="btn btn-primary">Start your project</a>
            <a href="/about/quality" class="btn btn-secondary">Quality & certifications</a>
          </div>
        </div>
        <div class="arc-contemp-visual" data-reveal="right">
          <Pic
            src="/assets/images/architectureheropage/contemporary-modern.jpg"
            alt="Contemporary aluminium architectural building by Banco"
            loading="lazy" sizes="(max-width: 1024px) 100vw, 60vw" />
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       08 · PHOTO GALLERY — EDGE TO EDGE
  ══════════════════════════════════════════════════════════════ -->
  <div class="a-gallery-bleed">
    {galleryPhotos.map((src, i) => (
      <div class="a-photo">
        <Pic src={src} alt={`Banco architectural project ${i + 1}`} loading="lazy" sizes="(max-width: 640px) 100vw, 33vw" maxW={1200} />
      </div>
    ))}
  </div>

  <!-- ══════════════════════════════════════════════════════════
       11 · PERFORMANCE BAND
  ══════════════════════════════════════════════════════════════ -->
  <section class="a-perf-band section-dark">
    <div class="container">
      <div class="a-perf-head">
        <div>
          <div class="eyebrow on-dark">Standards & testing</div>
          <h2 class="t-h2" style="color:var(--color-platinum);margin-top:10px">Tested to EN 14351-1.</h2>
        </div>
        <a href="/contact?src=architectural#quote" class="btn btn-secondary-dark">Request data sheets</a>
      </div>
      <div class="a-perf-cols">
        {performance.map((p) => (
          <div class="a-perf-col">
            <div class="a-perf-cat">{p.cat}</div>
            <div class="a-perf-std">{p.std}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       12 · SURFACE FINISHES
  ══════════════════════════════════════════════════════════════ -->
  <section id="surface-finishing" class="a-finishes section-light">
    <div class="container">
      <div class="eyebrow">Surface finishing</div>
      <h2 class="t-h2 a-h2-navy" style="margin-top:10px">Five finishes. In-house.</h2>
    </div>
    <div class="a-finish-strips">
      {finishes.map((f, i) => (
        <div class="a-finish-strip">
          <span class="a-finish-strip-num">{String(i + 1).padStart(2, '0')}</span>
          <span class="a-finish-strip-name">{f.name}</span>
          <span class="a-finish-strip-desc">{f.desc}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       13 · MANUFACTURING PLATFORM — 2-COL
  ══════════════════════════════════════════════════════════════ -->
  <section class="a-split">
    <div class="a-split-visual">
      <Pic src="/assets/images/architectureheropage/Aluminum-Structure.jpg" alt="Banco in-house aluminium extrusion in Vadodara" loading="lazy" sizes="(max-width: 1024px) 100vw, 60vw" />
    </div>
    <div class="a-split-body" style="background:var(--color-navy)">
      <div class="eyebrow on-dark">Manufacturing platform</div>
      <h2 class="a-split-h2" style="color:var(--color-platinum)">One roof.<br/>Full chain.</h2>
      <div class="a-cap-list">
        {[
          ['Billet casting',  '6063 · 6060 · 6005. Controlled Mg/Si for surface quality.'],
          ['Die design',      'Q-Form simulation · 5-axis CNC machined.'],
          ['Five presses',    '1100–3300T · 35,000 MT/yr capacity.'],
          ['Finishing',       'Class 20 anodising · QUALICOAT powder · Full RAL/NCS.'],
          ['Quality control', 'ASCONA optical measurement · full dimensional inspection.'],
        ].map(([cap, desc]) => (
          <div class="a-cap-row">
            <div class="a-cap-label">{cap}</div>
            <div class="a-cap-desc">{desc}</div>
          </div>
        ))}
      </div>
      <div style="display:flex;gap:16px;flex-wrap:wrap;margin-top:28px">
        <a href="/contact?src=architectural#quote" class="btn btn-primary-dark">Specify a system</a>
        <a href="/capabilities/extrusion" class="btn btn-secondary-dark">All capabilities</a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       14 · CTA STRIP
  ══════════════════════════════════════════════════════════════ -->
  <section class="section-deep" style="padding:clamp(48px,7vh,80px) 0;border-top:2px solid var(--color-green)">
    <div class="container">
      <div class="arc-cta-inner">
        <div>
          <h2 class="t-h2" style="color:var(--color-platinum)">
            Ready to build with Banco<br/><em class="accent">Architectural Systems?</em>
          </h2>
          <p class="t-body" style="color:var(--color-stone-400);margin-top:14px;max-width:52ch">
            Explore our architectural systems, download product information or connect
            with our team to discuss your next project.
          </p>
        </div>
        <div class="arc-cta-btns">
          <a href="/downloads" class="btn btn-primary-dark">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M8 2v9M4 8l4 4 4-4M2 14h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Download catalogue
          </a>
          <a href="/contact?src=architectural#quote" class="btn btn-secondary-dark">
            Send enquiry
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>


<style>
  /* ══ TIGHTER SECTION RHYTHM — overrides global section-pad ═ */
  .section-pad {
    padding: clamp(40px, 5vw, 72px) 0;
  }

  /* ══ WHY BANCO / ARCHITECTS / FABRICATORS — CONDENSED 3-COL ═ */
  .arc-waf-sec { padding: clamp(40px, 5.5vh, 64px) 0; }
  .arc-waf-head { margin-bottom: clamp(28px, 3.5vw, 40px); }
  .arc-waf-grid {
    display: grid;
    grid-template-columns: 1fr 1px 1fr 1px 1fr;
    gap: 0 40px;
    align-items: start;
  }
  .arc-waf-divider {
    background: var(--color-navy-line);
    align-self: stretch;
  }
  .arc-waf-col {
    padding: 0;
  }
  .arc-waf-type {
    font-family: var(--font-sans);
    font-size: clamp(15px, 1.4vw, 18px);
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-green);
    margin-bottom: 12px;
  }
  .arc-waf-h3 {
    font-family: var(--font-sans);
