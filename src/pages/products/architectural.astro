// ── Environments ──────────────────────────────────────────────────────────────
const environments = [
  { label: 'Residential Buildings',   img: '/assets/architectural/89a06dd9b7f65108e3bc376404f17998.jpg' },
  { label: 'Villas & Luxury Homes',   img: '/assets/architectural/9a30d7b0cacc131a0e0771ea36141d5b.jpg' },
  { label: 'Commercial Developments', img: '/assets/architectural/41f468e4f12973012f865d065f5f3b44.jpg' },
  { label: 'Office Environments',     img: '/assets/architectural/810f32deb5c2a2a7f3d0719cf87348fa.jpg' },
  { label: 'Hospitality Projects',    img: '/assets/architectural/45f8373ce3619411f301b794325c9ca5.jpg' },
  { label: 'Institutional Buildings', img: '/assets/architectural/95cdec405d6955cb06255832ff203365.jpg' },
  { label: 'Urban Developments',      img: '/assets/architectural/9908256f57e8df7b37302e330865c1b4.jpg' },
