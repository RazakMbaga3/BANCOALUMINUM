  /* ══ HERO — FULL-BLEED SINGLE IMAGE ════════════════════════ */
  .ah-wrap {
    position: relative;
    height: 100vh;
    min-height: 600px;
    overflow: hidden;
    background: var(--color-navy-deep);
    display: flex;
    flex-direction: column;
