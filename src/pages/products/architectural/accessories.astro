---
import Layout from '../../../layouts/Layout.astro';
import Pic from '../../../components/Pic.astro';

const accessoryTypes = [
  { name: 'Hardware Systems',       desc: 'Handles, hinges, rollers, locks and multi-point locking systems matched to Banco window and door series, sourced and stocked for consistent supply.', img: '/assets/architectural-systems/hardware-accessories-flatlay.webp' },
  { name: 'Surface Finish Options', desc: 'Powder coating, anodising, brushed, sand-blast and mill finish: five in-house surface treatments applied to any system in the range.', img: '/assets/architectural-systems/extruded-profile-finishes.jpg' },
];
---

<Layout
  title="Hardware & surface finish accessories: Banco Aluminium"
  description="Hardware systems and surface finish options for Banco architectural window, door and façade systems. Powder coating, anodising, and more, applied in-house."
>
  <section class="ac-hero">
    <Pic src="/assets/architectural-systems/aluminium-hardware-handle.jpg" alt="Banco aluminium hardware and finish accessories" class="ac-hero-img" loading="eager" sizes="100vw" />
    <div class="ac-hero-scrim" aria-hidden="true"></div>
    <div class="container ac-hero-body">
      <div class="eyebrow on-dark">Architectural systems / Accessories</div>
      <h1 class="ac-h1">Hardware & surface<br>finish options.</h1>
      <p class="ac-lead">Matched hardware and five in-house surface finishes, available across every window, door and façade system in the Banco range.</p>
    </div>
  </section>

  <section class="section-light section-pad">
    <div class="container">
      <div class="eyebrow">Accessory categories</div>
      <h2 class="t-h2" style="color:var(--color-navy);margin-top:12px;margin-bottom:32px">Two categories.<br>Every system.</h2>
      <div class="ac-grid">
        {accessoryTypes.map((a) => (
          <div class="ac-card">
            <div class="ac-card-bg" aria-hidden="true">
              <Pic src={a.img} alt="" loading="lazy" sizes="(max-width: 640px) 100vw, 50vw" maxW={1200} />
            </div>
            <h3 class="ac-card-title">{a.name}</h3>
            <p class="ac-card-desc">{a.desc}</p>
          </div>
        ))}
      </div>
      <div style="margin-top:36px;display:flex;gap:16px;flex-wrap:wrap">
        <a href="/products/architectural#surface-finishing" class="btn btn-primary">View surface finishes</a>
        <a href="/contact?src=architectural#quote" class="btn btn-secondary">Request hardware spec</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .ac-hero { position: relative; padding: 168px 0 72px; overflow: hidden; }
  :global(.ac-hero-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ac-hero-scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(8,27,48,0.80) 0%, rgba(8,27,48,0.92) 100%); }
  .ac-hero-body { position: relative; z-index: 1; }
  .ac-h1 { font-family: var(--font-sans); font-size: clamp(32px, 4.4vw, 56px); font-weight: 800; letter-spacing: -0.04em; line-height: 1.0; color: var(--color-platinum); margin-top: 18px; }
  .ac-lead { font-size: 15px; line-height: 1.65; color: var(--color-silver); margin-top: 20px; max-width: 58ch; }

  .ac-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--color-stone-200); border: 1px solid var(--color-stone-200); }
  .ac-card { background: #fff; padding: 26px 24px; border-top: 2px solid var(--color-green); overflow: hidden; }
  .ac-card-bg { aspect-ratio: 16/9; margin: -26px -24px 20px; overflow: hidden; background: var(--color-stone-200); }
  .ac-card-bg :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.55s ease; }
  .ac-card:hover .ac-card-bg :global(img) { transform: scale(1.05); }
  .ac-card-title { font-family: var(--font-sans); font-size: 16px; font-weight: 700; color: var(--color-navy); }
  .ac-card-desc { font-size: 13px; line-height: 1.6; color: var(--color-stone-700); margin-top: 12px; }

  @media (max-width: 640px) { .ac-grid { grid-template-columns: 1fr; } }
</style>
