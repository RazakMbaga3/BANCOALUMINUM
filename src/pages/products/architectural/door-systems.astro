---
import Layout from '../../../layouts/Layout.astro';
import Pic from '../../../components/Pic.astro';

const doorTypes = [
  { name: 'Sliding Doors',    desc: 'Two, three and four-panel sliding configurations. Suited to large residential and commercial openings requiring smooth, low-effort operation.', img: '/assets/architectural-systems/sliding-doors-lobby.jpg' },
  { name: 'Folding Doors',    desc: 'Multi-leaf bi-fold configurations stacking to one or both sides. Maximises clear opening width for indoor–outdoor living and hospitality frontages.', img: '/assets/architectural-systems/folding-door-studio.png' },
  { name: 'Partition Systems',desc: 'Fixed and operable internal aluminium partitions for offices and institutional interiors, with matching glazing and finish options.', img: '/assets/architectural-systems/aluminium-partition-system.jpg' },
  { name: 'Door Frames',      desc: 'Hinged single and double-leaf entrance door frames, sized to match façade and window sightlines for a consistent building elevation.', img: '/assets/architectural-systems/door-frame-casement-e3.jpg' },
];

const fiftySeries = {
  name: '50mm Casement Series',
  width: '50 mm',
  glazing: 'Single or double glaze',
  tier: 'Residential and commercial: windows, entrance doors, bi-fold systems',
  desc: 'Versatile 50mm frame system spanning casement windows, hinged entrance doors, and sliding-folding bi-fold configurations. Suited to larger openings, commercial entrances, and multi-leaf folding door applications.',
};
---

<Layout
  title="Sliding, folding and entrance door systems: Banco Aluminium"
  description="Sliding, folding, partition and entrance door systems in aluminium, including 50 mm multi-leaf frame series for residential and commercial openings."
>
  <section class="ds-hero">
    <Pic src="/assets/architectural-systems/aluminium-folding-doors-poolside.png" alt="Banco aluminium folding doors opening onto a poolside terrace" class="ds-hero-img" loading="eager" sizes="100vw" />
    <div class="ds-hero-scrim" aria-hidden="true"></div>
    <div class="container ds-hero-body">
      <div class="eyebrow on-dark">Architectural systems / Door systems</div>
      <h1 class="ds-h1">Sliding, folding &<br>entrance door systems.</h1>
      <p class="ds-lead">Hinged, sliding and multi-leaf folding door configurations for residential and commercial openings, built on the same 50mm frame platform as our casement windows.</p>
    </div>
  </section>

  <section class="section-light section-pad">
    <div class="container">
      <div class="eyebrow">Door system types</div>
      <h2 class="t-h2" style="color:var(--color-navy);margin-top:12px;margin-bottom:32px">Four configurations.<br>One frame platform.</h2>
      <div class="ds-grid">
        {doorTypes.map((d) => (
          <div class="ds-card">
            <div class="ds-card-bg" aria-hidden="true">
              <Pic src={d.img} alt="" loading="lazy" sizes="(max-width: 900px) 100vw, 25vw" maxW={1200} />
            </div>
            <div class="ds-card-scrim" aria-hidden="true"></div>
            <div class="ds-card-body">
              <h3 class="ds-card-title">{d.name}</h3>
              <p class="ds-card-desc">{d.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="ds-split">
    <div class="ds-split-visual">
      <Pic src="/assets/architectural/1c425a807b29256caece389fa7ed010f.jpg" alt="Banco 50mm casement and bi-fold door series" loading="lazy" sizes="(max-width: 1024px) 100vw, 60vw" />
    </div>
    <div class="ds-split-body">
      <div class="eyebrow">50mm series</div>
      <h2 class="ds-split-h2">{fiftySeries.name}</h2>
      <p style="font-size:14px;line-height:1.65;color:var(--color-stone-700);margin-top:16px">{fiftySeries.desc}</p>
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:20px">
        <span class="pill">{fiftySeries.glazing}</span>
        <span class="pill">{fiftySeries.tier}</span>
      </div>
      <a href="/contact#quote" class="btn btn-primary" style="margin-top:28px;align-self:flex-start">Specify a system</a>
    </div>
  </section>
</Layout>

<style>
  .ds-hero { position: relative; padding: 168px 0 72px; overflow: hidden; }
  :global(.ds-hero-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ds-hero-scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(8,27,48,0.80) 0%, rgba(8,27,48,0.92) 100%); }
  .ds-hero-body { position: relative; z-index: 1; }
  .ds-h1 { font-family: var(--font-sans); font-size: clamp(32px, 4.4vw, 56px); font-weight: 800; letter-spacing: -0.04em; line-height: 1.0; color: var(--color-platinum); margin-top: 18px; }
  .ds-lead { font-size: 15px; line-height: 1.65; color: var(--color-silver); margin-top: 20px; max-width: 58ch; }

  .ds-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--color-stone-200); border: 1px solid var(--color-stone-200); }
  .ds-card { position: relative; min-height: 300px; display: flex; overflow: hidden; border-top: 2px solid transparent; transition: border-color 0.2s; }
  .ds-card:hover { border-top-color: var(--color-green); }
  .ds-card-bg { position: absolute; inset: 0; }
  .ds-card-bg :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; filter: brightness(0.75) saturate(0.9); transition: transform 0.55s ease, filter 0.4s ease; }
  .ds-card:hover .ds-card-bg :global(img) { transform: scale(1.06); filter: brightness(0.6) saturate(0.95); }
  .ds-card-scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(8,27,48,0.10) 0%, rgba(8,27,48,0.55) 55%, rgba(8,27,48,0.92) 100%); }
  .ds-card-body { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 8px; padding: 22px 20px; margin-top: auto; width: 100%; }
  .ds-card-title { font-family: var(--font-sans); font-size: 15px; font-weight: 700; color: var(--color-platinum); }
  .ds-card-desc { font-size: 12px; line-height: 1.55; color: var(--color-silver); margin-top: 4px; }

  .ds-split { display: grid; grid-template-columns: 1fr 1fr; min-height: 60vh; }
  .ds-split-visual { overflow: hidden; background: var(--color-stone-200); }
  .ds-split-visual :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ds-split-body { display: flex; flex-direction: column; justify-content: center; padding: clamp(40px, 6vw, 80px) clamp(32px, 5vw, 64px); background: var(--color-stone-100); }
  .ds-split-h2 { font-family: var(--font-sans); font-size: clamp(24px, 2.8vw, 36px); font-weight: 800; letter-spacing: -0.03em; color: var(--color-navy); margin-top: 12px; }

  @media (max-width: 900px) {
    .ds-grid { grid-template-columns: 1fr 1fr; }
    .ds-split { grid-template-columns: 1fr; min-height: auto; }
    .ds-split-visual { min-height: 300px; }
  }
  @media (max-width: 540px) { .ds-grid { grid-template-columns: 1fr; } }
</style>
