---
import Layout from '../../../layouts/Layout.astro';
import Pic from '../../../components/Pic.astro';

const facadeTypes = [
  { name: 'Curtain Wall Systems', desc: 'Structural glazing and captured curtain wall systems for commercial and institutional elevations. Full-height glass spans with concealed or exposed cap options.', img: '/assets/architectural-systems/curtain-wall-system.jpg' },
  { name: 'Glazing Solutions',    desc: 'Single, double and structural glazing configurations engineered to Banco frame tolerances, coordinated with your glazier of choice.', img: '/assets/architectural-systems/aluminium-glazing-corner.jpeg' },
  { name: 'Louvers',              desc: 'Fixed and adjustable louvre and shading systems for solar control, ventilation, and plant screening on commercial façades.', img: '/assets/architectural-systems/louvers.webp' },
];

const performance = [
  { cat: 'Wind resistance',  std: 'EN 12211 / EN 12210' },
  { cat: 'Watertightness',   std: 'EN 1027 / EN 12208' },
  { cat: 'Air permeability', std: 'EN 1026 / EN 12207' },
  { cat: 'Sound insulation', std: 'EN ISO 10140' },
  { cat: 'Impact resistance',std: 'EN 13049' },
];
---

<Layout
  title="Façade & curtain wall systems: Banco Aluminium"
  description="Structural glazing, curtain wall and louvre systems for commercial and institutional elevations. Tested to EN 14351-1. Banco Architectural Systems."
>
  <section class="fs-hero">
    <Pic src="/assets/architectural/6de0a5d9e19749b6f1e136347b188ed6.jpg" alt="Banco aluminium curtain wall façade" class="fs-hero-img" loading="eager" sizes="100vw" />
    <div class="fs-hero-scrim" aria-hidden="true"></div>
    <div class="container fs-hero-body">
      <div class="eyebrow on-dark">Architectural systems / Façade systems</div>
      <h1 class="fs-h1">Structural glazing &<br>curtain wall.</h1>
      <p class="fs-lead">Curtain wall, structural glazing and louvre systems for commercial and institutional elevations, tested to EN 14351-1 for full performance data.</p>
    </div>
  </section>

  <section class="section-light section-pad">
    <div class="container">
      <div class="eyebrow">Façade system types</div>
      <h2 class="t-h2" style="color:var(--color-navy);margin-top:12px;margin-bottom:32px">Three configurations<br>for large-scale elevations.</h2>
      <div class="fs-grid">
        {facadeTypes.map((f) => (
          <div class="fs-card">
            {f.img && (
              <div class="fs-card-bg" aria-hidden="true">
                <Pic src={f.img} alt="" loading="lazy" sizes="(max-width: 900px) 100vw, 33vw" maxW={1200} />
              </div>
            )}
            <h3 class="fs-card-title">{f.name}</h3>
            <p class="fs-card-desc">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-dark section-pad">
    <div class="container">
      <div class="eyebrow on-dark">Standards & testing</div>
      <h2 class="t-h2" style="color:var(--color-platinum);margin-top:12px;margin-bottom:32px">Tested to EN 14351-1.</h2>
      <div class="fs-perf-grid">
        {performance.map((p) => (
          <div class="fs-perf-col">
            <div class="fs-perf-cat">{p.cat}</div>
            <div class="fs-perf-std">{p.std}</div>
          </div>
        ))}
      </div>
      <div style="margin-top:36px;display:flex;gap:16px;flex-wrap:wrap">
        <a href="/contact?src=architectural#quote" class="btn btn-primary-dark">Request data sheets</a>
        <a href="/products/architectural" class="btn btn-secondary-dark">All architectural systems</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .fs-hero { position: relative; padding: 168px 0 72px; overflow: hidden; }
  :global(.fs-hero-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .fs-hero-scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(8,27,48,0.80) 0%, rgba(8,27,48,0.92) 100%); }
  .fs-hero-body { position: relative; z-index: 1; }
  .fs-h1 { font-family: var(--font-sans); font-size: clamp(32px, 4.4vw, 56px); font-weight: 800; letter-spacing: -0.04em; line-height: 1.0; color: var(--color-platinum); margin-top: 18px; }
  .fs-lead { font-size: 15px; line-height: 1.65; color: var(--color-silver); margin-top: 20px; max-width: 58ch; }

  .fs-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--color-stone-200); border: 1px solid var(--color-stone-200); }
  .fs-card { position: relative; background: #fff; padding: 26px 24px; border-top: 2px solid var(--color-green); overflow: hidden; }
  .fs-card-bg { aspect-ratio: 4/3; margin: -26px -24px 20px; overflow: hidden; background: var(--color-stone-200); }
  .fs-card-bg :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.55s ease; }
  .fs-card:hover .fs-card-bg :global(img) { transform: scale(1.05); }
  .fs-card-title { font-family: var(--font-sans); font-size: 16px; font-weight: 700; color: var(--color-navy); }
  .fs-card-desc { font-size: 13px; line-height: 1.6; color: var(--color-stone-700); margin-top: 12px; }

  .fs-perf-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1px; background: var(--color-navy-line); border: 1px solid var(--color-navy-line); }
  .fs-perf-col { background: var(--color-navy-soft); padding: 20px 18px; }
  .fs-perf-cat { font-family: var(--font-sans); font-size: 12.5px; font-weight: 600; color: var(--color-platinum); }
  .fs-perf-std { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; color: var(--color-green); margin-top: 6px; }

  @media (max-width: 900px) {
    .fs-grid { grid-template-columns: 1fr; }
    .fs-perf-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
