---
import Layout from '../../../layouts/Layout.astro';
import Pic from '../../../components/Pic.astro';
import SeriesGrid from '../../../components/SeriesGrid.astro';
import { DOCS } from '../../../lib/documents';
import { byGroup, catalogue } from '../../../lib/series';

// Series, copy and imagery come from the Sept 2026 Profile Catalogue (src/lib/series.ts).
const sliding = byGroup('sliding');
const casement = byGroup('casement');
const range = (list: typeof sliding) => `${list[0].width} to ${list[list.length - 1].width}`;
const casementWidths = casement.map((s) => s.width!.replace(' mm', '')).join(', ') + ' mm';
const { livingSpaces, technicalFeatures } = catalogue.shared;
---

<Layout
  title="Sliding & casement aluminium windows: Banco Aluminium"
  description={`${sliding.length} sliding window series from ${range(sliding)} and ${casement.length} casement series (${casementWidths}), with section drawings, profile weights and bills of materials. Banco Architectural Systems.`}
  image={livingSpaces.src}
>
  <section class="ws-hero">
    <Pic src={livingSpaces.src} alt="" class="ws-hero-img" focus="50% 55%" loading="eager" sizes="100vw" />
    <div class="ws-hero-scrim" aria-hidden="true"></div>
    <div class="container ws-hero-body">
      <div class="eyebrow on-dark">Architectural systems / Window systems</div>
      <h1 class="ws-h1">Sliding & casement<br>window systems.</h1>
      <p class="ws-lead">{sliding.length} sliding series from {range(sliding)}, plus {casement.length} inward- and outward-opening casement series ({casementWidths}), each with section drawings and profile weights.</p>
    </div>
  </section>

  <section class="section-light section-pad ws-pad">
    <div class="container">
      <div class="eyebrow">Sliding systems</div>
      <h2 class="t-h2 ws-h2">{sliding.length} sliding series. {range(sliding)}.</h2>
      <SeriesGrid series={sliding} />
    </div>
  </section>

  <section class="section-alt section-pad ws-pad">
    <div class="container">
      <div class="eyebrow">Casement systems</div>
      <h2 class="t-h2 ws-h2">{casementWidths}. Inward or outward opening.</h2>
      <SeriesGrid series={casement} start={sliding.length + 1} />
    </div>
  </section>

  <!-- ── Technical features (catalogue p.01) ── -->
  <section class="ws-tf">
    <div class="ws-tf-visual">
      <Pic src={technicalFeatures.src} alt="Cut-away of a Banco sliding window frame showing the multi-chamber aluminium profile" focus="88% 70%" loading="lazy" sizes="(max-width: 900px) 100vw, 50vw" />
    </div>
    <div class="ws-tf-body">
      <div class="eyebrow on-dark">From the product catalogue</div>
      <h2 class="ws-tf-h2">Technical features.</h2>
      <ul class="ws-tf-list">
        {catalogue.features.map((f) => (
          <li>
            <span class="ws-tf-t">{f.title}</span>
            <span class="ws-tf-d">{f.desc}</span>
          </li>
        ))}
      </ul>
      <a href={DOCS.architecturalCatalogue.view} class="btn btn-secondary-dark ws-tf-btn" target="_blank" rel="noopener">View Profile Catalogue</a>
    </div>
  </section>
</Layout>

<style>
  .ws-hero { position: relative; padding: 168px 0 72px; overflow: hidden; }
  :global(.ws-hero-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ws-hero-scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(8,27,48,0.82) 0%, rgba(8,27,48,0.92) 100%); }
  .ws-hero-body { position: relative; z-index: 1; }
  .ws-h1 { font-family: var(--font-sans); font-size: clamp(32px, 4.4vw, 56px); font-weight: 800; letter-spacing: -0.04em; line-height: 1.0; color: var(--color-platinum); margin-top: 18px; }
  .ws-lead { font-size: 15px; line-height: 1.65; color: var(--color-silver); margin-top: 20px; max-width: 58ch; }

  .ws-pad { padding: clamp(48px, 6vw, 88px) 0; }
  .ws-h2 { color: var(--color-navy); margin-top: 12px; margin-bottom: 32px; }

  /* ── Technical features split ── */
  .ws-tf { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); background: var(--color-navy); border-bottom: 1px solid var(--color-navy-line); }
  .ws-tf-visual { overflow: hidden; min-height: 420px; background: var(--color-stone-100); }
  .ws-tf-visual :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ws-tf-body { padding: clamp(40px, 6vw, 88px) clamp(28px, 5vw, 72px); display: flex; flex-direction: column; justify-content: center; }
  .ws-tf-h2 { font-family: var(--font-sans); font-size: clamp(24px, 2.6vw, 36px); font-weight: 700; letter-spacing: -0.025em; line-height: 1.12; color: var(--color-platinum); margin-top: 14px; }
  .ws-tf-list { list-style: none; margin-top: 24px; border-top: 1px solid var(--color-navy-line); }
  .ws-tf-list li { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 14px; padding: 12px 0; border-bottom: 1px solid var(--color-navy-line); }
  .ws-tf-t { font-family: var(--font-mono); font-size: max(10px, var(--fs-min, 0px)); letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-green); padding-top: 2px; }
  .ws-tf-d { font-size: 13px; line-height: 1.55; color: var(--color-silver); }
  .ws-tf-btn { align-self: flex-start; margin-top: 28px; }

  @media (max-width: 900px) {
    .ws-tf { grid-template-columns: minmax(0, 1fr); }
    .ws-tf-visual { min-height: 0; height: clamp(240px, 60vw, 380px); }
    .ws-tf-list li { grid-template-columns: minmax(0, 1fr); gap: 4px; }
  }
</style>
