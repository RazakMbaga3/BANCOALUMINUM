---
import Layout from '../../layouts/Layout.astro';

// ── Alloy compositions — source: Banco Billets 2026 Product Catalogue ─────────
const alloys = [
  { alloy: '1070A', si: '≤ 0.10', mg: '≤ 0.03', fe: '≤ 0.25', mn: '≤ 0.03', cu: '≤ 0.03', al: '≥ 99.70', note: 'Pure aluminium' },
  { alloy: '1100',  si: '≤ 0.95', mg: '≤ 0.05', fe: '≤ 0.30', mn: '≤ 0.05', cu: '0.05–0.10', al: '≥ 99.00', note: 'Si + Fe ≤ 0.95 combined' },
  { alloy: '3003',  si: '≤ 0.10', mg: '≤ 0.05', fe: '≤ 0.25', mn: '1.05–1.15', cu: '0.05–0.09', al: 'Rem.', note: 'Heat exchanger · automotive' },
  { alloy: '6060',  si: '≤ 0.10', mg: '0.48–0.54', fe: '0.10–0.25', mn: '≤ 0.07', cu: '≤ 0.07', al: 'Rem.', note: 'Architectural profiles' },
  { alloy: '6063',  si: '≤ 0.10', mg: '0.48–0.55', fe: '≤ 0.30', mn: '≤ 0.10', cu: '≤ 0.10', al: 'Rem.', note: 'Windows · doors · general extrusion' },
  { alloy: '6101',  si: '≤ 0.10', mg: '0.48–0.55', fe: '≤ 0.20', mn: '≤ 0.03', cu: '≤ 0.03', al: 'Rem.', note: 'Electrical conductor grade' },
  { alloy: '6005',  si: '≤ 0.10', mg: '0.45–0.53', fe: '≤ 0.25', mn: '≤ 0.10', cu: '≤ 0.10', al: 'Rem.', note: 'Medium strength structural' },
  { alloy: '6005A', si: '≤ 0.10', mg: '0.50–0.58', fe: '≤ 0.25', mn: '0.20–0.28', cu: '≤ 0.10', al: 'Rem.', note: 'Transport · structural (Mn+Cr 0.12–0.50)' },
  { alloy: '6082',  si: '≤ 0.10', mg: '0.72–0.79', fe: '≤ 0.30', mn: '0.45–0.53', cu: '≤ 0.10', al: 'Rem.', note: 'High strength structural' },
  { alloy: '6061',  si: '≤ 0.10', mg: '0.90–0.98', fe: '≤ 0.35', mn: '≤ 0.13', cu: '0.18–0.25', al: 'Rem.', note: 'Engineering · aerospace' },
  { alloy: '6066',  si: '≤ 0.10', mg: '1.00–1.10', fe: '≤ 0.30', mn: '0.70–0.80', cu: '0.80–0.90', al: 'Rem.', note: 'High-strength forgings' },
];

// ── Alloy specialities ──────────────────────────────────────────────────────
const alloySpecialities = [
  'Hard and high-strength alloys for structural, transport, defence, aerospace and engineering applications',
  'Lead-free free-machining alloys, including 6026, for automotive, medical, food processing and precision-machined components',
  'Electrical conductivity alloys, including 6101 and 6201, for busbars, conductor profiles and renewable energy applications',
  'Custom alloys and special chemistries developed as per customer specification',
];

// ── Available dimensions — source: Banco Billets 2026 ─────────────────────────
const sizes = [
  { dia: '127 mm', inch: '5"',   note: 'Standard residential extrusion' },
  { dia: '152 mm', inch: '6"',   note: 'Window · door systems' },
  { dia: '178 mm', inch: '7"',   note: 'Commercial structural profiles' },
  { dia: '203 mm', inch: '8"',   note: 'Heavy-section industrial profiles' },
  { dia: '229 mm', inch: '9"',   note: 'Heavy-duty industrial sections' },
  { dia: '254 mm', inch: '10"',  note: 'Large-section · press 4 & 5' },
];

const tolerances = [
  { dim: 'Diameter',       tol: '± 1% of nominal diameter' },
  { dim: 'Length',         tol: '± 5 mm' },
  { dim: 'Bow / camber',   tol: '≤ 2 mm per metre · ≤ 10 mm full length' },
  { dim: 'Cutting angle',  tol: '90° ± 0.5°' },
  { dim: 'Std. length',    tol: '5,800 mm (all diameters)' },
];

// ── 5-stage production process ─────────────────────────────────────────────────
const process = [
  {
    num: '/ 01',
    name: 'Melting',
    photo: '/assets/manufacturing/melting-1.jpg',
    body: 'Charge materials are melted in gas-fired furnaces to a controlled tapping temperature, the starting point for consistent alloy chemistry batch after batch.',
  },
  {
    num: '/ 02',
    name: 'Refining & degassing',
    photo: '/assets/manufacturing/melting-3.jpg',
    body: 'Advanced nitrogen-purged liquid-metal refining removes dissolved hydrogen from the melt. Eliminating this porosity-driving gas prevents surface blistering and voids that compromise extrudability in downstream presses.',
  },
  {
    num: '/ 03',
    name: 'Ceramic foam filtration',
    photo: '/assets/manufacturing/melting-4.jpg',
    body: 'Online liquid-metal filtration through ceramic foam filters removes non-metallic inclusions before the casting station, delivering measurably improved metal cleanliness and reduced inclusion count in the finished billet.',
  },
  {
    num: '/ 04',
    name: 'Hot-Top casting',
    photo: '/assets/manufacturing/casting-1.jpg',
    body: 'Billets are produced using cylinder-guided Hot-Top casting technology, which controls casting speed and cooling rate with precision. The result is a consistent surface finish, controlled skin thickness, and uniform metallurgical structure through the full cross-section.',
  },
  {
    num: '/ 05',
    name: 'Batch homogenising',
    photo: '/assets/manufacturing/homo-1.jpg',
    body: 'Billets are heat-treated in controlled-atmosphere furnaces to dissolve soluble phases and homogenise the microstructure, then force-cooled to a specified exit temperature. This step directly governs extrudability, surface finish, and dimensional consistency in downstream extrusion.',
  },
];

// ── Quality assurance ──────────────────────────────────────────────────────────
const qc = [
  { stat: '100 %', label: 'Visual inspection — external defects', sub: 'External surface — every billet, every cast' },
  { stat: '100 %', label: 'Ultrasonic testing', sub: 'Internal defects — inclusions, voids' },
  { stat: '100 %', label: 'Chemical analysis', sub: 'Spectromax OES — verified against order specification' },
  { stat: 'SCADA', label: 'Online traceability', sub: 'Furnace conditions to despatch, batch-linked' },
  { stat: 'Cast №', label: 'Alloy marking', sub: 'Designation + cast number on every individual billet' },
];

const certs = [
  'ISO 9001:2015',
  'ISO 14001:2015',
  'ISO 45001:2018',
  'IATF 16949:2016',
  'CE (EN 15088:2005)',
  'IS 733 · IS 1285 · IS 5082',
  'ISO 14064-1',
];
---

<Layout
  title="Aluminium extrusion billets — casting & cast products — Banco Aluminium"
  description="Foundry-grade aluminium extrusion billets. 55,000 MT annual capacity. 11 standard alloys plus custom compositions. 127–254 mm diameters. Cylinder-guided Hot-Top casting. 0.480 kgCO₂e/kg, ISO 14064-1 verified. CBAM-ready."
  image="/assets/manufacturing/aluminumbillets.avif"
  transparentNav={true}
>

  <!-- ── Hero — full-bleed photo ───────────────────────────────────────────── -->
  <section class="c-hero">
    <img
      src="/assets/manufacturing/aluminumbillets.avif"
      alt="Aluminium extrusion billets — Banco Aluminium foundry"
      class="c-hero-img"
      loading="eager"
    />
    <div class="c-hero-overlay" aria-hidden="true"></div>
    <div class="c-hero-content">
      <h1 class="c-h1">
        Extrusion billets.<br>Cast to spec.
      </h1>
      <div class="c-stats">
        {[
          { n: '55,000', u: 'MT/yr',       l: 'Foundry capacity' },
          { n: '5',      u: 'Diameters',   l: '5" to 10"' },
          { n: '12+',    u: 'Alloys',      l: 'Custom on request' },
          { n: '0.480',  u: 'kgCO₂e/kg',  l: 'ISO 14064-1 verified' },
        ].map(({ n, u, l }) => (
          <div class="c-stat">
            <div class="c-stat-num">{n} <span class="c-stat-unit">{u}</span></div>
            <div class="c-stat-label">{l}</div>
          </div>
        ))}
      </div>
      <div class="c-hero-actions">
        <a href="/contact#technical" class="btn btn-primary-dark">Technical enquiry</a>
      </div>
    </div>
  </section>


  <!-- ── 01 · Overview ─────────────────────────────────────────────────────── -->
  <section class="section-light c-vp-section">
    <div class="container c-overview-grid">

      <!-- Left: rich content column -->
      <div class="c-overview-left">
        <div class="eyebrow">Foundry · Billet production</div>
        <h2 class="t-h2 c-h2-navy" style="font-weight:800;margin-top:14px">
          Consistent metallurgical<br/>quality, cast to cast.
        </h2>
        <p class="t-body c-body-text" style="margin-top:20px">
          Banco's integrated foundry produces extrusion-grade aluminium billets using
          cylinder-guided Hot-Top casting — delivering controlled microstructure,
          measurable metal cleanliness and consistent extrudability, batch after batch.
        </p>
        <p class="t-body c-body-text" style="margin-top:12px">
          Every billet undergoes 100% ultrasonic testing, spectroscopic chemical
          verification and full SCADA traceability from furnace charge through despatch.
        </p>
        <div class="c-chip-row" style="margin-top:24px">
          {['Hot-Top casting', 'In-house alloy development', 'SCADA traceability', 'CBAM-ready', 'Export-certified'].map(c => (
            <span class="pill">{c}</span>
          ))}
        </div>

      </div>

      <!-- Right: image composition — 1 large + 2 small -->
      <div class="c-overview-right">
        <div class="c-ov-main">
          <img src="/assets/manufacturing/billet-1.jpg" alt="Finished aluminium extrusion billets — Banco Aluminium, Vadodara" loading="eager" />
          <div class="c-ov-main-caption">
            <span>Finished extrusion billets</span>
            <span class="c-ov-cap-note">Alloy-marked · 5,800 mm · SCADA traced</span>
          </div>
        </div>
        <div class="c-ov-pair">
          <div class="c-ov-sm">
            <img src="/assets/manufacturing/casting-2.jpg" alt="Hot-Top casting station — Banco Aluminium" loading="lazy" />
            <span class="c-ov-sm-lbl">Hot-Top casting</span>
          </div>
          <div class="c-ov-sm">
            <img src="/assets/manufacturing/homo-1.jpg" alt="Homogenising furnace — Banco Aluminium" loading="lazy" />
            <span class="c-ov-sm-lbl">Homogenising</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ── 02 · Alloy range ──────────────────────────────────────────────────── -->
  <section class="section-alt section-pad">
    <div class="container">
      <div class="c-section-head">
        <h2 class="t-h2 c-h2-navy" style="font-weight:800">
          11 standard alloys.<br>Custom compositions on request.
        </h2>
      </div>

      <!-- Alloy composition table -->
      <div class="c-table-wrap">
        <table class="c-table" aria-label="Standard alloy chemical composition, weight percent">
          <thead>
            <tr>
              <th scope="col">Alloy</th>
              <th scope="col">Si (wt%)</th>
              <th scope="col">Mg (wt%)</th>
              <th scope="col">Fe (wt%)</th>
              <th scope="col">Mn (wt%)</th>
              <th scope="col">Cu (wt%)</th>
              <th scope="col">Al</th>
              <th scope="col">Primary application</th>
            </tr>
          </thead>
          <tbody>
            {alloys.map((a, i) => (
              <tr class={i % 2 === 0 ? 'c-row-even' : 'c-row-odd'}>
                <td class="c-cell-alloy">{a.alloy}</td>
                <td class="c-cell-val">{a.si}</td>
                <td class="c-cell-val">{a.mg}</td>
                <td class="c-cell-val">{a.fe}</td>
                <td class="c-cell-val">{a.mn}</td>
                <td class="c-cell-val">{a.cu}</td>
                <td class="c-cell-val">{a.al}</td>
                <td class="c-cell-note">{a.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="c-table-footnote">
        <span class="c-table-footnote-std">Full chemical composition including Zn, Cr, Ti, and individual trace elements available in the product data sheet.</span>
        <span class="c-table-footnote-callout"><strong>Additional alloys:</strong> 1050A, 2011, 2017A, 2014, 6262, 6026 — available to customer specification. Please contact us for details.</span>
      </p>

      <div class="c-spec-list">
        {alloySpecialities.map((s) => (
          <div class="c-spec-item">
            <span class="c-spec-dot" aria-hidden="true"></span>
            <span>{s}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── 03 · Dimensions & tolerances ─────────────────────────────────────── -->
  <section class="section-dark section-pad">
    <div class="container">
      <div class="c-section-head">
        <h2 class="t-h2" style="color:var(--color-platinum);font-weight:800">
          Six diameters.<br>5,800 mm standard length.
        </h2>
      </div>

      <div class="c-dim-grid">
        <!-- Diameter table -->
        <div>
          <div class="c-table-label">Available diameters</div>
          <div class="c-dim-table">
            {sizes.map((s, i) => (
              <div class={`c-dim-row ${i < sizes.length - 1 ? 'c-dim-row-border' : ''}`}>
                <div class="c-dim-dia">{s.dia}</div>
                <div class="c-dim-inch">{s.inch}</div>
                <div class="c-dim-note">{s.note}</div>
              </div>
            ))}
          </div>
        </div>

        <!-- Tolerance table -->
        <div>
          <div class="c-table-label">Dimensional tolerances</div>
          <div class="c-dim-table">
            {tolerances.map((t, i) => (
              <div class={`c-dim-row ${i < tolerances.length - 1 ? 'c-dim-row-border' : ''}`}>
                <div class="c-dim-dia">{t.dim}</div>
                <div class="c-dim-tol">{t.tol}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 04 · Production process ──────────────────────────────────────────── -->
  <section class="section-alt section-pad">
    <div class="container">
      <div class="c-section-head">
        <h2 class="t-h2 c-h2-navy" style="font-weight:800">
          Five stages<br>from melt to billet.
        </h2>
      </div>

      <div class="c-process-grid">
        {process.map((step) => (
          <div class="c-process-cell">
            <div class="c-proc-img">
              <img src={step.photo} alt={step.name} loading="lazy" />
            </div>
            <div class="c-process-num">{step.num}</div>
            <h3 class="c-process-name">{step.name}</h3>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ── 05 · Quality assurance ────────────────────────────────────────────── -->
  <section class="section-dark section-pad">
    <div class="container">
      <div class="c-section-head">
        <h2 class="t-h2" style="color:var(--color-platinum);font-weight:800">
          100% inspection<br>at every stage.
        </h2>
      </div>

      <div class="c-qc-grid">
        {qc.map((item) => (
          <div class="c-qc-cell">
            <div class="c-qc-stat">{item.stat}</div>
            <div class="c-qc-label">{item.label}</div>
            <div class="c-qc-sub">{item.sub}</div>
          </div>
        ))}
      </div>

      <!-- Packing note -->
      <div class="c-packing">
        <div class="c-packing-inner">
          <div class="c-packing-img">
            <img src="/assets/manufacturing/Labeling.png" alt="Banco billet alloy and cast number labelling" loading="lazy" />
          </div>
          <div>
            <div class="c-table-label">Packing &amp; identification</div>
          </div>
          <div class="c-packing-tags">
            <span class="pill on-dark">Plastic-strapped bundles</span>
            <span class="pill on-dark">Forklift-ready runners</span>
            <span class="pill on-dark">Alloy + cast number marking</span>
            <span class="pill on-dark">Full batch traceability</span>
            <span class="pill on-dark">Export-standard packing</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 06 · Green aluminium ──────────────────────────────────────────────── -->
  <section class="section-deep section-pad">
    <div class="container">
      <div class="c-two-col" style="align-items:start">
        <div>
          <h2 class="t-h2" style="color:var(--color-platinum);margin-top:20px;font-weight:800">
            0.480 kgCO₂e per kg.<br>Verified quarterly.
          </h2>
          <div class="c-chip-row" style="margin-top:28px">
            {['ISO 14064-1 verified', 'CBAM documentation', 'Up to 95% recycled input', '960 kW captive solar', 'Natural gas melting'].map(c => (
              <span class="pill on-dark">{c}</span>
            ))}
          </div>
        </div>
        <div class="c-green-stats">
          {[
            { n: '0.480', u: 'kgCO₂e / kg', l: 'Carbon footprint at full capacity · ISO 14064-1' },
            { n: '≤ 5%',  u: '',             l: 'Verified primary aluminium in green billet grade' },
            { n: '960',   u: 'kW',           l: 'Captive solar generation on site' },
            { n: '100%',  u: '',             l: 'Natural gas in melting — no coal energy input' },
          ].map(({ n, u, l }) => (
            <div class="c-green-cell">
              <div class="c-green-num">
                {n}
                {u && <span class="c-green-unit">&thinsp;{u}</span>}
              </div>
              <div class="c-green-label">{l}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── 07 · Certifications ───────────────────────────────────────────────── -->
  <section class="section-light" style="padding:40px 0;border-bottom:1px solid var(--color-stone-200)">
    <div class="container">
      <div class="c-cert-row">
        <div class="c-cert-label">Certified to:</div>
        <div class="c-cert-chips">
          {certs.map(c => <span class="pill">{c}</span>)}
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────────────────────── -->
  <section class="section-dark" style="padding:80px 0;border-top:2px solid var(--color-green)">
    <div class="container">
      <div class="c-cta-grid">
        <div>
          <div class="eyebrow on-dark">Enquiries welcome</div>
          <h2 class="t-h2" style="color:var(--color-platinum);margin-top:16px;font-weight:800">
            Supply discussions,<br>technical enquiries, sample orders.
          </h2>
        </div>
        <div class="c-cta-actions">
          <a href="/contact#quote" class="btn btn-primary-dark">Request a quotation</a>
          <a href="/sustainability" class="btn btn-secondary-dark">CBAM documentation</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Hero ──────────────────────────────────────────────────────────────── */
  .c-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .c-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .c-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      160deg,
      rgba(8,27,48,0.72) 0%,
      rgba(8,27,48,0.45) 50%,
      rgba(8,27,48,0.78) 100%
    );
  }
  .c-hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 0 0 64px;
  }
  .c-hero-content > .eyebrow { padding: 0 clamp(20px, 4vw, 60px); margin-bottom: 20px; }
  .c-h1 {
    font-family: var(--font-sans);
    font-size: clamp(40px, 5.5vw, 72px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.95;
    color: var(--color-platinum);
    padding: 0 clamp(20px, 4vw, 60px);
    margin-bottom: 48px;
  }
  .c-hero-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    padding: 0 clamp(20px, 4vw, 60px);
    margin-top: 36px;
  }

  /* Stats strip */
  .c-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: rgba(40,69,106,0.4);
    border-top: 1px solid rgba(40,69,106,0.4);
    border-bottom: 1px solid rgba(40,69,106,0.4);
    margin-bottom: 0;
  }
  .c-stat {
    background: rgba(8,27,48,0.7);
    backdrop-filter: blur(4px);
    padding: 20px clamp(20px, 4vw, 60px);
  }
  .c-stat-num {
    font-family: var(--font-sans);
    font-size: clamp(26px, 3vw, 38px);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-platinum);
    line-height: 1;
  }
  .c-stat-unit {
    font-family: var(--font-mono);
    font-size: clamp(13px, 1.5vw, 18px);
    letter-spacing: 0.08em;
    color: var(--color-green);
    margin-left: 4px;
    font-weight: 700;
  }
  .c-stat-label {
    font-family: var(--font-mono);
    font-size: clamp(11px, 1vw, 13px);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-nickel);
    margin-top: 8px;
  }

  /* ── Viewport-height sections ─────────────────────────────────────────── */
  .c-vp-section {
    min-height: calc(100vh - 72px);
    display: flex;
    align-items: center;
    padding: clamp(40px, 5vh, 64px) 0;
    border-bottom: 1px solid var(--color-stone-200);
  }

  /* ── Overview grid — balanced 2-col ───────────────────────────────────── */
  .c-overview-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 5vw, 80px);
    align-items: center;
    width: 100%;
  }
  .c-overview-left {
    display: flex;
    flex-direction: column;
  }
  .c-overview-right {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* Main large image */
  .c-ov-main {
    overflow: hidden;
    border: 1px solid var(--color-stone-200);
    position: relative;
  }
  .c-ov-main img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    filter: brightness(0.92) saturate(0.85);
    transition: transform 0.55s ease, filter 0.4s ease;
  }
  .c-ov-main:hover img { transform: scale(1.03); filter: brightness(1) saturate(1); }
  .c-ov-main-caption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 8px 10px;
    background: var(--color-stone-50);
    border-top: 1px solid var(--color-stone-200);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    color: var(--color-navy);
  }
  .c-ov-cap-note {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-stone-400);
    font-weight: 400;
  }

  /* Small image pair side-by-side */
  .c-ov-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }
  .c-ov-sm {
    overflow: hidden;
    border: 1px solid var(--color-stone-200);
    position: relative;
  }
  .c-ov-sm img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    filter: brightness(0.88) saturate(0.8);
    transition: transform 0.45s, filter 0.3s;
  }
