---
import Layout from '../../layouts/Layout.astro';

const industries = [
  { num: '/ 01', name: 'Electrical & power transmission',      note: 'Busbar · T&D profiles · cable management' },
  { num: '/ 02', name: 'Automotive & commercial vehicles',     note: 'Structural · trim · thermal management' },
  { num: '/ 03', name: 'Machinery & automation',               note: 'Machine frames · linear guides · housings' },
  { num: '/ 04', name: 'Heat sinks & heat exchangers',         note: 'Extruded fin · skived · bonded assemblies' },
  { num: '/ 05', name: 'Aerospace & defence',                  note: 'Cryogenic · structural · precision sections' },
  { num: '/ 06', name: 'Hydraulics & pneumatics',              note: 'Cylinder tubes · manifold bodies · rods' },
  { num: '/ 07', name: 'Railways & shipbuilding',              note: 'Structural · floor panels · marine profiles' },
  { num: '/ 08', name: 'Solar & alternative energy',           note: 'Mounting frames · tracker rails · inverter housings' },
  { num: '/ 09', name: 'Material handling & structural',       note: 'Modular rack · conveyor · frame sections' },
  { num: '/ 10', name: 'Pumps, motors & general engineering',  note: 'Motor bodies · pump housings · shafts' },
  { num: '/ 11', name: 'Forging & precision machining',        note: 'Machining billets · forging stock · turned parts' },
  { num: '/ 12', name: 'Transport & elevator systems',         note: 'Vehicle profiles · elevator guide rails · enclosures' },
];

const alloyFamilies = [
  {
    title: 'Hard alloys',
    sub: 'Structural · automotive · aerospace',
    grades: ['2011', '2014', '2017A', '5083', '5754', '6026', '6061', '6066', '6082', '6262'],
    note: 'Series 2xxx · 5xxx · 6xxx',
  },
  {
    title: 'Lead-free machining',
    sub: 'RoHS · automated CNC',
    grades: ['2111 LF', '2033 LF', '6026 LF'],
    note: 'RoHS compliant · custom compositions',
  },
  {
    title: 'Soft & medium alloys',
    sub: 'Architectural · electrical · general',
    grades: ['1050', '1070', '1100', '3003', '3103', '6060', '6063'],
    note: 'Series 1xxx · 3xxx · 6xxx',
  },
];

const capabilities = [
  { num: '/ 01', name: 'Die design & development',      tag: 'Q-Form simulation · 5-axis CNC · trial extrusion' },
  { num: '/ 02', name: 'Extrusion',                     tag: '5 presses · 1,100–3,300 MT · 35,000 MT/yr' },
  { num: '/ 03', name: 'Heat treatment',                tag: 'T5, T6, T73 tempers · in-line & batch' },
  { num: '/ 04', name: 'Fabrication & machining',       tag: 'Cut · drill · mill · bend · 10,000 parts/day' },
  { num: '/ 05', name: 'Cold drawing',                  tag: 'Rods · bars · tubes · tight OD tolerance' },
  { num: '/ 06', name: 'Surface finishing',             tag: 'Mill finish · anodising · powder coat (QUALICOAT)' },
];

const workflow = [
  { num: '01', step: 'Drawing or sample submission',    note: 'DXF, DWG, STEP, PDF, or physical sample' },
  { num: '02', step: 'Die design & Q-Form simulation',  note: 'Flow analysis · weld seam prediction' },
  { num: '03', step: 'Die manufacture & trial',         note: '5-axis CNC · trial run · dimensional report' },
  { num: '04', step: 'Sample approval',                 note: 'Dimensional cert · mechanical properties' },
  { num: '05', step: 'Value-added processing',          note: 'Heat treatment · fabrication · finishing' },
  { num: '06', step: 'Repeat supply',                   note: 'SCADA traceability · export documentation' },
];

const packingInternal = [
  { name: 'Bare',              desc: 'Standard for immediate processing.' },
  { name: 'Paper layer',       desc: 'Prevents surface friction in transit.' },
  { name: 'Paper interleave',  desc: 'Between individual bars.' },
  { name: 'Cardboard strip',   desc: 'Horizontal between layers.' },
  { name: 'Wrapped profiles',  desc: 'Crepe paper, bubble wrap, or nylon.' },
];

const packingExternal = [
  { name: 'Wooden bundle',  desc: '8×10 cm base blocks · plastic strapped.' },
  { name: 'Cardboard box',  desc: 'Wrapped for surface-sensitive profiles.' },
  { name: 'Wooden pallet',  desc: 'Forklift-compatible base boards.' },
  { name: 'Stretch film',   desc: 'Moisture and dust protection.' },
  { name: 'Plastic wrap',   desc: 'Nylon, four sides and edges.' },
];

const certs = [
  'ISO 9001:2015',
  'ISO 14001:2015',
  'ISO 45001:2018',
  'IATF 16949:2016',
  'CE (EN 15088)',
  'IRS Works Approval',
  'IS 733 · IS 1285 · IS 5082',
];
---

<Layout
  title="Industrial profiles and engineered aluminium for OEM applications — Banco Aluminium"
  description="Drawing-led aluminium profiles for OEM applications. Hard alloys, lead-free machining grades, cold drawing. Die design, extrusion, fabrication, 10,000 parts/day. IATF 16949 · ISO 9001 · CE certified."
  transparentNav={true}
>

  <!-- ── Hero — full-bleed photo ───────────────────────────────────────────── -->
  <section class="ih-hero">
    <img
      src="/assets/manufacturing/industrialOEMS.webp"
      alt="Banco Aluminium industrial extrusion facility"
      class="ih-hero-img"
      loading="eager"
    />
    <div class="ih-hero-overlay" aria-hidden="true"></div>
    <div class="ih-hero-content">
      <h1 class="ih-h1">
        Drawing-led profiles.<br>OEM repeat supply.
      </h1>
      <div class="ih-stats">
        {[
          { n: '35,000', u: 'MT/yr', l: 'Extrusion capacity' },
          { n: '5',      u: 'presses', l: '1,100–3,300 MT' },
          { n: '10,000', u: '/day',  l: 'Parts fabricated' },
          { n: '12',     u: 'sectors', l: 'Industries served' },
        ].map(({ n, u, l }) => (
          <div class="ih-stat">
            <div class="ih-stat-num">{n} <span class="ih-stat-u">{u}</span></div>
            <div class="ih-stat-l">{l}</div>
          </div>
        ))}
      </div>
      <div class="ih-hero-actions">
        <a href="/contact#quote" class="btn btn-primary-dark">Submit a drawing</a>
        <a href="/capabilities" class="btn btn-secondary-dark">View capabilities</a>
      </div>
    </div>
  </section>

  <!-- ── Overview — editorial split ───────────────────────────────────────── -->
  <section class="ih-split">
    <div class="ih-split-visual">
      <img
        src="/assets/manufacturing/Casting%201.JPG"
        alt="Banco Aluminium foundry — billet casting"
        loading="eager"
      />
    </div>
    <div class="ih-split-body">
      <h2 class="ih-split-h2">From drawing<br>to repeat supply.</h2>
      <div class="ih-cap-list">
        <div class="ih-cap-item">
          <span class="ih-cap-dot"></span>
          <span>Die design, trial, and approval managed in-house</span>
        </div>
        <div class="ih-cap-item">
          <span class="ih-cap-dot"></span>
          <span>Alloys 1xxx–7xxx · hard alloy specialists</span>
        </div>
        <div class="ih-cap-item">
          <span class="ih-cap-dot"></span>
          <span>Heat treatment, machining, cold drawing — same site</span>
        </div>
        <div class="ih-cap-item">
          <span class="ih-cap-dot"></span>
          <span>IATF 16949 · CBAM-ready export documentation</span>
        </div>
      </div>
      <a href="/contact#quote" class="btn btn-primary ih-split-cta">Submit a drawing</a>
    </div>
  </section>

  <!-- ── Industries — compact dark grid ────────────────────────────────────── -->
  <section class="section-dark" style="padding: 72px 0">
    <div class="container">
      <h2 class="ih-section-h2" style="color:var(--color-platinum)">
        12 sectors.<br>One partner.
      </h2>
      <div class="i-industry-grid">
        {industries.map((ind) => (
          <div class="i-industry-cell">
            <div class="i-ind-num">{ind.num}</div>
            <div class="i-ind-name">{ind.name}</div>
            <div class="i-ind-note">{ind.note}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Alloys — editorial split (reversed) ───────────────────────────────── -->
  <section class="ih-split ih-split-rev" style="background:var(--color-stone-50)">
    <div class="ih-split-visual">
      <img
        src="/assets/manufacturing/Melting%201.JPG"
        alt="Banco Aluminium alloy melting furnace"
        loading="lazy"
      />
    </div>
    <div class="ih-split-body">
      <h2 class="ih-split-h2">Hard alloys.<br>Lead-free grades.</h2>
      <div class="ih-alloy-cards">
        {alloyFamilies.map((fam, i) => (
          <div class="ih-alloy-card">
            <div class="ih-alloy-num">{String(i + 1).padStart(2, '0')}</div>
            <div class="ih-alloy-title">{fam.title}</div>
            <div class="ih-alloy-sub">{fam.sub}</div>
            <div class="ih-alloy-grades">
              {fam.grades.map(g => <span class="ih-grade">{g}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Capability chain — dark numbered grid ─────────────────────────────── -->
  <section class="section-dark" style="padding: 72px 0">
    <div class="container">
      <h2 class="ih-section-h2" style="color:var(--color-platinum)">
        Six integrated stages<br>under one roof.
      </h2>
      <div class="ih-cap-grid">
        {capabilities.map((cap) => (
          <div class="ih-cap-cell">
            <div class="ih-cap-n">{cap.num}</div>
            <div class="ih-cap-name">{cap.name}</div>
            <div class="ih-cap-tag">{cap.tag}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Facility photo strip ───────────────────────────────────────────────── -->
  <div class="ih-fac-strip">
    {[
      ['/assets/manufacturing/Casting%205.JPG',  'Casting pit — cylinder-guided Hot-Top casting'],
      ['/assets/manufacturing/Quality%201.JPG',  'Spectromax OES — 100% chemical verification'],
      ['/assets/manufacturing/Billet%201.JPG',   'Finished extrusion billets — despatch-ready'],
      ['/assets/manufacturing/Homo%201.JPG',     'Homogenisation furnace — billet conditioning'],
    ].map(([src, alt]) => (
      <div class="ih-fac-tile">
        <img src={src} alt={alt} loading="lazy" />
        <div class="ih-fac-caption">{alt}</div>
      </div>
    ))}
  </div>

  <!-- ── How to order — compact workflow ───────────────────────────────────── -->
  <section class="section-white" style="padding: 72px 0">
    <div class="container">
      <h2 class="ih-section-h2 ih-h2-navy">Submit a drawing.<br>We handle the rest.</h2>
      <div class="ih-workflow">
        {workflow.map((w) => (
          <div class="ih-wf-row">
            <div class="ih-wf-num">{w.num}</div>
            <div class="ih-wf-step">{w.step}</div>
            <div class="ih-wf-note">{w.note}</div>
          </div>
        ))}
      </div>
      <div class="ih-workflow-cta">
        <a href="/contact#quote" class="btn btn-primary">Submit a drawing</a>
        <a href="/contact#technical" class="btn btn-secondary">Talk to our die team</a>
      </div>
    </div>
  </section>

  <!-- ── Packing options ────────────────────────────────────────────────────── -->
  <section class="section-silver" style="padding: 72px 0">
    <div class="container">
      <h2 class="ih-section-h2 ih-h2-navy">Customer-specified packing.<br>Export-ready.</h2>
      <div class="ih-pack-grid">
        <div>
          <div class="ih-pack-label">Internal protection</div>
          <div class="ih-pack-table">
            {packingInternal.map((p, i) => (
              <div class={`ih-pack-row${i < packingInternal.length - 1 ? ' ih-pack-border' : ''}`}>
                <div class="ih-pack-name">{p.name}</div>
                <div class="ih-pack-desc">{p.desc}</div>
              </div>
            ))}
          </div>
        </div>
        <div>
          <div class="ih-pack-label">External bundle packing</div>
          <div class="ih-pack-table">
            {packingExternal.map((p, i) => (
              <div class={`ih-pack-row${i < packingExternal.length - 1 ? ' ih-pack-border' : ''}`}>
                <div class="ih-pack-name">{p.name}</div>
                <div class="ih-pack-desc">{p.desc}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Footer band ────────────────────────────────────────────────────────── -->
  <section class="section-dark" style="padding:60px 0;border-top:2px solid var(--color-green)">
    <div class="container">
      <div class="ih-footer-grid">
        <div>
          <div class="ih-cert-row">
            <div class="ih-cert-label">Certified to:</div>
            <div class="ih-cert-chips">
              {certs.map(c => <span class="pill pill-dark">{c}</span>)}
            </div>
          </div>
        </div>
        <div class="ih-cta-col">
          <div class="eyebrow on-dark">New profile development</div>
          <h2 class="ih-cta-h2">Have a drawing<br>or sample in mind?</h2>
          <div class="ih-cta-btns">
            <a href="/contact#quote" class="btn btn-primary-dark">Submit a drawing</a>
            <a href="/contact#quote" class="btn btn-secondary-dark">Request a quotation</a>
            <a href="/downloads" class="btn btn-secondary-dark">Download brochure</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Hero ────────────────────────────────────────────────────────────────── */
  .ih-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .ih-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .ih-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      160deg,
      rgba(8,27,48,0.72) 0%,
      rgba(8,27,48,0.45) 50%,
      rgba(8,27,48,0.78) 100%
    );
  }
  .ih-hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 0 0 64px;
  }
  .ih-hero-content > .eyebrow { padding: 0 clamp(24px, 5vw, 80px); margin-bottom: 20px; }
  .ih-h1 {
    font-family: var(--font-sans);
    font-size: clamp(40px, 5.6vw, 76px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.95;
    color: var(--color-platinum);
    padding: 0 clamp(24px, 5vw, 80px);
    margin-bottom: 48px;
  }
  .ih-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: rgba(40,69,106,0.4);
    border-top: 1px solid rgba(40,69,106,0.4);
    border-bottom: 1px solid rgba(40,69,106,0.4);
    margin-bottom: 40px;
  }
  .ih-stat {
    background: rgba(8,27,48,0.7);
    backdrop-filter: blur(4px);
    padding: 20px clamp(24px, 5vw, 80px);
  }
  .ih-stat-num {
    font-family: var(--font-sans);
    font-size: clamp(22px, 2.4vw, 32px);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-platinum);
    line-height: 1;
  }
  .ih-stat-u {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--color-green);
    margin-left: 4px;
    font-weight: 400;
  }
  .ih-stat-l {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-nickel);
    margin-top: 6px;
  }
  .ih-hero-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    padding: 0 clamp(24px, 5vw, 80px);
  }

  /* ── Editorial splits ─────────────────────────────────────────────────────── */
  .ih-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 80vh;
    background: #fff;
  }
  .ih-split-rev .ih-split-visual { order: 2; }
  .ih-split-rev .ih-split-body   { order: 1; }
  .ih-split-visual {
    overflow: hidden;
    background: var(--color-stone-200);
  }
  .ih-split-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .ih-split-visual:hover img { transform: scale(1.03); }
  .ih-split-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(40px, 6vw, 96px) clamp(32px, 5vw, 80px);
    gap: 24px;
  }
  .ih-split-h2 {
    font-family: var(--font-sans);
    font-size: clamp(28px, 3.2vw, 48px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.0;
    color: var(--color-navy);
    margin: 0;
  }
  .ih-split-cta { align-self: flex-start; margin-top: 8px; }

  /* Capability list for overview split */
  .ih-cap-list { display: flex; flex-direction: column; gap: 14px; }
  .ih-cap-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-stone-700);
    line-height: 1.5;
  }
  .ih-cap-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-green);
    margin-top: 6px;
    flex-shrink: 0;
  }

  /* Alloy cards inside split */
  .ih-alloy-cards { display: flex; flex-direction: column; gap: 12px; }
  .ih-alloy-card {
    border: 1px solid var(--color-stone-200);
    border-top: 2px solid var(--color-green);
    padding: 16px 20px;
    background: #fff;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .ih-alloy-num { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.16em; color: var(--color-green); }
  .ih-alloy-title { font-family: var(--font-sans); font-size: 16px; font-weight: 700; letter-spacing: -0.02em; color: var(--color-navy); }
  .ih-alloy-sub { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-stone-400); }
  .ih-alloy-grades { display: flex; flex-wrap: wrap; gap: 5px; padding-top: 8px; border-top: 1px solid var(--color-stone-200); margin-top: 4px; }
  .ih-grade { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.1em; color: var(--color-navy); background: var(--color-stone-50); border: 1px solid var(--color-stone-200); padding: 3px 8px; }

  /* ── Section headings ────────────────────────────────────────────────────── */
  .ih-section-h2 {
    font-family: var(--font-sans);
    font-size: clamp(26px, 3vw, 42px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin: 16px 0 40px;
  }
  .ih-h2-navy { color: var(--color-navy); }

  /* ── Industry grid ────────────────────────────────────────────────────────── */
  .i-industry-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--color-navy-line);
    border: 1px solid var(--color-navy-line);
  }
  .i-industry-cell {
    background: var(--color-navy);
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: background 0.2s ease;
  }
  .i-industry-cell:hover { background: var(--color-navy-soft); }
  .i-ind-num { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.16em; color: var(--color-green); }
  .i-ind-name { font-family: var(--font-sans); font-size: 14px; font-weight: 600; letter-spacing: -0.01em; color: var(--color-platinum); line-height: 1.25; }
  .i-ind-note { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-nickel); line-height: 1.4; margin-top: auto; }

  /* ── Capability grid ─────────────────────────────────────────────────────── */
  .ih-cap-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--color-navy-line);
    border: 1px solid var(--color-navy-line);
  }
  .ih-cap-cell {
    background: var(--color-navy);
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-top: 2px solid transparent;
    transition: background 0.2s ease, border-top-color 0.2s ease;
  }
  .ih-cap-cell:hover { background: var(--color-navy-soft); border-top-color: var(--color-green); }
  .ih-cap-n { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.16em; color: var(--color-green); }
  .ih-cap-name { font-family: var(--font-sans); font-size: 15px; font-weight: 700; letter-spacing: -0.02em; color: var(--color-platinum); line-height: 1.2; }
  .ih-cap-tag { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-nickel); line-height: 1.5; margin-top: auto; }

  /* ── Facility strip ──────────────────────────────────────────────────────── */
  .ih-fac-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }
  .ih-fac-tile { position: relative; aspect-ratio: 3/2; overflow: hidden; }
  .ih-fac-tile img { width: 100%; height: 100%; object-fit: cover; display: block; filter: brightness(0.72); transition: transform 0.5s ease, filter 0.3s ease; }
  .ih-fac-tile:hover img { transform: scale(1.05); filter: brightness(0.88); }
  .ih-fac-caption {
    position: absolute; bottom: 0; left: 0; right: 0;
    padding: 20px 12px 10px;
    background: linear-gradient(transparent, rgba(8,27,48,0.82));
    font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--color-nickel); line-height: 1.4;
    opacity: 0; transition: opacity 0.3s ease;
  }
  .ih-fac-tile:hover .ih-fac-caption { opacity: 1; }

  /* ── Workflow ────────────────────────────────────────────────────────────── */
  .ih-workflow { display: flex; flex-direction: column; border: 1px solid var(--color-stone-200); }
  .ih-wf-row {
    display: grid;
    grid-template-columns: 48px 1fr 1fr;
    gap: 24px;
    padding: 18px 24px;
    border-bottom: 1px solid var(--color-stone-200);
    align-items: center;
    background: var(--color-stone-50);
    transition: background 0.2s ease;
  }
  .ih-wf-row:last-child { border-bottom: none; }
  .ih-wf-row:hover { background: white; }
  .ih-wf-num { font-family: var(--font-mono); font-size: 17px; font-weight: 500; color: var(--color-green); }
  .ih-wf-step { font-family: var(--font-sans); font-size: 14px; font-weight: 600; color: var(--color-navy); }
  .ih-wf-note { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-stone-400); }
