---
import Layout from '../../layouts/Layout.astro';
import Pic from '../../components/Pic.astro';

const sectionGroups = [
  {
    title: 'Bars', std: 'IS 733',
    items: [
      { id: 'bar-round',  type: 'Round',      desc: '6–150 mm diameter. Extruded and cold drawn grades available.',                   alloy: '6061-T6 · 6082-T6 · 2011', icon: 'round' },
      { id: 'bar-square', type: 'Square',     desc: '10×10 to 80×80 mm. Structural and machining stock.',                             alloy: '6082-T6 · 6061-T6',         icon: 'square' },
      { id: 'bar-hex',    type: 'Hexagonal',  desc: '6–50 mm across flats. Fastener stock, machining blanks, and hex-drive components.', alloy: '6082-T6 · 6061-T6',        icon: 'hex' },
      { id: 'bar-flat',   type: 'Flat',       desc: '10–200 mm wide, 2–20 mm thick. Plate strip, fabrication flat.',                    alloy: '6061-T6 · 6082-T6',         icon: 'flat' },
    ],
  },
  {
    title: 'Tubes', std: 'IS 1285',
    items: [
      { id: 'tube-round', type: 'Round',        desc: '12–200 mm OD. Structural, mechanical, and architectural tube.',      alloy: '6063-T6 · 6082-T6', icon: 'roundTube' },
      { id: 'tube-square',type: 'Square',        desc: '10×10 to 100×100 mm. Structural and mechanical tube for frames and fabrication.', alloy: '6063-T6 · 6082-T6', icon: 'squareTube' },
      { id: 'tube-rect',  type: 'Rectangular',   desc: 'RHS for structural frames, guard rails, and support structures.',     alloy: '6082-T6 · 6063-T6', icon: 'rectTube' },
    ],
    fill: { src: '/assets/standard-sections/fill-tubes.png', alt: 'Cut length of Banco rectangular hollow section aluminium tube', span: 1 },
  },
  {
    title: 'Angles', std: 'IS 1285',
    items: [
      { id: 'angle-equal',   type: 'Equal',   desc: 'Equal legs, 20×20 to 100×100 mm. Structural and fabrication use.', alloy: '6063-T6 · 6082-T6', icon: 'equalAngle' },
      { id: 'angle-unequal', type: 'Unequal', desc: 'Unequal legs for specific structural configurations.',              alloy: '6063-T6 · 6082-T6', icon: 'unequalAngle' },
    ],
    fill: { src: '/assets/standard-sections/fill-angles.png', alt: 'Cut lengths of Banco equal and unequal leg aluminium angle', span: 2 },
  },
  {
    title: 'Channels', std: 'IS 1285',
    items: [
      { id: 'channel-equal',   type: 'Equal',   desc: 'C-section channel, standard and heavy duty. Wide flange versions.',       alloy: '6082-T6',           icon: 'channel' },
      { id: 'channel-unequal', type: 'Unequal', desc: 'Unequal flange channel for asymmetric structural and fabrication use.',    alloy: '6082-T6 · 6063-T6', icon: 'unequalChannel' },
    ],
    fill: { src: '/assets/standard-sections/fill-channels.png', alt: 'Cut lengths of Banco aluminium channel section', span: 2 },
  },
  {
    title: 'Tees', std: 'IS 1285',
    items: [
      { id: 'tee-regular', type: 'Regular', desc: 'Equal and unequal T-sections. Track, extrusion guide, structural T.',   alloy: '6063-T6 · 6082-T6', icon: 'tee' },
      { id: 'tee-bulb',    type: 'Bulb',    desc: 'Tee with a rolled bulb edge for stiffened panel and marine deck use.',   alloy: '6082-T6',           icon: 'bulbTee' },
    ],
    fill: { src: '/assets/standard-sections/fill-tees.png', alt: 'Cut lengths of Banco regular and bulb aluminium tee section', span: 2 },
  },
  {
    title: 'Modular', std: 'IS 1285',
    items: [
      { id: 'modular', type: 'Modular profiles', desc: 'Slotted modular profiles for framing, workstations, and machine guarding: assembled without welding using standard fasteners and brackets.', alloy: '6063-T6 · 6082-T6', icon: 'modular' },
    ],
    fill: { src: '/assets/standard-sections/fill-modular.png', alt: 'Assembled corner of Banco slotted modular aluminium framing', span: 3 },
  },
];

// Simplified cross-section silhouettes — schematic, not to scale
const sectionIcons: Record<string, string> = {
  equalAngle:    `<path d="M5 4 L5 32 L11 32 L11 10 L32 10 L32 4 Z" fill="currentColor" fill-opacity="0.14" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>`,
  unequalAngle:  `<path d="M5 4 L5 32 L9 32 L9 8 L32 8 L32 4 Z" fill="currentColor" fill-opacity="0.14" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>`,
  channel:       `<path d="M6 4 L30 4 L30 10 L12 10 L12 26 L30 26 L30 32 L6 32 Z" fill="currentColor" fill-opacity="0.14" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>`,
  unequalChannel:`<path d="M6 4 L26 4 L26 10 L12 10 L12 26 L30 26 L30 32 L6 32 Z" fill="currentColor" fill-opacity="0.14" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>`,
  tee:           `<path d="M4 4 L32 4 L32 10 L21 10 L21 32 L15 32 L15 10 L4 10 Z" fill="currentColor" fill-opacity="0.14" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>`,
  bulbTee:       `<path d="M4 4 L32 4 L32 10 L21 10 L21 26 L15 26 L15 10 L4 10 Z" fill="currentColor" fill-opacity="0.14" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="18" cy="29" r="4.5" fill="currentColor" fill-opacity="0.14" stroke="currentColor" stroke-width="1.4"/>`,
  flat:          `<rect x="4" y="13" width="28" height="8" fill="currentColor" fill-opacity="0.14" stroke="currentColor" stroke-width="1.6"/>`,
  square:        `<rect x="8" y="8" width="20" height="20" fill="currentColor" fill-opacity="0.14" stroke="currentColor" stroke-width="1.6"/>`,
  round:         `<circle cx="18" cy="18" r="13" fill="currentColor" fill-opacity="0.14" stroke="currentColor" stroke-width="1.6"/>`,
  hex:           `<path d="M12 5 L24 5 L31 18 L24 31 L12 31 L5 18 Z" fill="currentColor" fill-opacity="0.14" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>`,
  rectTube:      `<rect x="4" y="8" width="28" height="20" fill="none" stroke="currentColor" stroke-width="1.6"/><rect x="8" y="12" width="20" height="12" fill="none" stroke="currentColor" stroke-width="1.4"/>`,
  squareTube:    `<rect x="6" y="6" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6"/><rect x="11" y="11" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.4"/>`,
  roundTube:     `<circle cx="18" cy="18" r="14" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="18" cy="18" r="9" fill="none" stroke="currentColor" stroke-width="1.4"/>`,
  modular:       `<rect x="4" y="4" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M4 13 H32 M4 23 H32 M13 4 V32 M23 4 V32" stroke="currentColor" stroke-width="1" stroke-opacity="0.55"/>`,
};

const galleryImages = ['2a', '2b', '2c', '2d', '2e', '2f', '2g'];

const alloys = [
  {
    grade: '6063-T6',
    name: 'Architectural',
    tensile: '185 MPa',
    yield: '145 MPa',
    uses: 'Window systems, curtain wall, fascia, shopfront, solar racking, architectural trim.',
    anodise: 'Excellent',
    weld: 'Good',
  },
  {
    grade: '6082-T6',
    name: 'Structural',
    tensile: '310 MPa',
    yield: '290 MPa',
    uses: 'Load-bearing structures, beams, columns, racking, transport, marine.',
    anodise: 'Good',
    weld: 'Good',
  },
  {
    grade: '6061-T6',
    name: 'Engineering',
    tensile: '260 MPa',
    yield: '240 MPa',
    uses: 'Precision engineering, aerospace sub-structure, CNC machining stock, automotive.',
    anodise: 'Good',
    weld: 'Excellent',
  },
];
---

<Layout
  title="Standard sections: Banco Aluminium"
  description="Standard aluminium sections to IS 733 and IS 1285: angles, channels, T-sections, flat bar, RHS, SHS and round tube in 6063, 6082 and 6061 tempers."
>

  <section class="ss-hero">
    <Pic
      src="/assets/standard-sections/hero.jpg"
      alt="Banco Aluminium standard aluminium section samples"
      class="ss-hero-img"
      loading="eager" sizes="100vw" />
    <div class="ss-hero-scrim" aria-hidden="true"></div>
    <div class="container">
      <div class="eyebrow on-dark">Products / Standard sections</div>
      <h1 class="ss-h1">
        Standard profiles.<br>Ready to specify.
      </h1>
      <p class="ss-lead">
        Our extensive range of standard aluminium sections is engineered to meet the diverse
        needs of structural and architectural industries. Comprising versatile profile types
        and manufactured to IS 733 and IS 1285 standards.
      </p>
      <p class="ss-lead" style="margin-top:16px">
        Banco maintains ready stock in 6 series alloys with mill finish. Value-added surface
        treatments, including anodizing and powder coating, are available upon request,
        delivering enhanced durability and aesthetics.
      </p>
      <div class="ss-stats">
        {[
          { n: 'IS 1285',    l: 'Extruded sections standard' },
          { n: 'IS 733',     l: 'Wrought aluminium bars & rods' },
          { n: 'All Alloys', l: 'In stock' },
          { n: 'Certified',  l: 'CE marked', ce: true },
        ].map(({ n, l, ce }) => (
          <div class="ss-stat">
            <div class="ss-stat-n">
              {ce && (
                <img class="ss-ce" src="/assets/logos/ce-marking.png" alt="CE marking" width="130" height="60" />
              )}
              {n}
            </div>
            <div class="ss-stat-l">{l}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Gallery strip -->
  <section class="section-alt ss-gallery-section" style="padding:40px 0;border-top:1px solid var(--color-stone-200)">
    <div class="ss-gallery-viewport">
      <div class="ss-gallery-track">
        {[...galleryImages, ...galleryImages].map((id, i) => (
          <div class="ss-gallery-item" aria-hidden={i >= galleryImages.length ? 'true' : undefined}>
            <Pic
              src={`/assets/standard-sections/${id}.jpg`}
              alt={i < galleryImages.length ? 'Banco Aluminium standard section extrusion sample' : ''}
              class="ss-gallery-img"
              sizes="240px"
              loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section types -->
  <section class="section-light section-pad">
    <div class="container">
      <div class="eyebrow">/ 01 · Section types</div>
      <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px;margin-bottom:40px">
        Standard section<br>types in stock.
      </h2>
      <div class="ss-groups">
        {sectionGroups.map((group, gi) => (
          <div class="ss-group">
            <div class="ss-group-head">
              <span class="ss-group-num">{String(gi + 1).padStart(2, '0')}</span>
              <h3 class="ss-group-title">{group.title}</h3>
              <span class="ss-group-std">{group.std}</span>
            </div>
            <div class="ss-sections-grid">
              {group.items.map((s) => (
                <div class="ss-section-card">
                  <div class="ss-sec-icon" aria-hidden="true">
                    <svg width="36" height="36" viewBox="0 0 36 36" fill="none" set:html={sectionIcons[s.icon]} />
                  </div>
                  <div class="ss-sec-id">{group.title} / {s.type}</div>
                  <h3 class="ss-sec-type">{s.type}</h3>
                  <p class="ss-sec-desc">{s.desc}</p>
                  <div class="ss-sec-footer">
                    <div class="ss-sec-alloy">{s.alloy}</div>
                    <div class="ss-sec-std">{group.std}</div>
                  </div>
                </div>
              ))}
              {group.fill && (
                <div class="ss-sec-fill" style={`grid-column:span ${group.fill.span}`}>
                  <Pic
                    src={group.fill.src}
                    alt={group.fill.alt}
                    class="ss-fill-img"
                    sizes="290px"
                    loading="lazy" />
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Alloys -->
  <section class="section-dark section-pad">
    <div class="container">
      <div class="eyebrow on-dark">/ 02 · Available alloys</div>
      <h2 class="t-h2" style="color:var(--color-platinum);margin-top:16px;margin-bottom:40px">
        Three grades.<br>Architectural to structural.
      </h2>
      <div class="ss-alloy-grid">
        {alloys.map((a) => (
          <div class="ss-alloy-card">
            <div class="ss-alloy-grade">{a.grade}</div>
            <div class="ss-alloy-name">{a.name}</div>
            <div class="ss-alloy-props">
              <div class="ss-prop">
                <span class="ss-prop-val">{a.tensile}</span>
                <span class="ss-prop-label">Tensile strength</span>
              </div>
              <div class="ss-prop">
                <span class="ss-prop-val">{a.yield}</span>
                <span class="ss-prop-label">0.2% Proof stress</span>
              </div>
            </div>
            <p class="ss-alloy-uses">{a.uses}</p>
            <div class="ss-alloy-attrs">
              <div class="ss-attr">
                <span class="ss-attr-key">Anodise quality</span>
                <span class="ss-attr-val">{a.anodise}</span>
              </div>
              <div class="ss-attr">
                <span class="ss-attr-key">Weldability</span>
                <span class="ss-attr-val">{a.weld}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Specifications -->
  <section class="section-alt section-pad">
    <div class="container">
      <div class="eyebrow">/ 03 · Specifications & standards</div>
      <div class="ss-spec-grid">
        <div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            IS 733 · IS 1285.<br>CE for export.
          </h2>
          <p class="t-body" style="color:var(--color-stone-700);margin-top:20px;line-height:1.7">
            Banco's standard section range is manufactured and supplied to the Bureau of
            Indian Standards specifications IS 733 (aluminium alloy wrought products:
            bars, rods, and sections) and IS 1285 (wrought aluminium and aluminium alloys:
            extruded sections). Material test certificates conforming to EN 10204 Type 3.1
            are available for all stock items.
          </p>
          <p class="t-body" style="color:var(--color-stone-700);margin-top:16px;line-height:1.7">
            For export orders to the European Union, a CE Declaration of Performance
            under EN 15088 (aluminium structures: technical conditions for inspection
            and delivery) can be issued for structural section grades. This is required
            for load-bearing applications in CE-marked structures.
          </p>
        </div>
        <div class="ss-std-list">
          {[
            { std: 'IS 733',        scope: 'Wrought aluminium bars, rods, and sections. Dimensional and mechanical tolerances for flat bars, square bars, and round bars.' },
            { std: 'IS 1285',       scope: 'Extruded aluminium and aluminium alloy round tubes, hollow and solid sections. Dimensional tolerances, straightness, and twist.' },
            { std: 'EN 755-2',      scope: 'Extruded rod/bar and tube: mechanical properties. Reference standard for export orders and CE marking.' },
            { std: 'EN 12020-2',    scope: 'Precision profiles, with tighter dimensional tolerances than EN 755-9 for precision engineering applications.' },
            { std: 'EN 15088',      scope: 'Aluminium structures: technical conditions for inspection and delivery. CE marking for structural load-bearing applications.' },
            { std: 'EN 10204 3.1',  scope: 'Material test certificate. Inspection by manufacturer, test results certified and traceable to production lot.' },
          ].map(({ std, scope }) => (
            <div class="ss-std-row">
              <div class="ss-std-code">{std}</div>
              <div class="ss-std-scope">{scope}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Custom die service -->
  <section class="section-light" style="padding:64px 0;border-top:1px solid var(--color-stone-200)">
    <div class="container">
      <div class="eyebrow">/ 04 · Custom die service</div>
      <div class="ss-custom-grid">
        <div>
          <h2 class="t-h2" style="color:var(--color-navy);margin-top:16px">
            Standard section<br>doesn't fit? We'll<br>design the die.
          </h2>
        </div>
        <div>
          <p class="t-lead" style="color:var(--color-stone-700)">
            If no standard section matches your application, Banco's in-house die shop
            will design and manufacture a custom die, typically within 2–3 weeks. Custom
            profiles are extruded, heat treated, and finished to the same specification
            and quality standard as standard sections.
          </p>
          <p class="t-body" style="color:var(--color-stone-700);margin-top:16px;line-height:1.7">
            Submit a DXF or PDF drawing with critical dimensions indicated. The die shop
            team will review for extrudability, propose any necessary modifications, and
            return a tooling quotation and lead time within 3 working days.
          </p>
          <div style="margin-top:32px;display:flex;gap:12px;flex-wrap:wrap">
            <a href="/contact#drawing" class="btn btn-primary">Submit a drawing</a>
            <a href="/capabilities/die-shop" class="btn btn-secondary">Die shop capability</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-dark" style="padding:64px 0;border-top:2px solid var(--color-green)">
    <div class="container">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:32px">
        <div>
          <div class="eyebrow on-dark">Standard sections</div>
          <h2 class="t-h2" style="color:var(--color-platinum);margin-top:12px">
            Download the catalogue.<br>Or request a quote now.
          </h2>
        </div>
        <div style="display:flex;flex-direction:column;gap:12px">
          <a href="/downloads" class="btn btn-primary-dark">Download catalogue</a>
          <a href="/contact#quote" class="btn btn-secondary-dark">Send Enquiry</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .ss-hero {
    background: var(--color-navy);
    padding: 148px 0 0;
    position: relative;
    overflow: hidden;
  }
  .ss-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: repeating-linear-gradient(90deg, transparent 0, transparent 3px, rgba(255,255,255,0.012) 3px, rgba(255,255,255,0.012) 4px);
    pointer-events: none;
  }
  :global(.ss-hero-img) {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ss-hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(8,27,48,0.88) 0%, rgba(14,42,71,0.90) 55%, rgba(8,27,48,0.96) 100%);
  }
  .ss-hero > .container { position: relative; z-index: 3; }
  .ss-h1 { font-family: var(--font-sans); font-size: clamp(36px, 5vw, 64px); font-weight: 800; letter-spacing: -0.04em; line-height: 0.95; color: var(--color-platinum); margin-top: 20px; }
  .ss-lead { font-family: var(--font-sans); font-size: clamp(15px, 1.4vw, 17px); line-height: 1.65; color: var(--color-silver); margin-top: 24px; max-width: 56ch; }
  .ss-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--color-navy-line); border-top: 1px solid var(--color-navy-line); margin-top: 48px; }
  .ss-stat { background: var(--color-navy-deep); padding: 22px 24px; }
  .ss-stat-n { font-family: var(--font-sans); font-size: clamp(16px, 2vw, 24px); font-weight: 700; letter-spacing: -0.03em; color: var(--color-platinum); display: flex; align-items: center; gap: 10px; }
  .ss-ce { width: 38px; height: auto; flex-shrink: 0; }
  .ss-stat-l { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-nickel); margin-top: 6px; }

  .ss-groups { display: flex; flex-direction: column; gap: 36px; }
  .ss-group-head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 14px; }
  .ss-group-num { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; color: var(--color-green); }
  .ss-group-title { font-family: var(--font-sans); font-size: 19px; font-weight: 700; color: var(--color-navy); letter-spacing: -0.01em; }
  .ss-group-std { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-stone-700); margin-left: auto; }
  .ss-sections-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--color-stone-200); border: 1px solid var(--color-stone-200); }
  .ss-section-card  { background: var(--color-stone-50); padding: 22px 18px; border-top: 2px solid var(--color-green); display: flex; flex-direction: column; gap: 6px; }
  .ss-sec-icon { color: var(--color-navy); margin-bottom: 4px; }
  .ss-sec-id   { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.16em; color: var(--color-green); }
  .ss-sec-type { font-family: var(--font-sans); font-size: 14px; font-weight: 700; color: var(--color-navy); line-height: 1.2; }
  .ss-sec-desc { font-family: var(--font-sans); font-size: 12px; line-height: 1.55; color: var(--color-stone-700); flex: 1; }
  .ss-sec-footer { display: flex; flex-direction: column; gap: 3px; margin-top: 8px; border-top: 1px solid var(--color-stone-200); padding-top: 8px; }
  .ss-sec-alloy { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.08em; color: var(--color-stone-700); }
  .ss-sec-std   { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-green); }

  .ss-sec-fill { position: relative; overflow: hidden; background: var(--color-stone-100); border-top: 2px solid var(--color-green); }
  :global(.ss-fill-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(0.5) contrast(1.02);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), filter 0.45s ease;
  }
  .ss-sec-fill:hover :global(.ss-fill-img) {
    transform: scale(1.05);
    filter: grayscale(0) contrast(1.02);
  }

  .ss-gallery-viewport {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent 0, black 64px, black calc(100% - 64px), transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, black 64px, black calc(100% - 64px), transparent 100%);
  }
  .ss-gallery-track {
    display: flex;
    width: max-content;
    padding: 4px 0 12px;
    animation: ss-marquee 34s linear infinite;
  }
  .ss-gallery-section:hover .ss-gallery-track { animation-play-state: paused; }
  .ss-gallery-item {
    position: relative;
    flex: 0 0 auto;
    width: 220px;
    margin-right: 20px;
    aspect-ratio: 290 / 244;
    overflow: hidden;
    background: var(--color-stone-100);
    border: 1px solid var(--color-stone-200);
    border-radius: 3px;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    transition: box-shadow 0.35s ease, border-color 0.35s ease, transform 0.35s ease;
  }
  .ss-gallery-item::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.5);
    pointer-events: none;
  }
  .ss-gallery-item:hover {
    border-color: var(--color-green);
